// Declarative Slint UI definition for Project Manifold
// Implements the complete UI/UX & Architectural Specifications in doc/specification_1.md,
// doc/specification_2.md, and doc/BRIEF.md.
//
// Elevation Token System (Dark Zinc Palette - doc/specification_2.md §2.2):
// - Base Window Canvas:       #121214
// - Unified Top Toolbar:      #1E1E22 (height: 36px, bottom border: #28282D)
// - Sidebar (Panel 0):        #161618 (border: #28282D)
// - Main File View (Panel 1): #1A1A1E (border: #28282D — no neon outer focus border)
// - Table Header Row:         #1E1E22 (height: 28px, uppercase #8E8E93, bottom border: #28282D)
// - Row Hover:                #26262B
// - Row Selected (Focused):   #0D52BF (Professional Royal Blue)
// - Row Selected (Unfocused): #2E323B (Muted Slate when pane loses focus)
// - Context Menu / Popover:   #202024 (100% Opaque, border: 1px solid #323238, radius: 8px)
// - Borders & Dividers:       #28282D (1px solid)

import { ScrollView } from "std-widgets.slint";

export struct SidebarEntrySlint {
    id: string,
    section: string,
    icon-kind: string,
    is-header: bool,
    label: string,
    badge: string,
    can-eject: bool,
    indent-level: int,
    is-selected: bool,
    has-color-tag: bool,
    color-tag-brush: brush,
}

export struct TabEntrySlint {
    title: string,
    tooltip: string,
    icon-kind: string,
    is-active: bool,
    is-search: bool,
    is-remote: bool,
}

export struct BreadcrumbSegmentSlint {
    label: string,
    target-path: string,
    is-last: bool,
}

export struct FileRowSlint {
    name: string,
    path: string,
    ext-badge: string,
    size-text: string,
    modified-text: string,
    kind-text: string,
    color-tag-hex: string,
    color-tag-name: string,
    color-tag-brush: brush,
    color-tag-tint: brush,
    has-color-tag: bool,
    is-dir: bool,
    is-image: bool,
    has-thumbnail: bool,
    thumbnail: image,
    is-executable: bool,
    is-expanded: bool,
    is-selected: bool,
    depth: int,
}

export struct IconGridTripleSlint {
    has-0: bool,
    idx-0: int,
    item-0: FileRowSlint,
    has-1: bool,
    idx-1: int,
    item-1: FileRowSlint,
    has-2: bool,
    idx-2: int,
    item-2: FileRowSlint,
}

export struct TransferRowSlint {
    id: string,
    priority-label: string,
    source-name: string,
    dest-path: string,
    status-text: string,
    progress-pct: int,
}

// Unified Lucide Vector Icon System (16x16px, 1.5px stroke width — doc/specification_2.md §2.5 & §4.5)
component LucideIcon inherits Rectangle {
    in property <string> kind: "file";
    in property <brush> icon-color: #A0A0AB;
    in property <brush> fill-color: transparent;
    in property <length> icon-size: 16px;

    width: icon-size;
    height: icon-size;
    background: transparent;

    Path {
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.icon-color;
        stroke-width: 1.5px;
        fill: root.fill-color;
        commands: root.kind == "folder"
            ? "M 22 19 A 2 2 0 0 1 20 21 L 4 21 A 2 2 0 0 1 2 19 L 2 5 A 2 2 0 0 1 4 3 L 9 3 L 11 6 L 20 6 A 2 2 0 0 1 22 8 Z"
            : root.kind == "drive"
            ? "M 2 12 L 22 12 M 5.45 5.11 L 2 12 L 2 18 A 2 2 0 0 0 4 20 L 20 20 A 2 2 0 0 0 22 18 L 22 12 L 18.55 5.11 A 2 2 0 0 0 16.76 4 L 7.24 4 A 2 2 0 0 0 5.45 5.11 Z M 6 16 L 7 16 M 10 16 L 11 16"
            : root.kind == "home"
            ? "M 3 10 L 12 3 L 21 10 L 21 20 A 2 2 0 0 1 19 22 L 5 22 A 2 2 0 0 1 3 20 Z M 9 22 L 9 13 L 15 13 L 15 22"
            : root.kind == "desktop"
            ? "M 4 3 L 20 3 A 2 2 0 0 1 22 5 L 22 15 A 2 2 0 0 1 20 17 L 4 17 A 2 2 0 0 1 2 15 L 2 5 A 2 2 0 0 1 4 3 Z M 8 21 L 16 21 M 12 17 L 12 21"
            : root.kind == "downloads"
            ? "M 21 15 L 21 19 A 2 2 0 0 1 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 15 M 7 10 L 12 15 L 17 10 M 12 15 L 12 3"
            : root.kind == "documents"
            ? "M 14 2 L 6 2 A 2 2 0 0 0 4 4 L 4 20 A 2 2 0 0 0 6 22 L 18 22 A 2 2 0 0 0 20 20 L 20 8 Z M 14 2 L 14 8 L 20 8 M 8 13 L 16 13 M 8 17 L 16 17"
            : root.kind == "applications"
            ? "M 3 3 L 10 3 L 10 10 L 3 10 Z M 14 3 L 21 3 L 21 10 L 14 10 Z M 14 14 L 21 14 L 21 21 L 14 21 Z M 3 14 L 10 14 L 10 21 L 3 21 Z"
            : (root.kind == "pictures" || root.kind == "image")
            ? "M 5 3 L 19 3 A 2 2 0 0 1 21 5 L 21 19 A 2 2 0 0 1 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 5 A 2 2 0 0 1 5 3 Z M 8.5 10 A 1.5 1.5 0 1 0 8.5 7 A 1.5 1.5 0 1 0 8.5 10 Z M 21 15 L 16 10 L 5 21"
            : root.kind == "music"
            ? "M 9 18 L 9 5 L 21 3 L 21 16 M 9 18 A 3 3 0 1 1 3 18 A 3 3 0 1 1 9 18 Z M 21 16 A 3 3 0 1 1 15 16 A 3 3 0 1 1 21 16 Z"
            : root.kind == "movies"
            ? "M 4 3 L 20 3 A 2 2 0 0 1 22 5 L 22 19 A 2 2 0 0 1 20 21 L 4 21 A 2 2 0 0 1 2 19 L 2 5 A 2 2 0 0 1 4 3 Z M 7 3 L 7 21 M 17 3 L 17 21 M 2 12 L 22 12 M 2 7.5 L 7 7.5 M 2 16.5 L 7 16.5 M 17 7.5 L 22 7.5 M 17 16.5 L 22 16.5"
            : (root.kind == "remote" || root.kind == "gdrive")
            ? "M 4 5 L 20 5 A 2 2 0 0 1 22 7 L 22 10 A 2 2 0 0 1 20 12 L 4 12 A 2 2 0 0 1 2 10 L 2 7 A 2 2 0 0 1 4 5 Z M 4 14 L 20 14 A 2 2 0 0 1 22 16 L 22 19 A 2 2 0 0 1 20 21 L 4 21 A 2 2 0 0 1 2 19 L 2 16 A 2 2 0 0 1 4 14 Z M 6 8.5 L 7 8.5 M 6 17.5 L 7 17.5"
            : root.kind == "terminal"
            ? "M 4 17 L 10 11 L 4 5 M 12 19 L 20 19"
            : root.kind == "chevron-right"
            ? "M 9 18 L 15 12 L 9 6"
            : root.kind == "chevron-left"
            ? "M 15 18 L 9 12 L 15 6"
            : root.kind == "chevron-down"
            ? "M 6 9 L 12 15 L 18 9"
            : root.kind == "chevron-up"
            ? "M 18 15 L 12 9 L 6 15"
            : root.kind == "arrow-up-down"
            ? "M 7 15 L 12 20 L 17 15 M 7 9 L 12 4 L 17 9"
            : root.kind == "globe"
            ? "M 22 12 A 10 10 0 1 1 2 12 A 10 10 0 1 1 22 12 Z M 2 12 L 22 12 M 12 2 A 15.3 15.3 0 0 1 16 12 A 15.3 15.3 0 0 1 12 22 A 15.3 15.3 0 0 1 8 12 A 15.3 15.3 0 0 1 12 2 Z"
            : root.kind == "scissors"
            ? "M 9 6 A 3 3 0 1 1 3 6 A 3 3 0 1 1 9 6 Z M 9 18 A 3 3 0 1 1 3 18 A 3 3 0 1 1 9 18 Z M 20 4 L 8.12 15.88 M 14.47 14.48 L 20 20 M 8.12 8.12 L 12 12"
            : root.kind == "arrow-up"
            ? "M 12 19 L 12 5 M 5 12 L 12 5 L 19 12"
            : root.kind == "search"
            ? "M 18 11 A 7 7 0 1 1 4 11 A 7 7 0 1 1 18 11 Z M 21 21 L 16.65 16.65"
            : root.kind == "plus"
            ? "M 12 5 L 12 19 M 5 12 L 19 12"
            : (root.kind == "refresh" || root.kind == "refresh-0")
            ? "M 3 12 A 9 9 0 0 1 18 5.3 L 21 8 M 21 3 L 21 8 L 16 8 M 21 12 A 9 9 0 0 1 6 18.7 L 3 16 M 3 21 L 3 16 L 8 16"
            : root.kind == "refresh-1"
            ? "M 3.7 8.6 A 9 9 0 0 1 20.1 8.1 L 21.8 11.8 M 23.8 7.2 L 21.8 11.8 L 17.2 9.8 M 20.3 15.4 A 9 9 0 0 1 3.9 15.9 L 2.2 12.2 M 0.2 16.8 L 2.2 12.2 L 6.8 14.2"
            : root.kind == "refresh-2"
            ? "M 5.6 5.6 A 9 9 0 0 1 21 11.5 L 21.2 15.5 M 24.7 12 L 21.2 15.5 L 17.7 12 M 18.4 18.4 A 9 9 0 0 1 3 12.5 L 2.8 8.5 M -0.7 12 L 2.8 8.5 L 6.3 12"
            : root.kind == "refresh-3"
            ? "M 8.6 3.7 A 9 9 0 0 1 20.5 14.9 L 19.1 18.8 M 23.8 16.8 L 19.1 18.8 L 17.2 14.2 M 15.4 20.3 A 9 9 0 0 1 3.5 9.1 L 4.9 5.2 M 0.2 7.2 L 4.9 5.2 L 6.8 9.8"
            : root.kind == "refresh-4"
            ? "M 12 3 A 9 9 0 0 1 18.7 18 L 16 21 M 21 21 L 16 21 L 16 16 M 12 21 A 9 9 0 0 1 5.3 6 L 8 3 M 3 3 L 8 3 L 8 8"
            : root.kind == "refresh-5"
            ? "M 15.4 3.7 A 9 9 0 0 1 15.9 20.1 L 12.2 21.8 M 16.8 23.8 L 12.2 21.8 L 14.2 17.2 M 8.6 20.3 A 9 9 0 0 1 8.1 3.9 L 11.8 2.2 M 7.2 0.2 L 11.8 2.2 L 9.8 6.8"
            : root.kind == "refresh-6"
            ? "M 18.4 5.6 A 9 9 0 0 1 12.5 21 L 8.5 21.2 M 12 24.7 L 8.5 21.2 L 12 17.7 M 5.6 18.4 A 9 9 0 0 1 11.5 3 L 15.5 2.8 M 12 -0.7 L 15.5 2.8 L 12 6.3"
            : root.kind == "refresh-7"
            ? "M 20.3 8.6 A 9 9 0 0 1 9.1 20.5 L 5.2 19.1 M 7.2 23.8 L 5.2 19.1 L 9.8 17.2 M 3.7 15.4 A 9 9 0 0 1 14.9 3.5 L 18.8 4.9 M 16.8 0.2 L 18.8 4.9 L 14.2 6.8"
            : root.kind == "check"
            ? "M 20 6 L 9 17 L 4 12"
            : root.kind == "inspector"
            ? "M 4 3 L 20 3 A 2 2 0 0 1 22 5 L 22 19 A 2 2 0 0 1 20 21 L 4 21 A 2 2 0 0 1 2 19 L 2 5 A 2 2 0 0 1 4 3 Z M 15 3 L 15 21"
            : root.kind == "trash"
            ? "M 3 6 L 21 6 M 19 6 L 19 20 A 2 2 0 0 1 17 22 L 7 22 A 2 2 0 0 1 5 20 L 5 6 M 8 6 L 8 4 A 2 2 0 0 1 10 2 L 14 2 A 2 2 0 0 1 16 4 L 16 6 M 10 11 L 10 17 M 14 11 L 14 17"
            : root.kind == "close"
            ? "M 18 6 L 6 18 M 6 6 L 18 18"
            : root.kind == "info"
            ? "M 22 12 A 10 10 0 1 1 2 12 A 10 10 0 1 1 22 12 Z M 12 16 L 12 12 M 12 8 L 12.1 8"
            : root.kind == "edit"
            ? "M 17 3 A 2.83 2.83 0 1 1 21 7 L 7.5 20.5 L 2 22 L 3.5 16.5 Z"
            : root.kind == "copy"
            ? "M 10 8 L 19 8 A 2 2 0 0 1 21 10 L 21 19 A 2 2 0 0 1 19 21 L 10 21 A 2 2 0 0 1 8 19 L 8 10 A 2 2 0 0 1 10 8 Z M 16 8 L 16 5 A 2 2 0 0 0 14 3 L 5 3 A 2 2 0 0 0 3 5 L 3 14 A 2 2 0 0 0 5 16 L 8 16"
            : root.kind == "archive"
            ? "M 21 8 L 21 21 L 3 21 L 3 8 M 1 3 L 23 3 L 23 8 L 1 8 Z M 10 12 L 14 12"
            : root.kind == "link"
            ? "M 10 13 A 5 5 0 0 0 17.54 13.54 L 20.54 10.54 A 5 5 0 0 0 13.47 3.47 L 11.75 5.18 M 14 11 A 5 5 0 0 0 6.46 10.46 L 3.46 13.46 A 5 5 0 0 0 10.53 20.53 L 12.24 18.82"
            : root.kind == "eye"
            ? "M 2 12 C 5 6 9 4 12 4 C 15 4 19 6 22 12 C 19 18 15 20 12 20 C 9 20 5 18 2 12 Z M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z"
            : root.kind == "external"
            ? "M 18 13 L 18 19 A 2 2 0 0 1 16 21 L 5 21 A 2 2 0 0 1 3 19 L 3 8 A 2 2 0 0 1 5 6 L 11 6 M 15 3 L 21 3 L 21 9 M 10 14 L 21 3"
            : root.kind == "eject"
            ? "M 5 14 L 12 5 L 19 14 Z M 5 18 L 19 18"
            : root.kind == "lock"
            ? "M 5 11 L 19 11 A 2 2 0 0 1 21 13 L 21 20 A 2 2 0 0 1 19 22 L 5 22 A 2 2 0 0 1 3 20 L 3 13 A 2 2 0 0 1 5 11 Z M 7 11 L 7 7 A 5 5 0 0 1 17 7 L 17 11"
            : root.kind == "key"
            ? "M 21 2 L 19 4 M 11.39 11.61 A 5.5 5.5 0 1 1 3.61 19.39 A 5.5 5.5 0 1 1 11.39 11.61 Z M 11.39 11.61 L 22 1 M 16 7 L 19 10"
            : root.kind == "star"
            ? "M 12 2 L 15.09 8.26 L 22 9.27 L 17 14.14 L 18.18 21.02 L 12 17.77 L 5.82 21.02 L 7 14.14 L 2 9.27 L 8.91 8.26 Z"
            : root.kind == "columns"
            ? "M 4 3 L 20 3 A 2 2 0 0 1 22 5 L 22 19 A 2 2 0 0 1 20 21 L 4 21 A 2 2 0 0 1 2 19 L 2 5 A 2 2 0 0 1 4 3 Z M 12 3 L 12 21"
            : "M 14 2 L 6 2 A 2 2 0 0 0 4 4 L 4 20 A 2 2 0 0 0 6 22 L 18 22 A 2 2 0 0 0 20 20 L 20 8 Z M 14 2 L 14 8 L 20 8 M 8 13 L 16 13 M 8 17 L 13 17";
    }
}

// Clean Dark Zinc Text Input (Replaces std-widgets LineEdit so #000000 black box never renders)
component CleanLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    in property <length> font-size: 12.5px;
    callback edited(string);
    callback accepted(string);
    callback escape-pressed();

    height: 28px;
    border-radius: 5px;
    background: #141417;
    border-width: 1px;
    border-color: inner-input.has-focus ? #0D52BF : #28282D;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            if root.text == "" && !inner-input.has-focus : Text {
                text: root.placeholder-text;
                color: #6E6E77;
                font-size: root.font-size;
                vertical-alignment: center;
            }

            inner-input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                input-type: root.input-type;
                font-size: root.font-size;
                color: #E1E1E6;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
                key-pressed(ev) => {
                    if ev.text == "\u{001b}" {
                        root.escape-pressed();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}

// Standardized FileRow Component (doc/specification_2.md §3 & §4.4)
// - Row Height: 28px + font_delta * 2.0
// - Focused Selected: #0D52BF (Royal Blue), Unfocused Selected: #2E323B (Muted Slate), Hover: #26262B
// - Vertically centered Lucide vector icon / tile
// - Primary Filename: 13.5px + font_delta (#ffffff selected, #e1e1e6 default)
// - Tabular Monospace Size & Date Modified: 12.5px + font_delta (#d0d0d8 selected, #888892 default)
export component FileRow inherits Rectangle {
    in property <string> file_name;
    in property <string> file_size;
    in property <string> file_date;
    in property <string> ext_badge: "";
    in property <bool> is_dir: false;
    in property <bool> is_image: false;
    in property <bool> has_thumbnail: false;
    in property <image> thumbnail;
    in property <bool> is_executable: false;
    in property <bool> is_expanded: false;
    in property <bool> selected: false;
    in property <bool> pane_focused: true;
    in property <int> depth: 0;
    in property <bool> has_color_tag: false;
    in property <string> color_tag_name: "";
    in property <brush> color_tag_brush: transparent;
    in property <brush> color_tag_tint: transparent;
    in property <length> size_col_width: 96px;
    in property <length> date_col_width: 145px;
    in property <bool> drag_drop_highlight: false;
    in property <length> font_delta: 1px;
    in property <bool> font_bold: false;
    in property <string> font_family: "";
    in property <brush> row_bg: #1A1A1E;
    in property <brush> row_hover_bg: #26262B;
    in property <brush> row_accent_bg: #0D52BF;
    in property <brush> text_primary: #e1e1e6;
    in property <brush> text_muted: #888892;
    private property <bool> down_shift: false;
    private property <bool> down_cmd: false;
    private property <bool> drag_active: false;
    private property <bool> suppress_next_click: false;

    callback row-clicked(bool, bool);
    callback row-double-clicked();
    callback row-context-menu(length, length);
    callback row-hovered(length, length);
    callback row-shift-drag(length);
    callback row-drag-moved(length, length);
    callback row-drag-ended(length, length);
    callback row-drag-to-other-pane();
    callback toggle-expand();
    callback wheel-scroll(length);

    height: 28px + Math.max(0px, root.font_delta * 2.0);
    border-radius: 4px;
    border-width: drag_drop_highlight ? 1px : 0px;
    border-color: drag_drop_highlight ? #5AC8FA : transparent;
    background: drag_drop_highlight
        ? #0D52BF55
        : (selected
            ? (pane_focused ? root.row_accent_bg : #2E323B)
            : (touch.has-hover
                ? root.row_hover_bg
                : (has_color_tag ? color_tag_tint : root.row_bg)));

    // Left vertical color tag accent bar for immediate visual feedback
    if root.has_color_tag : Rectangle {
        x: 1px;
        y: 3px;
        width: 3px;
        height: parent.height - 6px;
        border-radius: 1.5px;
        background: root.selected ? #FFFFFF : root.color_tag_brush;
    }

    touch := TouchArea {
        clicked => {
            if !root.suppress_next_click {
                root.row-clicked(root.down_shift, root.down_cmd);
            }
            root.suppress_next_click = false;
            root.down_shift = false;
            root.down_cmd = false;
        }
        double-clicked => {
            root.drag_active = false;
            root.suppress_next_click = false;
            root.row-double-clicked();
        }
        moved => {
            if self.pressed && !root.down_shift && !root.down_cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                root.drag_active = true;
                root.suppress_next_click = true;
                root.row-drag-moved(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.down_shift = ev.modifiers.shift;
                root.down_cmd = ev.modifiers.control || ev.modifiers.meta;
                root.drag_active = false;
                root.suppress_next_click = false;
            }
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                root.drag_active = false;
                root.suppress_next_click = true;
                root.row-context-menu(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.drag_active {
                root.drag_active = false;
                root.row-drag-ended(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if ev.kind == PointerEventKind.cancel {
                root.down_shift = false;
                root.down_cmd = false;
                root.suppress_next_click = false;
            }
        }
        scroll-event(ev) => {
            root.wheel-scroll(ev.delta-y);
            return accept;
        }
    }

    HorizontalLayout {
        padding-left: 8px + root.depth * 16px;
        padding-right: 12px;
        spacing: 8px;

        // Expand/collapse chevron for directories
        Rectangle {
            width: 14px;
            background: transparent;
            if root.is_dir : LucideIcon {
                x: 1px;
                y: (parent.height - self.height) / 2;
                icon-size: 12px;
                kind: root.is_expanded ? "chevron-down" : "chevron-right";
                icon-color: root.selected ? #FFFFFF : root.text_muted;
            }
            if root.is_dir : TouchArea {
                clicked => {
                    root.toggle-expand();
                }
                scroll-event(ev) => {
                    root.wheel-scroll(ev.delta-y);
                    return accept;
                }
            }
        }

        // Vertically centered 18x18px Thumbnail or Vector File Type Icon (unified with Columns mode)
        Rectangle {
            width: 20px;
            background: transparent;
            if !root.is_dir && root.has_thumbnail : Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: 3px;
                background: #121215;
                border-width: 1px;
                border-color: root.selected ? #FFFFFFAA : #32323A;
                clip: true;
                Image {
                    x: 1px;
                    y: 1px;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    source: root.thumbnail;
                }
            }
            if root.is_dir || !root.has_thumbnail : LucideIcon {
                x: 2px;
                y: (parent.height - self.height) / 2;
                icon-size: 16px;
                kind: root.is_dir
                    ? "folder"
                    : (root.is_executable
                        ? "terminal"
                        : (root.is_image
                            ? "image"
                            : ((root.ext_badge == "ZIP" || root.ext_badge == "TAR" || root.ext_badge == "GZ" || root.ext_badge == "ISO" || root.ext_badge == "7Z" || root.ext_badge == "RAR")
                                ? "archive"
                                : ((root.ext_badge == "MP3" || root.ext_badge == "WAV" || root.ext_badge == "FLAC" || root.ext_badge == "M4A" || root.ext_badge == "AAC" || root.ext_badge == "OGG")
                                    ? "music"
                                    : ((root.ext_badge == "MP4" || root.ext_badge == "MOV" || root.ext_badge == "MKV" || root.ext_badge == "WEBM" || root.ext_badge == "AVI")
                                        ? "movies"
                                        : "documents")))));
                icon-color: root.has_color_tag
                    ? root.color_tag_brush
                    : (root.is_dir
                        ? #38B6FF
                        : (root.ext_badge == "PDF"
                            ? #FF5F56
                            : (root.is_image ? #5AC8FA : #A0A0AB)));
                fill-color: root.is_dir
                    ? (root.has_color_tag ? root.color_tag_brush : #4CC2FF)
                    : transparent;
            }
        }

        // Primary Filename Text (scaled by font_delta, #ffffff selected)
        Text {
            text: root.file_name;
            color: root.selected ? #ffffff : root.text_primary;
            font-size: 13.5px + root.font_delta;
            font-family: root.font_family;
            font-weight: root.font_bold ? 700 : (root.has_color_tag ? 600 : 500);
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Labeled Color Tag Pill Badge ([ ● Orange ])
        if root.has_color_tag : Rectangle {
            width: tag-pill-layout.preferred-width;
            height: 18px + Math.max(0px, root.font_delta * 0.5);
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.selected ? #00000044 : root.color_tag_tint;
            border-width: 1px;
            border-color: root.selected ? #FFFFFF88 : root.color_tag_brush;
            tag-pill-layout := HorizontalLayout {
                padding-left: 6px;
                padding-right: 7px;
                spacing: 5px;
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3.5px;
                    background: root.color_tag_brush;
                }
                Text {
                    text: root.color_tag_name;
                    color: root.selected ? #FFFFFF : #F2F2F7;
                    font-size: 10.5px + root.font_delta * 0.5;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Tabular Monospace Size Column (resizable width, right-aligned)
        Text {
            text: root.file_size;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12.5px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: root.size_col_width;
            overflow: elide;
        }

        // Tabular Monospace Date Modified Column (resizable width, right-aligned)
        Text {
            text: root.file_date;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12.5px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: root.date_col_width;
            overflow: elide;
        }
    }
}

// Vector Sidebar Item Icon using Unified Lucide SVG Paths
component SidebarItemIcon inherits Rectangle {
    in property <string> kind: "folder";
    in property <bool> selected: false;
    in property <bool> has-color-tag: false;
    in property <brush> color-tag-brush: transparent;
    width: 16px;
    height: 16px;
    background: transparent;

    LucideIcon {
        x: 0px;
        y: (parent.height - self.height) / 2;
        icon-size: 16px;
        kind: root.kind;
        icon-color: root.selected
            ? #FFFFFF
            : (root.has-color-tag
                ? root.color-tag-brush
                : ((root.kind == "folder" || root.kind == "globe")
                    ? #38B6FF
                    : (root.kind == "gdrive" ? #30D158 : #A0A0AB)));
        fill-color: root.kind == "folder"
            ? (root.selected
                ? #FFFFFF
                : (root.has-color-tag ? root.color-tag-brush : #4CC2FF))
            : transparent;
    }
}

// Clean Segmented Control Button (Unified Toolbar & Inspector Tabs)
component SegmentControlButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled-state: true;
    in property <length> btn-width: 64px;
    in property <string> tooltip: "";
    in property <bool> tooltip-align-right: false;
    in property <brush> accent-bg: #0D52BF;
    in property <string> font-family: "";
    in property <length> font-delta: 1px;
    callback clicked();

    width: btn-width;
    height: 27px;
    border-radius: 5px;
    opacity: enabled-state ? 1.0 : 0.3;
    background: active ? root.accent-bg : (touch.has-hover && enabled-state ? #26262B : transparent);

    Text {
        text: root.label;
        color: active ? #FFFFFF : #B4B4BE;
        font-size: 12.5px + root.font-delta * 0.5;
        font-family: root.font-family;
        font-weight: active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.tooltip != "" && touch.has-hover && !touch.pressed : Rectangle {
        z: 3000;
        x: root.tooltip-align-right ? (parent.width - self.width) : 0px;
        y: parent.height + 6px;
        height: 22px;
        width: seg-tt-text.preferred-width + 14px;
        border-radius: 4px;
        background: #202024;
        border-width: 1px;
        border-color: #3A3A44;
        seg-tt-text := Text {
            x: 7px;
            y: (parent.height - self.height) / 2;
            text: root.tooltip;
            color: #F2F2F7;
            font-size: 11px;
            font-weight: 500;
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled-state {
                root.clicked();
            }
        }
    }
}

// Toolbar Action Button (Supports either a Lucide vector icon or text label + hover tooltip)
component ToolbarButton inherits Rectangle {
    in property <string> label: "";
    in property <string> icon-kind: "";
    in property <bool> active: false;
    in property <bool> enabled-state: true;
    in property <string> tooltip: "";
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    in property <brush> accent-bg: #0D52BF;
    in property <string> font-family: "";
    in property <length> font-delta: 1px;
    callback clicked();

    height: 30px;
    min-width: 30px;
    horizontal-stretch: 0;
    border-radius: 6px;
    opacity: enabled-state ? 1.0 : 0.35;
    background: active ? root.accent-bg : (touch.has-hover && enabled-state ? #26262B : #161618);
    border-width: 1px;
    border-color: active ? root.accent-bg : #28282D;

    HorizontalLayout {
        padding-left: root.icon-kind != "" && root.label == "" ? 7px : 9px;
        padding-right: root.icon-kind != "" && root.label == "" ? 7px : 9px;
        spacing: 5px;
        alignment: center;

        if root.icon-kind != "" : LucideIcon {
            y: (parent.height - self.height) / 2;
            icon-size: 15px;
            kind: root.icon-kind;
            icon-color: root.active ? #FFFFFF : #E1E1E6;
        }

        if root.label != "" : Text {
            text: root.label;
            color: active ? #FFFFFF : #E1E1E6;
            font-size: 12.5px + root.font-delta * 0.5;
            font-family: root.font-family;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.tooltip != "" && touch.has-hover && !touch.pressed : Rectangle {
        z: 3000;
        x: root.tooltip-align-right ? (parent.width - self.width) : 0px;
        y: root.tooltip-above ? -26px : (parent.height + 5px);
        height: 22px;
        width: btn-tt-text.preferred-width + 14px;
        border-radius: 4px;
        background: #202024;
        border-width: 1px;
        border-color: #3A3A44;
        btn-tt-text := Text {
            x: 7px;
            y: (parent.height - self.height) / 2;
            text: root.tooltip;
            color: #F2F2F7;
            font-size: 11px;
            font-weight: 500;
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled-state {
                root.clicked();
            }
        }
    }
}

// Checkbox used in Permissions matrix & Connect modal
component PermCheckbox inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 16px;
    height: 16px;
    border-radius: 3.5px;
    background: checked ? #0D52BF : #1A1A1E;
    border-width: 1px;
    border-color: checked ? #0D52BF : #28282D;

    if checked : Text {
        text: "✓";
        color: #FFFFFF;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

component ColorSwatchDot inherits Rectangle {
    in property <brush> swatch-color;
    in property <bool> selected: false;
    in property <bool> is-none: false;
    callback clicked();

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: is-none ? #1A1A1E : swatch-color;
    border-width: (selected || swatch-touch.has-hover) ? 2px : 1px;
    border-color: selected ? #FFFFFF : (swatch-touch.has-hover ? #D0D0D8 : #323238);

    if selected && !is-none : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: #FFFFFF;
    }

    if is-none : LucideIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon-size: 10px;
        kind: "close";
        icon-color: selected ? #FFFFFF : #888892;
    }

    swatch-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Opaque Context Menu Row Item (doc/specification_2.md §2.1 & §4.1:
// 100% opaque #202024 default fill, #0D52BF hover fill, crisp Lucide vector icon)
component ContextMenuItem inherits Rectangle {
    in property <string> icon-kind: "file";
    in property <string> label;
    in property <string> shortcut-hint: "";
    callback triggered();

    height: 28px;
    border-radius: 4px;
    opacity: 1.0;
    background: touch.has-hover ? #0D52BF : #202024;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Rectangle {
            width: 16px;
            background: transparent;
            LucideIcon {
                x: 0px;
                y: (parent.height - self.height) / 2;
                icon-size: 15px;
                kind: root.icon-kind;
                icon-color: touch.has-hover ? #FFFFFF : #A0A0AB;
            }
        }

        Text {
            text: root.label;
            color: touch.has-hover ? #FFFFFF : #E1E1E6;
            font-size: 13px;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.shortcut-hint != "" : Text {
            text: root.shortcut-hint;
            color: touch.has-hover ? #E1E1E6 : #888892;
            font-size: 11.5px;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.triggered(); }
    }
}

// Polaroid Icon Card Cell (Mode 1: 3-Column Icon Grid with Direct Image & Document Previews)
component PolaroidCell inherits Rectangle {
    in property <FileRowSlint> item;
    in property <bool> pane-focused: true;
    in property <bool> drag-drop-highlight: false;
    in property <length> font-delta: 1px;
    in property <bool> font-bold: false;
    in property <string> font-family: "";
    in property <brush> accent-bg: #0D52BF;
    private property <bool> down-shift: false;
    private property <bool> down-cmd: false;
    private property <bool> drag-active: false;
    private property <bool> suppress-next-click: false;
    callback select-cell(bool, bool);
    callback open-cell();
    callback context-cell(length, length);
    callback cell-hovered(length, length);
    callback cell-drag-moved(length, length);
    callback cell-drag-ended(length, length);
    callback wheel-scroll(length);

    height: 128px + Math.max(0px, root.font-delta * 4.0);
    horizontal-stretch: 1;
    border-radius: 6px;
    background: drag-drop-highlight
        ? #0D52BF55
        : (item.is-selected
            ? (pane-focused ? #0D52BF33 : #2E323B66)
            : (cell-touch.has-hover
                ? #26262B
                : (item.has-color-tag ? item.color-tag-tint : transparent)));
    border-width: (drag-drop-highlight || item.is-selected || item.has-color-tag) ? 1px : 0px;
    border-color: drag-drop-highlight
        ? #5AC8FA
        : (item.is-selected
            ? (pane-focused ? root.accent-bg : #3A3A44)
            : (item.has-color-tag ? item.color-tag-brush : transparent));

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding-top: 6px;
        padding-bottom: 6px;

        HorizontalLayout {
            alignment: center;
            if item.is-dir : Rectangle {
                width: 64px;
                height: 60px;
                background: transparent;
                LucideIcon {
                    x: 8px;
                    y: 6px;
                    icon-size: 48px;
                    kind: "folder";
                    icon-color: item.has-color-tag ? item.color-tag-brush : #38B6FF;
                    fill-color: item.has-color-tag ? item.color-tag-brush : #4CC2FF;
                }
            }
            if !item.is-dir : Rectangle {
                width: 108px;
                height: 68px;
                border-radius: 6px;
                background: item.has-thumbnail ? #101014 : #1E1E22;
                border-width: 1px;
                border-color: item.is-selected
                    ? #5AC8FA
                    : (item.has-color-tag ? item.color-tag-brush : #2E2E36);
                clip: true;

                // 1. Live Raster Image Thumbnail Preview directly inside the Polaroid card
                if item.has-thumbnail : Image {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    image-fit: contain;
                    source: item.thumbnail;
                }

                // 2. Styled Document / File Preview Card when no raster image thumbnail
                if !item.has-thumbnail : LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: 12px;
                    icon-size: 28px;
                    kind: item.is-image
                        ? "image"
                        : (item.is-executable
                            ? "terminal"
                            : ((item.ext-badge == "ZIP" || item.ext-badge == "TAR" || item.ext-badge == "GZ" || item.ext-badge == "ISO")
                                ? "archive"
                                : "documents"));
                    icon-color: item.has-color-tag
                        ? item.color-tag-brush
                        : (item.ext-badge == "PDF"
                            ? #FF5F56
                            : ((item.ext-badge == "DOC" || item.ext-badge == "DOCX")
                                ? #4CC2FF
                                : ((item.ext-badge == "ZIP" || item.ext-badge == "TAR" || item.ext-badge == "GZ" || item.ext-badge == "ISO")
                                    ? #FF9F0A
                                    : (item.is-image ? #5AC8FA : (item.is-executable ? #30D158 : #B4B4BE)))));
                }

                // Extension Badge Pill in top-right corner of Polaroid preview card
                if item.ext-badge != "" : Rectangle {
                    x: parent.width - self.width - 4px;
                    y: 4px;
                    width: card-ext-txt.preferred-width + 8px;
                    height: 14px;
                    border-radius: 3px;
                    background: item.ext-badge == "PDF"
                        ? #FF453ACC
                        : ((item.ext-badge == "DOC" || item.ext-badge == "DOCX")
                            ? #0A84FFCC
                            : ((item.ext-badge == "ZIP" || item.ext-badge == "TAR" || item.ext-badge == "GZ" || item.ext-badge == "ISO")
                                ? #FF9F0ACC
                                : #18181CDD));
                    card-ext-txt := Text {
                        x: 4px;
                        y: (parent.height - self.height) / 2;
                        text: item.ext-badge;
                        color: #FFFFFF;
                        font-size: 8.5px;
                        font-family: "monospace";
                        font-weight: 700;
                    }
                }

                // File Size Footer strip at bottom of document preview card
                if !item.has-thumbnail && item.size-text != "" : Rectangle {
                    x: 0px;
                    y: parent.height - 15px;
                    width: parent.width;
                    height: 15px;
                    background: #141418CC;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: item.size-text;
                        color: #9898A4;
                        font-size: 9px;
                        font-family: "monospace";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            Rectangle {
                height: 20px;
                horizontal-stretch: 1;
                border-radius: 4px;
                background: item.is-selected ? (pane-focused ? root.accent-bg : #2E323B) : transparent;
                Text {
                    x: 6px;
                    y: 0px;
                    width: parent.width - (item.has-color-tag ? 22px : 12px);
                    height: 20px;
                    text: item.name;
                    color: item.is-selected ? #FFFFFF : #E1E1E6;
                    font-size: 12.5px + root.font-delta;
                    font-family: root.font-family;
                    font-weight: root.font-bold ? 700 : (item.has-color-tag ? 600 : 500);
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if item.has-color-tag : Rectangle {
                    x: parent.width - 13px;
                    y: 5px;
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: item.color-tag-brush;
                    border-width: 1px;
                    border-color: #FFFFFFAA;
                }
            }
        }
    }

    cell-touch := TouchArea {
        clicked => {
            if !root.suppress-next-click {
                root.select-cell(root.down-shift, root.down-cmd);
            }
            root.suppress-next-click = false;
            root.down-shift = false;
            root.down-cmd = false;
        }
        double-clicked => {
            root.drag-active = false;
            root.suppress-next-click = false;
            root.open-cell();
        }
        moved => {
            if self.pressed && !root.down-shift && !root.down-cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                root.drag-active = true;
                root.suppress-next-click = true;
                root.cell-drag-moved(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.down-shift = ev.modifiers.shift;
                root.down-cmd = ev.modifiers.control || ev.modifiers.meta;
                root.drag-active = false;
                root.suppress-next-click = false;
            }
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                root.drag-active = false;
                root.suppress-next-click = true;
                root.context-cell(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.drag-active {
                root.drag-active = false;
                root.cell-drag-ended(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if ev.kind == PointerEventKind.cancel {
                root.down-shift = false;
                root.down-cmd = false;
                root.suppress-next-click = false;
            }
        }
        scroll-event(ev) => {
            root.wheel-scroll(ev.delta-y);
            return accept;
        }
    }
}

export component ManifoldWindow inherits Window {
    title: "Manifold";
    preferred-width: 1360px;
    preferred-height: 840px;
    min-width: 920px;
    min-height: 580px;
    // Dynamic Theme Canvas & Font Family (Default: Dark Zinc #121214)
    background: root.theme-bg-canvas;
    default-font-family: root.resolved-font-family;
    forward-focus: key-router;

    private property <bool> col-down-shift: false;
    private property <bool> col-down-cmd: false;
    private property <bool> col-drag-active: false;
    private property <bool> col-suppress-click: false;

    // Theme & Typography Preferences (Manifold Main Menu -> Preferences)
    in-out property <string> theme-name: "Dark Zinc";
    in-out property <string> ui-theme-preset: "dark_zinc";
    in-out property <brush> theme-bg-canvas: #121214;
    in-out property <brush> theme-bg-toolbar: #1E1E22;
    in-out property <brush> theme-bg-sidebar: #161618;
    in-out property <brush> theme-bg-surface: #1A1A1E;
    in-out property <brush> theme-bg-popover: #202024;
    in-out property <brush> theme-row-hover: #26262B;
    in-out property <brush> theme-bg-hover: root.theme-row-hover;
    in-out property <brush> theme-accent: #0D52BF;
    in-out property <brush> theme-border: #28282D;
    in-out property <brush> theme-text-primary: #E1E1E6;
    in-out property <brush> theme-text-secondary: #888892;
    in-out property <brush> theme-text-muted: root.theme-text-secondary;
    in-out property <int> ui-font-size-delta: 1;
    in-out property <length> font-size-delta: root.ui-font-size-delta * 1px;
    in-out property <string> ui-font-family: "sans-serif";
    in-out property <string> resolved-font-family: "";
    in-out property <bool> ui-font-bold: false;
    in-out property <bool> show-app-menu: false;
    in-out property <bool> show-preferences-modal: false;
    in-out property <bool> show-tab-preview: true;

    // Toolbar & layout state
    in-out property <string> active-folder-title: "Home";
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> dual-pane-mode: false;
    // 0 = Single, 1 = SplitHorizontal, 2 = SplitVertical
    in-out property <int> panes-layout: 0;
    in-out property <float> split-ratio: 0.5;
    in-out property <bool> show-hidden-files: false;
    in-out property <string> search-query: "";
    in-out property <string> left-filter-query: "";
    in-out property <string> right-filter-query: "";

    // Resizable Panel & Column Dimensions + Non-Oscillating Drag Anchors
    in-out property <length> sidebar-width: 205px;
    in-out property <length> inspector-width: 270px;
    in-out property <length> miller-col-width: 195px;
    in-out property <length> col-resize-start-x: 0px;
    in-out property <length> col-resize-start-w: 0px;
    private property <length> panes-avail-width: Math.max(
        340px,
        root.width
            - root.sidebar-width
            - (root.show-inspector ? (root.inspector-width + 8px) : 0px)
            - (root.dual-pane-mode ? 28px : 20px)
    );
    private property <length> left-pane-width: root.dual-pane-mode
        ? root.panes-avail-width * root.split-ratio
        : root.panes-avail-width;
    private property <length> right-pane-width: root.panes-avail-width * (1.0 - root.split-ratio);
    private property <length> left-tab-pill-width: Math.clamp(
        (root.left-pane-width - 48px - Math.max(0, root.left-tabs.length - 1) * 6px)
            / Math.max(1, root.left-tabs.length),
        56px,
        184px
    );
    private property <length> right-tab-pill-width: Math.clamp(
        (root.right-pane-width - 48px - Math.max(0, root.right-tabs.length - 1) * 6px)
            / Math.max(1, root.right-tabs.length),
        56px,
        184px
    );

    // Sidebar model
    in-out property <[SidebarEntrySlint]> sidebar-items: [];

    // Dual-pane focus & Dual-Mode Path Bar state
    in-out property <bool> right-pane-active: false;
    in-out property <string> left-header-icon: "home";
    in-out property <string> left-breadcrumbs: "/";
    in-out property <[BreadcrumbSegmentSlint]> left-breadcrumb-segments: [];
    in-out property <bool> left-path-edit-mode: false;
    in-out property <string> left-path-input: "/";
    in-out property <string> left-status-subtitle: "0 items";
    in-out property <int> left-view-mode: 0;
    in-out property <[TabEntrySlint]> left-tabs: [];
    in-out property <[FileRowSlint]> left-rows: [];
    in-out property <[IconGridTripleSlint]> left-icon-triples: [];
    in-out property <[FileRowSlint]> left-parent-rows: [];

    in-out property <string> right-header-icon: "home";
    in-out property <string> right-breadcrumbs: "/";
    in-out property <[BreadcrumbSegmentSlint]> right-breadcrumb-segments: [];
    in-out property <bool> right-path-edit-mode: false;
    in-out property <string> right-path-input: "/";
    in-out property <string> right-status-subtitle: "0 items";
    in-out property <int> right-view-mode: 0;
    in-out property <[TabEntrySlint]> right-tabs: [];
    in-out property <[FileRowSlint]> right-rows: [];
    in-out property <[IconGridTripleSlint]> right-icon-triples: [];
    in-out property <[FileRowSlint]> right-parent-rows: [];

    // Resizable Columns & Column Sort Indicator State
    in-out property <length> size-col-width: 96px;
    in-out property <length> date-col-width: 145px;
    in-out property <string> left-sort-column: "name";
    in-out property <bool> left-sort-ascending: true;
    in-out property <string> right-sort-column: "name";
    in-out property <bool> right-sort-ascending: true;

    // Tab & Sidebar Favorite Drag-and-Drop Rearrangement State
    in-out property <bool> dragging-tab-active: false;
    in-out property <bool> dragging-tab-is-right: false;
    in-out property <int> dragging-tab-idx: -1;
    in-out property <bool> drag-tab-hover-right: false;
    in-out property <int> drag-tab-hover-idx: -1;
    in-out property <bool> is-dragging-tab: false;
    in-out property <string> drag-tab-title: "";
    in-out property <int> dragging-sidebar-idx: -1;
    in-out property <int> drag-hover-fav-idx: -1;

    // Universal Drag-and-Drop State (Files/Directories -> Folders, Panes, Tabs, Breadcrumbs, Sidebar)
    in-out property <bool> is-dragging-row: false;
    in-out property <length> drag-ghost-x: 0px;
    in-out property <length> drag-ghost-y: 0px;
    in-out property <string> drag-ghost-label: "";
    in-out property <string> drag-target-hint: "";
    in-out property <int> drag-hover-sidebar-idx: -1;
    in-out property <int> drag-hover-left-tab: -1;
    in-out property <int> drag-hover-right-tab: -1;
    in-out property <int> drag-hover-left-row: -1;
    in-out property <int> drag-hover-right-row: -1;
    in-out property <bool> drag-hover-left-pane: false;
    in-out property <bool> drag-hover-right-pane: false;
    in-out property <length> drag-left-pane-w: 720px;
    in-out property <length> drag-left-scroll-y: 0px;
    in-out property <length> drag-right-scroll-y: 0px;

    // Sibling Directory Dropdown Popover
    in-out property <bool> show-sibling-dropdown: false;
    in-out property <bool> sibling-dropdown-is-right: false;
    in-out property <length> sibling-dropdown-x: 280px;
    in-out property <length> sibling-dropdown-y: 120px;
    in-out property <[BreadcrumbSegmentSlint]> sibling-dropdown-items: [];

    // Right Inspector, Media Metadata & Preview Minion state
    in-out property <bool> show-inspector: false;
    in-out property <int> inspector-tab-index: 0;
    in-out property <string> inspector-title: "";
    in-out property <string> inspector-subtitle: "";
    in-out property <string> inspector-preview-text: "";
    in-out property <bool> inspector-has-text-preview: false;
    in-out property <image> inspector-preview-image;
    in-out property <bool> inspector-has-image: false;
    in-out property <string> inspector-image-dimensions: "";
    in-out property <string> inspector-media-category: "";
    in-out property <string> inspector-media-line1: "";
    in-out property <string> inspector-media-line2: "";
    in-out property <string> inspector-media-line3: "";
    in-out property <bool> show-preview-minion: false;
    in-out property <length> preview-minion-x: 380px;
    in-out property <length> preview-minion-y: 110px;
    in-out property <float> preview-minion-zoom: 1.0;
    in-out property <bool> inspector-is-dir: false;
    in-out property <bool> inspector-is-image: false;
    in-out property <string> inspector-path: "";
    in-out property <string> inspector-size: "--";
    in-out property <string> inspector-modified: "--";
    in-out property <string> inspector-created: "--";
    in-out property <string> inspector-added: "--";
    in-out property <string> inspector-extension: "--";
    in-out property <bool> inspector-hide-extension: false;
    in-out property <int> inspector-color-index: 0;

    // Floating Mouseover File Details & Preview Card State (Photo / Text / JSON only, never Binary)
    in-out property <bool> show-hover-preview: false;
    in-out property <length> hover-preview-x: 300px;
    in-out property <length> hover-preview-y: 180px;
    in-out property <string> hover-file-name: "";
    in-out property <string> hover-file-kind: "";
    in-out property <string> hover-file-size: "";
    in-out property <string> hover-file-modified: "";
    in-out property <string> hover-file-perms: "";
    in-out property <string> hover-media-info: "";
    in-out property <bool> hover-has-image: false;
    in-out property <image> hover-image;
    in-out property <bool> hover-has-text: false;
    in-out property <string> hover-text: "";

    // Embedded Bottom Terminal Drawer State
    in-out property <bool> show-terminal-drawer: false;
    in-out property <length> terminal-drawer-height: 210px;
    in-out property <string> terminal-cwd: "/";
    in-out property <string> terminal-session-label: "LOCAL SHELL";
    in-out property <string> terminal-prompt: "$";
    in-out property <string> terminal-output: "";
    in-out property <string> terminal-input-text: "";
    in-out property <string> terminal-command-input: "";

    // 3x3 Permissions Matrix
    in-out property <bool> perm-ur: true;
    in-out property <bool> perm-uw: true;
    in-out property <bool> perm-ux: false;
    in-out property <bool> perm-gr: true;
    in-out property <bool> perm-gw: false;
    in-out property <bool> perm-gx: false;
    in-out property <bool> perm-or: true;
    in-out property <bool> perm-ow: false;
    in-out property <bool> perm-ox: false;
    in-out property <string> inspector-perm-symbolic: "rw-r--r--";
    in-out property <string> inspector-perm-octal: "644";
    in-out property <string> inspector-owner: "user";
    in-out property <string> inspector-group: "staff";
    in-out property <bool> inspector-locked: false;

    // Activities, Tasks Spinner & Logs models
    in-out property <[TransferRowSlint]> transfer-rows: [];
    in-out property <[string]> log-rows: [];
    in-out property <bool> task-running: false;
    in-out property <int> spinner-frame: 0;
    in-out property <string> active-task-label: "";
    in-out property <int> active-task-progress: 0;
    in-out property <bool> show-tasks-popover: false;

    // Context Menu, Clipboard & Toast Feedback state
    in-out property <bool> show-context-menu: false;
    in-out property <length> context-menu-x: 260px;
    in-out property <length> context-menu-y: 180px;
    in-out property <string> context-target-name: "";

    // Sidebar Object Right-Click Context Menu (Devices / Connections / Favorites)
    in-out property <bool> show-sidebar-context-menu: false;
    in-out property <length> sidebar-context-x: 90px;
    in-out property <length> sidebar-context-y: 140px;
    in-out property <int> sidebar-context-idx: 0;
    in-out property <string> sidebar-context-label: "";
    in-out property <string> sidebar-context-section: "Devices";
    in-out property <string> sidebar-context-icon: "drive";
    in-out property <bool> sidebar-context-can-eject: false;

    in-out property <bool> has-clipboard-item: false;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-text: "";
    in-out property <string> toast-kind: "info";

    // Delete Confirmation Modal
    in-out property <bool> show-delete-modal: false;
    in-out property <string> delete-modal-title: "Move to Trash?";
    in-out property <string> delete-modal-message: "";
    in-out property <bool> delete-modal-permanent: false;

    // Input Modal for New Folder / New File / Rename / Edit Sidebar Label
    in-out property <bool> show-input-modal: false;
    in-out property <string> input-modal-mode: "new_folder";
    in-out property <string> input-modal-title: "New Folder";
    in-out property <string> input-modal-value: "";

    // Dynamic Connection / Inspector Modal
    in-out property <bool> show-connect-modal: false;
    in-out property <string> connect-editing-id: "";
    in-out property <string> connect-name: "";
    in-out property <bool> connect-show-advanced: true;
    in-out property <string> connect-protocol: "SFTP";
    in-out property <string> connect-server: "";
    in-out property <string> connect-port: "22";
    in-out property <string> connect-username: "";
    in-out property <string> connect-auth-method: "password";
    in-out property <string> connect-password: "";
    in-out property <string> connect-key-path: "";
    in-out property <string> connect-passphrase: "";
    in-out property <string> connect-s3-endpoint: "";
    in-out property <string> connect-s3-bucket: "";
    in-out property <string> connect-s3-region: "";
    in-out property <string> connect-s3-access-key: "";
    in-out property <string> connect-s3-secret-key: "";
    in-out property <string> connect-smb-share: "";
    in-out property <string> connect-smb-domain: "";
    in-out property <string> connect-remote-path: "";
    in-out property <string> connect-local-path: "";
    in-out property <string> connect-base-url: "";
    in-out property <string> connect-encoding: "";
    in-out property <string> connect-note: "";
    in-out property <int> connect-color-index: 0;
    in-out property <bool> connect-save-credentials: true;

    // Conflict Resolution Modal
    in-out property <bool> show-conflict-modal: false;
    in-out property <string> conflict-headline: "An item named \"Text.txt\" already exists in this location.";
    in-out property <string> conflict-subheadline: "Do you want to replace it with the one you’re moving?";
    in-out property <string> conflict-new-date: "";
    in-out property <string> conflict-new-size: "";
    in-out property <string> conflict-existing-date: "";
    in-out property <string> conflict-existing-size: "";
    in-out property <bool> conflict-apply-all: false;

    // Callbacks to Rust controller
    callback activate-pane(bool);
    callback toggle-dual-pane();
    callback adjust-split-ratio(length);
    callback set-split-ratio(float);
    callback go-back();
    callback go-forward();
    callback select-sidebar-item(int);
    callback eject-sidebar-item(int);
    callback reorder-sidebar-favorite(int, int);
    callback open-sidebar-context-menu(int, length, length);
    callback execute-sidebar-context-action(string);
    callback set-sidebar-item-color(int);
    callback add-connection-to-favorites();
    callback select-tab(bool, int);
    callback add-tab(bool);
    callback close-tab(bool, int);
    callback move-tab(bool, int, bool, int);
    callback navigate-to-breadcrumb(bool, string);
    callback open-sibling-dropdown(bool, string, length, length);
    callback commit-path-input(bool, string);
    callback autocomplete-path-input(bool, string);
    callback select-file-row(bool, int);
    callback select-file-row-mod(bool, int, bool, bool);
    callback hover-file-row(bool, int, length, length);
    callback shift-drag-select(bool, int);
    callback open-file-row(bool, int);
    callback toggle-expand-folder(bool, int);
    callback update-drag-cursor(bool, int, length, length);
    callback finish-drag-drop(bool, int, length, length);
    callback drag-drop-row-to-other-pane(bool, int);
    callback drop-row-on-tab(bool, int, bool, int);
    callback open-context-menu-for-row(bool, int, length, length);
    callback open-blank-context-menu(bool, length, length);
    callback execute-context-action(string);
    callback open-new-folder-modal();
    callback open-new-file-modal();
    callback open-rename-modal();
    callback confirm-input-modal(string);
    callback delete-selected-item();
    callback permanent-delete-selected-item();
    callback confirm-delete-modal();
    callback clear-completed-tasks();
    callback add-current-to-favorites();
    callback add-current-folder-to-favorites();
    callback open-parent-row(bool, int);
    callback navigate-up(bool);
    callback sort-by-column(bool, string);
    callback filter-changed(string);
    callback clear-pane-filter(bool);
    callback set-view-mode(int);
    callback toggle-hidden-files();
    callback toggle-inspector();
    callback toggle-preview-minion();
    callback set-inspector-tab(int);
    callback toggle-permission-bit(int, int);
    callback toggle-hide-extension();
    callback toggle-locked();
    callback set-selected-color-label(int);
    callback calculate-selected-dir-size();
    callback copy-selected-between-panes();
    callback move-selected-between-panes();
    callback sync-panes();
    callback batch-rename-selected();
    callback open-terminal();
    callback open-terminal-here();
    callback run-terminal-command(string);
    callback terminal-key-event(string, bool) -> bool;
    callback clear-terminal();
    callback open-external-terminal();
    callback select-theme-preset(string);
    callback select-font-size-delta(int);
    callback select-font-family(string);
    callback toggle-font-bold();
    callback set-theme-preset(string);
    callback set-font-size-delta(int);
    callback set-font-family(string);
    callback set-font-bold(bool);
    callback open-connect-dialog();
    callback close-connect-dialog();
    callback confirm-connect-dialog();
    callback select-connect-protocol(string);
    callback select-connect-color(int);
    callback resolve-conflict(string);
    callback handle-shortcut(string, bool, bool, bool, bool) -> bool;

    public function focus-filter-box() {
        filter-text-input.focus();
        filter-text-input.select-all();
    }

    in-out property <length> right-scroll-y: 0px;

    public function focus-main-key-router() {
        key-router.focus();
    }

    public function ensure-row-visible(is-right: bool, row-idx: int) {
        key-router.focus();
        if !is-right {
            if (row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0))) < (-l-flick.viewport-y) {
                l-flick.viewport-y = -(row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0)));
            } else if ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0))) > (-l-flick.viewport-y + l-flick.height) {
                l-flick.viewport-y = Math.min(
                    0px,
                    l-flick.height - ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0)))
                );
            }
        } else {
            if (row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0))) < (-root.right-scroll-y) {
                root.right-scroll-y = -(row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0)));
            } else if ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0))) > (-root.right-scroll-y + l-flick.height) {
                root.right-scroll-y = Math.min(
                    0px,
                    l-flick.height - ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0)))
                );
            }
        }
    }

    // Centralized Cross-Platform Keyboard Shortcut Router
    key-router := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if root.handle-shortcut(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // 1. UNIFIED TOP TOOLBAR (doc/specification_2.md §2.2 & §4.2: #1E1E22, 42px height, #28282D border)
            Rectangle {
                z: 500;
                height: 42px;
                background: root.theme-bg-toolbar;
                border-width: 1px;
                border-color: root.theme-border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: space-between;

                    // Left Section: "Manifold ▾" Main Menu, Back, Forward, Parent Up, and Elided Active Title
                    HorizontalLayout {
                        width: Math.clamp(root.width - 980px, 280px, 440px);
                        spacing: 6px;
                        alignment: start;

                        // Dedicated "Manifold" Main Application Menu Button
                        Rectangle {
                            height: 30px;
                            y: 6px;
                            min-width: 96px;
                            border-radius: 6px;
                            background: root.show-app-menu
                                ? root.theme-accent
                                : (app-menu-touch.has-hover ? root.theme-bg-hover : root.theme-bg-sidebar);
                            border-width: 1px;
                            border-color: root.show-app-menu ? #388BFD : root.theme-border;
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;
                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 14px;
                                    kind: "columns";
                                    icon-color: root.show-app-menu ? #FFFFFF : #5AC8FA;
                                }
                                Text {
                                    text: "Manifold";
                                    color: #FFFFFF;
                                    font-size: 12.5px + root.font-size-delta;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 11px;
                                    kind: "chevron-down";
                                    icon-color: root.show-app-menu ? #FFFFFF : root.theme-text-muted;
                                }
                            }
                            app-menu-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-app-menu = !root.show-app-menu;
                                }
                            }
                        }

                        ToolbarButton {
                            y: 6px;
                            icon-kind: "chevron-left";
                            tooltip: "Back (Alt+Left)";
                            enabled-state: root.can-go-back;
                            clicked => { root.go-back(); }
                        }
                        ToolbarButton {
                            y: 6px;
                            icon-kind: "chevron-right";
                            tooltip: "Forward (Alt+Right)";
                            enabled-state: root.can-go-forward;
                            clicked => { root.go-forward(); }
                        }
                        ToolbarButton {
                            y: 6px;
                            icon-kind: "arrow-up";
                            tooltip: "Enclosing Folder (Alt+Up)";
                            clicked => {
                                root.navigate-up(root.right-pane-active && root.dual-pane-mode);
                            }
                        }
                        Rectangle {
                            width: 4px;
                            background: transparent;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.active-folder-title;
                            color: root.theme-text-primary;
                            font-size: 15px + root.font-size-delta;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // Center Section: Clean Segmented Controls for View Modes & Pane Layout
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        // View Modes: [ List | Columns | Icons ]
                        Rectangle {
                            height: 30px;
                            y: 6px;
                            border-radius: 6px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                SegmentControlButton {
                                    label: "List";
                                    btn-width: 56px;
                                    tooltip: "List View (Ctrl/Cmd+1)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 0;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(0);
                                    }
                                }
                                SegmentControlButton {
                                    label: "Columns";
                                    btn-width: 72px;
                                    tooltip: "Miller Columns View (Ctrl/Cmd+3)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 2;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(2);
                                    }
                                }
                                SegmentControlButton {
                                    label: "Icons";
                                    btn-width: 56px;
                                    tooltip: "Icon Grid View (Ctrl/Cmd+2)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 1;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(1);
                                    }
                                }
                            }
                        }

                        // Layout: [ Single Pane | Dual Pane ]
                        Rectangle {
                            height: 30px;
                            y: 6px;
                            border-radius: 6px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                SegmentControlButton {
                                    label: "Single Pane";
                                    btn-width: 90px;
                                    tooltip: "Single File Browser Pane";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: !root.dual-pane-mode;
                                    clicked => {
                                        if root.dual-pane-mode {
                                            root.toggle-dual-pane();
                                        }
                                    }
                                }
                                SegmentControlButton {
                                    label: "Dual Pane";
                                    btn-width: 82px;
                                    tooltip: "Dual-Pane Split View";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: root.dual-pane-mode;
                                    clicked => {
                                        if !root.dual-pane-mode {
                                            root.toggle-dual-pane();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right Section: Single-Border Search Input (No nested CleanLineEdit artifact) & Action Icons
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        Rectangle {
                            width: 214px;
                            height: 30px;
                            y: 6px;
                            border-radius: 6px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: filter-text-input.has-focus
                                ? root.theme-accent
                                : (root.search-query != "" ? #0D52BFAA : root.theme-border);
                            clip: true;

                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 6px;
                                spacing: 6px;

                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 14px;
                                    kind: "search";
                                    icon-color: (filter-text-input.has-focus || root.search-query != "") ? #5AC8FA : root.theme-text-muted;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    clip: true;

                                    if root.search-query == "" && !filter-text-input.has-focus : Text {
                                        text: "Filter tab (e.g. *pdf)";
                                        color: root.theme-text-muted;
                                        font-size: 12.5px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        vertical-alignment: center;
                                    }

                                    filter-text-input := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.search-query;
                                        font-size: 13px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        color: root.theme-text-primary;
                                        vertical-alignment: center;
                                        single-line: true;
                                        edited => {
                                            root.filter-changed(self.text);
                                        }
                                        key-pressed(ev) => {
                                            if ev.text == "\u{001b}" {
                                                if root.search-query != "" {
                                                    root.search-query = "";
                                                    root.filter-changed("");
                                                }
                                                key-router.focus();
                                                root.handle-shortcut("\u{001b}", false, false, false, false);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }

                                if root.search-query != "" : Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: 5px;
                                    border-radius: 9px;
                                    background: clear-filter-touch.has-hover ? #383842 : #282830;
                                    LucideIcon {
                                        x: 4px;
                                        y: 4px;
                                        icon-size: 10px;
                                        kind: "close";
                                        icon-color: clear-filter-touch.has-hover ? #FFFFFF : #B4B4BE;
                                    }
                                    clear-filter-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-query = "";
                                            root.filter-changed("");
                                        }
                                    }
                                }
                            }
                        }

                        ToolbarButton {
                            y: 6px;
                            icon-kind: "globe";
                            tooltip: "New Remote Connection";
                            tooltip-align-right: true;
                            accent-bg: root.theme-accent;
                            clicked => { root.open-connect-dialog(); }
                        }
                        ToolbarButton {
                            y: 6px;
                            icon-kind: "terminal";
                            tooltip: "Toggle Embedded Bottom Terminal";
                            tooltip-align-right: true;
                            accent-bg: root.theme-accent;
                            active: root.show-terminal-drawer;
                            clicked => { root.open-terminal(); }
                        }

                        // Tasks & Sync Button (Spinning Icon + Inline Progress Bar + Popover Trigger)
                        Rectangle {
                            height: 30px;
                            y: 6px;
                            min-width: root.task-running ? 136px : (root.transfer-rows.length > 0 ? 48px : 30px);
                            border-radius: 6px;
                            background: root.show-tasks-popover || root.task-running
                                ? #0D52BF33
                                : (tasks-btn-touch.has-hover ? root.theme-bg-hover : root.theme-bg-sidebar);
                            border-width: 1px;
                            border-color: root.task-running
                                ? #5AC8FA
                                : (root.show-tasks-popover ? root.theme-accent : root.theme-border);

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;

                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 15px;
                                    kind: root.task-running
                                        ? ("refresh-" + root.spinner-frame)
                                        : "refresh";
                                    icon-color: root.task-running ? #5AC8FA : root.theme-text-primary;
                                }

                                if root.task-running : VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    width: 92px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.active-task-label;
                                            color: #FFFFFF;
                                            font-size: 9px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.active-task-progress + "%";
                                            color: #5AC8FA;
                                            font-size: 9px;
                                            font-family: "monospace";
                                        }
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: root.theme-bg-canvas;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 4px;
                                            border-radius: 2px;
                                            width: parent.width * (Math.clamp(root.active-task-progress, 0, 100) / 100.0);
                                            background: #5AC8FA;
                                        }
                                    }
                                }

                                if !root.task-running && root.transfer-rows.length > 0 : Text {
                                    text: root.transfer-rows.length;
                                    color: #5AC8FA;
                                    font-size: 11px;
                                    font-weight: 700;
                                    font-family: "monospace";
                                    vertical-alignment: center;
                                }
                            }

                            if !root.show-tasks-popover && tasks-btn-touch.has-hover && !tasks-btn-touch.pressed : Rectangle {
                                z: 3000;
                                x: parent.width - self.width;
                                y: parent.height + 5px;
                                height: 22px;
                                width: tasks-tt-text.preferred-width + 14px;
                                border-radius: 4px;
                                background: root.theme-bg-popover;
                                border-width: 1px;
                                border-color: #3A3A44;
                                tasks-tt-text := Text {
                                    x: 7px;
                                    y: (parent.height - self.height) / 2;
                                    text: "Tasks & Operations Queue";
                                    color: #F2F2F7;
                                    font-size: 11px;
                                    font-weight: 500;
                                }
                            }

                            tasks-btn-touch := TouchArea {
                                clicked => {
                                    root.show-tasks-popover = !root.show-tasks-popover;
                                }
                            }
                        }

                        ToolbarButton {
                            y: 6px;
                            icon-kind: "inspector";
                            tooltip: "Toggle Inspector Drawer (Ctrl/Cmd+I)";
                            tooltip-align-right: true;
                            active: root.show-inspector;
                            clicked => { root.toggle-inspector(); }
                        }
                    }
                }
            }

            // 2. MAIN WORKSPACE: SIDEBAR | PANE VIEWPORTS | OPTIONAL INSPECTOR
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 6px;
                spacing: 4px;

                // 2A. LEFT SIDEBAR (Panel 0: Resizable width, Favorites "+" button)
                Rectangle {
                    width: root.sidebar-width;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    background: root.theme-bg-sidebar;
                    border-width: 1px;
                    border-color: root.theme-border;

                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        ScrollView {
                            viewport-height: Math.max(
                                self.height,
                                root.sidebar-items.length * (30px + Math.max(0px, root.font-size-delta * 1.5)) + 16px
                            );
                            VerticalLayout {
                                spacing: 2px;
                                padding-left: 8px;
                                padding-right: 8px;
                                for item[idx] in root.sidebar-items : Rectangle {
                                    height: item.is-header
                                        ? (24px + Math.max(0px, root.font-size-delta))
                                        : (28px + Math.max(0px, root.font-size-delta * 1.5));
                                    border-radius: 5px;
                                    border-width: (root.drag-hover-sidebar-idx == idx || root.drag-hover-fav-idx == idx) ? 1.5px : 0px;
                                    border-color: (root.drag-hover-sidebar-idx == idx || root.drag-hover-fav-idx == idx) ? #5AC8FA : transparent;
                                    background: (root.drag-hover-sidebar-idx == idx || root.drag-hover-fav-idx == idx)
                                        ? #0D52BF55
                                        : (item.is-selected ? root.theme-accent : (sb-touch.has-hover && !item.is-header ? root.theme-bg-hover : transparent));

                                    sb-touch := TouchArea {
                                        mouse-cursor: item.is-header ? default : pointer;
                                        clicked => {
                                            key-router.focus();
                                            if !item.is-header {
                                                root.select-sidebar-item(idx);
                                            }
                                        }
                                        moved => {
                                            if !item.is-header && self.pressed && Math.abs(self.mouse-y - self.pressed-y) > 6px {
                                                root.dragging-sidebar-idx = idx;
                                                root.drag-hover-fav-idx = Math.clamp(
                                                    idx + Math.round((self.mouse-y - 13px) / 28px),
                                                    0,
                                                    Math.max(0, root.sidebar-items.length - 1)
                                                );
                                            }
                                        }
                                        pointer-event(ev) => {
                                            if !item.is-header && ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                                root.open-sidebar-context-menu(
                                                    idx,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y
                                                );
                                            }
                                            if !item.is-header && ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up {
                                                if root.dragging-sidebar-idx == idx && root.drag-hover-fav-idx >= 0 && root.drag-hover-fav-idx != idx {
                                                    root.reorder-sidebar-favorite(idx, root.drag-hover-fav-idx);
                                                }
                                                root.dragging-sidebar-idx = -1;
                                                root.drag-hover-fav-idx = -1;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: item.is-header ? 4px : (8px + item.indent-level * 12px);
                                        padding-right: 6px;
                                        spacing: 8px;

                                        if !item.is-header : Rectangle {
                                            width: 16px;
                                            background: transparent;
                                            SidebarItemIcon {
                                                x: 0px;
                                                y: (parent.height - self.height) / 2;
                                                kind: item.icon-kind;
                                                selected: item.is-selected;
                                                has-color-tag: item.has-color-tag;
                                                color-tag-brush: item.color-tag-brush;
                                            }
                                        }

                                        Text {
                                            text: item.label;
                                            color: item.is-header
                                                ? root.theme-text-muted
                                                : (item.is-selected ? #FFFFFF : root.theme-text-primary);
                                            font-size: item.is-header ? (11px + root.font-size-delta) : (13.5px + root.font-size-delta);
                                            font-weight: item.is-header ? 700 : (root.ui-font-bold || item.is-selected ? 600 : 500);
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if !item.is-header && item.has-color-tag : Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 3.5px;
                                            background: item.color-tag-brush;
                                            border-width: 1px;
                                            border-color: item.is-selected ? #FFFFFF : root.theme-bg-sidebar;
                                        }

                                        if item.badge != "" : Text {
                                            text: item.badge;
                                            color: item.is-selected ? #D0D0D8 : root.theme-text-muted;
                                            font-size: 11px + root.font-size-delta;
                                            font-family: "monospace";
                                            vertical-alignment: center;
                                        }

                                        if item.can-eject : Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: 4px;
                                            border-radius: 3px;
                                            background: eject-touch.has-hover ? #323238 : transparent;
                                            LucideIcon {
                                                x: 3px;
                                                y: 3px;
                                                icon-size: 12px;
                                                kind: "eject";
                                                icon-color: eject-touch.has-hover || item.is-selected ? #FFFFFF : root.theme-text-muted;
                                            }
                                            if eject-touch.has-hover && !eject-touch.pressed : Rectangle {
                                                z: 3000;
                                                x: parent.width - self.width;
                                                y: parent.height + 4px;
                                                height: 20px;
                                                width: 114px;
                                                border-radius: 4px;
                                                background: root.theme-bg-popover;
                                                border-width: 1px;
                                                border-color: #3A3A44;
                                                Text {
                                                    x: 6px;
                                                    y: (parent.height - self.height) / 2;
                                                    text: "Disconnect / Eject";
                                                    color: #F2F2F7;
                                                    font-size: 10px;
                                                    font-weight: 500;
                                                }
                                            }
                                            eject-touch := TouchArea {
                                                clicked => {
                                                    root.eject-sidebar-item(idx);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Draggable right-edge resizer for Left Sidebar
                    Rectangle {
                        x: parent.width - 3px;
                        y: 0px;
                        width: 4px;
                        height: parent.height;
                        background: sb-resizer.has-hover || sb-resizer.pressed ? root.theme-accent : transparent;
                        sb-resizer := TouchArea {
                            mouse-cursor: col-resize;
                            pointer-event(ev) => {
                                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                    root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                    root.col-resize-start-w = root.sidebar-width;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.sidebar-width = Math.clamp(
                                        root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                        155px,
                                        340px
                                    );
                                }
                            }
                        }
                    }
                }

                // 2B. PRIMARY (LEFT) FILE BROWSING PANE (Explicit width prevents pushing Inspector Drawer off-screen)
                Rectangle {
                    width: root.dual-pane-mode
                        ? root.panes-avail-width * root.split-ratio
                        : root.panes-avail-width;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    background: root.theme-bg-surface;
                    border-width: (root.dual-pane-mode && !root.right-pane-active) ? 2px : 1px;
                    border-color: root.drag-hover-left-pane
                        ? #5AC8FA
                        : ((root.dual-pane-mode && !root.right-pane-active) ? root.theme-accent : root.theme-border);
                    opacity: (root.dual-pane-mode && root.right-pane-active) ? 0.84 : 1.0;
                    clip: true;

                    VerticalLayout {
                        // Per-Pane Tab Bar (Matches reference screenshot: dark #08080A active tab pill, #212126 inactive tab pill, monochrome outline icons, hover-only close button)
                        Rectangle {
                            z: 30;
                            height: 38px + Math.max(0px, root.font-size-delta * 1.5);
                            background: root.theme-bg-sidebar;
                            border-width: 0px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: start;

                                for tab[t-idx] in root.left-tabs : Rectangle {
                                    height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                                    width: root.left-tab-pill-width;
                                    y: 5px;
                                    border-radius: 6px;
                                    background: (root.drag-hover-left-tab == t-idx || (root.dragging-tab-active && !root.drag-tab-hover-right && root.drag-tab-hover-idx == t-idx))
                                        ? #0D52BF44
                                        : (tab.is-active
                                            ? #08080A
                                            : (l-tab-touch.has-hover ? #2A2A31 : #212126));
                                    border-width: (root.drag-hover-left-tab == t-idx || (root.dragging-tab-active && !root.drag-tab-hover-right && root.drag-tab-hover-idx == t-idx)) ? 1px : 0px;
                                    border-color: #5AC8FA;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;

                                        Rectangle {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            clip: true;
                                            background: transparent;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle {
                                                    width: 16px;
                                                    background: transparent;
                                                    LucideIcon {
                                                        x: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 15px;
                                                        kind: tab.icon-kind != "" ? tab.icon-kind : "folder";
                                                        icon-color: tab.is-active ? #FFFFFF : (l-tab-touch.has-hover ? #C8C8D2 : #8E8E98);
                                                        fill-color: transparent;
                                                    }
                                                }
                                                Text {
                                                    text: tab.title;
                                                    color: tab.is-active ? #FFFFFF : (l-tab-touch.has-hover ? #D8D8E2 : #9898A2);
                                                    font-size: 13px + root.font-size-delta;
                                                    font-weight: tab.is-active ? 600 : (root.ui-font-bold ? 600 : 500);
                                                    min-width: 0px;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if l-tab-touch.has-hover && !l-tab-touch.pressed && tab.tooltip != "" : Rectangle {
                                                z: 3000;
                                                x: 0px;
                                                y: parent.height + 5px;
                                                height: 22px;
                                                width: l-tab-tt.preferred-width + 14px;
                                                border-radius: 4px;
                                                background: root.theme-bg-popover;
                                                border-width: 1px;
                                                border-color: #3A3A44;
                                                l-tab-tt := Text {
                                                    x: 7px;
                                                    y: (parent.height - self.height) / 2;
                                                    text: tab.tooltip;
                                                    color: #F2F2F7;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                }
                                            }
                                            l-tab-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    key-router.focus();
                                                    root.activate-pane(false);
                                                    root.select-tab(false, t-idx);
                                                }
                                                moved => {
                                                    if self.pressed && Math.abs(self.mouse-x - self.pressed-x) > 10px {
                                                        root.dragging-tab-active = true;
                                                        root.dragging-tab-is-right = false;
                                                        root.dragging-tab-idx = t-idx;
                                                        if root.dual-pane-mode && (self.absolute-position.x + self.mouse-x) > (root.sidebar-width + root.panes-avail-width * root.split-ratio + 12px) {
                                                            root.drag-tab-hover-right = true;
                                                            root.drag-tab-hover-idx = Math.clamp(
                                                                Math.round(((self.absolute-position.x + self.mouse-x) - (root.sidebar-width + root.panes-avail-width * root.split-ratio + 18px)) / (root.right-tab-pill-width + 6px)),
                                                                0,
                                                                Math.max(0, root.right-tabs.length - 1)
                                                            );
                                                        } else {
                                                            root.drag-tab-hover-right = false;
                                                            root.drag-tab-hover-idx = Math.clamp(
                                                                Math.round(((self.absolute-position.x + self.mouse-x) - (root.sidebar-width + 18px)) / (root.left-tab-pill-width + 6px)),
                                                                0,
                                                                Math.max(0, root.left-tabs.length - 1)
                                                            );
                                                        }
                                                    }
                                                }
                                                pointer-event(ev) => {
                                                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.dragging-tab-active {
                                                        root.dragging-tab-active = false;
                                                        root.move-tab(false, t-idx, root.drag-tab-hover-right, root.drag-tab-hover-idx);
                                                        root.drag-tab-hover-idx = -1;
                                                    }
                                                }
                                            }
                                        }

                                        if root.left-tabs.length > 1 : Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: 5px;
                                            border-radius: 4px;
                                            opacity: (l-tab-touch.has-hover || l-close-touch.has-hover) ? 1.0 : 0.0;
                                            background: l-close-touch.has-hover ? #2C2C34 : transparent;
                                            LucideIcon {
                                                x: 4px;
                                                y: 4px;
                                                icon-size: 10px;
                                                kind: "close";
                                                icon-color: l-close-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                            }
                                            l-close-touch := TouchArea {
                                                clicked => { root.close-tab(false, t-idx); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    y: 6px;
                                    border-radius: 5px;
                                    background: l-add-touch.has-hover ? #26262E : transparent;
                                    border-width: 0px;
                                    LucideIcon {
                                        x: 6.5px;
                                        y: 6.5px;
                                        icon-size: 13px;
                                        kind: "plus";
                                        icon-color: l-add-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                    }
                                    if l-add-touch.has-hover && !l-add-touch.pressed : Rectangle {
                                        z: 3000;
                                        x: 0px;
                                        y: parent.height + 5px;
                                        height: 22px;
                                        width: 126px;
                                        border-radius: 4px;
                                        background: root.theme-bg-popover;
                                        border-width: 1px;
                                        border-color: #3A3A44;
                                        Text {
                                            x: 7px;
                                            y: (parent.height - self.height) / 2;
                                            text: "New Tab (Ctrl/Cmd+T)";
                                            color: #F2F2F7;
                                            font-size: 11px;
                                            font-weight: 500;
                                        }
                                    }
                                    l-add-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.add-tab(false); }
                                    }
                                }
                            }
                        }

                        // Full-Width Horizontal Active Accent Bar below Tab Bar (Bound to active theme accent color)
                        Rectangle {
                            height: 2.5px;
                            background: (!root.right-pane-active || !root.dual-pane-mode) ? root.theme-accent : #2C2C34;
                        }

                        // TWO-LINE PATH & STATUS HEADER BAR (Matches original screenshot: 28px icon on left, Breadcrumbs on Line 1, "4 items, 100,58 GB available" on Line 2)
                        Rectangle {
                            height: 50px + Math.max(0px, root.font-size-delta * 2.0);
                            background: root.theme-bg-surface;
                            border-width: 0px;

                            if !root.left-path-edit-mode : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                // Large 28x28px Crisp White Outline Home / Volume / Server Icon
                                Rectangle {
                                    width: 30px;
                                    background: transparent;
                                    LucideIcon {
                                        x: 1px;
                                        y: (parent.height - self.height) / 2;
                                        icon-size: 28px;
                                        kind: root.left-header-icon != "" ? root.left-header-icon : "home";
                                        icon-color: #F2F2F7;
                                    }
                                }

                                // Stacked Line 1 (Clickable Breadcrumbs) + Line 2 (Items & Available Space Subtitle)
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for seg[s-idx] in root.left-breadcrumb-segments : HorizontalLayout {
                                            spacing: 2px;

                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: l-seg-touch.has-hover ? root.theme-bg-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    Text {
                                                        text: seg.label;
                                                        color: seg.is-last ? #FFFFFF : #D8D8E0;
                                                        font-size: 13.5px + root.font-size-delta;
                                                        font-weight: seg.is-last ? 600 : 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                l-seg-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        key-router.focus();
                                                        root.activate-pane(false);
                                                        root.navigate-to-breadcrumb(false, seg.target-path);
                                                    }
                                                }
                                            }

                                            if !seg.is-last : Rectangle {
                                                width: 14px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: l-chev-touch.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 1px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: l-chev-touch.has-hover ? "chevron-down" : "chevron-right";
                                                    icon-color: #9898A2;
                                                    opacity: l-chev-touch.has-hover ? 0.95 : 0.65;
                                                }
                                                l-chev-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(false);
                                                        root.open-sibling-dropdown(
                                                            false,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }

                                            if seg.is-last : Rectangle {
                                                width: 16px;
                                                height: 20px;
                                                border-radius: 4px;
                                                opacity: l-leaf-chev.has-hover ? 1.0 : 0.0;
                                                background: l-leaf-chev.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 2px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: "chevron-down";
                                                    icon-color: root.theme-text-primary;
                                                }
                                                l-leaf-chev := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(false);
                                                        root.open-sibling-dropdown(
                                                            false,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        // Blank space in Path Bar: clicking switches into Edit Mode (Ctrl+L / Cmd+L)
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 20px;
                                            background: transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.left-path-edit-mode = true;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        alignment: start;
                                        Text {
                                            text: root.left-status-subtitle;
                                            color: #8E8E98;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Edit Mode (Triggered via Ctrl+L / Cmd+L or clicking blank path bar space)
                            if root.left-path-edit-mode : HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                CleanLineEdit {
                                    y: 11px;
                                    horizontal-stretch: 1;
                                    text <=> root.left-path-input;
                                    placeholder-text: "/path/to/directory";
                                    font-size: 12.5px + root.font-size-delta * 0.5;
                                    accepted(val) => {
                                        root.left-path-edit-mode = false;
                                        key-router.focus();
                                        root.commit-path-input(false, val);
                                    }
                                    escape-pressed => {
                                        root.left-path-edit-mode = false;
                                        key-router.focus();
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Tab";
                                    tooltip: "Autocomplete Path (Tab)";
                                    tooltip-align-right: true;
                                    clicked => {
                                        root.autocomplete-path-input(false, root.left-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Go";
                                    tooltip: "Navigate to Path (Enter)";
                                    tooltip-align-right: true;
                                    active: true;
                                    clicked => {
                                        root.left-path-edit-mode = false;
                                        root.commit-path-input(false, root.left-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    icon-kind: "close";
                                    tooltip: "Cancel Path Edit (Esc)";
                                    tooltip-align-right: true;
                                    clicked => { root.left-path-edit-mode = false; }
                                }
                            }
                        }

                        // PER-TAB SEARCH HEADER BANNER
                        if root.left-filter-query != "" : Rectangle {
                            z: 15;
                            height: 44px;
                            background: root.theme-bg-sidebar;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: 7px;
                                        border-radius: 14px;
                                        background: #222228;
                                        border-width: 1px;
                                        border-color: #3A3A44;
                                        LucideIcon {
                                            x: 7px;
                                            y: 7px;
                                            icon-size: 14px;
                                            kind: "search";
                                            icon-color: #5AC8FA;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Search: \"" + root.left-filter-query + "\"";
                                            color: root.theme-text-primary;
                                            font-size: 13px + root.font-size-delta;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: root.left-status-subtitle;
                                            color: root.theme-text-muted;
                                            font-size: 11px + root.font-size-delta;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 64px;
                                    height: 24px;
                                    y: 9px;
                                    border-radius: 4px;
                                    background: l-clr-banner.has-hover ? #2C2C34 : #202026;
                                    border-width: 1px;
                                    border-color: #32323A;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: "close";
                                            icon-color: #E1E1E6;
                                        }
                                        Text {
                                            text: "Clear";
                                            color: #E1E1E6;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                    l-clr-banner := TouchArea {
                                        clicked => {
                                            root.clear-pane-filter(false);
                                        }
                                    }
                                }
                            }
                        }

                        // TABLE HEADER ROW (Clean Title-Case "Name | Size | Date Modified" matching original screenshot)
                        if root.left-view-mode == 0 : Rectangle {
                            z: 10;
                            height: 26px + Math.max(0px, root.font-size-delta);
                            background: #17171B;
                            border-width: 1px;
                            border-color: #26262B;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 26px;
                                spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: l-name-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 5px;
                                        alignment: start;
                                        Text {
                                            text: "Name";
                                            color: root.left-sort-column == "name" ? #AEAEB8 : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "name"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: #8E8E98;
                                            opacity: l-name-hdr.has-hover ? 0.85 : (root.left-sort-column == "name" ? 0.55 : 0.0);
                                        }
                                    }
                                    l-name-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "name");
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 6px;
                                    background: transparent;
                                    Rectangle {
                                        x: 2px;
                                        y: 4px;
                                        width: 1px;
                                        height: parent.height - 8px;
                                        background: l-col-resizer-1.has-hover || l-col-resizer-1.pressed ? root.theme-accent : #2E2E36;
                                    }
                                    l-col-resizer-1 := TouchArea {
                                        mouse-cursor: col-resize;
                                        pointer-event(ev) => {
                                            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                                root.col-resize-start-w = root.size-col-width;
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.size-col-width = Math.clamp(
                                                    root.col-resize-start-w - ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                    68px,
                                                    260px
                                                );
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: root.size-col-width;
                                    background: l-size-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Size";
                                            color: root.left-sort-column == "size" ? #AEAEB8 : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "size"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: #8E8E98;
                                            opacity: (root.left-sort-column == "size" || l-size-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-size-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "size");
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 6px;
                                    background: transparent;
                                    Rectangle {
                                        x: 2px;
                                        y: 4px;
                                        width: 1px;
                                        height: parent.height - 8px;
                                        background: l-col-resizer-2.has-hover || l-col-resizer-2.pressed ? root.theme-accent : #2E2E36;
                                    }
                                    l-col-resizer-2 := TouchArea {
                                        mouse-cursor: col-resize;
                                        pointer-event(ev) => {
                                            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                                root.col-resize-start-w = root.date-col-width;
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.date-col-width = Math.clamp(
                                                    root.col-resize-start-w - ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                    115px,
                                                    300px
                                                );
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: root.date-col-width;
                                    background: l-date-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Modified";
                                            color: root.left-sort-column == "modified" ? #AEAEB8 : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "modified"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: #8E8E98;
                                            opacity: (root.left-sort-column == "modified" || l-date-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-date-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "modified");
                                        }
                                    }
                                }
                            }
                        }

                        // LEFT PANE SCROLLABLE VIEWPORT
                        Rectangle {
                            z: 0;
                            vertical-stretch: 1;
                            background: root.theme-bg-surface;
                            clip: true;

                            l-blank-touch := TouchArea {
                                clicked => {
                                    key-router.focus();
                                    root.activate-pane(false);
                                }
                                pointer-event(ev) => {
                                    if ev.kind == PointerEventKind.down {
                                        root.activate-pane(false);
                                        if ev.button == PointerEventButton.right || (ev.button == PointerEventButton.left && root.left-rows.length == 0) {
                                            root.open-blank-context-menu(
                                                false,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y
                                            );
                                        }
                                    }
                                }
                                scroll-event(ev) => {
                                    l-flick.viewport-y = Math.clamp(
                                        l-flick.viewport-y + ev.delta-y,
                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                        0px
                                    );
                                    l-flick.viewport-x = Math.clamp(
                                        l-flick.viewport-x + ev.delta-x,
                                        Math.min(0px, l-flick.width - l-flick.viewport-width),
                                        0px
                                    );
                                    return accept;
                                }
                            }

                            l-flick := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: false;
                                viewport-width: root.left-view-mode == 0
                                    ? Math.max(self.width, 320px + root.size-col-width + root.date-col-width)
                                    : (root.left-view-mode == 2
                                        ? Math.max(self.width, 460px)
                                        : Math.max(self.width, 360px));
                                viewport-height: Math.min(
                                    9600px,
                                    root.left-view-mode == 0
                                        ? Math.max(self.height, root.left-rows.length * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px)
                                        : (root.left-view-mode == 1
                                            ? Math.max(self.height, root.left-icon-triples.length * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 28px)
                                            : Math.max(self.height, Math.max(root.left-parent-rows.length, root.left-rows.length) * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px))
                                );

                                VerticalLayout {
                                    alignment: start;

                                    // Blank / Empty Directory Action Card (Left-click or right-click to create file/folder or paste)
                                    if root.left-rows.length == 0 : VerticalLayout {
                                        alignment: center;
                                        padding-top: 56px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 48px;
                                                height: 48px;
                                                border-radius: 24px;
                                                background: root.theme-bg-sidebar;
                                                border-width: 1px;
                                                border-color: root.theme-border;
                                                LucideIcon {
                                                    x: 12px;
                                                    y: 12px;
                                                    icon-size: 24px;
                                                    kind: "folder";
                                                    icon-color: #38B6FF;
                                                    fill-color: #4CC2FF55;
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Folder is Empty";
                                            color: root.theme-text-primary;
                                            font-size: 13.5px + root.font-size-delta;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "Click anywhere or use the actions below to create items or paste.";
                                            color: root.theme-text-muted;
                                            font-size: 11.5px + root.font-size-delta;
                                            horizontal-alignment: center;
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            ToolbarButton {
                                                icon-kind: "folder";
                                                label: "New Folder";
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.open-new-folder-modal();
                                                }
                                            }
                                            ToolbarButton {
                                                icon-kind: "file";
                                                label: "New File";
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.open-new-file-modal();
                                                }
                                            }
                                            if root.has-clipboard-item : ToolbarButton {
                                                icon-kind: "downloads";
                                                label: "Paste Here";
                                                active: true;
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.execute-context-action("paste");
                                                }
                                            }
                                        }
                                    }

                                    // Mode 0: Standardized 26px FileRow List View
                                    if root.left-view-mode == 0 : VerticalLayout {
                                        alignment: start;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        spacing: 1px;
                                        for row[r-idx] in root.left-rows : FileRow {
                                            file_name: row.name;
                                            file_size: row.size-text;
                                            file_date: row.modified-text;
                                            ext_badge: row.ext-badge;
                                            is_dir: row.is-dir;
                                            is_image: row.is-image;
                                            is_executable: row.is-executable;
                                            is_expanded: row.is-expanded;
                                            has_thumbnail: row.has-thumbnail;
                                            thumbnail: row.thumbnail;
                                            selected: row.is-selected;
                                            pane_focused: !root.right-pane-active || !root.dual-pane-mode;
                                            depth: row.depth;
                                            has_color_tag: row.has-color-tag;
                                            color_tag_name: row.color-tag-name;
                                            color_tag_brush: row.color-tag-brush;
                                            color_tag_tint: row.color-tag-tint;
                                            size_col_width: root.size-col-width;
                                            date_col_width: root.date-col-width;
                                            font_delta: root.font-size-delta;
                                            font_bold: root.ui-font-bold;
                                            font_family: root.resolved-font-family;
                                            row_bg: root.theme-bg-surface;
                                            row_hover_bg: root.theme-bg-hover;
                                            row_accent_bg: root.theme-accent;
                                            text_primary: root.theme-text-primary;
                                            text_muted: root.theme-text-muted;
                                            drag_drop_highlight: root.drag-hover-left-row == r-idx;
                                            row-clicked(sh, cmd) => {
                                                key-router.focus();
                                                root.select-file-row-mod(false, r-idx, sh, cmd);
                                            }
                                            row-double-clicked => {
                                                key-router.focus();
                                                root.open-file-row(false, r-idx);
                                            }
                                            row-context-menu(abs_x, abs_y) => {
                                                root.open-context-menu-for-row(false, r-idx, abs_x, abs_y);
                                            }
                                            row-hovered(abs_x, abs_y) => {
                                                root.hover-file-row(false, r-idx, abs_x, abs_y);
                                            }
                                            row-shift-drag(my) => {
                                                root.shift-drag-select(false, r-idx + Math.round((my - 13px) / 27px));
                                            }
                                            row-drag-moved(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.update-drag-cursor(false, r-idx, abs_x, abs_y);
                                            }
                                            row-drag-ended(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.finish-drag-drop(false, r-idx, abs_x, abs_y);
                                            }
                                            row-drag-to-other-pane => {
                                                if root.dual-pane-mode {
                                                    root.drag-drop-row-to-other-pane(false, r-idx);
                                                }
                                            }
                                            toggle-expand => {
                                                root.toggle-expand-folder(false, r-idx);
                                            }
                                            wheel-scroll(dy) => {
                                                l-flick.viewport-y = Math.clamp(
                                                    l-flick.viewport-y + dy,
                                                    Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                    0px
                                                );
                                            }
                                        }
                                    }

                                    // Mode 1: 3-Column Icon Grid
                                    if root.left-view-mode == 1 : VerticalLayout {
                                        alignment: start;
                                        padding: 12px;
                                        spacing: 10px;
                                        for triple in root.left-icon-triples : HorizontalLayout {
                                            spacing: 10px;
                                            if triple.has-0 : PolaroidCell {
                                                item: triple.item-0;
                                                pane-focused: !root.right-pane-active || !root.dual-pane-mode;
                                                drag-drop-highlight: root.drag-hover-left-row == triple.idx-0;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                select-cell(sh, cmd) => { root.select-file-row-mod(false, triple.idx-0, sh, cmd); }
                                                open-cell => { root.open-file-row(false, triple.idx-0); }
                                                context-cell(cx, cy) => { root.open-context-menu-for-row(false, triple.idx-0, cx, cy); }
                                                cell-hovered(abs_x, abs_y) => { root.hover-file-row(false, triple.idx-0, abs_x, abs_y); }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.update-drag-cursor(false, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.finish-drag-drop(false, triple.idx-0, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    l-flick.viewport-y = Math.clamp(
                                                        l-flick.viewport-y + dy,
                                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-0 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-1 : PolaroidCell {
                                                item: triple.item-1;
                                                pane-focused: !root.right-pane-active || !root.dual-pane-mode;
                                                drag-drop-highlight: root.drag-hover-left-row == triple.idx-1;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                select-cell(sh, cmd) => { root.select-file-row-mod(false, triple.idx-1, sh, cmd); }
                                                open-cell => { root.open-file-row(false, triple.idx-1); }
                                                context-cell(cx, cy) => { root.open-context-menu-for-row(false, triple.idx-1, cx, cy); }
                                                cell-hovered(abs_x, abs_y) => { root.hover-file-row(false, triple.idx-1, abs_x, abs_y); }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.update-drag-cursor(false, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.finish-drag-drop(false, triple.idx-1, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    l-flick.viewport-y = Math.clamp(
                                                        l-flick.viewport-y + dy,
                                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-1 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-2 : PolaroidCell {
                                                item: triple.item-2;
                                                pane-focused: !root.right-pane-active || !root.dual-pane-mode;
                                                drag-drop-highlight: root.drag-hover-left-row == triple.idx-2;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                select-cell(sh, cmd) => { root.select-file-row-mod(false, triple.idx-2, sh, cmd); }
                                                open-cell => { root.open-file-row(false, triple.idx-2); }
                                                context-cell(cx, cy) => { root.open-context-menu-for-row(false, triple.idx-2, cx, cy); }
                                                cell-hovered(abs_x, abs_y) => { root.hover-file-row(false, triple.idx-2, abs_x, abs_y); }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.update-drag-cursor(false, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.finish-drag-drop(false, triple.idx-2, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    l-flick.viewport-y = Math.clamp(
                                                        l-flick.viewport-y + dy,
                                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-2 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                        }
                                    }

                                    // Mode 2: 3-Column Miller Columns View (Parent | Current Directory | Live Preview & Media Metadata)
                                    if root.left-view-mode == 2 : HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            alignment: start;
                                            width: root.miller-col-width;
                                            for p-row[p-idx] in root.left-parent-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                background: p-row.is-selected
                                                    ? root.theme-bg-hover
                                                    : (p-row.has-color-tag ? p-row.color-tag-tint : transparent);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 18px;
                                                        background: transparent;
                                                        if !p-row.is-dir && p-row.has-thumbnail : Image {
                                                            x: 0px;
                                                            y: (parent.height - 18px) / 2;
                                                            width: 18px;
                                                            height: 18px;
                                                            image-fit: contain;
                                                            source: p-row.thumbnail;
                                                        }
                                                        if p-row.is-dir || !p-row.has-thumbnail : LucideIcon {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: p-row.is-dir
                                                                ? "folder"
                                                                : (p-row.is-executable
                                                                    ? "terminal"
                                                                    : (p-row.is-image
                                                                        ? "image"
                                                                        : ((p-row.ext-badge == "ZIP" || p-row.ext-badge == "TAR" || p-row.ext-badge == "GZ" || p-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((p-row.ext-badge == "MP3" || p-row.ext-badge == "FLAC" || p-row.ext-badge == "WAV" || p-row.ext-badge == "M4A" || p-row.ext-badge == "OGG" || p-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((p-row.ext-badge == "MP4" || p-row.ext-badge == "MKV" || p-row.ext-badge == "MOV" || p-row.ext-badge == "AVI" || p-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : "documents")))));
                                                            icon-color: p-row.has-color-tag
                                                                ? p-row.color-tag-brush
                                                                : (p-row.is-dir
                                                                    ? #38B6FF
                                                                    : (p-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (p-row.is-image ? #5AC8FA : #A0A0AB)));
                                                            fill-color: p-row.is-dir
                                                                ? (p-row.has-color-tag ? p-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: p-row.name;
                                                        color: root.theme-text-primary;
                                                        font-size: 12px + root.font-size-delta;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if p-row.has-color-tag : Rectangle {
                                                        width: 7px;
                                                        height: 7px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3.5px;
                                                        background: p-row.color-tag-brush;
                                                    }
                                                    if p-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: root.theme-text-muted;
                                                    }
                                                }
                                                TouchArea {
                                                    clicked => { root.open-parent-row(false, p-idx); }
                                                    scroll-event(ev) => {
                                                        l-flick.viewport-y = Math.clamp(
                                                            l-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: start;
                                            horizontal-stretch: 1;
                                            for c-row[c-idx] in root.left-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                border-width: root.drag-hover-left-row == c-idx ? 1px : 0px;
                                                border-color: root.drag-hover-left-row == c-idx ? #5AC8FA : transparent;
                                                background: root.drag-hover-left-row == c-idx
                                                    ? #0D52BF55
                                                    : (c-row.is-selected
                                                        ? ((!root.right-pane-active || !root.dual-pane-mode) ? root.theme-accent : #2E323B)
                                                        : (l-col-touch.has-hover
                                                            ? root.theme-bg-hover
                                                            : (c-row.has-color-tag ? c-row.color-tag-tint : transparent)));
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 20px;
                                                        background: transparent;
                                                        if !c-row.is-dir && c-row.has-thumbnail : Rectangle {
                                                            x: 0px;
                                                            y: (parent.height - 20px) / 2;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 3px;
                                                            background: #121215;
                                                            border-width: 1px;
                                                            border-color: c-row.is-selected ? #FFFFFFAA : #32323A;
                                                            clip: true;
                                                            Image {
                                                                x: 1px;
                                                                y: 1px;
                                                                width: 18px;
                                                                height: 18px;
                                                                image-fit: contain;
                                                                source: c-row.thumbnail;
                                                            }
                                                        }
                                                        if c-row.is-dir || !c-row.has-thumbnail : LucideIcon {
                                                            x: 2px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: c-row.is-dir
                                                                ? "folder"
                                                                : (c-row.is-executable
                                                                    ? "terminal"
                                                                    : (c-row.is-image
                                                                        ? "image"
                                                                        : ((c-row.ext-badge == "ZIP" || c-row.ext-badge == "TAR" || c-row.ext-badge == "GZ" || c-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((c-row.ext-badge == "MP3" || c-row.ext-badge == "FLAC" || c-row.ext-badge == "WAV" || c-row.ext-badge == "M4A" || c-row.ext-badge == "OGG" || c-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((c-row.ext-badge == "MP4" || c-row.ext-badge == "MKV" || c-row.ext-badge == "MOV" || c-row.ext-badge == "AVI" || c-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : "documents")))));
                                                            icon-color: c-row.has-color-tag
                                                                ? c-row.color-tag-brush
                                                                : (c-row.is-dir
                                                                    ? #38B6FF
                                                                    : (c-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (c-row.is-image ? #5AC8FA : #A0A0AB)));
                                                            fill-color: c-row.is-dir
                                                                ? (c-row.has-color-tag ? c-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: c-row.name;
                                                        color: c-row.is-selected ? #FFFFFF : root.theme-text-primary;
                                                        font-size: 12.5px + root.font-size-delta;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if c-row.has-color-tag : Rectangle {
                                                        width: l-col-tag.preferred-width;
                                                        height: 17px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 8.5px;
                                                        background: c-row.is-selected ? #00000044 : c-row.color-tag-tint;
                                                        border-width: 1px;
                                                        border-color: c-row.is-selected ? #FFFFFF88 : c-row.color-tag-brush;
                                                        l-col-tag := HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 6px;
                                                            spacing: 4px;
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 6px;
                                                                height: 6px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 3px;
                                                                background: c-row.color-tag-brush;
                                                            }
                                                            Text {
                                                                text: c-row.color-tag-name;
                                                                color: c-row.is-selected ? #FFFFFF : #F2F2F7;
                                                                font-size: 10px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if c-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: c-row.is-selected ? #FFFFFF : root.theme-text-muted;
                                                    }
                                                }
                                                l-col-touch := TouchArea {
                                                    clicked => {
                                                        root.show-hover-preview = false;
                                                        key-router.focus();
                                                        if !root.col-suppress-click {
                                                            root.select-file-row-mod(
                                                                false,
                                                                c-idx,
                                                                root.col-down-shift,
                                                                root.col-down-cmd
                                                            );
                                                        }
                                                        root.col-suppress-click = false;
                                                        root.col-down-shift = false;
                                                        root.col-down-cmd = false;
                                                    }
                                                    double-clicked => {
                                                        root.show-hover-preview = false;
                                                        root.open-file-row(false, c-idx);
                                                    }
                                                    moved => {
                                                        if self.pressed && !root.col-down-shift && !root.col-down-cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                                                            root.show-hover-preview = false;
                                                            root.col-drag-active = true;
                                                            root.col-suppress-click = true;
                                                            root.drag-left-pane-w = l-flick.width;
                                                            root.drag-left-scroll-y = l-flick.viewport-y;
                                                            root.update-drag-cursor(
                                                                false,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    pointer-event(ev) => {
                                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            key-router.focus();
                                                            root.col-down-shift = ev.modifiers.shift;
                                                            root.col-down-cmd = ev.modifiers.control || ev.modifiers.meta;
                                                            root.col-drag-active = false;
                                                            root.col-suppress-click = false;
                                                        }
                                                        if ev.button == PointerEventButton.left && (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                            if root.col-drag-active {
                                                                root.col-drag-active = false;
                                                                root.drag-left-pane-w = l-flick.width;
                                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                                root.finish-drag-drop(
                                                                    false,
                                                                    c-idx,
                                                                    self.absolute-position.x + self.mouse-x,
                                                                    self.absolute-position.y + self.mouse-y
                                                                );
                                                            }
                                                            if ev.kind == PointerEventKind.cancel {
                                                                root.col-suppress-click = false;
                                                                root.col-down-shift = false;
                                                                root.col-down-cmd = false;
                                                            }
                                                        }
                                                        if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            root.col-suppress-click = true;
                                                            root.open-context-menu-for-row(
                                                                false,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    scroll-event(ev) => {
                                                        l-flick.viewport-y = Math.clamp(
                                                            l-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }

                                        // Column 3: Miller Preview & Photo/Music/Video Metadata Column
                                        if root.inspector-title != "" : Rectangle {
                                            width: 248px;
                                            border-radius: 6px;
                                            background: root.theme-bg-sidebar;
                                            border-width: 1px;
                                            border-color: root.theme-border;
                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                alignment: start;

                                                // Visual Preview Box (Photo Raster or Text/JSON/Code Snippet — no binary dump)
                                                Rectangle {
                                                    height: 132px;
                                                    border-radius: 6px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    clip: true;

                                                    if root.inspector-is-dir : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 48px;
                                                        kind: "folder";
                                                        icon-color: #38B6FF;
                                                        fill-color: #4CC2FF;
                                                    }
                                                    if !root.inspector-is-dir && root.inspector-has-image : Image {
                                                        x: 4px;
                                                        y: 4px;
                                                        width: parent.width - 8px;
                                                        height: parent.height - 8px;
                                                        image-fit: contain;
                                                        source: root.inspector-preview-image;
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && root.inspector-has-text-preview : VerticalLayout {
                                                        padding: 6px;
                                                        alignment: start;
                                                        Text {
                                                            text: root.inspector-preview-text;
                                                            color: root.theme-text-primary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && !root.inspector-has-text-preview : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 44px;
                                                        kind: "documents";
                                                        icon-color: #5AC8FA;
                                                    }
                                                }

                                                Text {
                                                    text: root.inspector-title;
                                                    color: root.theme-text-primary;
                                                    font-size: 12.5px + root.font-size-delta;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: root.inspector-subtitle + "  •  " + root.inspector-size;
                                                    color: #5AC8FA;
                                                    font-size: 11px + root.font-size-delta;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: "Modified: " + root.inspector-modified;
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }
                                                Text {
                                                    text: "Permissions: " + root.inspector-perm-symbolic + " (" + root.inspector-perm-octal + ")";
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }

                                                // Direct Photo / Music / Video Meta Information in Columns View
                                                if root.inspector-media-category != "" : Rectangle {
                                                    border-radius: 5px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: #388BFD55;
                                                    VerticalLayout {
                                                        padding: 7px;
                                                        spacing: 3px;
                                                        Text {
                                                            text: root.inspector-media-category;
                                                            color: #5AC8FA;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-weight: 700;
                                                        }
                                                        if root.inspector-media-line1 != "" : Text {
                                                            text: root.inspector-media-line1;
                                                            color: root.theme-text-primary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                        if root.inspector-media-line2 != "" : Text {
                                                            text: root.inspector-media-line2;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                        if root.inspector-media-line3 != "" : Text {
                                                            text: root.inspector-media-line3;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Miller Columns draggable vertical divider clipped to viewport height
                            if root.left-view-mode == 2 : Rectangle {
                                x: root.miller-col-width + l-flick.viewport-x;
                                y: 0px;
                                width: 4px;
                                height: parent.height;
                                background: l-miller-resizer.has-hover || l-miller-resizer.pressed ? root.theme-accent : root.theme-border;
                                l-miller-resizer := TouchArea {
                                    mouse-cursor: col-resize;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                            root.col-resize-start-w = root.miller-col-width;
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.miller-col-width = Math.clamp(
                                                root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                130px,
                                                340px
                                            );
                                        }
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Vertical Scrollbar for Left Pane
                            if l-flick.viewport-height > l-flick.height : Rectangle {
                                z: 25;
                                x: parent.width - 12px;
                                y: 2px;
                                width: 10px;
                                height: parent.height - (l-flick.viewport-width > l-flick.width ? 14px : 4px);
                                border-radius: 5px;
                                background: l-vbar-touch.has-hover || l-vbar-touch.pressed ? #141417DD : #16161888;

                                l-vthumb := Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: (l-vbar-touch.has-hover || l-vbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.width / 2;
                                    background: l-vbar-touch.pressed
                                        ? root.theme-accent
                                        : (l-vbar-touch.has-hover ? #8E8E98 : #52525E);
                                    height: Math.max(28px, parent.height * (l-flick.height / l-flick.viewport-height));
                                    y: (parent.height - self.height) * (-l-flick.viewport-y / Math.max(1px, l-flick.viewport-height - l-flick.height));
                                }

                                l-vbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(false);
                                            l-flick.viewport-y = Math.clamp(
                                                -((self.mouse-y - l-vthumb.height / 2) / Math.max(1px, self.height - l-vthumb.height))
                                                    * (l-flick.viewport-height - l-flick.height),
                                                Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                0px
                                            );
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            l-flick.viewport-y = Math.clamp(
                                                -((self.mouse-y - l-vthumb.height / 2) / Math.max(1px, self.height - l-vthumb.height))
                                                    * (l-flick.viewport-height - l-flick.height),
                                                Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                0px
                                            );
                                        }
                                    }
                                    scroll-event(ev) => {
                                        l-flick.viewport-y = Math.clamp(
                                            l-flick.viewport-y + ev.delta-y,
                                            Math.min(0px, l-flick.height - l-flick.viewport-height),
                                            0px
                                        );
                                        return accept;
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Horizontal Scrollbar for Left Pane
                            if l-flick.viewport-width > l-flick.width : Rectangle {
                                z: 25;
                                x: 2px;
                                y: parent.height - 12px;
                                width: parent.width - (l-flick.viewport-height > l-flick.height ? 14px : 4px);
                                height: 10px;
                                border-radius: 5px;
                                background: l-hbar-touch.has-hover || l-hbar-touch.pressed ? #141417DD : #16161888;

                                l-hthumb := Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: (l-hbar-touch.has-hover || l-hbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.height / 2;
                                    background: l-hbar-touch.pressed
                                        ? root.theme-accent
                                        : (l-hbar-touch.has-hover ? #8E8E98 : #52525E);
                                    width: Math.max(28px, parent.width * (l-flick.width / l-flick.viewport-width));
                                    x: (parent.width - self.width) * (-l-flick.viewport-x / Math.max(1px, l-flick.viewport-width - l-flick.width));
                                }

                                l-hbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(false);
                                            l-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - l-hthumb.width / 2) / Math.max(1px, self.width - l-hthumb.width))
                                                    * (l-flick.viewport-width - l-flick.width),
                                                Math.min(0px, l-flick.width - l-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            l-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - l-hthumb.width / 2) / Math.max(1px, self.width - l-hthumb.width))
                                                    * (l-flick.viewport-width - l-flick.width),
                                                Math.min(0px, l-flick.width - l-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 2B-SPLITTER: Draggable 6px Splitter Handle in Dual-Pane Mode (1:1 smooth absolute pointer math)
                if root.dual-pane-mode : Rectangle {
                    z: 20;
                    width: 6px;
                    horizontal-stretch: 0;
                    border-radius: 3px;
                    background: splitter-touch.has-hover || splitter-touch.pressed ? root.theme-accent : root.theme-border;
                    splitter-touch := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            if self.pressed {
                                root.split-ratio = Math.clamp(
                                    ((self.absolute-position.x + self.mouse-x) - (root.sidebar-width + 10px))
                                        / Math.max(200px, root.panes-avail-width),
                                    0.20,
                                    0.80
                                );
                            }
                        }
                    }
                }

                // 2C. SECONDARY (RIGHT) FILE BROWSING PANE (Explicit width guarantees Right Inspector Drawer stays visible)
                if root.dual-pane-mode : Rectangle {
                    width: root.panes-avail-width * (1.0 - root.split-ratio);
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    background: root.theme-bg-surface;
                    border-width: (root.dual-pane-mode && root.right-pane-active) ? 2px : 1px;
                    border-color: root.drag-hover-right-pane
                        ? #5AC8FA
                        : (root.right-pane-active ? root.theme-accent : root.theme-border);
                    opacity: root.right-pane-active ? 1.0 : 0.84;
                    clip: true;

                    VerticalLayout {
                        // Right Pane Tab Bar (Matches reference screenshot: dark #08080A active tab pill, #212126 inactive tab pill, monochrome outline icons, hover-only close button)
                        Rectangle {
                            z: 30;
                            height: 38px + Math.max(0px, root.font-size-delta * 1.5);
                            background: root.theme-bg-sidebar;
                            border-width: 0px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: start;
                                for tab[t-idx] in root.right-tabs : Rectangle {
                                    height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                                    width: root.right-tab-pill-width;
                                    y: 5px;
                                    border-radius: 6px;
                                    background: (root.drag-hover-right-tab == t-idx || (root.dragging-tab-active && root.drag-tab-hover-right && root.drag-tab-hover-idx == t-idx))
                                        ? #0D52BF44
                                        : (tab.is-active
                                            ? #08080A
                                            : (r-tab-touch.has-hover ? #2A2A31 : #212126));
                                    border-width: (root.drag-hover-right-tab == t-idx || (root.dragging-tab-active && root.drag-tab-hover-right && root.drag-tab-hover-idx == t-idx)) ? 1px : 0px;
                                    border-color: #5AC8FA;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;

                                        Rectangle {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            clip: true;
                                            background: transparent;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle {
                                                    width: 16px;
                                                    background: transparent;
                                                    LucideIcon {
                                                        x: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 15px;
                                                        kind: tab.icon-kind != "" ? tab.icon-kind : "folder";
                                                        icon-color: tab.is-active ? #FFFFFF : (r-tab-touch.has-hover ? #C8C8D2 : #8E8E98);
                                                        fill-color: transparent;
                                                    }
                                                }
                                                Text {
                                                    text: tab.title;
                                                    color: tab.is-active ? #FFFFFF : (r-tab-touch.has-hover ? #D8D8E2 : #9898A2);
                                                    font-size: 13px + root.font-size-delta;
                                                    font-weight: tab.is-active ? 600 : (root.ui-font-bold ? 600 : 500);
                                                    min-width: 0px;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if r-tab-touch.has-hover && !r-tab-touch.pressed && tab.tooltip != "" : Rectangle {
                                                z: 3000;
                                                x: 0px;
                                                y: parent.height + 5px;
                                                height: 22px;
                                                width: r-tab-tt.preferred-width + 14px;
                                                border-radius: 4px;
                                                background: root.theme-bg-popover;
                                                border-width: 1px;
                                                border-color: #3A3A44;
                                                r-tab-tt := Text {
                                                    x: 7px;
                                                    y: (parent.height - self.height) / 2;
                                                    text: tab.tooltip;
                                                    color: #F2F2F7;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                }
                                            }
                                            r-tab-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    key-router.focus();
                                                    root.activate-pane(true);
                                                    root.select-tab(true, t-idx);
                                                }
                                                moved => {
                                                    if self.pressed && Math.abs(self.mouse-x - self.pressed-x) > 10px {
                                                        root.dragging-tab-active = true;
                                                        root.dragging-tab-is-right = true;
                                                        root.dragging-tab-idx = t-idx;
                                                        if (self.absolute-position.x + self.mouse-x) < (root.sidebar-width + root.panes-avail-width * root.split-ratio + 10px) {
                                                            root.drag-tab-hover-right = false;
                                                            root.drag-tab-hover-idx = Math.clamp(
                                                                Math.round(((self.absolute-position.x + self.mouse-x) - (root.sidebar-width + 18px)) / (root.left-tab-pill-width + 6px)),
                                                                0,
                                                                Math.max(0, root.left-tabs.length - 1)
                                                            );
                                                        } else {
                                                            root.drag-tab-hover-right = true;
                                                            root.drag-tab-hover-idx = Math.clamp(
                                                                Math.round(((self.absolute-position.x + self.mouse-x) - (root.sidebar-width + root.panes-avail-width * root.split-ratio + 18px)) / (root.right-tab-pill-width + 6px)),
                                                                0,
                                                                Math.max(0, root.right-tabs.length - 1)
                                                            );
                                                        }
                                                    }
                                                }
                                                pointer-event(ev) => {
                                                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.dragging-tab-active {
                                                        root.dragging-tab-active = false;
                                                        root.move-tab(true, t-idx, root.drag-tab-hover-right, root.drag-tab-hover-idx);
                                                        root.drag-tab-hover-idx = -1;
                                                    }
                                                }
                                            }
                                        }

                                        if root.right-tabs.length > 1 : Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: 5px;
                                            border-radius: 4px;
                                            opacity: (r-tab-touch.has-hover || r-close-touch.has-hover) ? 1.0 : 0.0;
                                            background: r-close-touch.has-hover ? #2C2C34 : transparent;
                                            LucideIcon {
                                                x: 4px;
                                                y: 4px;
                                                icon-size: 10px;
                                                kind: "close";
                                                icon-color: r-close-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                            }
                                            r-close-touch := TouchArea {
                                                clicked => { root.close-tab(true, t-idx); }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    y: 6px;
                                    border-radius: 5px;
                                    background: r-add-touch.has-hover ? #26262E : transparent;
                                    border-width: 0px;
                                    LucideIcon {
                                        x: 6.5px;
                                        y: 6.5px;
                                        icon-size: 13px;
                                        kind: "plus";
                                        icon-color: r-add-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                    }
                                    if r-add-touch.has-hover && !r-add-touch.pressed : Rectangle {
                                        z: 3000;
                                        x: 0px;
                                        y: parent.height + 5px;
                                        height: 22px;
                                        width: 126px;
                                        border-radius: 4px;
                                        background: root.theme-bg-popover;
                                        border-width: 1px;
                                        border-color: #3A3A44;
                                        Text {
                                            x: 7px;
                                            y: (parent.height - self.height) / 2;
                                            text: "New Tab (Ctrl/Cmd+T)";
                                            color: #F2F2F7;
                                            font-size: 11px;
                                            font-weight: 500;
                                        }
                                    }
                                    r-add-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.add-tab(true); }
                                    }
                                }
                            }
                        }

                        // Full-Width Horizontal Active Accent Bar below Right Tab Bar (Bound to active theme accent color)
                        Rectangle {
                            height: 2.5px;
                            background: root.right-pane-active ? root.theme-accent : #2C2C34;
                        }

                        // Right Pane Two-Line Path & Status Header Bar
                        Rectangle {
                            height: 50px + Math.max(0px, root.font-size-delta * 2.0);
                            background: root.theme-bg-surface;
                            border-width: 0px;

                            if !root.right-path-edit-mode : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                Rectangle {
                                    width: 30px;
                                    background: transparent;
                                    LucideIcon {
                                        x: 1px;
                                        y: (parent.height - self.height) / 2;
                                        icon-size: 28px;
                                        kind: root.right-header-icon != "" ? root.right-header-icon : "home";
                                        icon-color: #F2F2F7;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for seg[s-idx] in root.right-breadcrumb-segments : HorizontalLayout {
                                            spacing: 2px;
                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: r-seg-touch.has-hover ? root.theme-bg-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    Text {
                                                        text: seg.label;
                                                        color: seg.is-last ? #FFFFFF : #D8D8E0;
                                                        font-size: 13.5px + root.font-size-delta;
                                                        font-weight: seg.is-last ? 600 : 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                r-seg-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        key-router.focus();
                                                        root.activate-pane(true);
                                                        root.navigate-to-breadcrumb(true, seg.target-path);
                                                    }
                                                }
                                            }
                                            if !seg.is-last : Rectangle {
                                                width: 14px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: r-chev-touch.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 1px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: r-chev-touch.has-hover ? "chevron-down" : "chevron-right";
                                                    icon-color: #9898A2;
                                                    opacity: r-chev-touch.has-hover ? 0.95 : 0.65;
                                                }
                                                r-chev-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(true);
                                                        root.open-sibling-dropdown(
                                                            true,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }
                                            if seg.is-last : Rectangle {
                                                width: 16px;
                                                height: 20px;
                                                border-radius: 4px;
                                                opacity: r-leaf-chev.has-hover ? 1.0 : 0.0;
                                                background: r-leaf-chev.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 2px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: "chevron-down";
                                                    icon-color: root.theme-text-primary;
                                                }
                                                r-leaf-chev := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(true);
                                                        root.open-sibling-dropdown(
                                                            true,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 20px;
                                            background: transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.activate-pane(true);
                                                    root.right-path-edit-mode = true;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        alignment: start;
                                        Text {
                                            text: root.right-status-subtitle;
                                            color: #8E8E98;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            if root.right-path-edit-mode : HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                CleanLineEdit {
                                    y: 11px;
                                    horizontal-stretch: 1;
                                    text <=> root.right-path-input;
                                    placeholder-text: "/path/to/directory";
                                    font-size: 12.5px + root.font-size-delta * 0.5;
                                    accepted(val) => {
                                        root.right-path-edit-mode = false;
                                        key-router.focus();
                                        root.commit-path-input(true, val);
                                    }
                                    escape-pressed => {
                                        root.right-path-edit-mode = false;
                                        key-router.focus();
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Tab";
                                    clicked => {
                                        root.autocomplete-path-input(true, root.right-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Go";
                                    active: true;
                                    clicked => {
                                        root.right-path-edit-mode = false;
                                        root.commit-path-input(true, root.right-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    icon-kind: "close";
                                    clicked => { root.right-path-edit-mode = false; }
                                }
                            }
                        }

                        // Right Pane Per-Tab Search Header Banner
                        if root.right-filter-query != "" : Rectangle {
                            z: 15;
                            height: 44px;
                            background: root.theme-bg-sidebar;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: 7px;
                                        border-radius: 14px;
                                        background: #222228;
                                        border-width: 1px;
                                        border-color: #3A3A44;
                                        LucideIcon {
                                            x: 7px;
                                            y: 7px;
                                            icon-size: 14px;
                                            kind: "search";
                                            icon-color: #5AC8FA;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Search: \"" + root.right-filter-query + "\"";
                                            color: root.theme-text-primary;
                                            font-size: 13px + root.font-size-delta;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: root.right-status-subtitle;
                                            color: root.theme-text-muted;
                                            font-size: 11px + root.font-size-delta;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 64px;
                                    height: 24px;
                                    y: 9px;
                                    border-radius: 4px;
                                    background: r-clr-banner.has-hover ? #2C2C34 : #202026;
                                    border-width: 1px;
                                    border-color: #32323A;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: "close";
                                            icon-color: #E1E1E6;
                                        }
                                        Text {
                                            text: "Clear";
                                            color: #E1E1E6;
                                            font-size: 11px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                    r-clr-banner := TouchArea {
                                        clicked => {
                                            root.clear-pane-filter(true);
                                        }
                                    }
                                }
                            }
                        }

                        // Right Pane Table Header Row (Clean Title-Case "Name | Size | Date Modified")
                        if root.right-view-mode == 0 : Rectangle {
                            z: 10;
                            height: 26px + Math.max(0px, root.font-size-delta);
                            background: #17171B;
                            border-width: 1px;
                            border-color: #26262B;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 26px;
                                spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: r-name-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 5px;
                                        alignment: start;
                                        Text {
                                            text: "Name";
                                            color: root.right-sort-column == "name" ? #AEAEB8 : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "name"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: #8E8E98;
                                            opacity: r-name-hdr.has-hover ? 0.85 : (root.right-sort-column == "name" ? 0.55 : 0.0);
                                        }
                                    }
                                    r-name-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "name");
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 6px;
                                    background: transparent;
                                    Rectangle {
                                        x: 2px;
                                        y: 4px;
                                        width: 1px;
                                        height: parent.height - 8px;
                                        background: r-col-resizer-1.has-hover || r-col-resizer-1.pressed ? root.theme-accent : #2E2E36;
                                    }
                                    r-col-resizer-1 := TouchArea {
                                        mouse-cursor: col-resize;
                                        pointer-event(ev) => {
                                            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                                root.col-resize-start-w = root.size-col-width;
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.size-col-width = Math.clamp(
                                                    root.col-resize-start-w - ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                    68px,
                                                    260px
                                                );
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: root.size-col-width;
                                    background: r-size-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Size";
                                            color: root.right-sort-column == "size" ? #AEAEB8 : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "size"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: #8E8E98;
                                            opacity: (root.right-sort-column == "size" || r-size-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-size-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "size");
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 6px;
                                    background: transparent;
                                    Rectangle {
                                        x: 2px;
                                        y: 4px;
                                        width: 1px;
                                        height: parent.height - 8px;
                                        background: r-col-resizer-2.has-hover || r-col-resizer-2.pressed ? root.theme-accent : #2E2E36;
                                    }
                                    r-col-resizer-2 := TouchArea {
                                        mouse-cursor: col-resize;
                                        pointer-event(ev) => {
                                            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                                root.col-resize-start-w = root.date-col-width;
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.date-col-width = Math.clamp(
                                                    root.col-resize-start-w - ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                    115px,
                                                    300px
                                                );
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: root.date-col-width;
                                    background: r-date-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Modified";
                                            color: root.right-sort-column == "modified" ? #AEAEB8 : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "modified"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: #8E8E98;
                                            opacity: (root.right-sort-column == "modified" || r-date-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-date-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "modified");
                                        }
                                    }
                                }
                            }
                        }

                        // RIGHT PANE SCROLLABLE VIEWPORT (#1A1A1E)
                        Rectangle {
                            z: 0;
                            vertical-stretch: 1;
                            background: root.theme-bg-surface;
                            clip: true;

                            r-blank-touch := TouchArea {
                                clicked => {
                                    key-router.focus();
                                    root.show-hover-preview = false;
                                    root.activate-pane(true);
                                }
                                moved => {
                                    root.show-hover-preview = false;
                                }
                                pointer-event(ev) => {
                                    if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                        root.open-blank-context-menu(
                                            true,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y
                                        );
                                    }
                                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down && root.right-rows.length == 0 {
                                        root.open-blank-context-menu(
                                            true,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y
                                        );
                                    }
                                }
                                scroll-event(ev) => {
                                    r-flick.viewport-y = Math.clamp(
                                        r-flick.viewport-y + ev.delta-y,
                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                        0px
                                    );
                                    r-flick.viewport-x = Math.clamp(
                                        r-flick.viewport-x + ev.delta-x,
                                        Math.min(0px, r-flick.width - r-flick.viewport-width),
                                        0px
                                    );
                                    return accept;
                                }
                            }

                            // EMPTY DIRECTORY ACTION CARD (Left-Click or Quick-Action Buttons)
                            if root.right-rows.length == 0 : Rectangle {
                                z: 5;
                                width: Math.min(parent.width - 24px, 340px);
                                height: 124px;
                                x: (parent.width - self.width) / 2;
                                y: Math.max(16px, (parent.height - self.height) / 2 - 20px);
                                border-radius: 8px;
                                background: root.theme-bg-sidebar;
                                border-width: 1px;
                                border-color: root.theme-border;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 16px;
                                            kind: "folder";
                                            icon-color: root.theme-text-secondary;
                                        }
                                        Text {
                                            text: root.right-filter-query != ""
                                                ? "No matching items in this folder"
                                                : "Folder is empty — Click to create or paste";
                                            color: root.theme-text-secondary;
                                            font-size: 12px + root.ui-font-size-delta * 1px;
                                            font-family: root.ui-font-family;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        ToolbarButton {
                                            icon-kind: "plus";
                                            label: "New Folder";
                                            clicked => {
                                                root.activate-pane(true);
                                                root.open-new-folder-modal();
                                            }
                                        }

                                        ToolbarButton {
                                            icon-kind: "file";
                                            label: "New File";
                                            clicked => {
                                                root.activate-pane(true);
                                                root.open-new-file-modal();
                                            }
                                        }

                                        if root.has-clipboard-item : ToolbarButton {
                                            icon-kind: "downloads";
                                            label: "Paste Here";
                                            active: true;
                                            clicked => {
                                                root.activate-pane(true);
                                                root.execute-context-action("paste");
                                            }
                                        }
                                    }
                                }
                            }

                            r-flick := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: false;
                                viewport-y <=> root.right-scroll-y;
                                viewport-width: root.right-view-mode == 0
                                    ? Math.max(self.width, 320px + root.size-col-width + root.date-col-width)
                                    : (root.right-view-mode == 2
                                        ? Math.max(self.width, root.miller-col-width * 2 + 280px)
                                        : Math.max(self.width, 360px));
                                viewport-height: Math.min(
                                    9600px,
                                    root.right-view-mode == 0
                                        ? Math.max(self.height, root.right-rows.length * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px)
                                        : (root.right-view-mode == 1
                                            ? Math.max(self.height, root.right-icon-triples.length * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 28px)
                                            : Math.max(self.height, Math.max(root.right-parent-rows.length, root.right-rows.length) * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px))
                                );

                                VerticalLayout {
                                    alignment: start;
                                    if root.right-view-mode == 0 : VerticalLayout {
                                        alignment: start;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        spacing: 1px;
                                        for row[r-idx] in root.right-rows : FileRow {
                                            file_name: row.name;
                                            file_size: row.size-text;
                                            file_date: row.modified-text;
                                            ext_badge: row.ext-badge;
                                            is_dir: row.is-dir;
                                            is_image: row.is-image;
                                            is_executable: row.is-executable;
                                            is_expanded: row.is-expanded;
                                            has_thumbnail: row.has-thumbnail;
                                            thumbnail: row.thumbnail;
                                            selected: row.is-selected;
                                            pane_focused: root.right-pane-active;
                                            depth: row.depth;
                                            has_color_tag: row.has-color-tag;
                                            color_tag_name: row.color-tag-name;
                                            color_tag_brush: row.color-tag-brush;
                                            color_tag_tint: row.color-tag-tint;
                                            size_col_width: root.size-col-width;
                                            date_col_width: root.date-col-width;
                                            font_delta: root.font-size-delta;
                                            font_bold: root.ui-font-bold;
                                            font_family: root.resolved-font-family;
                                            row_bg: root.theme-bg-surface;
                                            row_hover_bg: root.theme-bg-hover;
                                            row_accent_bg: root.theme-accent;
                                            text_primary: root.theme-text-primary;
                                            text_muted: root.theme-text-muted;
                                            drag_drop_highlight: root.drag-hover-right-row == r-idx;
                                            row-clicked(sh, cmd) => {
                                                key-router.focus();
                                                root.show-hover-preview = false;
                                                root.select-file-row-mod(true, r-idx, sh, cmd);
                                            }
                                            row-double-clicked => {
                                                key-router.focus();
                                                root.show-hover-preview = false;
                                                root.open-file-row(true, r-idx);
                                            }
                                            row-context-menu(abs_x, abs_y) => {
                                                root.show-hover-preview = false;
                                                root.open-context-menu-for-row(
                                                    true,
                                                    r-idx,
                                                    abs_x,
                                                    abs_y
                                                );
                                            }
                                            row-hovered(abs_x, abs_y) => {
                                                root.hover-file-row(true, r-idx, abs_x, abs_y);
                                            }
                                            row-shift-drag(my) => {
                                                root.shift-drag-select(true, r-idx + Math.round((my - 13px) / 27px));
                                            }
                                            row-drag-moved(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.drag-right-scroll-y = r-flick.viewport-y;
                                                root.update-drag-cursor(true, r-idx, abs_x, abs_y);
                                            }
                                            row-drag-ended(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.drag-right-scroll-y = r-flick.viewport-y;
                                                root.finish-drag-drop(true, r-idx, abs_x, abs_y);
                                            }
                                            row-drag-to-other-pane => {
                                                root.drag-drop-row-to-other-pane(true, r-idx);
                                            }
                                            toggle-expand => {
                                                root.toggle-expand-folder(true, r-idx);
                                            }
                                            wheel-scroll(dy) => {
                                                root.show-hover-preview = false;
                                                r-flick.viewport-y = Math.clamp(
                                                    r-flick.viewport-y + dy,
                                                    Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                    0px
                                                );
                                            }
                                        }
                                    }

                                    if root.right-view-mode == 1 : VerticalLayout {
                                        alignment: start;
                                        padding: 12px;
                                        spacing: 10px;
                                        for triple in root.right-icon-triples : HorizontalLayout {
                                            spacing: 10px;
                                            if triple.has-0 : PolaroidCell {
                                                item: triple.item-0;
                                                pane-focused: root.right-pane-active;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                drag-drop-highlight: root.drag-hover-right-row == triple.idx-0;
                                                select-cell(sh, cmd) => {
                                                    root.show-hover-preview = false;
                                                    root.select-file-row-mod(true, triple.idx-0, sh, cmd);
                                                }
                                                open-cell => {
                                                    root.show-hover-preview = false;
                                                    root.open-file-row(true, triple.idx-0);
                                                }
                                                context-cell(abs_x, abs_y) => {
                                                    root.show-hover-preview = false;
                                                    root.open-context-menu-for-row(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-hovered(abs_x, abs_y) => {
                                                    root.hover-file-row(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.update-drag-cursor(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.finish-drag-drop(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    root.show-hover-preview = false;
                                                    r-flick.viewport-y = Math.clamp(
                                                        r-flick.viewport-y + dy,
                                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-0 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-1 : PolaroidCell {
                                                item: triple.item-1;
                                                pane-focused: root.right-pane-active;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                drag-drop-highlight: root.drag-hover-right-row == triple.idx-1;
                                                select-cell(sh, cmd) => {
                                                    root.show-hover-preview = false;
                                                    root.select-file-row-mod(true, triple.idx-1, sh, cmd);
                                                }
                                                open-cell => {
                                                    root.show-hover-preview = false;
                                                    root.open-file-row(true, triple.idx-1);
                                                }
                                                context-cell(abs_x, abs_y) => {
                                                    root.show-hover-preview = false;
                                                    root.open-context-menu-for-row(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-hovered(abs_x, abs_y) => {
                                                    root.hover-file-row(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.update-drag-cursor(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.finish-drag-drop(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    root.show-hover-preview = false;
                                                    r-flick.viewport-y = Math.clamp(
                                                        r-flick.viewport-y + dy,
                                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-1 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-2 : PolaroidCell {
                                                item: triple.item-2;
                                                pane-focused: root.right-pane-active;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                drag-drop-highlight: root.drag-hover-right-row == triple.idx-2;
                                                select-cell(sh, cmd) => {
                                                    root.show-hover-preview = false;
                                                    root.select-file-row-mod(true, triple.idx-2, sh, cmd);
                                                }
                                                open-cell => {
                                                    root.show-hover-preview = false;
                                                    root.open-file-row(true, triple.idx-2);
                                                }
                                                context-cell(abs_x, abs_y) => {
                                                    root.show-hover-preview = false;
                                                    root.open-context-menu-for-row(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-hovered(abs_x, abs_y) => {
                                                    root.hover-file-row(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.update-drag-cursor(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.finish-drag-drop(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    root.show-hover-preview = false;
                                                    r-flick.viewport-y = Math.clamp(
                                                        r-flick.viewport-y + dy,
                                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-2 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                        }
                                    }

                                    if root.right-view-mode == 2 : HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            alignment: start;
                                            width: root.miller-col-width;
                                            for p-row[p-idx] in root.right-parent-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                background: p-row.is-selected
                                                    ? root.theme-bg-hover
                                                    : (p-row.has-color-tag ? p-row.color-tag-tint : transparent);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 18px;
                                                        background: transparent;
                                                        if !p-row.is-dir && p-row.has-thumbnail : Image {
                                                            x: 0px;
                                                            y: (parent.height - 18px) / 2;
                                                            width: 18px;
                                                            height: 18px;
                                                            image-fit: contain;
                                                            source: p-row.thumbnail;
                                                        }
                                                        if p-row.is-dir || !p-row.has-thumbnail : LucideIcon {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: p-row.is-dir
                                                                ? "folder"
                                                                : (p-row.is-executable
                                                                    ? "terminal"
                                                                    : (p-row.is-image
                                                                        ? "image"
                                                                        : ((p-row.ext-badge == "ZIP" || p-row.ext-badge == "TAR" || p-row.ext-badge == "GZ" || p-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((p-row.ext-badge == "MP3" || p-row.ext-badge == "FLAC" || p-row.ext-badge == "WAV" || p-row.ext-badge == "M4A" || p-row.ext-badge == "OGG" || p-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((p-row.ext-badge == "MP4" || p-row.ext-badge == "MKV" || p-row.ext-badge == "MOV" || p-row.ext-badge == "AVI" || p-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : "documents")))));
                                                            icon-color: p-row.has-color-tag
                                                                ? p-row.color-tag-brush
                                                                : (p-row.is-dir
                                                                    ? #38B6FF
                                                                    : (p-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (p-row.is-image ? #5AC8FA : #A0A0AB)));
                                                            fill-color: p-row.is-dir
                                                                ? (p-row.has-color-tag ? p-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: p-row.name;
                                                        color: root.theme-text-primary;
                                                        font-size: 12px + root.font-size-delta;
                                                        font-family: root.resolved-font-family;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if p-row.has-color-tag : Rectangle {
                                                        width: 7px;
                                                        height: 7px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3.5px;
                                                        background: p-row.color-tag-brush;
                                                    }
                                                    if p-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: root.theme-text-muted;
                                                    }
                                                }
                                                TouchArea {
                                                    clicked => { root.open-parent-row(true, p-idx); }
                                                    scroll-event(ev) => {
                                                        r-flick.viewport-y = Math.clamp(
                                                            r-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: start;
                                            width: root.miller-col-width + 40px;
                                            for c-row[c-idx] in root.right-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                border-width: root.drag-hover-right-row == c-idx ? 1px : 0px;
                                                border-color: root.drag-hover-right-row == c-idx ? #5AC8FA : transparent;
                                                background: root.drag-hover-right-row == c-idx
                                                    ? #0D52BF55
                                                    : (c-row.is-selected
                                                        ? (root.right-pane-active ? root.theme-accent : #2E323B)
                                                        : (r-col-touch.has-hover
                                                            ? root.theme-bg-hover
                                                            : (c-row.has-color-tag ? c-row.color-tag-tint : transparent)));
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 20px;
                                                        background: transparent;
                                                        if !c-row.is-dir && c-row.has-thumbnail : Rectangle {
                                                            x: 0px;
                                                            y: (parent.height - 20px) / 2;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 3px;
                                                            background: #121215;
                                                            border-width: 1px;
                                                            border-color: c-row.is-selected ? #FFFFFFAA : #32323A;
                                                            clip: true;
                                                            Image {
                                                                x: 1px;
                                                                y: 1px;
                                                                width: 18px;
                                                                height: 18px;
                                                                image-fit: contain;
                                                                source: c-row.thumbnail;
                                                            }
                                                        }
                                                        if c-row.is-dir || !c-row.has-thumbnail : LucideIcon {
                                                            x: 2px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: c-row.is-dir
                                                                ? "folder"
                                                                : (c-row.is-executable
                                                                    ? "terminal"
                                                                    : (c-row.is-image
                                                                        ? "image"
                                                                        : ((c-row.ext-badge == "ZIP" || c-row.ext-badge == "TAR" || c-row.ext-badge == "GZ" || c-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((c-row.ext-badge == "MP3" || c-row.ext-badge == "FLAC" || c-row.ext-badge == "WAV" || c-row.ext-badge == "M4A" || c-row.ext-badge == "OGG" || c-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((c-row.ext-badge == "MP4" || c-row.ext-badge == "MKV" || c-row.ext-badge == "MOV" || c-row.ext-badge == "AVI" || c-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : "documents")))));
                                                            icon-color: c-row.has-color-tag
                                                                ? c-row.color-tag-brush
                                                                : (c-row.is-dir
                                                                    ? #38B6FF
                                                                    : (c-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (c-row.is-image ? #5AC8FA : #A0A0AB)));
                                                            fill-color: c-row.is-dir
                                                                ? (c-row.has-color-tag ? c-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: c-row.name;
                                                        color: c-row.is-selected ? #FFFFFF : root.theme-text-primary;
                                                        font-size: 12.5px + root.font-size-delta;
                                                        font-family: root.resolved-font-family;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if c-row.has-color-tag : Rectangle {
                                                        width: r-col-tag.preferred-width;
                                                        height: 17px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 8.5px;
                                                        background: c-row.is-selected ? #00000044 : c-row.color-tag-tint;
                                                        border-width: 1px;
                                                        border-color: c-row.is-selected ? #FFFFFF88 : c-row.color-tag-brush;
                                                        r-col-tag := HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 6px;
                                                            spacing: 4px;
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 6px;
                                                                height: 6px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 3px;
                                                                background: c-row.color-tag-brush;
                                                            }
                                                            Text {
                                                                text: c-row.color-tag-name;
                                                                color: c-row.is-selected ? #FFFFFF : #F2F2F7;
                                                                font-size: 10px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if c-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: c-row.is-selected ? #FFFFFF : root.theme-text-muted;
                                                    }
                                                }
                                                r-col-touch := TouchArea {
                                                    clicked => {
                                                        root.show-hover-preview = false;
                                                        key-router.focus();
                                                        if !root.col-suppress-click {
                                                            root.select-file-row-mod(
                                                                true,
                                                                c-idx,
                                                                root.col-down-shift,
                                                                root.col-down-cmd
                                                            );
                                                        }
                                                        root.col-suppress-click = false;
                                                        root.col-down-shift = false;
                                                        root.col-down-cmd = false;
                                                    }
                                                    double-clicked => {
                                                        root.show-hover-preview = false;
                                                        root.open-file-row(true, c-idx);
                                                    }
                                                    moved => {
                                                        if self.pressed && !root.col-down-shift && !root.col-down-cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                                                            root.show-hover-preview = false;
                                                            root.col-drag-active = true;
                                                            root.col-suppress-click = true;
                                                            root.drag-left-pane-w = l-flick.width;
                                                            root.drag-left-scroll-y = l-flick.viewport-y;
                                                            root.drag-right-scroll-y = r-flick.viewport-y;
                                                            root.update-drag-cursor(
                                                                true,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    pointer-event(ev) => {
                                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            key-router.focus();
                                                            root.col-down-shift = ev.modifiers.shift;
                                                            root.col-down-cmd = ev.modifiers.control || ev.modifiers.meta;
                                                            root.col-drag-active = false;
                                                            root.col-suppress-click = false;
                                                        }
                                                        if ev.button == PointerEventButton.left && (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                            if root.col-drag-active {
                                                                root.col-drag-active = false;
                                                                root.drag-left-pane-w = l-flick.width;
                                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                                root.drag-right-scroll-y = r-flick.viewport-y;
                                                                root.finish-drag-drop(
                                                                    true,
                                                                    c-idx,
                                                                    self.absolute-position.x + self.mouse-x,
                                                                    self.absolute-position.y + self.mouse-y
                                                                );
                                                            }
                                                            if ev.kind == PointerEventKind.cancel {
                                                                root.col-suppress-click = false;
                                                                root.col-down-shift = false;
                                                                root.col-down-cmd = false;
                                                            }
                                                        }
                                                        if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            root.col-suppress-click = true;
                                                            root.open-context-menu-for-row(
                                                                true,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    scroll-event(ev) => {
                                                        root.show-hover-preview = false;
                                                        r-flick.viewport-y = Math.clamp(
                                                            r-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }

                                        // 3rd Column: Miller Preview & Photo/Music/Video Metadata Column (Right Pane)
                                        if root.inspector-title != "" : Rectangle {
                                            horizontal-stretch: 1;
                                            min-width: 240px;
                                            background: root.theme-bg-sidebar;
                                            border-width: 1px;
                                            border-color: root.theme-border;
                                            border-radius: 6px;
                                            clip: true;

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 8px;
                                                alignment: start;

                                                Rectangle {
                                                    height: root.inspector-has-image ? 164px : (root.inspector-has-text-preview ? 140px : 84px);
                                                    border-radius: 6px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    clip: true;

                                                    if root.inspector-is-dir : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 48px;
                                                        kind: "folder";
                                                        icon-color: #38B6FF;
                                                        fill-color: #4CC2FF;
                                                    }
                                                    if !root.inspector-is-dir && root.inspector-has-image : Image {
                                                        x: 6px;
                                                        y: 6px;
                                                        width: parent.width - 12px;
                                                        height: parent.height - 12px;
                                                        image-fit: contain;
                                                        source: root.inspector-preview-image;
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && root.inspector-has-text-preview : VerticalLayout {
                                                        padding: 8px;
                                                        Text {
                                                            text: root.inspector-preview-text;
                                                            color: root.theme-text-primary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && !root.inspector-has-text-preview : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 44px;
                                                        kind: root.inspector-media-category == "Audio / Music"
                                                            ? "music"
                                                            : (root.inspector-media-category == "Video / Media" ? "video" : "file");
                                                        icon-color: #5AC8FA;
                                                    }
                                                }

                                                Text {
                                                    text: root.inspector-title;
                                                    color: root.theme-text-primary;
                                                    font-size: 13px + root.font-size-delta;
                                                    font-family: root.resolved-font-family;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: root.inspector-subtitle + " • " + root.inspector-size;
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.font-size-delta;
                                                    font-family: root.resolved-font-family;
                                                    font-weight: 500;
                                                }

                                                if root.inspector-media-category != "" : Rectangle {
                                                    border-radius: 5px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    VerticalLayout {
                                                        padding: 8px;
                                                        spacing: 3px;
                                                        Text {
                                                            text: root.inspector-media-category;
                                                            color: #5AC8FA;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: root.resolved-font-family;
                                                            font-weight: 700;
                                                        }
                                                        if root.inspector-media-line1 != "" : Text {
                                                            text: root.inspector-media-line1;
                                                            color: root.theme-text-primary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: "monospace";
                                                        }
                                                        if root.inspector-media-line2 != "" : Text {
                                                            text: root.inspector-media-line2;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: "monospace";
                                                        }
                                                        if root.inspector-media-line3 != "" : Text {
                                                            text: root.inspector-media-line3;
                                                            color: root.theme-text-muted;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: "Modified: " + root.inspector-modified;
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }
                                                Text {
                                                    text: "Permissions: " + root.inspector-perm-symbolic + " (" + root.inspector-perm-octal + ")";
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.right-view-mode == 2 : Rectangle {
                                z: 15;
                                x: root.miller-col-width + r-flick.viewport-x;
                                y: 0px;
                                width: 5px;
                                height: parent.height;
                                background: r-miller-resizer.has-hover || r-miller-resizer.pressed ? root.theme-accent : transparent;
                                Rectangle {
                                    x: 2px;
                                    width: 1px;
                                    height: parent.height;
                                    background: root.theme-border;
                                }
                                r-miller-resizer := TouchArea {
                                    mouse-cursor: col-resize;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                            root.col-resize-start-w = root.miller-col-width;
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.miller-col-width = Math.clamp(
                                                root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                120px,
                                                420px
                                            );
                                        }
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Vertical Scrollbar for Right Pane
                            if r-flick.viewport-height > r-flick.height : Rectangle {
                                z: 25;
                                x: parent.width - 12px;
                                y: 2px;
                                width: 10px;
                                height: parent.height - (r-flick.viewport-width > r-flick.width ? 14px : 4px);
                                border-radius: 5px;
                                background: r-vbar-touch.has-hover || r-vbar-touch.pressed ? #141417DD : #16161888;

                                r-vthumb := Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: (r-vbar-touch.has-hover || r-vbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.width / 2;
                                    background: r-vbar-touch.pressed
                                        ? root.theme-accent
                                        : (r-vbar-touch.has-hover ? #8E8E98 : #52525E);
                                    height: Math.max(28px, parent.height * (r-flick.height / r-flick.viewport-height));
                                    y: (parent.height - self.height) * (-r-flick.viewport-y / Math.max(1px, r-flick.viewport-height - r-flick.height));
                                }

                                r-vbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(true);
                                            r-flick.viewport-y = Math.clamp(
                                                -((self.mouse-y - r-vthumb.height / 2) / Math.max(1px, self.height - r-vthumb.height))
                                                    * (r-flick.viewport-height - r-flick.height),
                                                Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                0px
                                            );
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            r-flick.viewport-y = Math.clamp(
                                                -((self.mouse-y - r-vthumb.height / 2) / Math.max(1px, self.height - r-vthumb.height))
                                                    * (r-flick.viewport-height - r-flick.height),
                                                Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                0px
                                            );
                                        }
                                    }
                                    scroll-event(ev) => {
                                        r-flick.viewport-y = Math.clamp(
                                            r-flick.viewport-y + ev.delta-y,
                                            Math.min(0px, r-flick.height - r-flick.viewport-height),
                                            0px
                                        );
                                        return accept;
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Horizontal Scrollbar for Right Pane
                            if r-flick.viewport-width > r-flick.width : Rectangle {
                                z: 25;
                                x: 2px;
                                y: parent.height - 12px;
                                width: parent.width - (r-flick.viewport-height > r-flick.height ? 14px : 4px);
                                height: 10px;
                                border-radius: 5px;
                                background: r-hbar-touch.has-hover || r-hbar-touch.pressed ? #141417DD : #16161888;

                                r-hthumb := Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: (r-hbar-touch.has-hover || r-hbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.height / 2;
                                    background: r-hbar-touch.pressed
                                        ? root.theme-accent
                                        : (r-hbar-touch.has-hover ? #8E8E98 : #52525E);
                                    width: Math.max(28px, parent.width * (r-flick.width / r-flick.viewport-width));
                                    x: (parent.width - self.width) * (-r-flick.viewport-x / Math.max(1px, r-flick.viewport-width - r-flick.width));
                                }

                                r-hbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(true);
                                            r-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - r-hthumb.width / 2) / Math.max(1px, self.width - r-hthumb.width))
                                                    * (r-flick.viewport-width - r-flick.width),
                                                Math.min(0px, r-flick.width - r-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            r-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - r-hthumb.width / 2) / Math.max(1px, self.width - r-hthumb.width))
                                                    * (r-flick.viewport-width - r-flick.width),
                                                Math.min(0px, r-flick.width - r-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 2D. RIGHT PREVIEW / INSPECTOR PANE (Always visible in Single or Dual-Pane mode when show-inspector is true)
                if root.show-inspector : Rectangle {
                    width: root.inspector-width;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    background: root.theme-bg-sidebar;
                    border-width: 1px;
                    border-color: root.theme-border;

                    // Draggable Inspector Left-Edge Resizer
                    Rectangle {
                        z: 40;
                        x: -2px;
                        y: 0px;
                        width: 5px;
                        height: parent.height;
                        background: insp-resizer.has-hover || insp-resizer.pressed ? root.theme-accent : transparent;
                        insp-resizer := TouchArea {
                            mouse-cursor: col-resize;
                            pointer-event(ev) => {
                                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                    root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                    root.col-resize-start-w = root.inspector-width;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.inspector-width = Math.clamp(
                                        root.col-resize-start-w - ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                        230px,
                                        440px
                                    );
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            SegmentControlButton {
                                label: "Info";
                                btn-width: 96px;
                                accent-bg: root.theme-accent;
                                font-family: root.resolved-font-family;
                                font-delta: root.font-size-delta;
                                active: root.inspector-tab-index == 0;
                                clicked => { root.set-inspector-tab(0); }
                            }
                            SegmentControlButton {
                                label: "Tasks";
                                btn-width: 96px;
                                accent-bg: root.theme-accent;
                                font-family: root.resolved-font-family;
                                font-delta: root.font-size-delta;
                                active: root.inspector-tab-index == 1;
                                clicked => { root.set-inspector-tab(1); }
                            }
                        }

                        if root.inspector-tab-index == 0 : ScrollView {
                            vertical-stretch: 1;
                            viewport-height: 540px;
                            VerticalLayout {
                                spacing: 10px;

                                Rectangle {
                                    height: 136px;
                                    border-radius: 6px;
                                    background: root.theme-bg-canvas;
                                    border-width: 1px;
                                    border-color: root.theme-border;
                                    clip: true;

                                    if root.inspector-is-dir : LucideIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2 - 8px;
                                        icon-size: 56px;
                                        kind: "folder";
                                        icon-color: #38B6FF;
                                        fill-color: #4CC2FF;
                                    }
                                    if !root.inspector-is-dir && root.inspector-has-image : Image {
                                        x: 4px;
                                        y: 4px;
                                        width: parent.width - 8px;
                                        height: parent.height - 28px;
                                        image-fit: contain;
                                        source: root.inspector-preview-image;
                                    }
                                    if !root.inspector-is-dir && !root.inspector-has-image && root.inspector-is-image : LucideIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2 - 8px;
                                        icon-size: 56px;
                                        kind: "image";
                                        icon-color: #5AC8FA;
                                    }
                                    if !root.inspector-is-dir && !root.inspector-is-image && root.inspector-has-text-preview : VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: root.inspector-preview-text;
                                            color: root.theme-text-secondary;
                                            font-size: 10px + root.ui-font-size-delta * 1px;
                                            font-family: "monospace";
                                            wrap: word-wrap;
                                        }
                                    }
                                    if !root.inspector-is-dir && !root.inspector-is-image && !root.inspector-has-text-preview : LucideIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2 - 8px;
                                        icon-size: 52px;
                                        kind: root.inspector-media-category == "Audio / Music"
                                            ? "music"
                                            : (root.inspector-media-category == "Video / Media" ? "video" : "file");
                                        icon-color: #5AC8FA;
                                    }

                                    // Bottom bar inside preview box to open Preview Minion (Quick Look HUD)
                                    Rectangle {
                                        x: 0px;
                                        y: parent.height - 24px;
                                        width: parent.width;
                                        height: 24px;
                                        background: preview-btn-touch.has-hover ? root.theme-accent : #1A1A1EDD;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            alignment: center;
                                            LucideIcon {
                                                y: (parent.height - self.height) / 2;
                                                icon-size: 12px;
                                                kind: "eye";
                                                icon-color: #FFFFFF;
                                            }
                                            Text {
                                                text: root.inspector-image-dimensions != ""
                                                    ? ("Preview Minion (" + root.inspector-image-dimensions + ")")
                                                    : "Open Preview Minion (Space)";
                                                color: #FFFFFF;
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        preview-btn-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-preview-minion(); }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: root.inspector-title;
                                        color: root.theme-text-primary;
                                        font-size: 13px + root.ui-font-size-delta * 1px;
                                        font-family: root.ui-font-family;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.inspector-subtitle;
                                        color: root.theme-text-secondary;
                                        font-size: 11px + root.ui-font-size-delta * 1px;
                                        font-family: root.ui-font-family;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: space-between;
                                    Text {
                                        text: "Tag";
                                        color: root.theme-text-secondary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 5px;
                                        ColorSwatchDot {
                                            is-none: true;
                                            selected: root.inspector-color-index == 0;
                                            clicked => { root.set-selected-color-label(0); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #8E8E93;
                                            selected: root.inspector-color-index == 1;
                                            clicked => { root.set-selected-color-label(1); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #5AC85A;
                                            selected: root.inspector-color-index == 2;
                                            clicked => { root.set-selected-color-label(2); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #AF52DE;
                                            selected: root.inspector-color-index == 3;
                                            clicked => { root.set-selected-color-label(3); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #0A84FF;
                                            selected: root.inspector-color-index == 4;
                                            clicked => { root.set-selected-color-label(4); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #FFD60A;
                                            selected: root.inspector-color-index == 5;
                                            clicked => { root.set-selected-color-label(5); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #FF453A;
                                            selected: root.inspector-color-index == 6;
                                            clicked => { root.set-selected-color-label(6); }
                                        }
                                        ColorSwatchDot {
                                            swatch-color: #FF9F0A;
                                            selected: root.inspector-color-index == 7;
                                            clicked => { root.set-selected-color-label(7); }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: root.theme-border; }

                                Text {
                                    text: "General";
                                    color: root.theme-text-primary;
                                    font-size: 12px + root.ui-font-size-delta * 1px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Size"; color: root.theme-text-secondary; font-size: 11.5px + root.ui-font-size-delta * 1px; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.inspector-size; color: root.theme-text-primary; font-size: 11.5px + root.ui-font-size-delta * 1px; font-family: "monospace"; }
                                        if root.inspector-is-dir : ToolbarButton {
                                            label: "Calc";
                                            clicked => { root.calculate-selected-dir-size(); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Modified"; color: root.theme-text-secondary; font-size: 11.5px + root.ui-font-size-delta * 1px; }
                                    Text { text: root.inspector-modified; color: root.theme-text-primary; font-size: 11.5px + root.ui-font-size-delta * 1px; font-family: "monospace"; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Created"; color: root.theme-text-secondary; font-size: 11.5px + root.ui-font-size-delta * 1px; }
                                    Text { text: root.inspector-created; color: root.theme-text-primary; font-size: 11.5px + root.ui-font-size-delta * 1px; font-family: "monospace"; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Extension"; color: root.theme-text-secondary; font-size: 11.5px + root.ui-font-size-delta * 1px; }
                                    Text { text: root.inspector-extension; color: root.theme-text-primary; font-size: 11.5px + root.ui-font-size-delta * 1px; font-family: "monospace"; }
                                }

                                if root.inspector-media-category != "" : Rectangle {
                                    height: 1px;
                                    background: root.theme-border;
                                }

                                if root.inspector-media-category != "" : VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: root.inspector-media-category;
                                        color: #5AC8FA;
                                        font-size: 12px + root.ui-font-size-delta * 1px;
                                        font-weight: 700;
                                    }
                                    if root.inspector-media-line1 != "" : Text {
                                        text: root.inspector-media-line1;
                                        color: root.theme-text-primary;
                                        font-size: 11px + root.ui-font-size-delta * 1px;
                                        font-family: "monospace";
                                    }
                                    if root.inspector-media-line2 != "" : Text {
                                        text: root.inspector-media-line2;
                                        color: root.theme-text-secondary;
                                        font-size: 11px + root.ui-font-size-delta * 1px;
                                        font-family: "monospace";
                                    }
                                    if root.inspector-media-line3 != "" : Text {
                                        text: root.inspector-media-line3;
                                        color: root.theme-text-muted;
                                        font-size: 10.5px + root.ui-font-size-delta * 1px;
                                        font-family: "monospace";
                                    }
                                }

                                Rectangle { height: 1px; background: root.theme-border; }

                                Text {
                                    text: "Permissions";
                                    color: root.theme-text-primary;
                                    font-size: 12px + root.ui-font-size-delta * 1px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { width: 110px; text: ""; }
                                    Text { width: 22px; text: "R"; color: root.theme-text-secondary; font-size: 9px; horizontal-alignment: center; }
                                    Text { width: 22px; text: "W"; color: root.theme-text-secondary; font-size: 9px; horizontal-alignment: center; }
                                    Text { width: 22px; text: "X"; color: root.theme-text-secondary; font-size: 9px; horizontal-alignment: center; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { width: 110px; text: "Owner"; color: root.theme-text-secondary; font-size: 10px; vertical-alignment: center; }
                                    PermCheckbox { checked: root.perm-ur; toggled => { root.toggle-permission-bit(0, 0); } }
                                    PermCheckbox { checked: root.perm-uw; toggled => { root.toggle-permission-bit(0, 1); } }
                                    PermCheckbox { checked: root.perm-ux; toggled => { root.toggle-permission-bit(0, 2); } }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { width: 110px; text: "Group"; color: root.theme-text-secondary; font-size: 10px; vertical-alignment: center; }
                                    PermCheckbox { checked: root.perm-gr; toggled => { root.toggle-permission-bit(1, 0); } }
                                    PermCheckbox { checked: root.perm-gw; toggled => { root.toggle-permission-bit(1, 1); } }
                                    PermCheckbox { checked: root.perm-gx; toggled => { root.toggle-permission-bit(1, 2); } }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { width: 110px; text: "Others"; color: root.theme-text-secondary; font-size: 10px; vertical-alignment: center; }
                                    PermCheckbox { checked: root.perm-or; toggled => { root.toggle-permission-bit(2, 0); } }
                                    PermCheckbox { checked: root.perm-ow; toggled => { root.toggle-permission-bit(2, 1); } }
                                    PermCheckbox { checked: root.perm-ox; toggled => { root.toggle-permission-bit(2, 2); } }
                                }
                                Rectangle { height: 1px; background: root.theme-border; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Octal"; color: root.theme-text-secondary; font-size: 10px; vertical-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: root.inspector-perm-symbolic;
                                            color: root.theme-text-primary;
                                            font-size: 10px;
                                            font-family: "monospace";
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 32px;
                                            height: 18px;
                                            border-radius: 3px;
                                            background: root.theme-bg-surface;
                                            border-width: 1px;
                                            border-color: root.theme-border;
                                            Text {
                                                text: root.inspector-perm-octal;
                                                color: #FFFFFF;
                                                font-size: 10px;
                                                font-family: "monospace";
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: root.theme-border; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Owner"; color: root.theme-text-secondary; font-size: 10px; }
                                    Text { text: root.inspector-owner; color: root.theme-text-primary; font-size: 10px; }
                                }
                                Rectangle { height: 1px; background: root.theme-border; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Group"; color: root.theme-text-secondary; font-size: 10px; }
                                    Text { text: root.inspector-group; color: root.theme-text-primary; font-size: 10px; }
                                }
                                Rectangle { height: 1px; background: root.theme-border; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Locked"; color: root.theme-text-secondary; font-size: 10px; vertical-alignment: center; }
                                    PermCheckbox {
                                        checked: root.inspector-locked;
                                        toggled => { root.toggle-locked(); }
                                    }
                                }
                            }
                        }

                        if root.inspector-tab-index == 1 : ScrollView {
                            vertical-stretch: 1;
                            viewport-height: Math.max(self.height, root.transfer-rows.length * 76px + 38px);
                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Tasks & Transfers";
                                        color: root.theme-text-primary;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    if root.transfer-rows.length > 0 : ToolbarButton {
                                        label: "Clear";
                                        clicked => { root.clear-completed-tasks(); }
                                    }
                                }
                                if root.transfer-rows.length == 0 : Text {
                                    text: "No active or recent tasks.";
                                    color: root.theme-text-secondary;
                                    font-size: 11px;
                                }
                                for tr in root.transfer-rows : Rectangle {
                                    height: 68px;
                                    border-radius: 6px;
                                    background: root.theme-bg-surface;
                                    border-width: 1px;
                                    border-color: tr.progress-pct < 100 ? root.theme-accent : root.theme-border;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                LucideIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    icon-size: 13px;
                                                    kind: tr.progress-pct < 100
                                                        ? ("refresh-" + root.spinner-frame)
                                                        : "check";
                                                    icon-color: tr.progress-pct < 100 ? #5AC8FA : #30D158;
                                                }
                                                Text {
                                                    text: tr.source-name;
                                                    color: #FFFFFF;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                            }
                                            Text {
                                                text: tr.progress-pct + "%";
                                                color: tr.progress-pct < 100 ? #5AC8FA : #30D158;
                                                font-size: 10px;
                                                font-family: "monospace";
                                                font-weight: 700;
                                            }
                                        }
                                        Text { text: tr.dest-path; color: root.theme-text-secondary; font-size: 10px; overflow: elide; }
                                        Rectangle {
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: root.theme-bg-canvas;
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                height: 5px;
                                                border-radius: 2.5px;
                                                width: parent.width * (Math.clamp(tr.progress-pct, 0, 100) / 100.0);
                                                background: tr.progress-pct < 100 ? root.theme-accent : #30D158;
                                            }
                                        }
                                        Text {
                                            text: tr.status-text;
                                            color: tr.progress-pct < 100 ? #5AC8FA : #30D158;
                                            font-size: 10.5px + root.ui-font-size-delta * 1px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 3. EMBEDDED BOTTOM TERMINAL DRAWER (Interactive PTY Shell, automatically follows active folder / tab)
            if root.show-terminal-drawer : Rectangle {
                height: root.terminal-drawer-height;
                vertical-stretch: 0;
                background: root.theme-bg-sidebar;
                border-width: 1px;
                border-color: root.theme-border;

                // Top 5px Height Resize Handle
                Rectangle {
                    z: 30;
                    x: 0px;
                    y: -2px;
                    width: parent.width;
                    height: 5px;
                    background: term-resizer.has-hover || term-resizer.pressed ? root.theme-accent : transparent;
                    term-resizer := TouchArea {
                        mouse-cursor: row-resize;
                        pointer-event(ev) => {
                            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                root.col-resize-start-x = self.absolute-position.y + self.mouse-y;
                                root.col-resize-start-w = root.terminal-drawer-height;
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.terminal-drawer-height = Math.clamp(
                                    root.col-resize-start-w - ((self.absolute-position.y + self.mouse-y) - root.col-resize-start-x),
                                    130px,
                                    Math.max(220px, root.height - 200px)
                                );
                            }
                        }
                    }
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Terminal Header Bar (32px)
                    Rectangle {
                        height: 32px;
                        background: root.theme-bg-toolbar;
                        border-width: 1px;
                        border-color: root.theme-border;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 14px;
                                    kind: "terminal";
                                    icon-color: #30D158;
                                }
                                Text {
                                    text: root.terminal-session-label;
                                    color: root.theme-text-primary;
                                    font-size: 12.5px + root.ui-font-size-delta * 1px;
                                    font-family: root.ui-font-family;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: root.theme-bg-surface;
                                    border-width: 1px;
                                    border-color: root.theme-border;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 11px;
                                            kind: "folder";
                                            icon-color: #5AC8FA;
                                        }
                                        Text {
                                            text: root.terminal-cwd;
                                            color: #5AC8FA;
                                            font-size: 11.5px + root.ui-font-size-delta * 1px;
                                            font-family: "monospace";
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: "• Interactive Shell (Up/Down History • Ctrl+C / Esc)";
                                    color: root.theme-text-secondary;
                                    font-size: 11px + root.ui-font-size-delta * 0.5px;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;
                                ToolbarButton {
                                    label: "Clear";
                                    tooltip: "Clear terminal output";
                                    tooltip-above: true;
                                    clicked => { root.clear-terminal(); }
                                }
                                ToolbarButton {
                                    icon-kind: "close";
                                    tooltip: "Hide Bottom Terminal (Esc)";
                                    tooltip-align-right: true;
                                    tooltip-above: true;
                                    clicked => {
                                        root.show-terminal-drawer = false;
                                        key-router.focus();
                                    }
                                }
                            }
                        }
                    }

                    // Terminal Scrollable Output Viewport
                    Rectangle {
                        vertical-stretch: 1;
                        background: #0E0E11;
                        clip: true;

                        term-scroll := ScrollView {
                            width: parent.width;
                            height: parent.height;
                            viewport-height: Math.max(self.height, term-out-text.preferred-height + 16px);
                            VerticalLayout {
                                padding: 8px;
                                alignment: start;
                                term-out-text := Text {
                                    text: root.terminal-output;
                                    color: #D4D4DC;
                                    font-size: 13px + root.ui-font-size-delta * 1px;
                                    font-family: "monospace";
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Terminal Interactive Shell Prompt Bar (34px)
                    Rectangle {
                        height: 34px;
                        background: #141418;
                        border-width: 1px;
                        border-color: root.theme-border;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            Text {
                                text: root.terminal-prompt;
                                color: #30D158;
                                font-size: 13px + root.ui-font-size-delta * 1px;
                                font-family: "monospace";
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: #1C1C22;
                                border-width: 1px;
                                border-color: term-cmd-input.has-focus ? root.theme-accent : #2C2C34;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    term-cmd-input := TextInput {
                                        text <=> root.terminal-command-input;
                                        color: #FFFFFF;
                                        font-size: 13px + root.ui-font-size-delta * 1px;
                                        font-family: "monospace";
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => {
                                            root.run-terminal-command(root.terminal-command-input);
                                            root.terminal-command-input = "";
                                        }
                                        key-pressed(ev) => {
                                            if ev.text == "\u{001b}" {
                                                if !root.terminal-key-event("escape", false) {
                                                    root.show-terminal-drawer = false;
                                                    key-router.focus();
                                                }
                                                return accept;
                                            }
                                            if ev.modifiers.control && (ev.text == "c" || ev.text == "C" || ev.text == "\u{0003}") {
                                                root.terminal-key-event("ctrl_c", true);
                                                return accept;
                                            }
                                            if ev.text == "\u{f700}" {
                                                root.terminal-key-event("up", false);
                                                return accept;
                                            }
                                            if ev.text == "\u{f701}" {
                                                root.terminal-key-event("down", false);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                                if root.terminal-command-input == "" && !term-cmd-input.has-focus : Text {
                                    x: 8px;
                                    y: 0px;
                                    height: parent.height;
                                    text: "Interactive shell prompt (e.g. ls -la, git status, top, cd ..) — Press Enter…";
                                    color: #6E6E77;
                                    font-size: 12px + root.ui-font-size-delta * 1px;
                                    font-family: "monospace";
                                    vertical-alignment: center;
                                }
                            }

                            ToolbarButton {
                                label: "Ctrl+C";
                                tooltip: "Send SIGINT (Interrupt Running Command)";
                                tooltip-align-right: true;
                                tooltip-above: true;
                                clicked => {
                                    root.terminal-key-event("ctrl_c", true);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 2 (z: 20): SIBLING DIRECTORIES DROPDOWN POPOVER (100% Opaque #202024, border #323238)
    if root.show-sibling-dropdown : Rectangle {
        z: 20;
        width: 100%;
        height: 100%;
        background: #00000033;

        TouchArea {
            clicked => { root.show-sibling-dropdown = false; }
        }

        // Software-renderer drop shadow layer
        Rectangle {
            x: Math.min(root.sibling-dropdown-x, root.width - 230px) - 2px;
            y: root.sibling-dropdown-y + 4px;
            width: 219px;
            height: Math.min(280px, Math.max(36px, root.sibling-dropdown-items.length * 28px + 12px)) + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: Math.min(root.sibling-dropdown-x, root.width - 230px);
            y: root.sibling-dropdown-y;
            width: 215px;
            height: Math.min(280px, Math.max(36px, root.sibling-dropdown-items.length * 28px + 12px));
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            TouchArea {}

            ScrollView {
                viewport-height: root.sibling-dropdown-items.length * 28px + 12px;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for sib in root.sibling-dropdown-items : ContextMenuItem {
                        icon-kind: "folder";
                        label: sib.label;
                        triggered => {
                            root.show-sibling-dropdown = false;
                            root.navigate-to-breadcrumb(root.sibling-dropdown-is-right, sib.target-path);
                        }
                    }
                }
            }
        }
    }

    // LAYER 3 (z: 1000): FLOATING RIGHT-CLICK CONTEXT MENU (doc/specification_2.md §2.1 & §4.1:
    // - 100% opaque #202024 surface (opacity: 1.0) on both container and items
    // - 1px solid #323238 border, 8px border-radius
    // - Multi-layer software-renderer shadow + native drop-shadow (offset-y: 10px, blur: 24px, #00000073)
    // - Subtle backdrop scrim (#00000055) so underlying table text never visually merges with menu labels
    // - Crisp 16x16px Lucide vector SVG icons)
    if root.show-context-menu : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: #00000055;

        TouchArea {
            clicked => { root.show-context-menu = false; }
        }

        // Outer ambient drop shadow (ensures visible elevation even in software renderer)
        Rectangle {
            x: Math.clamp(root.context-menu-x, 8px, root.width - 270px) - 4px;
            y: Math.clamp(root.context-menu-y, 8px, root.height - 545px) + 6px;
            width: 264px;
            height: root.has-clipboard-item ? 554px : 526px;
            border-radius: 12px;
            background: #00000055;
        }

        // Inner crisp drop shadow
        Rectangle {
            x: Math.clamp(root.context-menu-x, 8px, root.width - 270px) - 2px;
            y: Math.clamp(root.context-menu-y, 8px, root.height - 545px) + 3px;
            width: 260px;
            height: root.has-clipboard-item ? 550px : 522px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: Math.clamp(root.context-menu-x, 8px, root.width - 270px);
            y: Math.clamp(root.context-menu-y, 8px, root.height - 545px);
            width: 256px;
            height: root.has-clipboard-item ? 546px : 518px;
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                ContextMenuItem {
                    icon-kind: "external";
                    label: "Open";
                    shortcut-hint: "Enter";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("open");
                    }
                }
                ContextMenuItem {
                    icon-kind: "plus";
                    label: "Open in New Tab";
                    shortcut-hint: "Ctrl+T";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("open_new_tab");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "trash";
                    label: "Move to Bin";
                    shortcut-hint: "Del";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("trash");
                    }
                }
                ContextMenuItem {
                    icon-kind: "close";
                    label: "Permanent Delete";
                    shortcut-hint: "Shift+Del";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("delete_permanent");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "info";
                    label: "Get Info";
                    shortcut-hint: "Ctrl+I";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("get_info");
                    }
                }
                ContextMenuItem {
                    icon-kind: "edit";
                    label: "Rename";
                    shortcut-hint: "F2";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("rename");
                    }
                }
                ContextMenuItem {
                    icon-kind: "folder";
                    label: "New Folder";
                    shortcut-hint: "Ctrl+N";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("new_folder");
                    }
                }
                ContextMenuItem {
                    icon-kind: "file";
                    label: "New File";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("new_file");
                    }
                }
                ContextMenuItem {
                    icon-kind: "star";
                    label: "Add to Favorites";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("add_favorite");
                    }
                }
                ContextMenuItem {
                    icon-kind: "archive";
                    label: "Compress \"" + root.context-target-name + "\"";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("compress");
                    }
                }
                ContextMenuItem {
                    icon-kind: "copy";
                    label: "Duplicate";
                    shortcut-hint: "Ctrl+D";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("duplicate");
                    }
                }
                ContextMenuItem {
                    icon-kind: "link";
                    label: "Create Symlink";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("make_alias");
                    }
                }
                ContextMenuItem {
                    icon-kind: "terminal";
                    label: "Open in Bottom Terminal";
                    triggered => {
                        root.show-context-menu = false;
                        root.open-terminal-here();
                    }
                }
                ContextMenuItem {
                    icon-kind: "external";
                    label: "Open in OS File Manager";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("reveal_in_finder");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "scissors";
                    label: "Cut \"" + root.context-target-name + "\"";
                    shortcut-hint: "Ctrl+X";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("cut");
                    }
                }
                ContextMenuItem {
                    icon-kind: "copy";
                    label: "Copy \"" + root.context-target-name + "\"";
                    shortcut-hint: "Ctrl+C";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("copy");
                    }
                }
                if root.has-clipboard-item : ContextMenuItem {
                    icon-kind: "downloads";
                    label: "Paste Item Here";
                    shortcut-hint: "Ctrl+V";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("paste");
                    }
                }
                ContextMenuItem {
                    icon-kind: "link";
                    label: "Copy Path";
                    shortcut-hint: "Ctrl+Shift+C";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("copy_path");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    height: 24px;
                    alignment: space-between;
                    Text {
                        text: "Tag:";
                        color: #A0A0AB;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        ColorSwatchDot {
                            swatch-color: #FF453A;
                            selected: root.inspector-color-index == 6;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(6);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #FF9F0A;
                            selected: root.inspector-color-index == 7;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(7);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #FFD60A;
                            selected: root.inspector-color-index == 5;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(5);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #5AC85A;
                            selected: root.inspector-color-index == 2;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(2);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #0A84FF;
                            selected: root.inspector-color-index == 4;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(4);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #AF52DE;
                            selected: root.inspector-color-index == 3;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(3);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #8E8E93;
                            selected: root.inspector-color-index == 1;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(1);
                            }
                        }
                        ColorSwatchDot {
                            is-none: true;
                            selected: root.inspector-color-index == 0;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(0);
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.2 (z: 1600): SIDEBAR OBJECT RIGHT-CLICK CONTEXT MENU (Devices, Connections, Favorites)
    if root.show-sidebar-context-menu : Rectangle {
        z: 1600;
        width: 100%;
        height: 100%;
        background: #00000055;

        TouchArea {
            clicked => { root.show-sidebar-context-menu = false; }
        }

        // Outer ambient shadow layer
        Rectangle {
            x: Math.min(root.sidebar-context-x, root.width - 266px) - 2px;
            y: Math.min(root.sidebar-context-y, root.height - 432px) + 5px;
            width: 260px;
            height: root.sidebar-context-section == "Favorites" ? 424px : 368px;
            border-radius: 10px;
            background: #00000073;
        }

        // Solid opaque Dark Zinc surface (#202024, border #323238)
        Rectangle {
            x: Math.min(root.sidebar-context-x, root.width - 266px);
            y: Math.min(root.sidebar-context-y, root.height - 432px);
            width: 256px;
            height: root.sidebar-context-section == "Favorites" ? 420px : 364px;
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            TouchArea {}

            VerticalLayout {
                padding: 5px;
                spacing: 2px;

                // Header badge showing selected Device / Connection / Favorite
                Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: #161618;
                    border-width: 1px;
                    border-color: #28282D;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 14px;
                            kind: root.sidebar-context-icon;
                            icon-color: #5AC8FA;
                        }
                        Text {
                            text: root.sidebar-context-label;
                            color: #FFFFFF;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.sidebar-context-section;
                            color: #888892;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                ContextMenuItem {
                    icon-kind: "folder";
                    label: "Open";
                    shortcut-hint: "Enter";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("open");
                    }
                }
                ContextMenuItem {
                    icon-kind: "plus";
                    label: "Open in New Tab";
                    shortcut-hint: "Cmd+T";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("open_new_tab");
                    }
                }
                ContextMenuItem {
                    icon-kind: "columns";
                    label: "Open in Dual Pane";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("open_other_pane");
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                ContextMenuItem {
                    icon-kind: "edit";
                    label: root.sidebar-context-section == "Connections"
                        ? "Edit Connection…"
                        : "Edit Label / Information…";
                    shortcut-hint: "Cmd+E";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("edit");
                    }
                }
                ContextMenuItem {
                    icon-kind: "info";
                    label: "Get Info / Volume Details";
                    shortcut-hint: "Cmd+I";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("get_info");
                    }
                }
                ContextMenuItem {
                    icon-kind: "terminal";
                    label: root.sidebar-context-section == "Connections"
                        ? "Open SSH Terminal"
                        : "Open Terminal Here";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("terminal");
                    }
                }
                ContextMenuItem {
                    icon-kind: "refresh";
                    label: root.sidebar-context-section == "Connections"
                        ? "Reconnect Server"
                        : "Refresh Volume";
                    shortcut-hint: "Cmd+R";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("refresh");
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                ContextMenuItem {
                    icon-kind: "copy";
                    label: "Copy Path / URI";
                    shortcut-hint: "Cmd+Opt+C";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("copy_path");
                    }
                }
                if root.sidebar-context-section == "Favorites" : ContextMenuItem {
                    icon-kind: "chevron-up";
                    label: "Move Up in Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("move_fav_up");
                    }
                }
                if root.sidebar-context-section == "Favorites" : ContextMenuItem {
                    icon-kind: "chevron-down";
                    label: "Move Down in Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("move_fav_down");
                    }
                }
                ContextMenuItem {
                    icon-kind: root.sidebar-context-section == "Connections" ? "copy" : "star";
                    label: root.sidebar-context-section == "Connections"
                        ? "Duplicate Connection"
                        : "Add to Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action(
                            root.sidebar-context-section == "Connections"
                                ? "duplicate_connection"
                                : "add_favorite"
                        );
                    }
                }
                ContextMenuItem {
                    icon-kind: "eject";
                    label: root.sidebar-context-section == "Connections"
                        ? "Disconnect / Remove"
                        : (root.sidebar-context-section == "Favorites"
                            ? "Remove from Favorites"
                            : "Eject / Unmount Volume");
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("eject");
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                // 8-Color Swatch Tag Row for Devices, Connections & Favorites
                HorizontalLayout {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 9px;
                    alignment: center;
                    ColorSwatchDot {
                        swatch-color: #FF453A;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(6);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #FF9F0A;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(7);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #FFD60A;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(5);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #30D158;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(2);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #0A84FF;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(4);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #BF5AF2;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(3);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #8E8E93;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(1);
                        }
                    }
                    ColorSwatchDot {
                        is-none: true;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(0);
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): NEW FOLDER / RENAME INPUT MODAL
    if root.show-input-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {}

        Rectangle {
            width: 380px;
            height: 156px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;
                Text {
                    text: root.input-modal-title;
                    color: #FFFFFF;
                    font-size: 14px;
                    font-weight: 700;
                }
                CleanLineEdit {
                    text <=> root.input-modal-value;
                    font-size: 13px + root.font-size-delta;
                    accepted(val) => {
                        root.show-input-modal = false;
                        key-router.focus();
                        root.confirm-input-modal(val);
                    }
                    escape-pressed => {
                        root.show-input-modal = false;
                        key-router.focus();
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    ToolbarButton {
                        label: "Cancel";
                        clicked => { root.show-input-modal = false; }
                    }
                    ToolbarButton {
                        label: "Confirm";
                        active: true;
                        clicked => {
                            root.show-input-modal = false;
                            root.confirm-input-modal(root.input-modal-value);
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): DYNAMIC CONNECTION / INSPECTOR MODAL (Protocol-Specific Fields & Placeholders)
    if root.show-connect-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {}

        Rectangle {
            width: 530px;
            height: root.connect-show-advanced
                ? (root.connect-protocol == "SFTP" || root.connect-protocol == "SMB" ? 530px : 565px)
                : (root.connect-protocol == "SFTP" && root.connect-auth-method == "private_key" ? 450px : 415px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;

            VerticalLayout {
                padding: 18px;
                spacing: 8px;

                // Top Header Bar with Colored Padlock/Globe Icon + Connection Title
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 5px;
                        background: #28282D;
                        LucideIcon {
                            x: 3px;
                            y: 3px;
                            icon-size: 16px;
                            kind: root.connect-protocol == "SFTP" ? "lock" : "globe";
                            icon-color: root.connect-color-index == 1
                                ? #8E8E93
                                : (root.connect-color-index == 2
                                    ? #30D158
                                    : (root.connect-color-index == 3
                                        ? #BF5AF2
                                        : (root.connect-color-index == 4
                                            ? #0A84FF
                                            : (root.connect-color-index == 5
                                                ? #FFD60A
                                                : (root.connect-color-index == 6
                                                    ? #FF453A
                                                    : (root.connect-color-index == 7 ? #FF9F0A : #5AC8FA))))));
                        }
                    }
                    Text {
                        text: root.connect-name != ""
                            ? root.connect-name
                            : (root.connect-protocol == "S3" && root.connect-s3-bucket != ""
                                ? root.connect-s3-bucket
                                : (root.connect-server != ""
                                    ? root.connect-server
                                    : (root.connect-editing-id != ""
                                        ? ("Edit " + root.connect-protocol + " Connection")
                                        : ("New " + root.connect-protocol + " Connection"))));
                        color: #FFFFFF;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if root.connect-editing-id != "" : Rectangle {
                        height: 18px;
                        width: 54px;
                        border-radius: 4px;
                        background: #0D52BF33;
                        border-width: 1px;
                        border-color: #0D52BF;
                        Text {
                            text: "Editing";
                            color: #5AC8FA;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 105px; text: "Display Name:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                    CleanLineEdit {
                        horizontal-stretch: 1;
                        text <=> root.connect-name;
                        escape-pressed => {
                            root.close-connect-dialog();
                            key-router.focus();
                        }
                        placeholder-text: root.connect-protocol == "S3"
                            ? "e.g. AWS Production Bucket (optional)"
                            : (root.connect-protocol == "SMB"
                                ? "e.g. Office NAS Share (optional)"
                                : (root.connect-protocol == "WebDAV"
                                    ? "e.g. Nextcloud Server (optional)"
                                    : "e.g. Production Server (optional)"));
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 105px; text: "Protocol:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                    HorizontalLayout {
                        spacing: 4px;
                        for proto in ["SFTP", "S3", "SMB", "FTP", "WebDAV"] : SegmentControlButton {
                            label: proto;
                            btn-width: 68px;
                            active: root.connect-protocol == proto;
                            clicked => { root.select-connect-protocol(proto); }
                        }
                    }
                }

                // 1. SFTP / FTP / WebDAV Primary Fields
                if root.connect-protocol == "SFTP" || root.connect-protocol == "FTP" || root.connect-protocol == "WebDAV" : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Server:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-server;
                            placeholder-text: root.connect-protocol == "FTP"
                                ? "ftp.example.com"
                                : (root.connect-protocol == "WebDAV"
                                    ? "cloud.example.com"
                                    : "sftp.example.com or 192.168.1.10");
                        }
                        Text { text: "Port:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 64px;
                            text <=> root.connect-port;
                            placeholder-text: root.connect-protocol == "FTP"
                                ? "21"
                                : (root.connect-protocol == "WebDAV" ? "443" : "22");
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Username:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-username;
                            placeholder-text: root.connect-protocol == "FTP"
                                ? "anonymous or ftpuser"
                                : (root.connect-protocol == "WebDAV" ? "dav-user" : "root or ubuntu");
                        }
                    }
                    if root.connect-protocol != "SFTP" || root.connect-auth-method == "password" : HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Password:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            input-type: InputType.password;
                            text <=> root.connect-password;
                            placeholder-text: root.connect-protocol == "WebDAV"
                                ? "App password or token"
                                : "••••••••";
                        }
                        if root.connect-protocol == "SFTP" : ToolbarButton {
                            icon-kind: "key";
                            tooltip: "Switch to SSH Private Key";
                            tooltip-align-right: true;
                            tooltip-above: true;
                            active: false;
                            clicked => { root.connect-auth-method = "private_key"; }
                        }
                    }
                    if root.connect-protocol == "SFTP" && root.connect-auth-method == "private_key" : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 105px; text: "Private Key:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                            CleanLineEdit {
                                horizontal-stretch: 1;
                                text <=> root.connect-key-path;
                                placeholder-text: "~/.ssh/id_ed25519";
                            }
                            ToolbarButton {
                                icon-kind: "key";
                                tooltip: "Switch to SSH Password";
                                tooltip-align-right: true;
                                tooltip-above: true;
                                active: true;
                                clicked => { root.connect-auth-method = "password"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 105px; text: "Passphrase:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                            CleanLineEdit {
                                horizontal-stretch: 1;
                                input-type: InputType.password;
                                text <=> root.connect-passphrase;
                                placeholder-text: "Optional key passphrase";
                            }
                        }
                    }
                }

                // 2. S3 / S3-Compatible Object Storage Primary Fields
                if root.connect-protocol == "S3" : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Endpoint URL:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-s3-endpoint;
                            placeholder-text: "https://s3.amazonaws.com or https://minio.example.com";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Bucket:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-s3-bucket;
                            placeholder-text: "my-production-bucket";
                        }
                        Text { text: "Region:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 96px;
                            text <=> root.connect-s3-region;
                            placeholder-text: "us-east-1";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Access Key:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-s3-access-key;
                            placeholder-text: "AKIAIOSFODNN7EXAMPLE";
                        }
                        Text { text: "Secret:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 118px;
                            input-type: InputType.password;
                            text <=> root.connect-s3-secret-key;
                            placeholder-text: "••••••••";
                        }
                    }
                }

                // 3. SMB / CIFS Network Share Primary Fields
                if root.connect-protocol == "SMB" : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Server:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-server;
                            placeholder-text: "nas.local or 192.168.1.50";
                        }
                        Text { text: "Share:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 116px;
                            text <=> root.connect-smb-share;
                            placeholder-text: "SharedDocs";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Username:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-username;
                            placeholder-text: "smbuser";
                        }
                        Text { text: "Domain:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 96px;
                            text <=> root.connect-smb-domain;
                            placeholder-text: "WORKGROUP";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Password:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            input-type: InputType.password;
                            text <=> root.connect-password;
                            placeholder-text: "••••••••";
                        }
                    }
                }

                // Remote Path / Prefix / DAV Endpoint (Protocol-Aware Label & Placeholder)
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 105px;
                        text: root.connect-protocol == "S3"
                            ? "Key Prefix:"
                            : (root.connect-protocol == "WebDAV"
                                ? "DAV Path:"
                                : (root.connect-protocol == "SMB" ? "Subfolder:" : "Remote Path:"));
                        color: #A0A0AB;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    CleanLineEdit {
                        horizontal-stretch: 1;
                        text <=> root.connect-remote-path;
                        placeholder-text: root.connect-protocol == "S3"
                            ? "Optional prefix (e.g. backups/2026/)"
                            : (root.connect-protocol == "WebDAV"
                                ? "/remote.php/dav/files/user/"
                                : (root.connect-protocol == "FTP"
                                    ? "/public_html"
                                    : (root.connect-protocol == "SMB" ? "/ (optional path in share)" : "/home/user or /var/www")));
                    }
                }

                // Protocol-Specific Advanced Options
                if root.connect-show-advanced : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Local Path:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-local-path;
                            placeholder-text: "Optional default local directory (e.g. ~/Downloads)";
                        }
                    }
                    if root.connect-protocol == "S3" || root.connect-protocol == "WebDAV" || root.connect-protocol == "FTP" : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 105px;
                            text: root.connect-protocol == "S3" ? "CDN / URL:" : "Base URL:";
                            color: #A0A0AB;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-base-url;
                            placeholder-text: root.connect-protocol == "S3"
                                ? "https://cdn.example.com (optional public URL)"
                                : (root.connect-protocol == "WebDAV"
                                    ? "https://cloud.example.com/remote.php/dav"
                                    : "https://www.example.com (optional HTTP root)");
                        }
                        if root.connect-protocol == "FTP" : Text {
                            text: "Encoding:";
                            color: #A0A0AB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if root.connect-protocol == "FTP" : CleanLineEdit {
                            width: 128px;
                            text <=> root.connect-encoding;
                            placeholder-text: "UTF-8 / ISO-8859-1";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Note:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-note;
                            placeholder-text: root.connect-protocol == "S3"
                                ? "Bucket policy, IAM role, or environment notes"
                                : "Server notes, jump host, or environment info";
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 105px; text: "Color Label:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        ColorSwatchDot {
                            is-none: true;
                            selected: root.connect-color-index == 0;
                            clicked => { root.select-connect-color(0); }
                        }
                        ColorSwatchDot {
                            swatch-color: #8E8E93;
                            selected: root.connect-color-index == 1;
                            clicked => { root.select-connect-color(1); }
                        }
                        ColorSwatchDot {
                            swatch-color: #5AC85A;
                            selected: root.connect-color-index == 2;
                            clicked => { root.select-connect-color(2); }
                        }
                        ColorSwatchDot {
                            swatch-color: #AF52DE;
                            selected: root.connect-color-index == 3;
                            clicked => { root.select-connect-color(3); }
                        }
                        ColorSwatchDot {
                            swatch-color: #0A84FF;
                            selected: root.connect-color-index == 4;
                            clicked => { root.select-connect-color(4); }
                        }
                        ColorSwatchDot {
                            swatch-color: #FFD60A;
                            selected: root.connect-color-index == 5;
                            clicked => { root.select-connect-color(5); }
                        }
                        ColorSwatchDot {
                            swatch-color: #FF453A;
                            selected: root.connect-color-index == 6;
                            clicked => { root.select-connect-color(6); }
                        }
                        ColorSwatchDot {
                            swatch-color: #FF9F0A;
                            selected: root.connect-color-index == 7;
                            clicked => { root.select-connect-color(7); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PermCheckbox {
                        y: 3px;
                        checked: root.connect-save-credentials;
                        toggled => { root.connect-save-credentials = !root.connect-save-credentials; }
                    }
                    Text {
                        text: "Save in Keyring";
                        color: #A0A0AB;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: #2A2A30; }

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        ToolbarButton {
                            label: "Add to Favorites";
                            icon-kind: "star";
                            clicked => { root.add-connection-to-favorites(); }
                        }
                        ToolbarButton {
                            label: root.connect-show-advanced ? "Hide Advanced" : "Show Advanced";
                            active: root.connect-show-advanced;
                            clicked => { root.connect-show-advanced = !root.connect-show-advanced; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.close-connect-dialog(); }
                        }
                        ToolbarButton {
                            label: root.connect-editing-id != "" ? "Save & Connect" : "Connect";
                            active: true;
                            clicked => { root.confirm-connect-dialog(); }
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): CONFLICT RESOLUTION MODAL (matching reference screenshot)
    if root.show-conflict-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {}

        Rectangle {
            width: 344px;
            height: 462px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: #252529;
            border-width: 1px;
            border-color: #3C3C42;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000099;

            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 18px;
                padding-left: 22px;
                padding-right: 22px;
                spacing: 10px;
                alignment: space-between;

                // Top Document Page Illustration (white page with folded corner & content lines)
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 46px;
                        height: 56px;
                        border-radius: 6px;
                        background: #EDEDF2;
                        border-width: 1px;
                        border-color: #C8C8D0;

                        // Folded top-right corner flap
                        Path {
                            x: 32px;
                            y: 0px;
                            width: 14px;
                            height: 14px;
                            fill: #C4C4CC;
                            commands: "M 0 0 L 14 14 L 0 14 Z";
                        }

                        // Miniature document content preview bars
                        Rectangle {
                            x: 8px;
                            y: 18px;
                            width: 10px;
                            height: 8px;
                            border-radius: 1.5px;
                            background: #B4B4BE;
                        }
                        Rectangle {
                            x: 21px;
                            y: 19px;
                            width: 16px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #B4B4BE;
                        }
                        Rectangle {
                            x: 21px;
                            y: 24px;
                            width: 13px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #B4B4BE;
                        }
                        Rectangle {
                            x: 8px;
                            y: 31px;
                            width: 29px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #C2C2CC;
                        }
                        Rectangle {
                            x: 8px;
                            y: 37px;
                            width: 24px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #C2C2CC;
                        }
                    }
                }

                // Headline & Subheadline
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.conflict-headline;
                        color: #FFFFFF;
                        font-size: 13.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.conflict-subheadline;
                        color: #B4B4BE;
                        font-size: 11.5px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                Rectangle { height: 1px; background: #3A3A40; }

                // Side-by-Side Comparison: [New] vs [Existing]
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 42px;
                                height: 19px;
                                border-radius: 5px;
                                background: #0A84FF;
                                Text {
                                    text: "New";
                                    color: #FFFFFF;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.conflict-new-date;
                            color: #E1E1E6;
                            font-size: 11px;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.conflict-new-size;
                            color: #E1E1E6;
                            font-size: 11px;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 60px;
                                height: 19px;
                                border-radius: 5px;
                                background: #525258;
                                Text {
                                    text: "Existing";
                                    color: #FFFFFF;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.conflict-existing-date;
                            color: #E1E1E6;
                            font-size: 11px;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.conflict-existing-size;
                            color: #E1E1E6;
                            font-size: 11px;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #3A3A40; }

                // Vertical Action Stack (Replace pill, Replace Older, Keep Both, Skip, Stop pill)
                VerticalLayout {
                    spacing: 2px;

                    // Primary Blue Pill: Replace
                    Rectangle {
                        height: 30px;
                        border-radius: 15px;
                        background: cf-replace-touch.has-hover ? #1E90FF : #0A84FF;
                        Text {
                            text: "Replace";
                            color: #FFFFFF;
                            font-size: 12.5px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-replace-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("replace"); }
                        }
                    }

                    // Action Row: Replace Older
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: cf-older-touch.has-hover ? #323238 : transparent;
                        Text {
                            text: "Replace Older";
                            color: cf-older-touch.has-hover ? #FFFFFF : #B4B4BE;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-older-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("replace_older"); }
                        }
                    }

                    Rectangle { height: 1px; background: #38383E; }

                    // Action Row: Keep Both
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: cf-keep-touch.has-hover ? #323238 : transparent;
                        Text {
                            text: "Keep Both";
                            color: cf-keep-touch.has-hover ? #FFFFFF : #B4B4BE;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-keep-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("keep_both"); }
                        }
                    }

                    Rectangle { height: 1px; background: #38383E; }

                    // Action Row: Skip
                    Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: cf-skip-touch.has-hover ? #323238 : transparent;
                        Text {
                            text: "Skip";
                            color: cf-skip-touch.has-hover ? #FFFFFF : #B4B4BE;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-skip-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("skip"); }
                        }
                    }

                    // Secondary Grey Pill: Stop
                    Rectangle {
                        height: 30px;
                        border-radius: 15px;
                        background: cf-stop-touch.has-hover ? #56565E : #46464C;
                        Text {
                            text: "Stop";
                            color: #FFFFFF;
                            font-size: 12.5px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-stop-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("stop"); }
                        }
                    }
                }

                // Bottom "Apply to all" Checkbox Row
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    PermCheckbox {
                        y: (parent.height - self.height) / 2;
                        checked: root.conflict-apply-all;
                        toggled => { root.conflict-apply-all = !root.conflict-apply-all; }
                    }
                    Rectangle {
                        width: cf-apply-lbl.preferred-width;
                        height: 20px;
                        background: transparent;
                        cf-apply-lbl := Text {
                            text: "Apply to all";
                            color: #E1E1E6;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.conflict-apply-all = !root.conflict-apply-all; }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.5 (z: 1500): TASKS & TRANSFERS POPOVER (Anchored below Toolbar Tasks Button)
    if root.show-tasks-popover : Rectangle {
        z: 1500;
        width: 100%;
        height: 100%;
        background: #00000033;

        TouchArea {
            clicked => { root.show-tasks-popover = false; }
        }

        Rectangle {
            x: Math.max(12px, root.width - 338px) - 2px;
            y: 42px;
            width: 330px;
            height: Math.min(340px, Math.max(114px, root.transfer-rows.length * 74px + 54px)) + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: Math.max(12px, root.width - 338px);
            y: 38px;
            width: 326px;
            height: Math.min(340px, Math.max(114px, root.transfer-rows.length * 74px + 54px));
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            TouchArea {}

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 14px;
                            kind: root.task-running
                                ? ("refresh-" + root.spinner-frame)
                                : "refresh";
                            icon-color: root.task-running ? #5AC8FA : #E1E1E6;
                        }
                        Text {
                            text: "Tasks & Operations";
                            color: #FFFFFF;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        ToolbarButton {
                            label: root.dual-pane-mode ? "Sync Panes" : "Refresh";
                            clicked => { root.sync-panes(); }
                        }
                        if root.transfer-rows.length > 0 : ToolbarButton {
                            label: "Clear";
                            clicked => { root.clear-completed-tasks(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                if root.transfer-rows.length == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "No active background tasks.";
                        color: #888892;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }

                if root.transfer-rows.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    viewport-height: root.transfer-rows.length * 72px + 8px;
                    VerticalLayout {
                        spacing: 6px;
                        for tr in root.transfer-rows : Rectangle {
                            height: 66px;
                            border-radius: 6px;
                            background: #1A1A1E;
                            border-width: 1px;
                            border-color: tr.progress-pct < 100 ? #0D52BF : #28282D;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 13px;
                                            kind: tr.progress-pct < 100
                                                ? ("refresh-" + root.spinner-frame)
                                                : "check";
                                            icon-color: tr.progress-pct < 100 ? #5AC8FA : #30D158;
                                        }
                                        Text {
                                            text: tr.source-name;
                                            color: #FFFFFF;
                                            font-size: 11px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: tr.progress-pct + "%";
                                        color: tr.progress-pct < 100 ? #5AC8FA : #30D158;
                                        font-size: 10px;
                                        font-family: "monospace";
                                        font-weight: 700;
                                    }
                                }
                                Text {
                                    text: tr.dest-path;
                                    color: #888892;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                                Rectangle {
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: #121214;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        width: parent.width * (Math.clamp(tr.progress-pct, 0, 100) / 100.0);
                                        background: tr.progress-pct < 100 ? #0D52BF : #30D158;
                                    }
                                }
                                Text {
                                    text: tr.status-text;
                                    color: tr.progress-pct < 100 ? #5AC8FA : #30D158;
                                    font-size: 10px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): DELETE CONFIRMATION MODAL
    if root.show-delete-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {}

        Rectangle {
            width: 400px;
            height: 184px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: #FF453A26;
                        LucideIcon {
                            x: 8px;
                            y: 8px;
                            icon-size: 16px;
                            kind: "trash";
                            icon-color: #FF453A;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.delete-modal-title;
                            color: #FFFFFF;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.delete-modal-message;
                            color: #A0A0AB;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    ToolbarButton {
                        label: "Cancel";
                        clicked => { root.show-delete-modal = false; }
                    }
                    Rectangle {
                        height: 26px;
                        min-width: 124px;
                        border-radius: 5px;
                        background: del-confirm-touch.has-hover ? #FF5E54 : #FF453A;
                        border-width: 1px;
                        border-color: #FF453A;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text {
                                text: root.delete-modal-permanent ? "Delete Permanently" : "Move to Trash";
                                color: #FFFFFF;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        del-confirm-touch := TouchArea {
                            clicked => {
                                root.show-delete-modal = false;
                                root.confirm-delete-modal();
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.7 (z: 1700): MANIFOLD MAIN MENU DROPDOWN (Top-Left Application Menu)
    if root.show-app-menu : Rectangle {
        z: 1700;
        width: 100%;
        height: 100%;
        background: #00000033;

        TouchArea {
            clicked => { root.show-app-menu = false; }
        }

        Rectangle {
            x: 10px;
            y: 44px;
            width: 256px;
            height: 264px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: 12px;
            y: 40px;
            width: 252px;
            height: 260px;
            border-radius: 8px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000088;

            TouchArea {}

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                ContextMenuItem {
                    icon-kind: "star";
                    label: "Preferences & Themes…";
                    shortcut-hint: "Ctrl+,";
                    triggered => {
                        root.show-app-menu = false;
                        root.show-preferences-modal = true;
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                ContextMenuItem {
                    icon-kind: "plus";
                    label: "New Folder";
                    shortcut-hint: "Ctrl+N";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-new-folder-modal();
                    }
                }
                ContextMenuItem {
                    icon-kind: "file";
                    label: "New File";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-new-file-modal();
                    }
                }
                ContextMenuItem {
                    icon-kind: "star";
                    label: "Add Current Folder to Favorites";
                    triggered => {
                        root.show-app-menu = false;
                        root.add-current-folder-to-favorites();
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                ContextMenuItem {
                    icon-kind: "terminal";
                    label: root.show-terminal-drawer ? "Hide Bottom Terminal" : "Open Bottom Terminal";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-terminal();
                    }
                }
                ContextMenuItem {
                    icon-kind: "columns";
                    label: root.dual-pane-mode ? "Switch to Single Pane" : "Switch to Dual Pane";
                    shortcut-hint: "F6";
                    triggered => {
                        root.show-app-menu = false;
                        root.toggle-dual-pane();
                    }
                }
                ContextMenuItem {
                    icon-kind: "info";
                    label: root.show-inspector ? "Hide Inspector Drawer" : "Show Inspector Drawer";
                    shortcut-hint: "Ctrl+I";
                    triggered => {
                        root.show-app-menu = false;
                        root.toggle-inspector();
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "globe";
                    label: "New Remote Connection…";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-connect-dialog();
                    }
                }
            }
        }
    }

    // LAYER 3.8 (z: 1800): FLOATING IMAGE / FILE PREVIEW MINION (Quick Look HUD)
    if root.show-preview-minion : Rectangle {
        z: 1800;
        x: Math.clamp(root.preview-minion-x, 16px, Math.max(16px, root.width - 576px));
        y: Math.clamp(root.preview-minion-y, 44px, Math.max(44px, root.height - 460px));
        width: 560px;
        height: 430px;
        border-radius: 10px;
        background: #1C1C21;
        border-width: 1px;
        border-color: root.theme-accent;
        drop-shadow-offset-y: 14px;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000000AA;
        clip: true;

        TouchArea {}

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Draggable Preview Minion Header Bar (36px)
            Rectangle {
                height: 36px;
                background: root.theme-bg-toolbar;
                border-width: 1px;
                border-color: root.theme-border;

                minion-drag-touch := TouchArea {
                    mouse-cursor: move;
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                            root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                            root.col-resize-start-w = root.preview-minion-x;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.preview-minion-x = Math.clamp(
                                root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                16px,
                                Math.max(16px, root.width - 576px)
                            );
                            root.preview-minion-y = Math.clamp(
                                self.absolute-position.y + self.mouse-y - 18px,
                                44px,
                                Math.max(44px, root.height - 460px)
                            );
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 15px;
                            kind: root.inspector-has-image ? "image" : (root.inspector-is-dir ? "folder" : "eye");
                            icon-color: #5AC8FA;
                        }
                        Text {
                            text: "Preview Minion — " + root.inspector-title;
                            color: #FFFFFF;
                            font-size: 12.5px + root.ui-font-size-delta * 1px;
                            font-family: root.ui-font-family;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.inspector-image-dimensions != "" : Rectangle {
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: #0D52BF33;
                            border-width: 1px;
                            border-color: root.theme-accent;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.inspector-image-dimensions;
                                    color: #5AC8FA;
                                    font-size: 10px;
                                    font-family: "monospace";
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        if root.inspector-has-image : ToolbarButton {
                            label: "−";
                            tooltip: "Zoom Out";
                            clicked => {
                                root.preview-minion-zoom = Math.max(0.5, root.preview-minion-zoom - 0.25);
                            }
                        }
                        if root.inspector-has-image : ToolbarButton {
                            label: Math.round(root.preview-minion-zoom * 100) + "%";
                            tooltip: "Reset Zoom (100%)";
                            clicked => { root.preview-minion-zoom = 1.0; }
                        }
                        if root.inspector-has-image : ToolbarButton {
                            label: "+";
                            tooltip: "Zoom In";
                            clicked => {
                                root.preview-minion-zoom = Math.min(3.0, root.preview-minion-zoom + 0.25);
                            }
                        }
                        ToolbarButton {
                            icon-kind: "close";
                            tooltip: "Close Preview Minion (Space / Esc)";
                            tooltip-align-right: true;
                            clicked => { root.show-preview-minion = false; }
                        }
                    }
                }
            }

            // Preview Minion Body (High-Res Image or Code/Text/Hex Viewport)
            Rectangle {
                vertical-stretch: 1;
                background: #101014;
                clip: true;

                if root.inspector-has-image : ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: Math.max(self.width, self.width * root.preview-minion-zoom);
                    viewport-height: Math.max(self.height, self.height * root.preview-minion-zoom);
                    Rectangle {
                        width: Math.max(parent.width, parent.width * root.preview-minion-zoom);
                        height: Math.max(parent.height, parent.height * root.preview-minion-zoom);
                        background: transparent;
                        Image {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                            image-fit: contain;
                            source: root.inspector-preview-image;
                        }
                    }
                }

                if !root.inspector-has-image && root.inspector-is-dir : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        LucideIcon {
                            icon-size: 68px;
                            kind: "folder";
                            icon-color: #38B6FF;
                            fill-color: #4CC2FF;
                        }
                    }
                    Text {
                        text: root.inspector-title;
                        color: #FFFFFF;
                        font-size: 15px + root.ui-font-size-delta * 1px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.inspector-subtitle + " •Modified: " + root.inspector-modified;
                        color: #A0A0AB;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                if !root.inspector-has-image && !root.inspector-is-dir : ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: Math.max(self.height, minion-text-preview.preferred-height + 24px);
                    VerticalLayout {
                        padding: 12px;
                        alignment: start;
                        minion-text-preview := Text {
                            text: root.inspector-preview-text;
                            color: #E1E1E6;
                            font-size: 11.5px + root.ui-font-size-delta * 1px;
                            font-family: "monospace";
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Preview Minion Footer Metadata Bar (28px)
            Rectangle {
                height: 28px;
                background: root.theme-bg-toolbar;
                border-width: 1px;
                border-color: root.theme-border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    Text {
                        text: root.inspector-subtitle + "  |  Size: " + root.inspector-size;
                        color: root.theme-text-secondary;
                        font-size: 11px;
                        font-family: "monospace";
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Modified: " + root.inspector-modified + "  |  Perm: " + root.inspector-perm-symbolic + " (" + root.inspector-perm-octal + ")";
                        color: root.theme-text-secondary;
                        font-size: 11px;
                        font-family: "monospace";
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // LAYER 4.2 (z: 2100): PREFERENCES & THEMES MODAL (Font Size/Type/Style & App Color Themes)
    if root.show-preferences-modal : Rectangle {
        z: 2100;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {
            clicked => { root.show-preferences-modal = false; }
        }

        Rectangle {
            width: 660px;
            height: 476px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;

            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 16px;
                            kind: "star";
                            icon-color: #5AC8FA;
                        }
                        Text {
                            text: "Manifold Preferences — Fonts & Themes";
                            color: root.theme-text-primary;
                            font-size: 14px + root.font-size-delta;
                            font-family: root.resolved-font-family;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    ToolbarButton {
                        icon-kind: "close";
                        accent-bg: root.theme-accent;
                        clicked => { root.show-preferences-modal = false; }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 1. Font Size Preference
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 110px;
                        text: "Font Size:";
                        color: root.theme-text-secondary;
                        font-size: 12px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        font-weight: root.ui-font-bold ? 700 : 500;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SegmentControlButton {
                            label: "Compact (-1)";
                            btn-width: 96px;
                            active: root.ui-font-size-delta == -1;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(-1); }
                        }
                        SegmentControlButton {
                            label: "Standard (0)";
                            btn-width: 96px;
                            active: root.ui-font-size-delta == 0;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(0); }
                        }
                        SegmentControlButton {
                            label: "Medium (+1)";
                            btn-width: 96px;
                            active: root.ui-font-size-delta == 1;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(1); }
                        }
                        SegmentControlButton {
                            label: "Large (+2)";
                            btn-width: 88px;
                            active: root.ui-font-size-delta == 2;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(2); }
                        }
                        SegmentControlButton {
                            label: "XL (+4)";
                            btn-width: 78px;
                            active: root.ui-font-size-delta == 4;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(4); }
                        }
                    }
                }

                // 2. Font Family / Type Preference
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 110px;
                        text: "Font Type:";
                        color: root.theme-text-secondary;
                        font-size: 12px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        font-weight: root.ui-font-bold ? 700 : 500;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SegmentControlButton {
                            label: "System Sans";
                            btn-width: 108px;
                            active: root.ui-font-family == "" || root.ui-font-family == "sans-serif";
                            accent-bg: root.theme-accent;
                            font-family: "";
                            clicked => { root.select-font-family("sans-serif"); }
                        }
                        SegmentControlButton {
                            label: "Inter / UI";
                            btn-width: 98px;
                            active: root.ui-font-family == "Inter";
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-family("Inter"); }
                        }
                        SegmentControlButton {
                            label: "Monospace";
                            btn-width: 108px;
                            active: root.ui-font-family == "monospace";
                            accent-bg: root.theme-accent;
                            font-family: "monospace";
                            clicked => { root.select-font-family("monospace"); }
                        }
                        SegmentControlButton {
                            label: "Serif";
                            btn-width: 84px;
                            active: root.ui-font-family == "serif";
                            accent-bg: root.theme-accent;
                            font-family: "serif";
                            clicked => { root.select-font-family("serif"); }
                        }
                    }
                }

                // 3. Font Weight / Style Preference
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 110px;
                        text: "Font Style:";
                        color: root.theme-text-secondary;
                        font-size: 12px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        font-weight: root.ui-font-bold ? 700 : 500;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SegmentControlButton {
                            label: "Regular Weight";
                            btn-width: 132px;
                            active: !root.ui-font-bold;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { if root.ui-font-bold { root.toggle-font-bold(); } }
                        }
                        SegmentControlButton {
                            label: "Bold / High-Legibility";
                            btn-width: 164px;
                            active: root.ui-font-bold;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { if !root.ui-font-bold { root.toggle-font-bold(); } }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 4. Color Theme Presets
                Text {
                    text: "Application Color Theme:";
                    color: root.theme-text-primary;
                    font-size: 12px + root.font-size-delta;
                    font-family: root.resolved-font-family;
                    font-weight: 700;
                }

                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        for th in [
                            { id: "dark_zinc", title: "Dark Zinc", bg: #1A1A1E, acc: #0D52BF },
                            { id: "midnight_ocean", title: "Midnight Ocean", bg: #131B2E, acc: #0284C7 },
                            { id: "dracula_pro", title: "Dracula Pro", bg: #21222C, acc: #BD93F9 }
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            height: 60px;
                            border-radius: 6px;
                            background: th.bg;
                            border-width: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? 2px : 1px;
                            border-color: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? #5AC8FA : root.theme-border;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: th.acc;
                                    }
                                    Text {
                                        text: th.title;
                                        color: #FFFFFF;
                                        font-size: 12px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? "✓ Active Theme" : "Click to apply";
                                    color: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? #5AC8FA : #888892;
                                    font-size: 10px + root.font-size-delta;
                                    font-family: root.resolved-font-family;
                                    font-weight: 600;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-theme-preset(th.id); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        for th in [
                            { id: "nordic_slate", title: "Nordic Slate", bg: #242933, acc: #5E81AC },
                            { id: "solarized_dark", title: "Solarized Dark", bg: #002B36, acc: #268BD2 },
                            { id: "high_contrast", title: "High Contrast", bg: #09090B, acc: #2563EB }
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            height: 60px;
                            border-radius: 6px;
                            background: th.bg;
                            border-width: root.ui-theme-preset == th.id ? 2px : 1px;
                            border-color: root.ui-theme-preset == th.id ? #5AC8FA : root.theme-border;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: th.acc;
                                    }
                                    Text {
                                        text: th.title;
                                        color: #FFFFFF;
                                        font-size: 12px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.ui-theme-preset == th.id ? "✓ Active Theme" : "Click to apply";
                                    color: root.ui-theme-preset == th.id ? #5AC8FA : #888892;
                                    font-size: 10px + root.font-size-delta;
                                    font-family: root.resolved-font-family;
                                    font-weight: 600;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-theme-preset(th.id); }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Preferences are automatically saved to ~/.config/manifold/preferences.toml";
                        color: root.theme-text-muted;
                        font-size: 10.5px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        vertical-alignment: center;
                    }
                    ToolbarButton {
                        label: "Done";
                        active: true;
                        accent-bg: root.theme-accent;
                        font-family: root.resolved-font-family;
                        clicked => { root.show-preferences-modal = false; }
                    }
                }
            }
        }
    }

    // LAYER 4.7 (z: 1800): FLOATING MOUSEOVER FILE DETAILS & NON-BINARY PREVIEW CARD
    if root.show-hover-preview && !root.is-dragging-row && !root.is-dragging-tab && !root.show-context-menu && !root.show-sidebar-context-menu : Rectangle {
        z: 1800;
        width: 316px;
        height: root.hover-has-image
            ? 234px
            : (root.hover-has-text
                ? 206px
                : (root.hover-media-info != "" ? 116px : 92px));
        x: Math.clamp(root.hover-preview-x + 22px, 12px, root.width - self.width - 14px);
        y: Math.clamp(root.hover-preview-y + 18px, 50px, root.height - self.height - 14px);
        border-radius: 8px;
        background: root.theme-bg-popover;
        border-width: 1px;
        border-color: #3A3A46;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: root.hover-file-name;
                    color: root.theme-text-primary;
                    font-size: 12px + root.font-size-delta;
                    font-family: root.resolved-font-family;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.hover-file-size;
                    color: #5AC8FA;
                    font-size: 10.5px + root.font-size-delta;
                    font-family: "monospace";
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.hover-file-kind + "  •  " + root.hover-file-modified + "  •  " + root.hover-file-perms;
                color: root.theme-text-secondary;
                font-size: 10px + root.font-size-delta;
                font-family: "monospace";
                overflow: elide;
            }

            if root.hover-media-info != "" : Rectangle {
                height: 22px;
                border-radius: 4px;
                background: root.theme-bg-canvas;
                border-width: 1px;
                border-color: root.theme-border;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.hover-media-info;
                        color: #5AC8FA;
                        font-size: 10px + root.font-size-delta;
                        font-family: "monospace";
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }

            if root.hover-has-image : Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                background: #0D0D10;
                border-width: 1px;
                border-color: root.theme-border;
                clip: true;
                Image {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    image-fit: contain;
                    source: root.hover-image;
                }
            }

            if !root.hover-has-image && root.hover-has-text : Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                background: root.theme-bg-canvas;
                border-width: 1px;
                border-color: root.theme-border;
                clip: true;
                VerticalLayout {
                    padding: 7px;
                    Text {
                        text: root.hover-text;
                        color: root.theme-text-primary;
                        font-size: 10px + root.font-size-delta;
                        font-family: "monospace";
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // LAYER 4.8 (z: 2400): FLOATING DRAG-AND-DROP GHOST PILL HUD
    if root.is-dragging-row && root.drag-ghost-label != "" : Rectangle {
        z: 2400;
        x: Math.clamp(root.drag-ghost-x + 14px, 8px, root.width - 280px);
        y: Math.clamp(root.drag-ghost-y + 10px, 8px, root.height - 40px);
        height: 28px;
        width: 268px;
        border-radius: 14px;
        background: #202024EE;
        border-width: 1px;
        border-color: root.drag-target-hint != "" ? #5AC8FA : #3A3A44;
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000099;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            alignment: start;

            LucideIcon {
                y: (parent.height - self.height) / 2;
                icon-size: 13px;
                kind: root.drag-target-hint != "" ? "folder" : "copy";
                icon-color: root.drag-target-hint != "" ? #5AC8FA : #E1E1E6;
            }

            Text {
                text: root.drag-ghost-label;
                color: #FFFFFF;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.drag-target-hint != "" : Text {
                text: root.drag-target-hint;
                color: #5AC8FA;
                font-size: 11px;
                font-weight: 600;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // LAYER 4.9 (z: 2450): FLOATING TAB DRAG-AND-DROP GHOST PILL
    if root.is-dragging-tab && root.drag-tab-title != "" : Rectangle {
        z: 2450;
        x: Math.clamp(root.drag-ghost-x + 12px, 8px, root.width - 240px);
        y: Math.clamp(root.drag-ghost-y + 8px, 8px, root.height - 36px);
        height: 26px;
        width: 224px;
        border-radius: 6px;
        background: #202024EE;
        border-width: 1px;
        border-color: root.theme-accent;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            LucideIcon {
                y: (parent.height - self.height) / 2;
                icon-size: 13px;
                kind: "folder";
                icon-color: #4CC2FF;
                fill-color: #4CC2FF;
            }
            Text {
                text: "Move Tab: " + root.drag-tab-title;
                color: #FFFFFF;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
