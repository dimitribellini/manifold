    callback confirm-open-with(string);
    callback delete-selected-item();
    callback permanent-delete-selected-item();
    callback confirm-delete-modal();
    callback clear-completed-tasks();
    callback add-current-to-favorites();
    callback add-current-folder-to-favorites();
    callback open-parent-row(bool, int);
    callback navigate-up(bool);
    callback sort-by-column(bool, string);
    callback filter-changed(string);
    callback clear-pane-filter(bool);
    callback set-view-mode(int);
    callback toggle-hidden-files();
    callback toggle-inspector();
    callback toggle-preview-minion();
    callback set-inspector-tab(int);
    callback toggle-permission-bit(int, int);
    callback toggle-hide-extension();
    callback toggle-locked();
    callback set-selected-color-label(int);
    callback calculate-selected-dir-size();
    callback copy-selected-between-panes();
    callback move-selected-between-panes();
    callback sync-panes();
    callback open-sync-modal();
    callback update-sync-options(string, string);
    callback toggle-sync-row-approved(int);
    callback execute-sync-plan();
    callback toggle-pause-transfer(string);
    callback cancel-transfer(string);
    callback select-max-bandwidth-mbps(int);
    callback add-batch-rename-rule(int);
    callback remove-batch-rename-rule(int);
    callback update-batch-rename-rule(int, string, string);
    callback toggle-batch-rename-case-sensitive(int);
    callback reset-batch-rename-rules();
    callback confirm-batch-rename-modal();
    callback save-batch-rename-favorite();
    callback apply-batch-rename-favorite(int);
    callback delete-batch-rename-favorite(int);
    callback open-terminal();
    callback open-terminal-here();
    callback terminal-key-input(string, string, bool, bool, bool);
    callback terminal-paste();
    callback terminal-scroll(int);
    callback restart-terminal();
    callback clear-terminal();
    callback sync-terminal-cwd();
    callback open-external-terminal();
    callback select-theme-preset(string);
    callback select-font-size-delta(int);
    callback select-font-family(string);
    callback toggle-font-bold();
    callback set-theme-preset(string);
    callback set-font-size-delta(int);
    callback set-font-family(string);
    callback set-font-bold(bool);
    callback open-connect-dialog();
    callback close-connect-dialog();
    callback confirm-connect-dialog();
    callback select-connect-protocol(string);
    callback select-connect-color(int);
    callback resolve-conflict(string);
    callback handle-shortcut(string, bool, bool, bool, bool) -> bool;
    callback toggle-view-options-option(string);
    callback set-view-options-scope(string);
    callback set-view-options-sort(string);
    callback set-view-options-icon-size(int);
    callback use-view-options-as-defaults();

    public function focus-filter-box() {
        filter-text-input.focus();
        filter-text-input.select-all();
    }

    public function focus-input-modal() {
        root.show-input-modal = true;
    }

    window-mono-probe := Text {
        visible: false;
        x: 0px;
        y: 0px;
        text: "0123456789";
        font-family: root.resolved-mono-font-family;
        font-size: 13px + root.ui-font-size-delta * 1px;
        font-weight: 400;
    }

    public function focus-terminal-input() {
        root.show-terminal-drawer = true;
    }

    in-out property <length> right-scroll-y: 0px;

    public function focus-main-key-router() {
        key-router.focus();
    }

    function scroll-pane-by-delta(is-right: bool, dy: length) {
        if !is-right {
            if (root.left-view-mode == 0 || root.left-view-mode == 3) && root.left-total-rows > root.left-rows.length {
                root.set-virtual-scroll-row(
                    false,
                    Math.clamp(
                        root.left-virtual-top-row - Math.round(dy / (29px + Math.max(0px, root.font-size-delta * 2.0))),
                        0,
                        Math.max(0, root.left-total-rows - root.left-rows.length)
                    )
                );
            } else {
                l-flick.viewport-y = Math.clamp(
                    l-flick.viewport-y + dy,
                    Math.min(0px, l-flick.height - l-flick.viewport-height),
                    0px
                );
            }
        } else {
            if (root.right-view-mode == 0 || root.right-view-mode == 3) && root.right-total-rows > root.right-rows.length {
                root.set-virtual-scroll-row(
                    true,
                    Math.clamp(
                        root.right-virtual-top-row - Math.round(dy / (29px + Math.max(0px, root.font-size-delta * 2.0))),
                        0,
                        Math.max(0, root.right-total-rows - root.right-rows.length)
                    )
                );
            } else {
                root.right-scroll-y = Math.min(0px, root.right-scroll-y + dy);
            }
        }
    }

    public function ensure-row-visible(is-right: bool, row-idx: int) {
        key-router.focus();
        if !is-right {
            if root.left-view-mode == 1 {
                if (Math.floor(row-idx / 3) * (138px + Math.max(0px, root.font-size-delta * 4.0))) < (-l-flick.viewport-y) {
                    l-flick.viewport-y = -(Math.floor(row-idx / 3) * (138px + Math.max(0px, root.font-size-delta * 4.0)));
                } else if ((Math.floor(row-idx / 3) + 1) * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 24px) > (-l-flick.viewport-y + l-flick.height) {
                    l-flick.viewport-y = Math.min(
                        0px,
                        l-flick.height - ((Math.floor(row-idx / 3) + 1) * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 24px)
                    );
                }
            } else {
                if (row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.left-icon-size * 1px - 16px))) < (-l-flick.viewport-y) {
                    l-flick.viewport-y = -(row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.left-icon-size * 1px - 16px)));
                } else if ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.left-icon-size * 1px - 16px))) > (-l-flick.viewport-y + l-flick.height) {
                    l-flick.viewport-y = Math.min(
                        0px,
                        l-flick.height - ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.left-icon-size * 1px - 16px)))
                    );
                }
            }
        } else {
            if root.right-view-mode == 1 {
                if (Math.floor(row-idx / 3) * (138px + Math.max(0px, root.font-size-delta * 4.0))) < (-root.right-scroll-y) {
                    root.right-scroll-y = -(Math.floor(row-idx / 3) * (138px + Math.max(0px, root.font-size-delta * 4.0)));
                } else if ((Math.floor(row-idx / 3) + 1) * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 24px) > (-root.right-scroll-y + l-flick.height) {
                    root.right-scroll-y = Math.min(
                        0px,
                        l-flick.height - ((Math.floor(row-idx / 3) + 1) * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 24px)
                    );
                }
            } else {
                if (row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.right-icon-size * 1px - 16px))) < (-root.right-scroll-y) {
                    root.right-scroll-y = -(row-idx * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.right-icon-size * 1px - 16px)));
                } else if ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.right-icon-size * 1px - 16px))) > (-root.right-scroll-y + l-flick.height) {
                    root.right-scroll-y = Math.min(
                        0px,
                        l-flick.height - ((row-idx + 2) * (29px + Math.max(0px, root.font-size-delta * 2.0) + Math.max(0px, root.right-icon-size * 1px - 16px)))
                    );
                }
            }
        }
    }

    // Centralized Cross-Platform Keyboard Shortcut Router
    key-router := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if root.handle-shortcut(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // 1. UNIFIED TOP TOOLBAR (doc/specification_2.md §2.2 & §4.2: #1E1E22, 42px height, #28282D border)
            Rectangle {
                z: 500;
                height: 42px;
                background: root.theme-bg-toolbar;
                border-width: 1px;
                border-color: root.theme-border;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;

                    // Left Section: "Manifold ▾" Main Menu, Back, Forward, Parent Up, and Responsive Active Title
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        min-width: 260px;
                        spacing: 6px;
                        alignment: start;

                        // Dedicated "Manifold" Main Application Menu Button (auto-sized so chevron never clips)
                        Rectangle {
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            width: app-menu-layout.preferred-width;
                            horizontal-stretch: 0;
                            border-radius: 6px;
                            background: root.show-app-menu
                                ? root.theme-accent
                                : (app-menu-touch.has-hover ? root.theme-bg-hover : root.theme-bg-sidebar);
                            border-width: 1px;
                            border-color: root.show-app-menu ? #388BFD : root.theme-border;
                            app-menu-layout := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 14px;
                                    kind: "columns";
                                    icon-color: root.show-app-menu ? #FFFFFF : root.theme-text-secondary;
                                }
                                Text {
                                    text: "Manifold";
                                    color: #FFFFFF;
                                    font-size: 12.5px + root.font-size-delta;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 11px;
                                    kind: "chevron-down";
                                    icon-color: root.show-app-menu ? #FFFFFF : root.theme-text-muted;
                                }
                            }
                            app-menu-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-app-menu = !root.show-app-menu;
                                }
                            }
                        }

                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "chevron-left";
                            tooltip: "Back (Alt+Left)";
                            enabled-state: root.can-go-back;
                            clicked => { root.go-back(); }
                        }
                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "chevron-right";
                            tooltip: "Forward (Alt+Right)";
                            enabled-state: root.can-go-forward;
                            clicked => { root.go-forward(); }
                        }
                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "arrow-up";
                            tooltip: "Enclosing Folder (Alt+Up)";
                            clicked => {
                                root.navigate-up(root.right-pane-active && root.dual-pane-mode);
                            }
                        }
                        Rectangle {
                            width: 4px;
                            horizontal-stretch: 0;
                            background: transparent;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 72px;
                            background: transparent;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.active-folder-title;
                                color: root.theme-text-primary;
                                font-size: 15px + root.font-size-delta;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if (root.right-pane-active && root.dual-pane-mode ? root.right-filter-query : root.left-filter-query) != "" : TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    key-router.focus();
                                    root.clear-pane-filter(root.right-pane-active && root.dual-pane-mode);
                                }
                            }
                        }
                    }

                    // Center Section: Clean Segmented Controls for View Modes & Pane Layout
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        alignment: center;

                        // View Modes Pill Switcher: [ ⊞ Icons | ≔ List | ▥ Columns | 🌿 Tree ]
                        Rectangle {
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 0;
                            border-radius: 15px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding-left: 3px;
                                padding-right: 3px;
                                spacing: 2px;
                                alignment: center;
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "view-icons";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "Icons View (Ctrl/Cmd+1)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 1;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(1);
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    background: ((root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 1 || (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 0) ? transparent : #2E2E36;
                                }
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "view-list";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "List View (Ctrl/Cmd+2)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 0;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(0);
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    background: ((root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 0 || (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 2) ? transparent : #2E2E36;
                                }
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "view-columns";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "Miller Columns View (Ctrl/Cmd+3)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 2;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(2);
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    background: ((root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 2 || (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 3) ? transparent : #2E2E36;
                                }
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "view-tree";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "Tree View (Ctrl/Cmd+4)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: (root.right-pane-active && root.dual-pane-mode ? root.right-view-mode : root.left-view-mode) == 3;
                                    clicked => {
                                        l-flick.viewport-y = 0px;
                                        l-flick.viewport-x = 0px;
                                        root.set-view-mode(3);
                                    }
                                }
                            }
                        }

                        // Pane Layout Pill Switcher: [ ▢ Single | ◫ Split H | ⊟ Split V ]
                        Rectangle {
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 0;
                            border-radius: 15px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding-left: 3px;
                                padding-right: 3px;
                                spacing: 2px;
                                alignment: center;
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "pane-single";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "Single Pane View (Ctrl/Cmd+Alt+T)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: !root.dual-pane-mode;
                                    clicked => {
                                        root.set-panes-layout(0);
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    background: transparent;
                                }
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "pane-dual";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "Dual-Pane Side-by-Side Split (F6)";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: root.dual-pane-mode && root.panes-layout != 2;
                                    clicked => {
                                        root.set-panes-layout(1);
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    background: transparent;
                                }
                                SegmentControlButton {
                                    y: (parent.height - self.height) / 2;
                                    icon-kind: "pane-split-v";
                                    pill-style: true;
                                    btn-width: 34px;
                                    tooltip: "Dual-Pane Top/Bottom Split";
                                    accent-bg: root.theme-accent;
                                    font-family: root.resolved-font-family;
                                    active: root.dual-pane-mode && root.panes-layout == 2;
                                    clicked => {
                                        root.set-panes-layout(2);
                                    }
                                }
                            }
                        }
                    }

                    // Flexible Right-Center Spacer so Center Section stays balanced on wide monitors while collapsing to 0px on compact windows
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        max-width: Math.max(0px, (root.width - 1060px) * 0.45);
                        background: transparent;
                    }

                    // Right Section: Responsive Single-Border Search Input & Action Icons
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        alignment: end;

                        Rectangle {
                            width: Math.clamp(root.width * 0.19, 152px, 260px);
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            horizontal-stretch: 0;
                            border-radius: 6px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: filter-text-input.has-focus
                                ? root.theme-accent
                                : (root.search-query != "" ? #0D52BFAA : root.theme-border);
                            clip: true;

                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 6px;
                                spacing: 6px;

                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 14px;
                                    kind: "search";
                                    icon-color: (filter-text-input.has-focus || root.search-query != "") ? root.theme-text-primary : root.theme-text-muted;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;
                                    clip: true;

                                    if root.search-query == "" && !filter-text-input.has-focus : Text {
                                        text: "Filter tab (e.g. *pdf)";
                                        color: root.theme-text-muted;
                                        font-size: 12.5px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        vertical-alignment: center;
                                    }

                                    filter-text-input := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.search-query;
                                        font-size: 13px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        color: root.theme-text-primary;
                                        vertical-alignment: center;
                                        single-line: true;
                                        edited => {
                                            root.filter-changed(self.text);
                                        }
                                        key-pressed(ev) => {
                                            if ev.text == "\u{001b}" {
                                                if root.search-query != "" {
                                                    root.search-query = "";
                                                    root.filter-changed("");
                                                }
                                                key-router.focus();
                                                root.handle-shortcut("\u{001b}", false, false, false, false);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }

                                if root.search-query != "" : Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    horizontal-stretch: 0;
                                    border-radius: 9px;
                                    background: clear-filter-touch.has-hover ? #383842 : #282830;
                                    LucideIcon {
                                        x: 4px;
                                        y: 4px;
                                        icon-size: 10px;
                                        kind: "close";
                                        icon-color: clear-filter-touch.has-hover ? #FFFFFF : #B4B4BE;
                                    }
                                    clear-filter-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-query = "";
                                            root.filter-changed("");
                                        }
                                    }
                                }
                            }
                        }

                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "globe";
                            tooltip: "New Remote Connection";
                            tooltip-align-right: true;
                            accent-bg: root.theme-accent;
                            clicked => { root.open-connect-dialog(); }
                        }
                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "folder-sync";
                            tooltip: "Directory Sync & Diff (Ctrl/Cmd+Shift+Y)";
                            tooltip-align-right: true;
                            accent-bg: root.theme-accent;
                            active: root.show-sync-modal;
                            clicked => { root.open-sync-modal(); }
                        }
                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "terminal";
                            tooltip: "Toggle Embedded Bottom Terminal";
                            tooltip-align-right: true;
                            accent-bg: root.theme-accent;
                            active: root.show-terminal-drawer;
                            clicked => { root.open-terminal(); }
                        }

                        // Tasks & Sync Button (Spinning Icon + Inline Progress Bar + Popover Trigger)
                        Rectangle {
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            width: root.task-running ? 136px : (root.transfer-rows.length > 0 ? 48px : 30px);
                            horizontal-stretch: 0;
                            border-radius: 6px;
                            background: root.show-tasks-popover || root.task-running
                                ? #0D52BF33
                                : (tasks-btn-touch.has-hover ? root.theme-bg-hover : root.theme-bg-sidebar);
                            border-width: 1px;
                            border-color: root.task-running
                                ? root.theme-accent
                                : (root.show-tasks-popover ? root.theme-accent : root.theme-border);

                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                spacing: 6px;
                                alignment: center;

                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 15px;
                                    kind: root.task-running
                                        ? ("refresh-" + root.spinner-frame)
                                        : "refresh";
                                    icon-color: root.task-running ? #E1E1E6 : root.theme-text-primary;
                                }

                                if root.task-running : VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    width: 92px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.active-task-label;
                                            color: #FFFFFF;
                                            font-size: 9px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.active-task-progress + "%";
                                            color: root.theme-text-secondary;
                                            font-size: 9px;
                                            font-family: "monospace";
                                        }
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: root.theme-bg-canvas;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 4px;
                                            border-radius: 2px;
                                            width: parent.width * (Math.clamp(root.active-task-progress, 0, 100) / 100.0);
                                            background: root.theme-accent;
                                        }
                                    }
                                }

                                if !root.task-running && root.transfer-rows.length > 0 : Text {
                                    text: root.transfer-rows.length;
                                    color: root.theme-text-secondary;
                                    font-size: 11px;
                                    font-weight: 700;
                                    font-family: "monospace";
                                    vertical-alignment: center;
                                }
                            }

                            if !root.show-tasks-popover && tasks-btn-touch.has-hover && !tasks-btn-touch.pressed : Rectangle {
                                z: 3000;
                                x: parent.width - self.width;
                                y: parent.height + 5px;
                                height: 22px;
                                width: tasks-tt-text.preferred-width + 14px;
                                border-radius: 4px;
                                background: root.theme-bg-popover;
                                border-width: 1px;
                                border-color: #3A3A44;
                                tasks-tt-text := Text {
                                    x: 7px;
                                    y: (parent.height - self.height) / 2;
                                    text: "Tasks & Operations Queue";
                                    color: #F2F2F7;
                                    font-size: 11px;
                                    font-weight: 500;
                                }
                            }

                            tasks-btn-touch := TouchArea {
                                clicked => {
                                    root.show-tasks-popover = !root.show-tasks-popover;
                                }
                            }
                        }

                        ToolbarButton {
                            y: (parent.height - self.height) / 2;
                            icon-kind: "inspector";
                            tooltip: "Toggle Inspector Drawer (Ctrl/Cmd+I)";
                            tooltip-align-right: true;
                            active: root.show-inspector;
                            clicked => { root.toggle-inspector(); }
                        }
                    }
                }
            }

            // 2. MAIN WORKSPACE: SIDEBAR | PANE VIEWPORTS | OPTIONAL INSPECTOR
            HorizontalLayout {
                vertical-stretch: 1;
                padding: 6px;
                spacing: 4px;

                // 2A. LEFT SIDEBAR (Panel 0: Resizable width, Favorites "+" button)

                // 2A. LEFT SIDEBAR
                SidebarPanel {
                    col-resize-start-w <=> root.col-resize-start-w;
                    col-resize-start-x <=> root.col-resize-start-x;
                    drag-fav-grab-offset-x <=> root.drag-fav-grab-offset-x;
                    drag-fav-grab-offset-y <=> root.drag-fav-grab-offset-y;
                    drag-fav-icon <=> root.drag-fav-icon;
                    drag-fav-label <=> root.drag-fav-label;
                    drag-fav-mouse-x <=> root.drag-fav-mouse-x;
                    drag-fav-mouse-y <=> root.drag-fav-mouse-y;
                    drag-hover-fav-idx <=> root.drag-hover-fav-idx;
                    drag-hover-sidebar-idx: root.drag-hover-sidebar-idx;
                    drag-sidebar-scroll-y <=> root.drag-sidebar-scroll-y;
                    dragging-sidebar-idx <=> root.dragging-sidebar-idx;
                    fav-max-sidebar-idx: root.fav-max-sidebar-idx;
                    fav-min-sidebar-idx: root.fav-min-sidebar-idx;
                    font-size-delta: root.font-size-delta;
                    sidebar-items: root.sidebar-items;
                    sidebar-width <=> root.sidebar-width;
                    theme-accent: root.theme-accent;
                    theme-bg-hover: root.theme-bg-hover;
                    theme-bg-popover: root.theme-bg-popover;
                    theme-bg-sidebar: root.theme-bg-sidebar;
                    theme-border: root.theme-border;
                    theme-text-muted: root.theme-text-muted;
                    theme-text-primary: root.theme-text-primary;
                    ui-font-bold: root.ui-font-bold;
                    eject-sidebar-item(a0) => { root.eject-sidebar-item(a0); }
                    focus-key-router => { key-router.focus(); }
                    open-sidebar-context-menu(a0, a1, a2) => { root.open-sidebar-context-menu(a0, a1, a2); }
                    reorder-sidebar-favorite(a0, a1) => { root.reorder-sidebar-favorite(a0, a1); }
                    select-sidebar-item(a0) => { root.select-sidebar-item(a0); }
                }

                // 2B–2C. PANE STAGE (Supports Single, SplitHorizontal side-by-side, and SplitVertical top/bottom)
                panes-stage := Rectangle {
                    width: (root.dual-pane-mode && root.panes-layout != 2)
                        ? (root.panes-avail-width + 14px)
                        : root.panes-avail-width;
                    horizontal-stretch: 0;
                    background: transparent;

                // 2B. PRIMARY (LEFT / TOP) FILE BROWSING PANE (Explicit width prevents pushing Inspector Drawer off-screen)
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: (root.dual-pane-mode && root.panes-layout != 2)
                        ? root.panes-avail-width * root.split-ratio
                        : parent.width;
                    height: (root.dual-pane-mode && root.panes-layout == 2)
                        ? Math.max(120px, (parent.height - 10px) * root.split-ratio)
                        : parent.height;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    background: root.theme-bg-surface;
                    border-width: (root.dual-pane-mode && !root.right-pane-active) ? 2px : 1px;
                    border-color: root.drag-hover-left-pane
                        ? root.theme-accent
                        : ((root.dual-pane-mode && !root.right-pane-active) ? root.theme-accent : root.theme-border);
                    opacity: (root.dual-pane-mode && root.right-pane-active) ? 0.84 : 1.0;
                    clip: true;

                    VerticalLayout {
                        // Per-Pane Tab Bar (Matches reference screenshot: dark #08080A active tab pill, #212126 inactive tab pill, monochrome outline icons, hover-only close button)
                        Rectangle {
                            z: 30;
                            height: 38px + Math.max(0px, root.font-size-delta * 1.5);
                            background: root.theme-bg-sidebar;
                            border-width: 0px;

                            for tab[t-idx] in root.left-tabs : Rectangle {
                                x: 8px + t-idx * (root.left-tab-pill-width + 6px);
                                y: 5px;
                                width: root.left-tab-pill-width;
                                height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                                background: transparent;

                                // Animated visual tab card (smoothly shifts left/right when a tab is dragged across it)
                                Rectangle {
                                    x: (root.dragging-tab-active && !root.dragging-tab-is-right && !root.drag-tab-hover-right && root.drag-tab-hover-idx >= 0)
                                        ? (t-idx == root.dragging-tab-idx
                                            ? ((root.drag-tab-hover-idx - root.dragging-tab-idx) * (root.left-tab-pill-width + 6px))
                                            : ((t-idx > root.dragging-tab-idx && t-idx <= root.drag-tab-hover-idx)
                                                ? -(root.left-tab-pill-width + 6px)
                                                : ((t-idx < root.dragging-tab-idx && t-idx >= root.drag-tab-hover-idx)
                                                    ? (root.left-tab-pill-width + 6px)
                                                    : 0px)))
                                        : ((root.dragging-tab-active && root.dragging-tab-is-right && !root.drag-tab-hover-right && root.drag-tab-hover-idx >= 0 && t-idx >= root.drag-tab-hover-idx)
                                            ? (root.left-tab-pill-width + 6px)
                                            : 0px);
                                    animate x { duration: 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1.0); }
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 6px;
                                    opacity: (root.dragging-tab-active && !root.dragging-tab-is-right && root.dragging-tab-idx == t-idx) ? 0.32 : 1.0;
                                    background: root.drag-hover-left-tab == t-idx
                                        ? #0D52BF38
                                        : ((root.dragging-tab-active && !root.dragging-tab-is-right && root.dragging-tab-idx == t-idx)
                                            ? #101014
                                            : (tab.is-active
                                                ? #08080A
                                                : (l-tab-touch.has-hover && !root.dragging-tab-active ? #2A2A31 : #212126)));
                                    border-width: (root.drag-hover-left-tab == t-idx || (root.dragging-tab-active && !root.dragging-tab-is-right && root.dragging-tab-idx == t-idx)) ? 1px : 0px;
                                    border-color: root.drag-hover-left-tab == t-idx ? root.theme-accent : #32323C;

                                    if !(root.dragging-tab-active && !root.dragging-tab-is-right && root.dragging-tab-idx == t-idx) : HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;

                                        Rectangle {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            clip: true;
                                            background: transparent;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle {
                                                    width: 16px;
                                                    background: transparent;
                                                    LucideIcon {
                                                        x: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 15px;
                                                        kind: tab.icon-kind != "" ? tab.icon-kind : "folder";
                                                        icon-color: tab.is-active ? #FFFFFF : (l-tab-touch.has-hover ? #C8C8D2 : #8E8E98);
                                                        fill-color: transparent;
                                                    }
                                                }
                                                Text {
                                                    text: tab.title;
                                                    color: tab.is-active ? #FFFFFF : (l-tab-touch.has-hover ? #D8D8E2 : #9898A2);
                                                    font-size: 13px + root.font-size-delta;
                                                    font-weight: tab.is-active ? 600 : (root.ui-font-bold ? 600 : 500);
                                                    min-width: 0px;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if l-tab-touch.has-hover && !l-tab-touch.pressed && !root.dragging-tab-active && tab.tooltip != "" : Rectangle {
                                                z: 3000;
                                                x: 0px;
                                                y: parent.height + 5px;
                                                height: 22px;
                                                width: l-tab-tt.preferred-width + 14px;
                                                border-radius: 4px;
                                                background: root.theme-bg-popover;
                                                border-width: 1px;
                                                border-color: #3A3A44;
                                                l-tab-tt := Text {
                                                    x: 7px;
                                                    y: (parent.height - self.height) / 2;
                                                    text: tab.tooltip;
                                                    color: #F2F2F7;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                }
                                            }
                                        }

                                        if root.left-tabs.length > 1 : Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: 5px;
                                            border-radius: 4px;
                                            opacity: (l-tab-touch.has-hover || l-close-touch.has-hover) && !root.dragging-tab-active ? 1.0 : 0.0;
                                            background: l-close-touch.has-hover ? #2C2C34 : transparent;
                                            LucideIcon {
                                                x: 4px;
                                                y: 4px;
                                                icon-size: 10px;
                                                kind: "close";
                                                icon-color: l-close-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                            }
                                            l-close-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.close-tab(false, t-idx); }
                                            }
                                        }
                                    }
                                }

                                l-tab-touch := TouchArea {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width - (root.left-tabs.length > 1 ? 24px : 0px);
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        key-router.focus();
                                        if !root.dragging-tab-active {
                                            root.activate-pane(false);
                                            root.select-tab(false, t-idx);
                                        }
                                    }
                                    moved => {
                                        if self.pressed && Math.abs(self.mouse-x - self.pressed-x) > 8px {
                                            if !root.dragging-tab-active {
                                                root.dragging-tab-active = true;
                                                root.dragging-tab-is-right = false;
                                                root.dragging-tab-idx = t-idx;
                                                root.drag-tab-title = tab.title;
                                                root.drag-tab-icon = tab.icon-kind != "" ? tab.icon-kind : "folder";
                                                root.drag-tab-width = root.left-tab-pill-width;
                                                root.drag-tab-grab-offset-x = self.pressed-x;
                                                root.drag-tab-grab-offset-y = self.pressed-y;
                                            }
                                            root.drag-tab-mouse-x = self.absolute-position.x + self.mouse-x;
                                            root.drag-tab-mouse-y = self.absolute-position.y + self.mouse-y;
                                            if root.dual-pane-mode && root.drag-tab-mouse-x > (root.sidebar-width + root.panes-avail-width * root.split-ratio + 12px) {
                                                root.drag-tab-hover-right = true;
                                                root.drag-tab-hover-idx = Math.clamp(
                                                    Math.round((root.drag-tab-mouse-x - (root.sidebar-width + root.panes-avail-width * root.split-ratio + 18px) - root.right-tab-pill-width / 2) / (root.right-tab-pill-width + 6px)),
                                                    0,
                                                    Math.max(0, root.right-tabs.length - 1)
                                                );
                                            } else {
                                                root.drag-tab-hover-right = false;
                                                root.drag-tab-hover-idx = Math.clamp(
                                                    Math.round((root.drag-tab-mouse-x - (root.sidebar-width + 18px) - root.left-tab-pill-width / 2) / (root.left-tab-pill-width + 6px)),
                                                    0,
                                                    Math.max(0, root.left-tabs.length - 1)
                                                );
                                            }
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.dragging-tab-active {
                                            root.dragging-tab-active = false;
                                            root.move-tab(false, t-idx, root.drag-tab-hover-right, root.drag-tab-hover-idx);
                                            root.drag-tab-hover-idx = -1;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                x: 8px + root.left-tabs.length * (root.left-tab-pill-width + 6px);
                                y: 6px;
                                width: 26px;
                                height: 26px;
                                border-radius: 5px;
                                background: l-add-touch.has-hover ? #26262E : transparent;
                                border-width: 0px;
                                LucideIcon {
                                    x: 6.5px;
                                    y: 6.5px;
                                    icon-size: 13px;
                                    kind: "plus";
                                    icon-color: l-add-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                }
                                if l-add-touch.has-hover && !l-add-touch.pressed : Rectangle {
                                    z: 3000;
                                    x: 0px;
                                    y: parent.height + 5px;
                                    height: 22px;
                                    width: 126px;
                                    border-radius: 4px;
                                    background: root.theme-bg-popover;
                                    border-width: 1px;
                                    border-color: #3A3A44;
                                    Text {
                                        x: 7px;
                                        y: (parent.height - self.height) / 2;
                                        text: "New Tab (Ctrl/Cmd+T)";
                                        color: #F2F2F7;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                                l-add-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.add-tab(false); }
                                }
                            }
                        }

                        // Full-Width Horizontal Active Accent Bar below Tab Bar (Bound to active theme accent color)
                        Rectangle {
                            height: 2.5px;
                            background: (!root.right-pane-active || !root.dual-pane-mode) ? root.theme-accent : #2C2C34;
                        }

                        // TWO-LINE PATH & STATUS HEADER BAR (Switches to clickable "Search: \"...\"" pill during search, matching reference UI)
                        Rectangle {
                            height: 50px + Math.max(0px, root.font-size-delta * 2.0);
                            background: root.theme-bg-surface;
                            border-width: 0px;

                            if !root.left-path-edit-mode : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                // Large 28x28px Crisp White Outline Home / Volume / Server / Search Circle Icon
                                Rectangle {
                                    width: 30px;
                                    background: transparent;
                                    LucideIcon {
                                        x: 1px;
                                        y: (parent.height - self.height) / 2;
                                        icon-size: 28px;
                                        kind: root.left-filter-query != ""
                                            ? "search-circle"
                                            : (root.left-header-icon != "" ? root.left-header-icon : "home");
                                        icon-color: #F2F2F7;
                                    }
                                    if root.left-filter-query != "" : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            key-router.focus();
                                            root.clear-pane-filter(false);
                                        }
                                    }
                                }

                                // Stacked Line 1 (Clickable Search Pill or Breadcrumbs) + Line 2 (Items & Available Space Subtitle)
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;

                                    if root.left-filter-query != "" : HorizontalLayout {
                                        alignment: start;
                                        Rectangle {
                                            height: 22px + Math.max(0px, root.font-size-delta * 1.0);
                                            border-radius: 5px;
                                            background: l-search-pill-touch.pressed
                                                ? #2E2E38
                                                : (l-search-pill-touch.has-hover ? #24242C : #0C0C0E);
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: "Search: \"" + root.left-filter-query + "\"";
                                                    color: #FFFFFF;
                                                    font-size: 13.5px + root.font-size-delta;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            l-search-pill-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    key-router.focus();
                                                    root.clear-pane-filter(false);
                                                }
                                            }
                                        }
                                    }

                                    if root.left-filter-query == "" : HorizontalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for seg[s-idx] in root.left-breadcrumb-segments : HorizontalLayout {
                                            spacing: 2px;

                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: l-seg-touch.has-hover ? root.theme-bg-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    Text {
                                                        text: seg.label;
                                                        color: seg.is-last ? #FFFFFF : #D8D8E0;
                                                        font-size: 13.5px + root.font-size-delta;
                                                        font-weight: seg.is-last ? 600 : 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                l-seg-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        key-router.focus();
                                                        root.activate-pane(false);
                                                        root.navigate-to-breadcrumb(false, seg.target-path);
                                                    }
                                                }
                                            }

                                            if !seg.is-last : Rectangle {
                                                width: 14px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: l-chev-touch.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 1px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: l-chev-touch.has-hover ? "chevron-down" : "chevron-right";
                                                    icon-color: #9898A2;
                                                    opacity: l-chev-touch.has-hover ? 0.95 : 0.65;
                                                }
                                                l-chev-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(false);
                                                        root.open-sibling-dropdown(
                                                            false,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }

                                            if seg.is-last : Rectangle {
                                                width: 16px;
                                                height: 20px;
                                                border-radius: 4px;
                                                opacity: l-leaf-chev.has-hover ? 1.0 : 0.0;
                                                background: l-leaf-chev.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 2px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: "chevron-down";
                                                    icon-color: root.theme-text-primary;
                                                }
                                                l-leaf-chev := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(false);
                                                        root.open-sibling-dropdown(
                                                            false,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        // Blank space in Path Bar: clicking switches into Edit Mode (Ctrl+L / Cmd+L)
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 20px;
                                            background: transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.left-path-edit-mode = true;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        alignment: start;
                                        Text {
                                            text: root.left-search-running && root.left-filter-query != ""
                                                ? ("Searching subfolders… • " + root.left-status-subtitle)
                                                : root.left-status-subtitle;
                                            color: root.left-search-running && root.left-filter-query != "" ? #6E92B8 : #8E8E98;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Edit Mode (Triggered via Ctrl+L / Cmd+L or clicking blank path bar space)
                            if root.left-path-edit-mode : HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                CleanLineEdit {
                                    y: 11px;
                                    horizontal-stretch: 1;
                                    text <=> root.left-path-input;
                                    placeholder-text: "/path/to/directory";
                                    font-size: 12.5px + root.font-size-delta * 0.5;
                                    accepted(val) => {
                                        root.left-path-edit-mode = false;
                                        key-router.focus();
                                        root.commit-path-input(false, val);
                                    }
                                    escape-pressed => {
                                        root.left-path-edit-mode = false;
                                        key-router.focus();
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Tab";
                                    tooltip: "Autocomplete Path (Tab)";
                                    tooltip-align-right: true;
                                    clicked => {
                                        root.autocomplete-path-input(false, root.left-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Go";
                                    tooltip: "Navigate to Path (Enter)";
                                    tooltip-align-right: true;
                                    active: true;
                                    clicked => {
                                        root.left-path-edit-mode = false;
                                        root.commit-path-input(false, root.left-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    icon-kind: "close";
                                    tooltip: "Cancel Path Edit (Esc)";
                                    tooltip-align-right: true;
                                    clicked => { root.left-path-edit-mode = false; }
                                }
                            }
                        }

                        // TABLE HEADER ROW (Dynamic Columns controlled by Show View Options)
                        if root.left-view-mode == 0 || root.left-view-mode == 3 : Rectangle {
                            z: 10;
                            height: 26px + Math.max(0px, root.font-size-delta);
                            background: root.theme-bg-toolbar;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: l-name-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 5px;
                                        alignment: start;
                                        Text {
                                            text: "Name";
                                            color: root.left-sort-column == "name" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "name" ? 600 : 500;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "name"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: l-name-hdr.has-hover ? 0.85 : (root.left-sort-column == "name" ? 0.75 : 0.0);
                                        }
                                    }
                                    l-name-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "name");
                                        }
                                    }
                                }
                                if root.left-col-size : Rectangle {
                                    width: root.size-col-width;
                                    background: l-size-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Size";
                                            color: root.left-sort-column == "size" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "size" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "size"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.left-sort-column == "size" || l-size-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-size-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "size");
                                        }
                                    }
                                }
                                if root.left-col-kind : Rectangle {
                                    width: 112px;
                                    background: l-kind-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: "Kind";
                                            color: root.left-sort-column == "kind" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "kind" ? 600 : 500;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "kind"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.left-sort-column == "kind" || l-kind-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-kind-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "kind");
                                        }
                                    }
                                }
                                if root.left-col-modified : Rectangle {
                                    width: root.date-col-width;
                                    background: l-date-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Modified";
                                            color: root.left-sort-column == "modified" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "modified" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "modified"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.left-sort-column == "modified" || l-date-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-date-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "modified");
                                        }
                                    }
                                }
                                if root.left-col-added : Rectangle {
                                    width: 140px;
                                    background: l-added-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Added";
                                            color: root.left-sort-column == "added" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "added" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "added"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.left-sort-column == "added" || l-added-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-added-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "added");
                                        }
                                    }
                                }
                                if root.left-col-created : Rectangle {
                                    width: 140px;
                                    background: l-created-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Created";
                                            color: root.left-sort-column == "created" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "created" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "created"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.left-sort-column == "created" || l-created-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-created-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "created");
                                        }
                                    }
                                }
                                if root.left-col-owner : Rectangle {
                                    width: 84px;
                                    background: transparent;
                                    Text {
                                        text: "Owner";
                                        color: root.theme-text-muted;
                                        font-size: 12px + root.font-size-delta * 0.75;
                                        font-weight: 500;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.left-col-group : Rectangle {
                                    width: 84px;
                                    background: transparent;
                                    Text {
                                        text: "Group";
                                        color: root.theme-text-muted;
                                        font-size: 12px + root.font-size-delta * 0.75;
                                        font-weight: 500;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.left-col-permissions : Rectangle {
                                    width: 92px;
                                    background: l-perm-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Permissions";
                                            color: root.left-sort-column == "permissions" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.left-sort-column == "permissions" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.left-sort-column == "permissions"
                                                ? (root.left-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.left-sort-column == "permissions" || l-perm-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    l-perm-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(false, "permissions");
                                        }
                                    }
                                }
                            }
                        }

                        // LEFT PANE SCROLLABLE VIEWPORT
                        Rectangle {
                            z: 0;
                            vertical-stretch: 1;
                            background: root.theme-bg-surface;
                            clip: true;

                            l-blank-touch := TouchArea {
                                clicked => {
                                    key-router.focus();
                                    root.activate-pane(false);
                                }
                                pointer-event(ev) => {
                                    if ev.kind == PointerEventKind.down {
                                        root.activate-pane(false);
                                        if ev.button == PointerEventButton.right || (ev.button == PointerEventButton.left && root.left-rows.length == 0) {
                                            root.open-blank-context-menu(
                                                false,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y
                                            );
                                        }
                                    }
                                }
                                scroll-event(ev) => {
                                    root.scroll-pane-by-delta(false, ev.delta-y);
                                    l-flick.viewport-x = Math.clamp(
                                        l-flick.viewport-x + ev.delta-x,
                                        Math.min(0px, l-flick.width - l-flick.viewport-width),
                                        0px
                                    );
                                    return accept;
                                }
                            }

                            l-flick := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: false;
                                viewport-width: (root.left-view-mode == 0 || root.left-view-mode == 3)
                                    ? Math.max(
                                        self.width,
                                        260px
                                            + (root.left-col-size ? root.size-col-width : 0px)
                                            + (root.left-col-kind ? 120px : 0px)
                                            + (root.left-col-modified ? root.date-col-width : 0px)
                                            + (root.left-col-added ? 140px : 0px)
                                            + (root.left-col-created ? 140px : 0px)
                                            + (root.left-col-owner ? 96px : 0px)
                                            + (root.left-col-group ? 96px : 0px)
                                            + (root.left-col-permissions ? 116px : 0px)
                                    )
                                    : (root.left-view-mode == 2
                                        ? Math.max(self.width, 460px)
                                        : Math.max(self.width, 360px));
                                viewport-height: Math.min(
                                    9600px,
                                    (root.left-view-mode == 0 || root.left-view-mode == 3)
                                        ? Math.max(self.height, root.left-rows.length * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px)
                                        : (root.left-view-mode == 1
                                            ? Math.max(self.height, root.left-icon-triples.length * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 28px)
                                            : Math.max(self.height, Math.max(root.left-parent-rows.length, root.left-rows.length) * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px))
                                );

                                VerticalLayout {
                                    alignment: start;

                                    // Blank / Empty Directory or Search Result Action Card
                                    if root.left-rows.length == 0 : VerticalLayout {
                                        alignment: center;
                                        padding-top: 56px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 48px;
                                                height: 48px;
                                                border-radius: 24px;
                                                background: root.theme-bg-sidebar;
                                                border-width: 1px;
                                                border-color: root.theme-border;
                                                LucideIcon {
                                                    x: 12px;
                                                    y: 12px;
                                                    icon-size: 24px;
                                                    kind: root.left-filter-query != "" ? "search" : "folder";
                                                    icon-color: #38B6FF;
                                                    fill-color: root.left-filter-query != "" ? transparent : #4CC2FF55;
                                                }
                                            }
                                        }
                                        Text {
                                            text: root.left-filter-query != ""
                                                ? (root.left-search-running
                                                    ? "Searching subfolders…"
                                                    : "No matching items found")
                                                : "Folder is Empty";
                                            color: root.theme-text-primary;
                                            font-size: 13.5px + root.font-size-delta;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: root.left-filter-query != ""
                                                ? (root.left-search-running
                                                    ? "Scanning downstream directories for matching files and folders…"
                                                    : ("No files or folders matched \"" + root.left-filter-query + "\" in this directory or its subfolders."))
                                                : "Click anywhere or use the actions below to create items or paste.";
                                            color: root.theme-text-muted;
                                            font-size: 11.5px + root.font-size-delta;
                                            horizontal-alignment: center;
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            if root.left-filter-query != "" : ToolbarButton {
                                                icon-kind: "close";
                                                label: "Clear Search";
                                                clicked => {
                                                    root.clear-pane-filter(false);
                                                }
                                            }
                                            if root.left-filter-query == "" : ToolbarButton {
                                                icon-kind: "folder";
                                                label: "New Folder";
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.open-new-folder-modal();
                                                }
                                            }
                                            if root.left-filter-query == "" : ToolbarButton {
                                                icon-kind: "file";
                                                label: "New File";
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.open-new-file-modal();
                                                }
                                            }
                                            if root.left-filter-query == "" && root.has-clipboard-item : ToolbarButton {
                                                icon-kind: "downloads";
                                                label: "Paste Here";
                                                active: true;
                                                clicked => {
                                                    root.activate-pane(false);
                                                    root.execute-context-action("paste");
                                                }
                                            }
                                        }
                                    }

                                    // Mode 0 (List View) & Mode 3 (Tree View): Standardized 26px FileRow Table
                                    if root.left-view-mode == 0 || root.left-view-mode == 3 : VerticalLayout {
                                        alignment: start;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        spacing: 1px;
                                        for row[r-idx] in root.left-rows : FileRow {
                                            row_index: root.left-virtual-top-row + r-idx;
                                            file_name: row.name;
                                            file_size: row.size-text;
                                            file_date: row.modified-text;
                                            file_kind: row.kind-text;
                                            file_created: row.created-text;
                                            file_added: row.added-text;
                                            file_owner: row.owner-text;
                                            file_group: row.group-text;
                                            file_permissions: row.permissions-text;
                                            ext_badge: row.ext-badge;
                                            is_dir: row.is-dir;
                                            is_image: row.is-image;
                                            is_executable: row.is-executable;
                                            is_expanded: row.is-expanded;
                                            has_thumbnail: row.has-thumbnail;
                                            thumbnail: row.thumbnail;
                                            selected: row.is-selected;
                                            pane_focused: !root.right-pane-active || !root.dual-pane-mode;
                                            depth: row.depth;
                                            tree_mode: root.left-view-mode == 3;
                                            has_color_tag: row.has-color-tag;
                                            color_tag_name: row.color-tag-name;
                                            color_tag_brush: row.color-tag-brush;
                                            color_tag_tint: row.color-tag-tint;
                                            size_col_width: root.size-col-width;
                                            date_col_width: root.date-col-width;
                                            show_col_size: root.left-col-size;
                                            show_col_kind: root.left-col-kind;
                                            show_col_modified: root.left-col-modified;
                                            show_col_created: root.left-col-created;
                                            show_col_added: root.left-col-added;
                                            show_col_owner: root.left-col-owner;
                                            show_col_group: root.left-col-group;
                                            show_col_permissions: root.left-col-permissions;
                                            show_col_tags: root.left-col-tags;
                                            bold_folders: root.left-bold-folders;
                                            use_alt_bg: root.left-alt-bg;
                                            view_icon_size: root.left-icon-size * 1px;
                                            font_delta: root.font-size-delta;
                                            font_bold: root.ui-font-bold;
                                            font_family: root.resolved-font-family;
                                            row_bg: root.theme-bg-surface;
                                            row_alt_bg: root.theme-row-alt;
                                            row_hover_bg: root.theme-bg-hover;
                                            row_accent_bg: root.theme-accent;
                                            text_primary: root.theme-text-primary;
                                            text_muted: root.theme-text-muted;
                                            drag_drop_highlight: root.drag-hover-left-row == (root.left-virtual-top-row + r-idx);
                                            row-clicked(sh, cmd) => {
                                                key-router.focus();
                                                root.select-file-row-mod(false, root.left-virtual-top-row + r-idx, sh, cmd);
                                            }
                                            row-double-clicked => {
                                                key-router.focus();
                                                root.open-file-row(false, root.left-virtual-top-row + r-idx);
                                            }
                                            row-context-menu(abs_x, abs_y) => {
                                                root.open-context-menu-for-row(false, root.left-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-hovered(abs_x, abs_y) => {
                                                root.hover-file-row(false, root.left-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-unhovered => {
                                                root.hover-leave-file-row(false, root.left-virtual-top-row + r-idx);
                                            }
                                            row-shift-drag(my) => {
                                                root.shift-drag-select(
                                                    false,
                                                    root.left-virtual-top-row + r-idx + Math.round((my - 14px) / (29px + Math.max(0px, root.font-size-delta * 2.0)))
                                                );
                                            }
                                            row-drag-moved(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.drag-right-scroll-y = root.right-scroll-y;
                                                root.update-drag-cursor(false, root.left-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-drag-ended(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.drag-right-scroll-y = root.right-scroll-y;
                                                root.finish-drag-drop(false, root.left-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-drag-to-other-pane => {
                                                if root.dual-pane-mode {
                                                    root.drag-drop-row-to-other-pane(false, root.left-virtual-top-row + r-idx);
                                                }
                                            }
                                            toggle-expand => {
                                                root.toggle-expand-folder(false, root.left-virtual-top-row + r-idx);
                                            }
                                            wheel-scroll(dy) => {
                                                root.scroll-pane-by-delta(false, dy);
                                            }
                                        }
                                    }

                                    // Mode 1: 3-Column Icon Grid
                                    if root.left-view-mode == 1 : VerticalLayout {
                                        alignment: start;
                                        padding: 12px;
                                        spacing: 10px;
                                        for triple in root.left-icon-triples : HorizontalLayout {
                                            spacing: 10px;
                                            if triple.has-0 : PolaroidCell {
                                                item: triple.item-0;
                                                pane-focused: !root.right-pane-active || !root.dual-pane-mode;
                                                drag-drop-highlight: root.drag-hover-left-row == triple.idx-0;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                select-cell(sh, cmd) => {
                                                    key-router.focus();
                                                    root.select-file-row-mod(false, triple.idx-0, sh, cmd);
                                                }
                                                open-cell => {
                                                    key-router.focus();
                                                    root.open-file-row(false, triple.idx-0);
                                                }
                                                context-cell(cx, cy) => {
                                                    key-router.focus();
                                                    root.open-context-menu-for-row(false, triple.idx-0, cx, cy);
                                                }
                                                cell-hovered(abs_x, abs_y) => { root.hover-file-row(false, triple.idx-0, abs_x, abs_y); }
                                                cell-unhovered => { root.hover-leave-file-row(false, triple.idx-0); }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.update-drag-cursor(false, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.finish-drag-drop(false, triple.idx-0, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    l-flick.viewport-y = Math.clamp(
                                                        l-flick.viewport-y + dy,
                                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-0 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-1 : PolaroidCell {
                                                item: triple.item-1;
                                                pane-focused: !root.right-pane-active || !root.dual-pane-mode;
                                                drag-drop-highlight: root.drag-hover-left-row == triple.idx-1;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                select-cell(sh, cmd) => {
                                                    key-router.focus();
                                                    root.select-file-row-mod(false, triple.idx-1, sh, cmd);
                                                }
                                                open-cell => {
                                                    key-router.focus();
                                                    root.open-file-row(false, triple.idx-1);
                                                }
                                                context-cell(cx, cy) => {
                                                    key-router.focus();
                                                    root.open-context-menu-for-row(false, triple.idx-1, cx, cy);
                                                }
                                                cell-hovered(abs_x, abs_y) => { root.hover-file-row(false, triple.idx-1, abs_x, abs_y); }
                                                cell-unhovered => { root.hover-leave-file-row(false, triple.idx-1); }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.update-drag-cursor(false, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.finish-drag-drop(false, triple.idx-1, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    l-flick.viewport-y = Math.clamp(
                                                        l-flick.viewport-y + dy,
                                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-1 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-2 : PolaroidCell {
                                                item: triple.item-2;
                                                pane-focused: !root.right-pane-active || !root.dual-pane-mode;
                                                drag-drop-highlight: root.drag-hover-left-row == triple.idx-2;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                select-cell(sh, cmd) => {
                                                    key-router.focus();
                                                    root.select-file-row-mod(false, triple.idx-2, sh, cmd);
                                                }
                                                open-cell => {
                                                    key-router.focus();
                                                    root.open-file-row(false, triple.idx-2);
                                                }
                                                context-cell(cx, cy) => {
                                                    key-router.focus();
                                                    root.open-context-menu-for-row(false, triple.idx-2, cx, cy);
                                                }
                                                cell-hovered(abs_x, abs_y) => { root.hover-file-row(false, triple.idx-2, abs_x, abs_y); }
                                                cell-unhovered => { root.hover-leave-file-row(false, triple.idx-2); }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.update-drag-cursor(false, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.finish-drag-drop(false, triple.idx-2, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    l-flick.viewport-y = Math.clamp(
                                                        l-flick.viewport-y + dy,
                                                        Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-2 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                        }
                                    }

                                    // Mode 2: 3-Column Miller Columns View (Parent | Current Directory | Live Preview & Media Metadata)
                                    if root.left-view-mode == 2 : HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            alignment: start;
                                            width: root.miller-col-width;
                                            for p-row[p-idx] in root.left-parent-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                background: p-row.is-selected
                                                    ? root.theme-bg-hover
                                                    : (p-row.has-color-tag ? p-row.color-tag-tint : transparent);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 18px;
                                                        background: transparent;
                                                        if !p-row.is-dir && p-row.has-thumbnail : Image {
                                                            x: 0px;
                                                            y: (parent.height - 18px) / 2;
                                                            width: 18px;
                                                            height: 18px;
                                                            image-fit: contain;
                                                            source: p-row.thumbnail;
                                                        }
                                                        if p-row.is-dir || !p-row.has-thumbnail : LucideIcon {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: p-row.is-dir
                                                                ? "folder"
                                                                : (p-row.ext-badge == "APP"
                                                                    ? "applications"
                                                                    : (p-row.is-image
                                                                        ? "image"
                                                                        : ((p-row.ext-badge == "ZIP" || p-row.ext-badge == "TAR" || p-row.ext-badge == "GZ" || p-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((p-row.ext-badge == "MP3" || p-row.ext-badge == "FLAC" || p-row.ext-badge == "WAV" || p-row.ext-badge == "M4A" || p-row.ext-badge == "OGG" || p-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((p-row.ext-badge == "MP4" || p-row.ext-badge == "MKV" || p-row.ext-badge == "MOV" || p-row.ext-badge == "AVI" || p-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : (p-row.is-executable ? "terminal" : "documents"))))));
                                                            icon-color: p-row.has-color-tag
                                                                ? p-row.color-tag-brush
                                                                : ((p-row.is-dir || p-row.ext-badge == "APP")
                                                                    ? #38B6FF
                                                                    : (p-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (p-row.is-image ? #6E92B8 : #A0A0AB)));
                                                            fill-color: p-row.is-dir
                                                                ? (p-row.has-color-tag ? p-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: p-row.name;
                                                        color: root.theme-text-primary;
                                                        font-size: 12px + root.font-size-delta;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if p-row.has-color-tag : Rectangle {
                                                        width: 7px;
                                                        height: 7px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3.5px;
                                                        background: p-row.color-tag-brush;
                                                    }
                                                    if p-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: root.theme-text-muted;
                                                    }
                                                }
                                                TouchArea {
                                                    clicked => { root.open-parent-row(false, p-idx); }
                                                    scroll-event(ev) => {
                                                        l-flick.viewport-y = Math.clamp(
                                                            l-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: start;
                                            horizontal-stretch: 1;
                                            for c-row[c-idx] in root.left-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                border-width: root.drag-hover-left-row == c-idx ? 1px : 0px;
                                                border-color: root.drag-hover-left-row == c-idx ? root.theme-accent : transparent;
                                                background: root.drag-hover-left-row == c-idx
                                                    ? #0D52BF38
                                                    : (c-row.is-selected
                                                        ? ((!root.right-pane-active || !root.dual-pane-mode) ? root.theme-accent : #2E323B)
                                                        : (l-col-touch.has-hover
                                                            ? root.theme-bg-hover
                                                            : (c-row.has-color-tag ? c-row.color-tag-tint : transparent)));
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 20px;
                                                        background: transparent;
                                                        if !c-row.is-dir && c-row.has-thumbnail : Rectangle {
                                                            x: 0px;
                                                            y: (parent.height - 20px) / 2;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 3px;
                                                            background: #121215;
                                                            border-width: 1px;
                                                            border-color: c-row.is-selected ? #FFFFFFAA : #32323A;
                                                            clip: true;
                                                            Image {
                                                                x: 1px;
                                                                y: 1px;
                                                                width: 18px;
                                                                height: 18px;
                                                                image-fit: contain;
                                                                source: c-row.thumbnail;
                                                            }
                                                        }
                                                        if c-row.is-dir || !c-row.has-thumbnail : LucideIcon {
                                                            x: 2px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: c-row.is-dir
                                                                ? "folder"
                                                                : (c-row.ext-badge == "APP"
                                                                    ? "applications"
                                                                    : (c-row.is-image
                                                                        ? "image"
                                                                        : ((c-row.ext-badge == "ZIP" || c-row.ext-badge == "TAR" || c-row.ext-badge == "GZ" || c-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((c-row.ext-badge == "MP3" || c-row.ext-badge == "FLAC" || c-row.ext-badge == "WAV" || c-row.ext-badge == "M4A" || c-row.ext-badge == "OGG" || c-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((c-row.ext-badge == "MP4" || c-row.ext-badge == "MKV" || c-row.ext-badge == "MOV" || c-row.ext-badge == "AVI" || c-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : (c-row.is-executable ? "terminal" : "documents"))))));
                                                            icon-color: c-row.has-color-tag
                                                                ? c-row.color-tag-brush
                                                                : ((c-row.is-dir || c-row.ext-badge == "APP")
                                                                    ? #38B6FF
                                                                    : (c-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (c-row.is-image ? #6E92B8 : #A0A0AB)));
                                                            fill-color: c-row.is-dir
                                                                ? (c-row.has-color-tag ? c-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: c-row.name;
                                                        color: c-row.is-selected ? #FFFFFF : root.theme-text-primary;
                                                        font-size: 12.5px + root.font-size-delta;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if c-row.has-color-tag : Rectangle {
                                                        width: l-col-tag.preferred-width;
                                                        height: 17px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 8.5px;
                                                        background: c-row.is-selected ? #00000044 : c-row.color-tag-tint;
                                                        border-width: 1px;
                                                        border-color: c-row.is-selected ? #FFFFFF88 : c-row.color-tag-brush;
                                                        l-col-tag := HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 6px;
                                                            spacing: 4px;
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 6px;
                                                                height: 6px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 3px;
                                                                background: c-row.color-tag-brush;
                                                            }
                                                            Text {
                                                                text: c-row.color-tag-name;
                                                                color: c-row.is-selected ? #FFFFFF : #F2F2F7;
                                                                font-size: 10px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if c-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: c-row.is-selected ? #FFFFFF : root.theme-text-muted;
                                                    }
                                                }
                                                l-col-touch := TouchArea {
                                                    clicked => {
                                                        root.show-hover-preview = false;
                                                        key-router.focus();
                                                        if !root.col-suppress-click {
                                                            root.select-file-row-mod(
                                                                false,
                                                                c-idx,
                                                                root.col-down-shift,
                                                                root.col-down-cmd
                                                            );
                                                        }
                                                        root.col-suppress-click = false;
                                                        root.col-down-shift = false;
                                                        root.col-down-cmd = false;
                                                    }
                                                    double-clicked => {
                                                        root.show-hover-preview = false;
                                                        root.open-file-row(false, c-idx);
                                                    }
                                                    moved => {
                                                        if self.pressed && !root.col-down-shift && !root.col-down-cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                                                            root.show-hover-preview = false;
                                                            root.col-drag-active = true;
                                                            root.col-suppress-click = true;
                                                            root.drag-left-pane-w = l-flick.width;
                                                            root.drag-left-scroll-y = l-flick.viewport-y;
                                                            root.update-drag-cursor(
                                                                false,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    changed has-hover => {
                                                        if self.has-hover && !self.pressed && !root.col-drag-active {
                                                            root.hover-file-row(
                                                                false,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        } else if !self.has-hover {
                                                            root.hover-leave-file-row(false, c-idx);
                                                        }
                                                    }
                                                    pointer-event(ev) => {
                                                        if ev.kind == PointerEventKind.move && !self.pressed && !root.col-drag-active {
                                                            root.hover-file-row(
                                                                false,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            key-router.focus();
                                                            root.col-down-shift = ev.modifiers.shift;
                                                            root.col-down-cmd = ev.modifiers.control || ev.modifiers.meta;
                                                            root.col-drag-active = false;
                                                            root.col-suppress-click = false;
                                                        }
                                                        if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                                                            if root.col-drag-active {
                                                                root.col-drag-active = false;
                                                                root.drag-left-pane-w = l-flick.width;
                                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                                root.finish-drag-drop(
                                                                    false,
                                                                    c-idx,
                                                                    self.absolute-position.x + self.mouse-x,
                                                                    self.absolute-position.y + self.mouse-y
                                                                );
                                                            }
                                                            if ev.kind == PointerEventKind.cancel {
                                                                root.col-suppress-click = false;
                                                                root.col-down-shift = false;
                                                                root.col-down-cmd = false;
                                                            }
                                                        }
                                                        if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            root.col-suppress-click = true;
                                                            root.open-context-menu-for-row(
                                                                false,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    scroll-event(ev) => {
                                                        l-flick.viewport-y = Math.clamp(
                                                            l-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }

                                        // Column 3: Miller Preview & Photo/Music/Video Metadata Column
                                        if root.inspector-title != "" : Rectangle {
                                            width: 248px;
                                            border-radius: 6px;
                                            background: root.theme-bg-sidebar;
                                            border-width: 1px;
                                            border-color: root.theme-border;
                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 8px;
                                                alignment: start;

                                                // Visual Preview Box (Photo Raster or Text/JSON/Code Snippet — no binary dump)
                                                Rectangle {
                                                    height: 132px;
                                                    border-radius: 6px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    clip: true;

                                                    if root.inspector-is-dir : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 48px;
                                                        kind: "folder";
                                                        icon-color: #38B6FF;
                                                        fill-color: #4CC2FF;
                                                    }
                                                    if !root.inspector-is-dir && root.inspector-has-image : Image {
                                                        x: 4px;
                                                        y: 4px;
                                                        width: parent.width - 8px;
                                                        height: parent.height - 8px;
                                                        image-fit: contain;
                                                        source: root.inspector-preview-image;
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && root.inspector-has-text-preview : VerticalLayout {
                                                        padding: 6px;
                                                        alignment: start;
                                                        Text {
                                                            text: root.inspector-preview-text;
                                                            color: root.theme-text-primary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && !root.inspector-has-text-preview : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 44px;
                                                        kind: "documents";
                                                        icon-color: root.theme-text-secondary;
                                                    }
                                                }

                                                Text {
                                                    text: root.inspector-title;
                                                    color: root.theme-text-primary;
                                                    font-size: 12.5px + root.font-size-delta;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: root.inspector-subtitle + "  •  " + root.inspector-size;
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.font-size-delta;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: "Modified: " + root.inspector-modified;
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }
                                                Text {
                                                    text: "Permissions: " + root.inspector-perm-symbolic + " (" + root.inspector-perm-octal + ")";
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }

                                                // Direct Photo / Music / Video Meta Information in Columns View
                                                if root.inspector-media-category != "" : Rectangle {
                                                    border-radius: 5px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    VerticalLayout {
                                                        padding: 7px;
                                                        spacing: 3px;
                                                        Text {
                                                            text: root.inspector-media-category;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-weight: 700;
                                                        }
                                                        if root.inspector-media-line1 != "" : Text {
                                                            text: root.inspector-media-line1;
                                                            color: root.theme-text-primary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                        if root.inspector-media-line2 != "" : Text {
                                                            text: root.inspector-media-line2;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                        if root.inspector-media-line3 != "" : Text {
                                                            text: root.inspector-media-line3;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Miller Columns draggable vertical divider clipped to viewport height
                            if root.left-view-mode == 2 : Rectangle {
                                x: root.miller-col-width + l-flick.viewport-x;
                                y: 0px;
                                width: 4px;
                                height: parent.height;
                                background: l-miller-resizer.has-hover || l-miller-resizer.pressed ? root.theme-accent : root.theme-border;
                                l-miller-resizer := TouchArea {
                                    mouse-cursor: col-resize;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                            root.col-resize-start-w = root.miller-col-width;
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.miller-col-width = Math.clamp(
                                                root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                130px,
                                                340px
                                            );
                                        }
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Vertical Scrollbar for Left Pane
                            if l-flick.viewport-height > l-flick.height || root.left-total-rows > root.left-rows.length : Rectangle {
                                z: 25;
                                x: parent.width - 12px;
                                y: 2px;
                                width: 10px;
                                height: parent.height - (l-flick.viewport-width > l-flick.width ? 14px : 4px);
                                border-radius: 5px;
                                background: l-vbar-touch.has-hover || l-vbar-touch.pressed ? #141417DD : #16161888;

                                l-vthumb := Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: (l-vbar-touch.has-hover || l-vbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.width / 2;
                                    background: l-vbar-touch.pressed
                                        ? root.theme-accent
                                        : (l-vbar-touch.has-hover ? #8E8E98 : #52525E);
                                    height: (root.left-view-mode == 0 || root.left-view-mode == 3) && root.left-total-rows > root.left-rows.length
                                        ? Math.max(28px, parent.height * (root.left-rows.length / Math.max(1.0, root.left-total-rows * 1.0)))
                                        : Math.max(28px, parent.height * (l-flick.height / l-flick.viewport-height));
                                    y: (root.left-view-mode == 0 || root.left-view-mode == 3) && root.left-total-rows > root.left-rows.length
                                        ? (parent.height - self.height) * (root.left-virtual-top-row / Math.max(1.0, (root.left-total-rows - root.left-rows.length) * 1.0))
                                        : (parent.height - self.height) * (-l-flick.viewport-y / Math.max(1px, l-flick.viewport-height - l-flick.height));
                                }

                                l-vbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(false);
                                            if (root.left-view-mode == 0 || root.left-view-mode == 3) && root.left-total-rows > root.left-rows.length {
                                                root.set-virtual-scroll-row(
                                                    false,
                                                    Math.clamp(
                                                        Math.round(
                                                            ((self.mouse-y - l-vthumb.height / 2) / Math.max(1px, self.height - l-vthumb.height))
                                                                * Math.max(1, root.left-total-rows - root.left-rows.length)
                                                        ),
                                                        0,
                                                        Math.max(0, root.left-total-rows - root.left-rows.length)
                                                    )
                                                );
                                            } else {
                                                l-flick.viewport-y = Math.clamp(
                                                    -((self.mouse-y - l-vthumb.height / 2) / Math.max(1px, self.height - l-vthumb.height))
                                                        * (l-flick.viewport-height - l-flick.height),
                                                    Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                    0px
                                                );
                                            }
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            if (root.left-view-mode == 0 || root.left-view-mode == 3) && root.left-total-rows > root.left-rows.length {
                                                root.set-virtual-scroll-row(
                                                    false,
                                                    Math.clamp(
                                                        Math.round(
                                                            ((self.mouse-y - l-vthumb.height / 2) / Math.max(1px, self.height - l-vthumb.height))
                                                                * Math.max(1, root.left-total-rows - root.left-rows.length)
                                                        ),
                                                        0,
                                                        Math.max(0, root.left-total-rows - root.left-rows.length)
                                                    )
                                                );
                                            } else {
                                                l-flick.viewport-y = Math.clamp(
                                                    -((self.mouse-y - l-vthumb.height / 2) / Math.max(1px, self.height - l-vthumb.height))
                                                        * (l-flick.viewport-height - l-flick.height),
                                                    Math.min(0px, l-flick.height - l-flick.viewport-height),
                                                    0px
                                                );
                                            }
                                        }
                                    }
                                    scroll-event(ev) => {
                                        root.scroll-pane-by-delta(false, ev.delta-y);
                                        return accept;
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Horizontal Scrollbar for Left Pane
                            if l-flick.viewport-width > l-flick.width : Rectangle {
                                z: 25;
                                x: 2px;
                                y: parent.height - 12px;
                                width: parent.width - (l-flick.viewport-height > l-flick.height ? 14px : 4px);
                                height: 10px;
                                border-radius: 5px;
                                background: l-hbar-touch.has-hover || l-hbar-touch.pressed ? #141417DD : #16161888;

                                l-hthumb := Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: (l-hbar-touch.has-hover || l-hbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.height / 2;
                                    background: l-hbar-touch.pressed
                                        ? root.theme-accent
                                        : (l-hbar-touch.has-hover ? #8E8E98 : #52525E);
                                    width: Math.max(28px, parent.width * (l-flick.width / l-flick.viewport-width));
                                    x: (parent.width - self.width) * (-l-flick.viewport-x / Math.max(1px, l-flick.viewport-width - l-flick.width));
                                }

                                l-hbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(false);
                                            l-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - l-hthumb.width / 2) / Math.max(1px, self.width - l-hthumb.width))
                                                    * (l-flick.viewport-width - l-flick.width),
                                                Math.min(0px, l-flick.width - l-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            l-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - l-hthumb.width / 2) / Math.max(1px, self.width - l-hthumb.width))
                                                    * (l-flick.viewport-width - l-flick.width),
                                                Math.min(0px, l-flick.width - l-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 2B-SPLITTER: Draggable 6px Splitter Handle in Dual-Pane Mode (1:1 smooth absolute pointer math)
                if root.dual-pane-mode : Rectangle {
                    z: 20;
                    x: root.panes-layout == 2 ? 0px : (root.panes-avail-width * root.split-ratio + 4px);
                    y: root.panes-layout == 2 ? (Math.max(120px, (parent.height - 10px) * root.split-ratio) + 2px) : 0px;
                    width: root.panes-layout == 2 ? parent.width : 6px;
                    height: root.panes-layout == 2 ? 6px : parent.height;
                    horizontal-stretch: 0;
                    border-radius: 3px;
                    background: splitter-touch.has-hover || splitter-touch.pressed ? root.theme-accent : root.theme-border;
                    splitter-touch := TouchArea {
                        mouse-cursor: root.panes-layout == 2 ? row-resize : col-resize;
                        moved => {
                            if self.pressed {
                                if root.panes-layout == 2 {
                                    root.split-ratio = Math.clamp(
                                        ((self.absolute-position.y + self.mouse-y) - 48px)
                                            / Math.max(200px, parent.height - 10px),
                                        0.20,
                                        0.80
                                    );
                                } else {
                                    root.split-ratio = Math.clamp(
                                        ((self.absolute-position.x + self.mouse-x) - (root.sidebar-width + 10px))
                                            / Math.max(200px, root.panes-avail-width),
                                        0.20,
                                        0.80
                                    );
                                }
                                root.set-split-ratio(root.split-ratio);
                            }
                        }
                    }
                }

                // 2C. SECONDARY (RIGHT / BOTTOM) FILE BROWSING PANE (Explicit width guarantees Right Inspector Drawer stays visible)
                if root.dual-pane-mode : Rectangle {
                    x: root.panes-layout == 2 ? 0px : (root.panes-avail-width * root.split-ratio + 14px);
                    y: root.panes-layout == 2 ? (Math.max(120px, (parent.height - 10px) * root.split-ratio) + 10px) : 0px;
                    width: root.panes-layout == 2 ? parent.width : (root.panes-avail-width * (1.0 - root.split-ratio));
                    height: root.panes-layout == 2
                        ? Math.max(120px, parent.height - Math.max(120px, (parent.height - 10px) * root.split-ratio) - 10px)
                        : parent.height;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    background: root.theme-bg-surface;
                    border-width: (root.dual-pane-mode && root.right-pane-active) ? 2px : 1px;
                    border-color: root.drag-hover-right-pane
                        ? root.theme-accent
                        : (root.right-pane-active ? root.theme-accent : root.theme-border);
                    opacity: root.right-pane-active ? 1.0 : 0.84;
                    clip: true;

                    VerticalLayout {
                        // Right Pane Tab Bar (Matches reference screenshot: dark #08080A active tab pill, #212126 inactive tab pill, monochrome outline icons, hover-only close button)
                        Rectangle {
                            z: 30;
                            height: 38px + Math.max(0px, root.font-size-delta * 1.5);
                            background: root.theme-bg-sidebar;
                            border-width: 0px;

                            for tab[t-idx] in root.right-tabs : Rectangle {
                                x: 8px + t-idx * (root.right-tab-pill-width + 6px);
                                y: 5px;
                                width: root.right-tab-pill-width;
                                height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                                background: transparent;

                                // Animated visual tab card (smoothly shifts left/right when a tab is dragged across it)
                                Rectangle {
                                    x: (root.dragging-tab-active && root.dragging-tab-is-right && root.drag-tab-hover-right && root.drag-tab-hover-idx >= 0)
                                        ? (t-idx == root.dragging-tab-idx
                                            ? ((root.drag-tab-hover-idx - root.dragging-tab-idx) * (root.right-tab-pill-width + 6px))
                                            : ((t-idx > root.dragging-tab-idx && t-idx <= root.drag-tab-hover-idx)
                                                ? -(root.right-tab-pill-width + 6px)
                                                : ((t-idx < root.dragging-tab-idx && t-idx >= root.drag-tab-hover-idx)
                                                    ? (root.right-tab-pill-width + 6px)
                                                    : 0px)))
                                        : ((root.dragging-tab-active && !root.dragging-tab-is-right && root.drag-tab-hover-right && root.drag-tab-hover-idx >= 0 && t-idx >= root.drag-tab-hover-idx)
                                            ? (root.right-tab-pill-width + 6px)
                                            : 0px);
                                    animate x { duration: 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1.0); }
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 6px;
                                    opacity: (root.dragging-tab-active && root.dragging-tab-is-right && root.dragging-tab-idx == t-idx) ? 0.32 : 1.0;
                                    background: root.drag-hover-right-tab == t-idx
                                        ? #0D52BF38
                                        : ((root.dragging-tab-active && root.dragging-tab-is-right && root.dragging-tab-idx == t-idx)
                                            ? #101014
                                            : (tab.is-active
                                                ? #08080A
                                                : (r-tab-touch.has-hover && !root.dragging-tab-active ? #2A2A31 : #212126)));
                                    border-width: (root.drag-hover-right-tab == t-idx || (root.dragging-tab-active && root.dragging-tab-is-right && root.dragging-tab-idx == t-idx)) ? 1px : 0px;
                                    border-color: root.drag-hover-right-tab == t-idx ? root.theme-accent : #32323C;

                                    if !(root.dragging-tab-active && root.dragging-tab-is-right && root.dragging-tab-idx == t-idx) : HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;

                                        Rectangle {
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            clip: true;
                                            background: transparent;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Rectangle {
                                                    width: 16px;
                                                    background: transparent;
                                                    LucideIcon {
                                                        x: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 15px;
                                                        kind: tab.icon-kind != "" ? tab.icon-kind : "folder";
                                                        icon-color: tab.is-active ? #FFFFFF : (r-tab-touch.has-hover ? #C8C8D2 : #8E8E98);
                                                        fill-color: transparent;
                                                    }
                                                }
                                                Text {
                                                    text: tab.title;
                                                    color: tab.is-active ? #FFFFFF : (r-tab-touch.has-hover ? #D8D8E2 : #9898A2);
                                                    font-size: 13px + root.font-size-delta;
                                                    font-weight: tab.is-active ? 600 : (root.ui-font-bold ? 600 : 500);
                                                    min-width: 0px;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if r-tab-touch.has-hover && !r-tab-touch.pressed && !root.dragging-tab-active && tab.tooltip != "" : Rectangle {
                                                z: 3000;
                                                x: 0px;
                                                y: parent.height + 5px;
                                                height: 22px;
                                                width: r-tab-tt.preferred-width + 14px;
                                                border-radius: 4px;
                                                background: root.theme-bg-popover;
                                                border-width: 1px;
                                                border-color: #3A3A44;
                                                r-tab-tt := Text {
                                                    x: 7px;
                                                    y: (parent.height - self.height) / 2;
                                                    text: tab.tooltip;
                                                    color: #F2F2F7;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                }
                                            }
                                        }

                                        if root.right-tabs.length > 1 : Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: 5px;
                                            border-radius: 4px;
                                            opacity: (r-tab-touch.has-hover || r-close-touch.has-hover) && !root.dragging-tab-active ? 1.0 : 0.0;
                                            background: r-close-touch.has-hover ? #2C2C34 : transparent;
                                            LucideIcon {
                                                x: 4px;
                                                y: 4px;
                                                icon-size: 10px;
                                                kind: "close";
                                                icon-color: r-close-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                            }
                                            r-close-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.close-tab(true, t-idx); }
                                            }
                                        }
                                    }
                                }

                                r-tab-touch := TouchArea {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width - (root.right-tabs.length > 1 ? 24px : 0px);
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        key-router.focus();
                                        if !root.dragging-tab-active {
                                            root.activate-pane(true);
                                            root.select-tab(true, t-idx);
                                        }
                                    }
                                    moved => {
                                        if self.pressed && Math.abs(self.mouse-x - self.pressed-x) > 8px {
                                            if !root.dragging-tab-active {
                                                root.dragging-tab-active = true;
                                                root.dragging-tab-is-right = true;
                                                root.dragging-tab-idx = t-idx;
                                                root.drag-tab-title = tab.title;
                                                root.drag-tab-icon = tab.icon-kind != "" ? tab.icon-kind : "folder";
                                                root.drag-tab-width = root.right-tab-pill-width;
                                                root.drag-tab-grab-offset-x = self.pressed-x;
                                                root.drag-tab-grab-offset-y = self.pressed-y;
                                            }
                                            root.drag-tab-mouse-x = self.absolute-position.x + self.mouse-x;
                                            root.drag-tab-mouse-y = self.absolute-position.y + self.mouse-y;
                                            if root.drag-tab-mouse-x < (root.sidebar-width + root.panes-avail-width * root.split-ratio + 10px) {
                                                root.drag-tab-hover-right = false;
                                                root.drag-tab-hover-idx = Math.clamp(
                                                    Math.round((root.drag-tab-mouse-x - (root.sidebar-width + 18px) - root.left-tab-pill-width / 2) / (root.left-tab-pill-width + 6px)),
                                                    0,
                                                    Math.max(0, root.left-tabs.length - 1)
                                                );
                                            } else {
                                                root.drag-tab-hover-right = true;
                                                root.drag-tab-hover-idx = Math.clamp(
                                                    Math.round((root.drag-tab-mouse-x - (root.sidebar-width + root.panes-avail-width * root.split-ratio + 18px) - root.right-tab-pill-width / 2) / (root.right-tab-pill-width + 6px)),
                                                    0,
                                                    Math.max(0, root.right-tabs.length - 1)
                                                );
                                            }
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.dragging-tab-active {
                                            root.dragging-tab-active = false;
                                            root.move-tab(true, t-idx, root.drag-tab-hover-right, root.drag-tab-hover-idx);
                                            root.drag-tab-hover-idx = -1;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                x: 8px + root.right-tabs.length * (root.right-tab-pill-width + 6px);
                                y: 6px;
                                width: 26px;
                                height: 26px;
                                border-radius: 5px;
                                background: r-add-touch.has-hover ? #26262E : transparent;
                                border-width: 0px;
                                LucideIcon {
                                    x: 6.5px;
                                    y: 6.5px;
                                    icon-size: 13px;
                                    kind: "plus";
                                    icon-color: r-add-touch.has-hover ? #FFFFFF : root.theme-text-muted;
                                }
                                if r-add-touch.has-hover && !r-add-touch.pressed : Rectangle {
                                    z: 3000;
                                    x: 0px;
                                    y: parent.height + 5px;
                                    height: 22px;
                                    width: 126px;
                                    border-radius: 4px;
                                    background: root.theme-bg-popover;
                                    border-width: 1px;
                                    border-color: #3A3A44;
                                    Text {
                                        x: 7px;
                                        y: (parent.height - self.height) / 2;
                                        text: "New Tab (Ctrl/Cmd+T)";
                                        color: #F2F2F7;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                                r-add-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.add-tab(true); }
                                }
                            }
                        }

                        // Full-Width Horizontal Active Accent Bar below Right Tab Bar (Bound to active theme accent color)
                        Rectangle {
                            height: 2.5px;
                            background: root.right-pane-active ? root.theme-accent : #2C2C34;
                        }

                        // Right Pane Two-Line Path & Status Header Bar (Switches to clickable "Search: \"...\"" pill during search)
                        Rectangle {
                            height: 50px + Math.max(0px, root.font-size-delta * 2.0);
                            background: root.theme-bg-surface;
                            border-width: 0px;

                            if !root.right-path-edit-mode : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                Rectangle {
                                    width: 30px;
                                    background: transparent;
                                    LucideIcon {
                                        x: 1px;
                                        y: (parent.height - self.height) / 2;
                                        icon-size: 28px;
                                        kind: root.right-filter-query != ""
                                            ? "search-circle"
                                            : (root.right-header-icon != "" ? root.right-header-icon : "home");
                                        icon-color: #F2F2F7;
                                    }
                                    if root.right-filter-query != "" : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            key-router.focus();
                                            root.clear-pane-filter(true);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;

                                    if root.right-filter-query != "" : HorizontalLayout {
                                        alignment: start;
                                        Rectangle {
                                            height: 22px + Math.max(0px, root.font-size-delta * 1.0);
                                            border-radius: 5px;
                                            background: r-search-pill-touch.pressed
                                                ? #2E2E38
                                                : (r-search-pill-touch.has-hover ? #24242C : #0C0C0E);
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: "Search: \"" + root.right-filter-query + "\"";
                                                    color: #FFFFFF;
                                                    font-size: 13.5px + root.font-size-delta;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            r-search-pill-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    key-router.focus();
                                                    root.clear-pane-filter(true);
                                                }
                                            }
                                        }
                                    }

                                    if root.right-filter-query == "" : HorizontalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for seg[s-idx] in root.right-breadcrumb-segments : HorizontalLayout {
                                            spacing: 2px;
                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: r-seg-touch.has-hover ? root.theme-bg-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    Text {
                                                        text: seg.label;
                                                        color: seg.is-last ? #FFFFFF : #D8D8E0;
                                                        font-size: 13.5px + root.font-size-delta;
                                                        font-weight: seg.is-last ? 600 : 500;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                r-seg-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        key-router.focus();
                                                        root.activate-pane(true);
                                                        root.navigate-to-breadcrumb(true, seg.target-path);
                                                    }
                                                }
                                            }
                                            if !seg.is-last : Rectangle {
                                                width: 14px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: r-chev-touch.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 1px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: r-chev-touch.has-hover ? "chevron-down" : "chevron-right";
                                                    icon-color: #9898A2;
                                                    opacity: r-chev-touch.has-hover ? 0.95 : 0.65;
                                                }
                                                r-chev-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(true);
                                                        root.open-sibling-dropdown(
                                                            true,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }
                                            if seg.is-last : Rectangle {
                                                width: 16px;
                                                height: 20px;
                                                border-radius: 4px;
                                                opacity: r-leaf-chev.has-hover ? 1.0 : 0.0;
                                                background: r-leaf-chev.has-hover ? root.theme-bg-hover : transparent;
                                                LucideIcon {
                                                    x: 2px;
                                                    y: 4px;
                                                    icon-size: 12px;
                                                    kind: "chevron-down";
                                                    icon-color: root.theme-text-primary;
                                                }
                                                r-leaf-chev := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.activate-pane(true);
                                                        root.open-sibling-dropdown(
                                                            true,
                                                            seg.target-path,
                                                            self.absolute-position.x,
                                                            self.absolute-position.y + self.height + 4px
                                                        );
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 20px;
                                            background: transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.activate-pane(true);
                                                    root.right-path-edit-mode = true;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        alignment: start;
                                        Text {
                                            text: root.right-search-running && root.right-filter-query != ""
                                                ? ("Searching subfolders… • " + root.right-status-subtitle)
                                                : root.right-status-subtitle;
                                            color: root.right-search-running && root.right-filter-query != "" ? #6E92B8 : #8E8E98;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            if root.right-path-edit-mode : HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                CleanLineEdit {
                                    y: 11px;
                                    horizontal-stretch: 1;
                                    text <=> root.right-path-input;
                                    placeholder-text: "/path/to/directory";
                                    font-size: 12.5px + root.font-size-delta * 0.5;
                                    accepted(val) => {
                                        root.right-path-edit-mode = false;
                                        key-router.focus();
                                        root.commit-path-input(true, val);
                                    }
                                    escape-pressed => {
                                        root.right-path-edit-mode = false;
                                        key-router.focus();
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Tab";
                                    clicked => {
                                        root.autocomplete-path-input(true, root.right-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    label: "Go";
                                    active: true;
                                    clicked => {
                                        root.right-path-edit-mode = false;
                                        root.commit-path-input(true, root.right-path-input);
                                    }
                                }
                                ToolbarButton {
                                    y: 9px;
                                    icon-kind: "close";
                                    clicked => { root.right-path-edit-mode = false; }
                                }
                            }
                        }

                        // Right Pane Table Header Row (Dynamic Columns controlled by Show View Options)
                        if root.right-view-mode == 0 || root.right-view-mode == 3 : Rectangle {
                            z: 10;
                            height: 26px + Math.max(0px, root.font-size-delta);
                            background: root.theme-bg-toolbar;
                            border-width: 1px;
                            border-color: root.theme-border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: r-name-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 5px;
                                        alignment: start;
                                        Text {
                                            text: "Name";
                                            color: root.right-sort-column == "name" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "name" ? 600 : 500;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "name"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: r-name-hdr.has-hover ? 0.85 : (root.right-sort-column == "name" ? 0.75 : 0.0);
                                        }
                                    }
                                    r-name-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "name");
                                        }
                                    }
                                }
                                if root.right-col-size : Rectangle {
                                    width: root.size-col-width;
                                    background: r-size-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Size";
                                            color: root.right-sort-column == "size" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "size" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "size"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.right-sort-column == "size" || r-size-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-size-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "size");
                                        }
                                    }
                                }
                                if root.right-col-kind : Rectangle {
                                    width: 112px;
                                    background: r-kind-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: "Kind";
                                            color: root.right-sort-column == "kind" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "kind" ? 600 : 500;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "kind"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.right-sort-column == "kind" || r-kind-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-kind-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "kind");
                                        }
                                    }
                                }
                                if root.right-col-modified : Rectangle {
                                    width: root.date-col-width;
                                    background: r-date-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Modified";
                                            color: root.right-sort-column == "modified" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "modified" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "modified"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.right-sort-column == "modified" || r-date-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-date-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "modified");
                                        }
                                    }
                                }
                                if root.right-col-added : Rectangle {
                                    width: 140px;
                                    background: r-added-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Added";
                                            color: root.right-sort-column == "added" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "added" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "added"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.right-sort-column == "added" || r-added-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-added-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "added");
                                        }
                                    }
                                }
                                if root.right-col-created : Rectangle {
                                    width: 140px;
                                    background: r-created-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Date Created";
                                            color: root.right-sort-column == "created" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "created" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "created"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.right-sort-column == "created" || r-created-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-created-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "created");
                                        }
                                    }
                                }
                                if root.right-col-owner : Rectangle {
                                    width: 84px;
                                    background: transparent;
                                    Text {
                                        text: "Owner";
                                        color: root.theme-text-muted;
                                        font-size: 12px + root.font-size-delta * 0.75;
                                        font-weight: 500;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.right-col-group : Rectangle {
                                    width: 84px;
                                    background: transparent;
                                    Text {
                                        text: "Group";
                                        color: root.theme-text-muted;
                                        font-size: 12px + root.font-size-delta * 0.75;
                                        font-weight: 500;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                    }
                                }
                                if root.right-col-permissions : Rectangle {
                                    width: 92px;
                                    background: r-perm-hdr.has-hover ? root.theme-bg-hover : transparent;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        alignment: end;
                                        Text {
                                            text: "Permissions";
                                            color: root.right-sort-column == "permissions" ? root.theme-text-primary : root.theme-text-muted;
                                            font-size: 12px + root.font-size-delta * 0.75;
                                            font-weight: root.right-sort-column == "permissions" ? 600 : 500;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 10px;
                                            kind: root.right-sort-column == "permissions"
                                                ? (root.right-sort-ascending ? "chevron-up" : "chevron-down")
                                                : "arrow-up-down";
                                            icon-color: root.theme-text-secondary;
                                            opacity: (root.right-sort-column == "permissions" || r-perm-hdr.has-hover) ? 0.75 : 0.0;
                                        }
                                    }
                                    r-perm-hdr := TouchArea {
                                        clicked => {
                                            key-router.focus();
                                            root.sort-by-column(true, "permissions");
                                        }
                                    }
                                }
                            }
                        }

                        // RIGHT PANE SCROLLABLE VIEWPORT (#1A1A1E)
                        Rectangle {
                            z: 0;
                            vertical-stretch: 1;
                            background: root.theme-bg-surface;
                            clip: true;

                            r-blank-touch := TouchArea {
                                clicked => {
                                    key-router.focus();
                                    root.show-hover-preview = false;
                                    root.activate-pane(true);
                                }
                                moved => {
                                    root.show-hover-preview = false;
                                }
                                pointer-event(ev) => {
                                    if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                        root.open-blank-context-menu(
                                            true,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y
                                        );
                                    }
                                    if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down && root.right-rows.length == 0 {
                                        root.open-blank-context-menu(
                                            true,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y
                                        );
                                    }
                                }
                                scroll-event(ev) => {
                                    root.scroll-pane-by-delta(true, ev.delta-y);
                                    r-flick.viewport-x = Math.clamp(
                                        r-flick.viewport-x + ev.delta-x,
                                        Math.min(0px, r-flick.width - r-flick.viewport-width),
                                        0px
                                    );
                                    return accept;
                                }
                            }

                            // EMPTY DIRECTORY ACTION CARD (Left-Click or Quick-Action Buttons)
                            if root.right-rows.length == 0 : Rectangle {
                                z: 5;
                                width: Math.min(parent.width - 24px, 340px);
                                height: 124px;
                                x: (parent.width - self.width) / 2;
                                y: Math.max(16px, (parent.height - self.height) / 2 - 20px);
                                border-radius: 8px;
                                background: root.theme-bg-sidebar;
                                border-width: 1px;
                                border-color: root.theme-border;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        LucideIcon {
                                            y: (parent.height - self.height) / 2;
                                            icon-size: 16px;
                                            kind: root.right-filter-query != "" ? "search" : "folder";
                                            icon-color: root.theme-text-secondary;
                                        }
                                        Text {
                                            text: root.right-filter-query != ""
                                                ? (root.right-search-running
                                                    ? "Searching subfolders…"
                                                    : "No matching items found")
                                                : "Folder is empty — Click to create or paste";
                                            color: root.theme-text-secondary;
                                            font-size: 12px + root.ui-font-size-delta * 1px;
                                            font-family: root.ui-font-family;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        if root.right-filter-query != "" : ToolbarButton {
                                            icon-kind: "close";
                                            label: "Clear Search";
                                            clicked => {
                                                root.clear-pane-filter(true);
                                            }
                                        }

                                        if root.right-filter-query == "" : ToolbarButton {
                                            icon-kind: "plus";
                                            label: "New Folder";
                                            clicked => {
                                                root.activate-pane(true);
                                                root.open-new-folder-modal();
                                            }
                                        }

                                        if root.right-filter-query == "" : ToolbarButton {
                                            icon-kind: "file";
                                            label: "New File";
                                            clicked => {
                                                root.activate-pane(true);
                                                root.open-new-file-modal();
                                            }
                                        }

                                        if root.right-filter-query == "" && root.has-clipboard-item : ToolbarButton {
                                            icon-kind: "downloads";
                                            label: "Paste Here";
                                            active: true;
                                            clicked => {
                                                root.activate-pane(true);
                                                root.execute-context-action("paste");
                                            }
                                        }
                                    }
                                }
                            }

                            r-flick := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: false;
                                viewport-y <=> root.right-scroll-y;
                                viewport-width: (root.right-view-mode == 0 || root.right-view-mode == 3)
                                    ? Math.max(
                                        self.width,
                                        260px
                                            + (root.right-col-size ? root.size-col-width : 0px)
                                            + (root.right-col-kind ? 120px : 0px)
                                            + (root.right-col-modified ? root.date-col-width : 0px)
                                            + (root.right-col-added ? 140px : 0px)
                                            + (root.right-col-created ? 140px : 0px)
                                            + (root.right-col-owner ? 96px : 0px)
                                            + (root.right-col-group ? 96px : 0px)
                                            + (root.right-col-permissions ? 116px : 0px)
                                    )
                                    : (root.right-view-mode == 2
                                        ? Math.max(self.width, root.miller-col-width * 2 + 280px)
                                        : Math.max(self.width, 360px));
                                viewport-height: Math.min(
                                    9600px,
                                    (root.right-view-mode == 0 || root.right-view-mode == 3)
                                        ? Math.max(self.height, root.right-rows.length * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px)
                                        : (root.right-view-mode == 1
                                            ? Math.max(self.height, root.right-icon-triples.length * (138px + Math.max(0px, root.font-size-delta * 4.0)) + 28px)
                                            : Math.max(self.height, Math.max(root.right-parent-rows.length, root.right-rows.length) * (29px + Math.max(0px, root.font-size-delta * 2.0)) + 20px))
                                );

                                VerticalLayout {
                                    alignment: start;
                                    if root.right-view-mode == 0 || root.right-view-mode == 3 : VerticalLayout {
                                        alignment: start;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        spacing: 1px;
                                        for row[r-idx] in root.right-rows : FileRow {
                                            row_index: root.right-virtual-top-row + r-idx;
                                            file_name: row.name;
                                            file_size: row.size-text;
                                            file_date: row.modified-text;
                                            file_kind: row.kind-text;
                                            file_created: row.created-text;
                                            file_added: row.added-text;
                                            file_owner: row.owner-text;
                                            file_group: row.group-text;
                                            file_permissions: row.permissions-text;
                                            ext_badge: row.ext-badge;
                                            is_dir: row.is-dir;
                                            is_image: row.is-image;
                                            is_executable: row.is-executable;
                                            is_expanded: row.is-expanded;
                                            has_thumbnail: row.has-thumbnail;
                                            thumbnail: row.thumbnail;
                                            selected: row.is-selected;
                                            pane_focused: root.right-pane-active;
                                            depth: row.depth;
                                            tree_mode: root.right-view-mode == 3;
                                            has_color_tag: row.has-color-tag;
                                            color_tag_name: row.color-tag-name;
                                            color_tag_brush: row.color-tag-brush;
                                            color_tag_tint: row.color-tag-tint;
                                            size_col_width: root.size-col-width;
                                            date_col_width: root.date-col-width;
                                            show_col_size: root.right-col-size;
                                            show_col_kind: root.right-col-kind;
                                            show_col_modified: root.right-col-modified;
                                            show_col_created: root.right-col-created;
                                            show_col_added: root.right-col-added;
                                            show_col_owner: root.right-col-owner;
                                            show_col_group: root.right-col-group;
                                            show_col_permissions: root.right-col-permissions;
                                            show_col_tags: root.right-col-tags;
                                            bold_folders: root.right-bold-folders;
                                            use_alt_bg: root.right-alt-bg;
                                            view_icon_size: root.right-icon-size * 1px;
                                            font_delta: root.font-size-delta;
                                            font_bold: root.ui-font-bold;
                                            font_family: root.resolved-font-family;
                                            row_bg: root.theme-bg-surface;
                                            row_alt_bg: root.theme-row-alt;
                                            row_hover_bg: root.theme-bg-hover;
                                            row_accent_bg: root.theme-accent;
                                            text_primary: root.theme-text-primary;
                                            text_muted: root.theme-text-muted;
                                            drag_drop_highlight: root.drag-hover-right-row == (root.right-virtual-top-row + r-idx);
                                            row-clicked(sh, cmd) => {
                                                key-router.focus();
                                                root.show-hover-preview = false;
                                                root.select-file-row-mod(true, root.right-virtual-top-row + r-idx, sh, cmd);
                                            }
                                            row-double-clicked => {
                                                key-router.focus();
                                                root.show-hover-preview = false;
                                                root.open-file-row(true, root.right-virtual-top-row + r-idx);
                                            }
                                            row-context-menu(abs_x, abs_y) => {
                                                root.show-hover-preview = false;
                                                root.open-context-menu-for-row(
                                                    true,
                                                    root.right-virtual-top-row + r-idx,
                                                    abs_x,
                                                    abs_y
                                                );
                                            }
                                            row-hovered(abs_x, abs_y) => {
                                                root.hover-file-row(true, root.right-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-unhovered => {
                                                root.hover-leave-file-row(true, root.right-virtual-top-row + r-idx);
                                            }
                                            row-shift-drag(my) => {
                                                root.shift-drag-select(true, root.right-virtual-top-row + r-idx + Math.round((my - 13px) / 27px));
                                            }
                                            row-drag-moved(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.drag-right-scroll-y = r-flick.viewport-y;
                                                root.update-drag-cursor(true, root.right-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-drag-ended(abs_x, abs_y) => {
                                                root.drag-left-pane-w = l-flick.width;
                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                root.drag-right-scroll-y = r-flick.viewport-y;
                                                root.finish-drag-drop(true, root.right-virtual-top-row + r-idx, abs_x, abs_y);
                                            }
                                            row-drag-to-other-pane => {
                                                root.drag-drop-row-to-other-pane(true, root.right-virtual-top-row + r-idx);
                                            }
                                            toggle-expand => {
                                                root.toggle-expand-folder(true, root.right-virtual-top-row + r-idx);
                                            }
                                            wheel-scroll(dy) => {
                                                root.show-hover-preview = false;
                                                root.scroll-pane-by-delta(true, dy);
                                            }
                                        }
                                    }

                                    if root.right-view-mode == 1 : VerticalLayout {
                                        alignment: start;
                                        padding: 12px;
                                        spacing: 10px;
                                        for triple in root.right-icon-triples : HorizontalLayout {
                                            spacing: 10px;
                                            if triple.has-0 : PolaroidCell {
                                                item: triple.item-0;
                                                pane-focused: root.right-pane-active;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                drag-drop-highlight: root.drag-hover-right-row == triple.idx-0;
                                                select-cell(sh, cmd) => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.select-file-row-mod(true, triple.idx-0, sh, cmd);
                                                }
                                                open-cell => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.open-file-row(true, triple.idx-0);
                                                }
                                                context-cell(abs_x, abs_y) => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.open-context-menu-for-row(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-hovered(abs_x, abs_y) => {
                                                    root.hover-file-row(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-unhovered => {
                                                    root.hover-leave-file-row(true, triple.idx-0);
                                                }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.update-drag-cursor(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.finish-drag-drop(true, triple.idx-0, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    root.show-hover-preview = false;
                                                    r-flick.viewport-y = Math.clamp(
                                                        r-flick.viewport-y + dy,
                                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-0 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-1 : PolaroidCell {
                                                item: triple.item-1;
                                                pane-focused: root.right-pane-active;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                drag-drop-highlight: root.drag-hover-right-row == triple.idx-1;
                                                select-cell(sh, cmd) => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.select-file-row-mod(true, triple.idx-1, sh, cmd);
                                                }
                                                open-cell => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.open-file-row(true, triple.idx-1);
                                                }
                                                context-cell(abs_x, abs_y) => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.open-context-menu-for-row(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-hovered(abs_x, abs_y) => {
                                                    root.hover-file-row(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-unhovered => {
                                                    root.hover-leave-file-row(true, triple.idx-1);
                                                }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.update-drag-cursor(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.finish-drag-drop(true, triple.idx-1, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    root.show-hover-preview = false;
                                                    r-flick.viewport-y = Math.clamp(
                                                        r-flick.viewport-y + dy,
                                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-1 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                            if triple.has-2 : PolaroidCell {
                                                item: triple.item-2;
                                                pane-focused: root.right-pane-active;
                                                font-delta: root.font-size-delta;
                                                font-bold: root.ui-font-bold;
                                                font-family: root.resolved-font-family;
                                                accent-bg: root.theme-accent;
                                                drag-drop-highlight: root.drag-hover-right-row == triple.idx-2;
                                                select-cell(sh, cmd) => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.select-file-row-mod(true, triple.idx-2, sh, cmd);
                                                }
                                                open-cell => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.open-file-row(true, triple.idx-2);
                                                }
                                                context-cell(abs_x, abs_y) => {
                                                    key-router.focus();
                                                    root.show-hover-preview = false;
                                                    root.open-context-menu-for-row(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-hovered(abs_x, abs_y) => {
                                                    root.hover-file-row(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-unhovered => {
                                                    root.hover-leave-file-row(true, triple.idx-2);
                                                }
                                                cell-drag-moved(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.update-drag-cursor(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                cell-drag-ended(abs_x, abs_y) => {
                                                    root.drag-left-pane-w = l-flick.width;
                                                    root.drag-left-scroll-y = l-flick.viewport-y;
                                                    root.drag-right-scroll-y = r-flick.viewport-y;
                                                    root.finish-drag-drop(true, triple.idx-2, abs_x, abs_y);
                                                }
                                                wheel-scroll(dy) => {
                                                    root.show-hover-preview = false;
                                                    r-flick.viewport-y = Math.clamp(
                                                        r-flick.viewport-y + dy,
                                                        Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                        0px
                                                    );
                                                }
                                            }
                                            if !triple.has-2 : Rectangle { height: 132px; border-radius: 4px; background: transparent; horizontal-stretch: 1; }
                                        }
                                    }

                                    if root.right-view-mode == 2 : HorizontalLayout {
                                        spacing: 4px;
                                        VerticalLayout {
                                            alignment: start;
                                            width: root.miller-col-width;
                                            for p-row[p-idx] in root.right-parent-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                background: p-row.is-selected
                                                    ? root.theme-bg-hover
                                                    : (p-row.has-color-tag ? p-row.color-tag-tint : transparent);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 18px;
                                                        background: transparent;
                                                        if !p-row.is-dir && p-row.has-thumbnail : Image {
                                                            x: 0px;
                                                            y: (parent.height - 18px) / 2;
                                                            width: 18px;
                                                            height: 18px;
                                                            image-fit: contain;
                                                            source: p-row.thumbnail;
                                                        }
                                                        if p-row.is-dir || !p-row.has-thumbnail : LucideIcon {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: p-row.is-dir
                                                                ? "folder"
                                                                : (p-row.ext-badge == "APP"
                                                                    ? "applications"
                                                                    : (p-row.is-image
                                                                        ? "image"
                                                                        : ((p-row.ext-badge == "ZIP" || p-row.ext-badge == "TAR" || p-row.ext-badge == "GZ" || p-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((p-row.ext-badge == "MP3" || p-row.ext-badge == "FLAC" || p-row.ext-badge == "WAV" || p-row.ext-badge == "M4A" || p-row.ext-badge == "OGG" || p-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((p-row.ext-badge == "MP4" || p-row.ext-badge == "MKV" || p-row.ext-badge == "MOV" || p-row.ext-badge == "AVI" || p-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : (p-row.is-executable ? "terminal" : "documents"))))));
                                                            icon-color: p-row.has-color-tag
                                                                ? p-row.color-tag-brush
                                                                : ((p-row.is-dir || p-row.ext-badge == "APP")
                                                                    ? #38B6FF
                                                                    : (p-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (p-row.is-image ? #6E92B8 : #A0A0AB)));
                                                            fill-color: p-row.is-dir
                                                                ? (p-row.has-color-tag ? p-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: p-row.name;
                                                        color: root.theme-text-primary;
                                                        font-size: 12px + root.font-size-delta;
                                                        font-family: root.resolved-font-family;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if p-row.has-color-tag : Rectangle {
                                                        width: 7px;
                                                        height: 7px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 3.5px;
                                                        background: p-row.color-tag-brush;
                                                    }
                                                    if p-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: root.theme-text-muted;
                                                    }
                                                }
                                                TouchArea {
                                                    clicked => { root.open-parent-row(true, p-idx); }
                                                    scroll-event(ev) => {
                                                        r-flick.viewport-y = Math.clamp(
                                                            r-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: start;
                                            width: root.miller-col-width + 40px;
                                            for c-row[c-idx] in root.right-rows : Rectangle {
                                                height: 26px;
                                                border-radius: 4px;
                                                border-width: root.drag-hover-right-row == c-idx ? 1px : 0px;
                                                border-color: root.drag-hover-right-row == c-idx ? root.theme-accent : transparent;
                                                background: root.drag-hover-right-row == c-idx
                                                    ? #0D52BF38
                                                    : (c-row.is-selected
                                                        ? (root.right-pane-active ? root.theme-accent : #2E323B)
                                                        : (r-col-touch.has-hover
                                                            ? root.theme-bg-hover
                                                            : (c-row.has-color-tag ? c-row.color-tag-tint : transparent)));
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 20px;
                                                        background: transparent;
                                                        if !c-row.is-dir && c-row.has-thumbnail : Rectangle {
                                                            x: 0px;
                                                            y: (parent.height - 20px) / 2;
                                                            width: 20px;
                                                            height: 20px;
                                                            border-radius: 3px;
                                                            background: #121215;
                                                            border-width: 1px;
                                                            border-color: c-row.is-selected ? #FFFFFFAA : #32323A;
                                                            clip: true;
                                                            Image {
                                                                x: 1px;
                                                                y: 1px;
                                                                width: 18px;
                                                                height: 18px;
                                                                image-fit: contain;
                                                                source: c-row.thumbnail;
                                                            }
                                                        }
                                                        if c-row.is-dir || !c-row.has-thumbnail : LucideIcon {
                                                            x: 2px;
                                                            y: (parent.height - self.height) / 2;
                                                            icon-size: 15px;
                                                            kind: c-row.is-dir
                                                                ? "folder"
                                                                : (c-row.ext-badge == "APP"
                                                                    ? "applications"
                                                                    : (c-row.is-image
                                                                        ? "image"
                                                                        : ((c-row.ext-badge == "ZIP" || c-row.ext-badge == "TAR" || c-row.ext-badge == "GZ" || c-row.ext-badge == "ISO")
                                                                            ? "archive"
                                                                            : ((c-row.ext-badge == "MP3" || c-row.ext-badge == "FLAC" || c-row.ext-badge == "WAV" || c-row.ext-badge == "M4A" || c-row.ext-badge == "OGG" || c-row.ext-badge == "AAC")
                                                                                ? "music"
                                                                                : ((c-row.ext-badge == "MP4" || c-row.ext-badge == "MKV" || c-row.ext-badge == "MOV" || c-row.ext-badge == "AVI" || c-row.ext-badge == "WEBM")
                                                                                    ? "movies"
                                                                                    : (c-row.is-executable ? "terminal" : "documents"))))));
                                                            icon-color: c-row.has-color-tag
                                                                ? c-row.color-tag-brush
                                                                : ((c-row.is-dir || c-row.ext-badge == "APP")
                                                                    ? #38B6FF
                                                                    : (c-row.ext-badge == "PDF"
                                                                        ? #FF5F56
                                                                        : (c-row.is-image ? #6E92B8 : #A0A0AB)));
                                                            fill-color: c-row.is-dir
                                                                ? (c-row.has-color-tag ? c-row.color-tag-brush : #4CC2FF)
                                                                : transparent;
                                                        }
                                                    }
                                                    Text {
                                                        text: c-row.name;
                                                        color: c-row.is-selected ? #FFFFFF : root.theme-text-primary;
                                                        font-size: 12.5px + root.font-size-delta;
                                                        font-family: root.resolved-font-family;
                                                        font-weight: root.ui-font-bold ? 700 : 500;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    if c-row.has-color-tag : Rectangle {
                                                        width: r-col-tag.preferred-width;
                                                        height: 17px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 8.5px;
                                                        background: c-row.is-selected ? #00000044 : c-row.color-tag-tint;
                                                        border-width: 1px;
                                                        border-color: c-row.is-selected ? #FFFFFF88 : c-row.color-tag-brush;
                                                        r-col-tag := HorizontalLayout {
                                                            padding-left: 5px;
                                                            padding-right: 6px;
                                                            spacing: 4px;
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 6px;
                                                                height: 6px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 3px;
                                                                background: c-row.color-tag-brush;
                                                            }
                                                            Text {
                                                                text: c-row.color-tag-name;
                                                                color: c-row.is-selected ? #FFFFFF : #F2F2F7;
                                                                font-size: 10px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    if c-row.is-dir : LucideIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 12px;
                                                        kind: "chevron-right";
                                                        icon-color: c-row.is-selected ? #FFFFFF : root.theme-text-muted;
                                                    }
                                                }
                                                r-col-touch := TouchArea {
                                                    clicked => {
                                                        root.show-hover-preview = false;
                                                        key-router.focus();
                                                        if !root.col-suppress-click {
                                                            root.select-file-row-mod(
                                                                true,
                                                                c-idx,
                                                                root.col-down-shift,
                                                                root.col-down-cmd
                                                            );
                                                        }
                                                        root.col-suppress-click = false;
                                                        root.col-down-shift = false;
                                                        root.col-down-cmd = false;
                                                    }
                                                    double-clicked => {
                                                        root.show-hover-preview = false;
                                                        root.open-file-row(true, c-idx);
                                                    }
                                                    moved => {
                                                        if self.pressed && !root.col-down-shift && !root.col-down-cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                                                            root.show-hover-preview = false;
                                                            root.col-drag-active = true;
                                                            root.col-suppress-click = true;
                                                            root.drag-left-pane-w = l-flick.width;
                                                            root.drag-left-scroll-y = l-flick.viewport-y;
                                                            root.drag-right-scroll-y = r-flick.viewport-y;
                                                            root.update-drag-cursor(
                                                                true,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    changed has-hover => {
                                                        if self.has-hover && !self.pressed && !root.col-drag-active {
                                                            root.hover-file-row(
                                                                true,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        } else if !self.has-hover {
                                                            root.hover-leave-file-row(true, c-idx);
                                                        }
                                                    }
                                                    pointer-event(ev) => {
                                                        if ev.kind == PointerEventKind.move && !self.pressed && !root.col-drag-active {
                                                            root.hover-file-row(
                                                                true,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            key-router.focus();
                                                            root.col-down-shift = ev.modifiers.shift;
                                                            root.col-down-cmd = ev.modifiers.control || ev.modifiers.meta;
                                                            root.col-drag-active = false;
                                                            root.col-suppress-click = false;
                                                        }
                                                        if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                                                            if root.col-drag-active {
                                                                root.col-drag-active = false;
                                                                root.drag-left-pane-w = l-flick.width;
                                                                root.drag-left-scroll-y = l-flick.viewport-y;
                                                                root.drag-right-scroll-y = r-flick.viewport-y;
                                                                root.finish-drag-drop(
                                                                    true,
                                                                    c-idx,
                                                                    self.absolute-position.x + self.mouse-x,
                                                                    self.absolute-position.y + self.mouse-y
                                                                );
                                                            }
                                                            if ev.kind == PointerEventKind.cancel {
                                                                root.col-suppress-click = false;
                                                                root.col-down-shift = false;
                                                                root.col-down-cmd = false;
                                                            }
                                                        }
                                                        if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                                            root.show-hover-preview = false;
                                                            root.col-suppress-click = true;
                                                            root.open-context-menu-for-row(
                                                                true,
                                                                c-idx,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y
                                                            );
                                                        }
                                                    }
                                                    scroll-event(ev) => {
                                                        root.show-hover-preview = false;
                                                        r-flick.viewport-y = Math.clamp(
                                                            r-flick.viewport-y + ev.delta-y,
                                                            Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                            0px
                                                        );
                                                        return accept;
                                                    }
                                                }
                                            }
                                        }

                                        // 3rd Column: Miller Preview & Photo/Music/Video Metadata Column (Right Pane)
                                        if root.inspector-title != "" : Rectangle {
                                            horizontal-stretch: 1;
                                            min-width: 240px;
                                            background: root.theme-bg-sidebar;
                                            border-width: 1px;
                                            border-color: root.theme-border;
                                            border-radius: 6px;
                                            clip: true;

                                            VerticalLayout {
                                                padding: 12px;
                                                spacing: 8px;
                                                alignment: start;

                                                Rectangle {
                                                    height: root.inspector-has-image ? 164px : (root.inspector-has-text-preview ? 140px : 84px);
                                                    border-radius: 6px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    clip: true;

                                                    if root.inspector-is-dir : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 48px;
                                                        kind: "folder";
                                                        icon-color: #38B6FF;
                                                        fill-color: #4CC2FF;
                                                    }
                                                    if !root.inspector-is-dir && root.inspector-has-image : Image {
                                                        x: 6px;
                                                        y: 6px;
                                                        width: parent.width - 12px;
                                                        height: parent.height - 12px;
                                                        image-fit: contain;
                                                        source: root.inspector-preview-image;
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && root.inspector-has-text-preview : VerticalLayout {
                                                        padding: 8px;
                                                        Text {
                                                            text: root.inspector-preview-text;
                                                            color: root.theme-text-primary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: "monospace";
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                    if !root.inspector-is-dir && !root.inspector-has-image && !root.inspector-has-text-preview : LucideIcon {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        icon-size: 44px;
                                                        kind: root.inspector-media-category == "Audio / Music"
                                                            ? "music"
                                                            : (root.inspector-media-category == "Video / Media" ? "video" : "file");
                                                        icon-color: root.theme-text-secondary;
                                                    }
                                                }

                                                Text {
                                                    text: root.inspector-title;
                                                    color: root.theme-text-primary;
                                                    font-size: 13px + root.font-size-delta;
                                                    font-family: root.resolved-font-family;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: root.inspector-subtitle + " • " + root.inspector-size;
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.font-size-delta;
                                                    font-family: root.resolved-font-family;
                                                    font-weight: 500;
                                                }

                                                if root.inspector-media-category != "" : Rectangle {
                                                    border-radius: 5px;
                                                    background: root.theme-bg-canvas;
                                                    border-width: 1px;
                                                    border-color: root.theme-border;
                                                    VerticalLayout {
                                                        padding: 8px;
                                                        spacing: 3px;
                                                        Text {
                                                            text: root.inspector-media-category;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: root.resolved-font-family;
                                                            font-weight: 700;
                                                        }
                                                        if root.inspector-media-line1 != "" : Text {
                                                            text: root.inspector-media-line1;
                                                            color: root.theme-text-primary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: "monospace";
                                                        }
                                                        if root.inspector-media-line2 != "" : Text {
                                                            text: root.inspector-media-line2;
                                                            color: root.theme-text-secondary;
                                                            font-size: 10.5px + root.font-size-delta;
                                                            font-family: "monospace";
                                                        }
                                                        if root.inspector-media-line3 != "" : Text {
                                                            text: root.inspector-media-line3;
                                                            color: root.theme-text-muted;
                                                            font-size: 10px + root.font-size-delta;
                                                            font-family: "monospace";
                                                        }
                                                    }
                                                }

                                                Text {
                                                    text: "Modified: " + root.inspector-modified;
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }
                                                Text {
                                                    text: "Permissions: " + root.inspector-perm-symbolic + " (" + root.inspector-perm-octal + ")";
                                                    color: root.theme-text-muted;
                                                    font-size: 10.5px + root.font-size-delta;
                                                    font-family: "monospace";
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.right-view-mode == 2 : Rectangle {
                                z: 15;
                                x: root.miller-col-width + r-flick.viewport-x;
                                y: 0px;
                                width: 5px;
                                height: parent.height;
                                background: r-miller-resizer.has-hover || r-miller-resizer.pressed ? root.theme-accent : transparent;
                                Rectangle {
                                    x: 2px;
                                    width: 1px;
                                    height: parent.height;
                                    background: root.theme-border;
                                }
                                r-miller-resizer := TouchArea {
                                    mouse-cursor: col-resize;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                            root.col-resize-start-w = root.miller-col-width;
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            root.miller-col-width = Math.clamp(
                                                root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                                120px,
                                                420px
                                            );
                                        }
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Vertical Scrollbar for Right Pane
                            if r-flick.viewport-height > r-flick.height || root.right-total-rows > root.right-rows.length : Rectangle {
                                z: 25;
                                x: parent.width - 12px;
                                y: 2px;
                                width: 10px;
                                height: parent.height - (r-flick.viewport-width > r-flick.width ? 14px : 4px);
                                border-radius: 5px;
                                background: r-vbar-touch.has-hover || r-vbar-touch.pressed ? #141417DD : #16161888;

                                r-vthumb := Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: (r-vbar-touch.has-hover || r-vbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.width / 2;
                                    background: r-vbar-touch.pressed
                                        ? root.theme-accent
                                        : (r-vbar-touch.has-hover ? #8E8E98 : #52525E);
                                    height: (root.right-view-mode == 0 || root.right-view-mode == 3) && root.right-total-rows > root.right-rows.length
                                        ? Math.max(28px, parent.height * (root.right-rows.length / Math.max(1.0, root.right-total-rows * 1.0)))
                                        : Math.max(28px, parent.height * (r-flick.height / r-flick.viewport-height));
                                    y: (root.right-view-mode == 0 || root.right-view-mode == 3) && root.right-total-rows > root.right-rows.length
                                        ? (parent.height - self.height) * (root.right-virtual-top-row / Math.max(1.0, (root.right-total-rows - root.right-rows.length) * 1.0))
                                        : (parent.height - self.height) * (-r-flick.viewport-y / Math.max(1px, r-flick.viewport-height - r-flick.height));
                                }

                                r-vbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(true);
                                            if (root.right-view-mode == 0 || root.right-view-mode == 3) && root.right-total-rows > root.right-rows.length {
                                                root.set-virtual-scroll-row(
                                                    true,
                                                    Math.clamp(
                                                        Math.round(
                                                            ((self.mouse-y - r-vthumb.height / 2) / Math.max(1px, self.height - r-vthumb.height))
                                                                * Math.max(1, root.right-total-rows - root.right-rows.length)
                                                        ),
                                                        0,
                                                        Math.max(0, root.right-total-rows - root.right-rows.length)
                                                    )
                                                );
                                            } else {
                                                r-flick.viewport-y = Math.clamp(
                                                    -((self.mouse-y - r-vthumb.height / 2) / Math.max(1px, self.height - r-vthumb.height))
                                                        * (r-flick.viewport-height - r-flick.height),
                                                    Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                    0px
                                                );
                                            }
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            if (root.right-view-mode == 0 || root.right-view-mode == 3) && root.right-total-rows > root.right-rows.length {
                                                root.set-virtual-scroll-row(
                                                    true,
                                                    Math.clamp(
                                                        Math.round(
                                                            ((self.mouse-y - r-vthumb.height / 2) / Math.max(1px, self.height - r-vthumb.height))
                                                                * Math.max(1, root.right-total-rows - root.right-rows.length)
                                                        ),
                                                        0,
                                                        Math.max(0, root.right-total-rows - root.right-rows.length)
                                                    )
                                                );
                                            } else {
                                                r-flick.viewport-y = Math.clamp(
                                                    -((self.mouse-y - r-vthumb.height / 2) / Math.max(1px, self.height - r-vthumb.height))
                                                        * (r-flick.viewport-height - r-flick.height),
                                                    Math.min(0px, r-flick.height - r-flick.viewport-height),
                                                    0px
                                                );
                                            }
                                        }
                                    }
                                    scroll-event(ev) => {
                                        root.scroll-pane-by-delta(true, ev.delta-y);
                                        return accept;
                                    }
                                }
                            }

                            // Interactive Mouse-Usable Horizontal Scrollbar for Right Pane
                            if r-flick.viewport-width > r-flick.width : Rectangle {
                                z: 25;
                                x: 2px;
                                y: parent.height - 12px;
                                width: parent.width - (r-flick.viewport-height > r-flick.height ? 14px : 4px);
                                height: 10px;
                                border-radius: 5px;
                                background: r-hbar-touch.has-hover || r-hbar-touch.pressed ? #141417DD : #16161888;

                                r-hthumb := Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: (r-hbar-touch.has-hover || r-hbar-touch.pressed) ? 8px : 6px;
                                    border-radius: self.height / 2;
                                    background: r-hbar-touch.pressed
                                        ? root.theme-accent
                                        : (r-hbar-touch.has-hover ? #8E8E98 : #52525E);
                                    width: Math.max(28px, parent.width * (r-flick.width / r-flick.viewport-width));
                                    x: (parent.width - self.width) * (-r-flick.viewport-x / Math.max(1px, r-flick.viewport-width - r-flick.width));
                                }

                                r-hbar-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(ev) => {
                                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                            root.activate-pane(true);
                                            r-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - r-hthumb.width / 2) / Math.max(1px, self.width - r-hthumb.width))
                                                    * (r-flick.viewport-width - r-flick.width),
                                                Math.min(0px, r-flick.width - r-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                    moved => {
                                        if self.pressed {
                                            r-flick.viewport-x = Math.clamp(
                                                -((self.mouse-x - r-hthumb.width / 2) / Math.max(1px, self.width - r-hthumb.width))
                                                    * (r-flick.viewport-width - r-flick.width),
                                                Math.min(0px, r-flick.width - r-flick.viewport-width),
                                                0px
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }

                // 2D. RIGHT PREVIEW / INSPECTOR PANE
                if root.show-inspector : InspectorDrawer {
                    col-resize-start-w <=> root.col-resize-start-w;
                    col-resize-start-x <=> root.col-resize-start-x;
                    font-size-delta: root.font-size-delta;
                    inspector-color-index: root.inspector-color-index;
                    inspector-created: root.inspector-created;
                    inspector-extension: root.inspector-extension;
                    inspector-group: root.inspector-group;
                    inspector-has-image: root.inspector-has-image;
                    inspector-has-text-preview: root.inspector-has-text-preview;
                    inspector-image-dimensions: root.inspector-image-dimensions;
                    inspector-is-dir: root.inspector-is-dir;
                    inspector-is-image: root.inspector-is-image;
                    inspector-locked: root.inspector-locked;
                    inspector-media-category: root.inspector-media-category;
                    inspector-media-line1: root.inspector-media-line1;
                    inspector-media-line2: root.inspector-media-line2;
                    inspector-media-line3: root.inspector-media-line3;
                    inspector-modified: root.inspector-modified;
                    inspector-owner: root.inspector-owner;
                    inspector-perm-octal: root.inspector-perm-octal;
                    inspector-perm-symbolic: root.inspector-perm-symbolic;
                    inspector-preview-image: root.inspector-preview-image;
                    inspector-preview-text: root.inspector-preview-text;
                    inspector-size: root.inspector-size;
                    inspector-subtitle: root.inspector-subtitle;
                    inspector-tab-index: root.inspector-tab-index;
                    inspector-title: root.inspector-title;
                    inspector-width <=> root.inspector-width;
                    perm-gr: root.perm-gr;
                    perm-gw: root.perm-gw;
                    perm-gx: root.perm-gx;
                    perm-or: root.perm-or;
                    perm-ow: root.perm-ow;
                    perm-ox: root.perm-ox;
                    perm-ur: root.perm-ur;
                    perm-uw: root.perm-uw;
                    perm-ux: root.perm-ux;
                    resolved-font-family: root.resolved-font-family;
                    spinner-frame: root.spinner-frame;
                    theme-accent: root.theme-accent;
                    theme-bg-canvas: root.theme-bg-canvas;
                    theme-bg-hover: root.theme-bg-hover;
                    theme-bg-sidebar: root.theme-bg-sidebar;
                    theme-bg-surface: root.theme-bg-surface;
                    theme-border: root.theme-border;
                    theme-text-primary: root.theme-text-primary;
                    theme-text-secondary: root.theme-text-secondary;
                    transfer-rows: root.transfer-rows;
                    ui-font-size-delta: root.ui-font-size-delta;
                    calculate-selected-dir-size => { root.calculate-selected-dir-size(); }
                    cancel-transfer(a0) => { root.cancel-transfer(a0); }
                    clear-completed-tasks => { root.clear-completed-tasks(); }
                    set-inspector-tab(a0) => { root.set-inspector-tab(a0); }
                    set-selected-color-label(a0) => { root.set-selected-color-label(a0); }
                    toggle-locked => { root.toggle-locked(); }
                    toggle-pause-transfer(a0) => { root.toggle-pause-transfer(a0); }
                    toggle-permission-bit(a0, a1) => { root.toggle-permission-bit(a0, a1); }
                    toggle-preview-minion => { root.toggle-preview-minion(); }
                }
            }

            // 3. EMBEDDED BOTTOM TERMINAL DRAWER
            if root.show-terminal-drawer : TerminalDrawer {
                    window-height: root.height;
                    col-resize-start-w <=> root.col-resize-start-w;
                    col-resize-start-x <=> root.col-resize-start-x;
                    resolved-mono-font-family: root.resolved-mono-font-family;
                    show-terminal-drawer <=> root.show-terminal-drawer;
                    terminal-alt-screen: root.terminal-alt-screen;
                    terminal-canvas-height <=> root.terminal-canvas-height;
                    terminal-canvas-width <=> root.terminal-canvas-width;
                    terminal-cell-width: root.terminal-cell-width;
                    terminal-cwd: root.terminal-cwd;
                    terminal-drawer-height <=> root.terminal-drawer-height;
                    terminal-focused <=> root.terminal-focused;
                    terminal-lines: root.terminal-lines;
                    terminal-max-scroll: root.terminal-max-scroll;
                    terminal-scroll-offset: root.terminal-scroll-offset;
                    terminal-session-label: root.terminal-session-label;
                    theme-accent: root.theme-accent;
                    theme-border: root.theme-border;
                    ui-font-size-delta: root.ui-font-size-delta;
                    clear-terminal => { root.clear-terminal(); }
                    focus-key-router => { key-router.focus(); }
                    restart-terminal => { root.restart-terminal(); }
                    sync-terminal-cwd => { root.sync-terminal-cwd(); }
                    terminal-key-input(a0, a1, a2, a3, a4) => { root.terminal-key-input(a0, a1, a2, a3, a4); }
                    terminal-paste => { root.terminal-paste(); }
                    terminal-scroll(a0) => { root.terminal-scroll(a0); }
            }
        }
    }

    // LAYER 2..5: POPOVERS, CONTEXT MENUS, MODALS & STATUS BANNER
    WindowOverlays {
        app-version-label: root.app-version-label;
        batch-rename-changed-count: root.batch-rename-changed-count;
        batch-rename-conflict-count: root.batch-rename-conflict-count;
        batch-rename-dropdown-x <=> root.batch-rename-dropdown-x;
        batch-rename-dropdown-y <=> root.batch-rename-dropdown-y;
        batch-rename-favorite-names: root.batch-rename-favorite-names;
        batch-rename-open-dropdown-kind <=> root.batch-rename-open-dropdown-kind;
        batch-rename-open-dropdown-rule <=> root.batch-rename-open-dropdown-rule;
        batch-rename-preview-rows: root.batch-rename-preview-rows;
        batch-rename-rules: root.batch-rename-rules;
        batch-rename-status-text: root.batch-rename-status-text;
        col-resize-start-w <=> root.col-resize-start-w;
        col-resize-start-x <=> root.col-resize-start-x;
        compress-format <=> root.compress-format;
        compress-items-summary: root.compress-items-summary;
        conflict-apply-all <=> root.conflict-apply-all;
        conflict-existing-date: root.conflict-existing-date;
        conflict-existing-size: root.conflict-existing-size;
        conflict-headline: root.conflict-headline;
        conflict-new-date: root.conflict-new-date;
        conflict-new-size: root.conflict-new-size;
        conflict-subheadline: root.conflict-subheadline;
        connect-auth-method <=> root.connect-auth-method;
        connect-base-url <=> root.connect-base-url;
        connect-color-index: root.connect-color-index;
        connect-editing-id: root.connect-editing-id;
        connect-encoding <=> root.connect-encoding;
        connect-key-path <=> root.connect-key-path;
        connect-local-path <=> root.connect-local-path;
        connect-name <=> root.connect-name;
        connect-note <=> root.connect-note;
        connect-passphrase <=> root.connect-passphrase;
        connect-password <=> root.connect-password;
        connect-port <=> root.connect-port;
        connect-protocol: root.connect-protocol;
        connect-remote-path <=> root.connect-remote-path;
        connect-s3-access-key <=> root.connect-s3-access-key;
        connect-s3-bucket <=> root.connect-s3-bucket;
        connect-s3-endpoint <=> root.connect-s3-endpoint;
        connect-s3-region <=> root.connect-s3-region;
        connect-s3-secret-key <=> root.connect-s3-secret-key;
        connect-save-credentials <=> root.connect-save-credentials;
        connect-server <=> root.connect-server;
        connect-show-advanced <=> root.connect-show-advanced;
        connect-smb-domain <=> root.connect-smb-domain;
        connect-smb-share <=> root.connect-smb-share;
        connect-username <=> root.connect-username;
        context-can-show-enclosing: root.context-can-show-enclosing;
        context-is-blank: root.context-is-blank;
        context-menu-x: root.context-menu-x;
        context-menu-y: root.context-menu-y;
        context-selected-count: root.context-selected-count;
        context-target-is-app-bundle: root.context-target-is-app-bundle;
        context-target-is-archive: root.context-target-is-archive;
        context-target-is-dir: root.context-target-is-dir;
        context-target-is-favorite: root.context-target-is-favorite;
        context-target-name: root.context-target-name;
        current-folder-is-favorite: root.current-folder-is-favorite;
        delete-modal-message: root.delete-modal-message;
        delete-modal-permanent: root.delete-modal-permanent;
        delete-modal-title: root.delete-modal-title;
        drag-fav-grab-offset-x: root.drag-fav-grab-offset-x;
        drag-fav-grab-offset-y: root.drag-fav-grab-offset-y;
        drag-fav-icon: root.drag-fav-icon;
        drag-fav-label: root.drag-fav-label;
        drag-fav-mouse-x: root.drag-fav-mouse-x;
        drag-fav-mouse-y: root.drag-fav-mouse-y;
        drag-ghost-label: root.drag-ghost-label;
        drag-ghost-x: root.drag-ghost-x;
        drag-ghost-y: root.drag-ghost-y;
        drag-tab-grab-offset-x: root.drag-tab-grab-offset-x;
        drag-tab-grab-offset-y: root.drag-tab-grab-offset-y;
        drag-tab-icon: root.drag-tab-icon;
        drag-tab-mouse-x: root.drag-tab-mouse-x;
        drag-tab-mouse-y: root.drag-tab-mouse-y;
        drag-tab-title: root.drag-tab-title;
        drag-tab-width: root.drag-tab-width;
        drag-target-hint: root.drag-target-hint;
        dragging-sidebar-idx: root.dragging-sidebar-idx;
        dragging-tab-active: root.dragging-tab-active;
        dual-pane-mode: root.dual-pane-mode;
        font-size-delta: root.font-size-delta;
        has-clipboard-item: root.has-clipboard-item;
        hover-file-kind: root.hover-file-kind;
        hover-file-modified: root.hover-file-modified;
        hover-file-name: root.hover-file-name;
        hover-file-perms: root.hover-file-perms;
        hover-file-size: root.hover-file-size;
        hover-has-image: root.hover-has-image;
        hover-has-text: root.hover-has-text;
        hover-image: root.hover-image;
        hover-media-info: root.hover-media-info;
        hover-preview-x: root.hover-preview-x;
        hover-preview-y: root.hover-preview-y;
        hover-text: root.hover-text;
        input-modal-mode: root.input-modal-mode;
        input-modal-title: root.input-modal-title;
        input-modal-value <=> root.input-modal-value;
        inspector-color-index: root.inspector-color-index;
        inspector-has-image: root.inspector-has-image;
        inspector-image-dimensions: root.inspector-image-dimensions;
        inspector-is-dir: root.inspector-is-dir;
        inspector-modified: root.inspector-modified;
        inspector-perm-octal: root.inspector-perm-octal;
        inspector-perm-symbolic: root.inspector-perm-symbolic;
        inspector-preview-image: root.inspector-preview-image;
        inspector-preview-text: root.inspector-preview-text;
        inspector-size: root.inspector-size;
        inspector-subtitle: root.inspector-subtitle;
        inspector-title: root.inspector-title;
        inspector-width: root.inspector-width;
        is-dragging-row: root.is-dragging-row;
        is-dragging-tab: root.is-dragging-tab;
        left-pane-width: root.left-pane-width;
        open-with-apps: root.open-with-apps;
        open-with-custom-cmd <=> root.open-with-custom-cmd;
        open-with-selected-idx <=> root.open-with-selected-idx;
        open-with-target-name: root.open-with-target-name;
        pref-max-bandwidth-mbps: root.pref-max-bandwidth-mbps;
        preview-minion-x <=> root.preview-minion-x;
        preview-minion-y <=> root.preview-minion-y;
        preview-minion-zoom <=> root.preview-minion-zoom;
        resolved-font-family: root.resolved-font-family;
        right-pane-active: root.right-pane-active;
        show-about-modal <=> root.show-about-modal;
        show-app-menu <=> root.show-app-menu;
        show-batch-rename-modal <=> root.show-batch-rename-modal;
        show-conflict-modal: root.show-conflict-modal;
        show-connect-modal: root.show-connect-modal;
        show-context-menu <=> root.show-context-menu;
        show-delete-modal <=> root.show-delete-modal;
