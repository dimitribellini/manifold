// Reusable Modal, Popover & Overlay Components for Project Manifold (v0.7.0)
import { ScrollView } from "std-widgets.slint";
import {
    BreadcrumbSegmentSlint,
    TransferRowSlint,
    SyncPreviewRowSlint,
    OpenWithAppSlint,
    BatchRenameRuleSlint,
    BatchRenamePreviewRowSlint,
    LucideIcon,
    CleanLineEdit,
    SidebarItemIcon,
    SegmentControlButton,
    ToolbarButton,
    PermCheckbox,
    ViewOptionCheckboxRow,
    ColorSwatchDot,
    ContextMenuItem,
    TransferTaskCard
} from "components.slint";

component BatchRenameSelectRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> open: false;
    in property <brush> accent-bg: #0D52BF;
    in property <brush> hover-bg: #26262B;
    in property <brush> text-primary: #E1E1E6;
    in property <brush> text-secondary: #888892;
    in property <string> font-family: "";
    in property <length> font-delta: 0px;
    callback toggle-open(length, length);

    spacing: 8px;
    height: 26px;

    Text {
        width: 82px;
        text: root.label;
        color: root.text-secondary;
        font-size: 12px + root.font-delta * 0.5;
        font-family: root.font-family;
        font-weight: 500;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        horizontal-stretch: 1;
        height: 26px;
        border-radius: 5px;
        background: dd-ta.has-hover ? root.hover-bg : #2A2A32;
        border-width: 1px;
        border-color: root.open ? root.accent-bg : #383842;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            alignment: space-between;
            Text {
                text: root.value;
                color: root.text-primary;
                font-size: 12px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            LucideIcon {
                y: (parent.height - self.height) / 2;
                icon-size: 12px;
                kind: "arrow-up-down";
                icon-color: root.text-secondary;
            }
        }

        dd-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.toggle-open(
                    self.absolute-position.x,
                    self.absolute-position.y + self.height + 2px
                );
            }
        }
    }
}

component BatchRenameRuleCard inherits VerticalLayout {
    in property <BatchRenameRuleSlint> rule;
    in property <int> rule-index: 0;
    in property <int> total-rules: 1;
    in property <int> open-dropdown-rule: -1;
    in property <string> open-dropdown-kind: "";
    in property <brush> accent-bg: #0D52BF;
    in property <brush> surface-bg: #1A1A1E;
    in property <brush> hover-bg: #26262B;
    in property <brush> border-brush: #28282D;
    in property <brush> text-primary: #E1E1E6;
    in property <brush> text-secondary: #888892;
    in property <string> font-family: "";
    in property <length> font-delta: 0px;

    callback add-rule();
    callback remove-rule();
    callback open-dropdown(string, length, length);
    callback update-field(string, string);
    callback toggle-case-sensitive();
    callback escape-modal();

    spacing: 7px;

    HorizontalLayout {
        alignment: space-between;
        height: 22px;
        Text {
            text: root.total-rules > 1 ? ("Step " + (root.rule-index + 1)) : "";
            color: root.text-secondary;
            font-size: 11px + root.font-delta * 0.5;
            font-family: root.font-family;
            font-weight: 600;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            Rectangle {
                width: 24px;
                height: 20px;
                border-radius: 4px;
                background: add-ta.has-hover ? root.hover-bg : #2A2A32;
                border-width: 1px;
                border-color: root.border-brush;
                LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-size: 12px;
                    kind: "plus";
                    icon-color: root.text-primary;
                }
                add-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.add-rule(); }
                }
            }
            Rectangle {
                width: 24px;
                height: 20px;
                border-radius: 4px;
                opacity: root.total-rules > 1 ? 1.0 : 0.35;
                background: (rem-ta.has-hover && root.total-rules > 1) ? root.hover-bg : #2A2A32;
                border-width: 1px;
                border-color: root.border-brush;
                LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-size: 12px;
                    kind: "minus";
                    icon-color: root.text-primary;
                }
                rem-ta := TouchArea {
                    mouse-cursor: root.total-rules > 1 ? pointer : default;
                    clicked => {
                        if root.total-rules > 1 {
                            root.remove-rule();
                        }
                    }
                }
            }
        }
    }

    BatchRenameSelectRow {
        label: "Operation:";
        value: root.rule.operation;
        open: root.open-dropdown-rule == root.rule-index && root.open-dropdown-kind == "operation";
        accent-bg: root.accent-bg;
        hover-bg: root.hover-bg;
        text-primary: root.text-primary;
        text-secondary: root.text-secondary;
        font-family: root.font-family;
        font-delta: root.font-delta;
        toggle-open(ax, ay) => { root.open-dropdown("operation", ax, ay); }
    }

    BatchRenameSelectRow {
        label: "Apply to:";
        value: root.rule.apply-to;
        open: root.open-dropdown-rule == root.rule-index && root.open-dropdown-kind == "apply_to";
        accent-bg: root.accent-bg;
        hover-bg: root.hover-bg;
        text-primary: root.text-primary;
        text-secondary: root.text-secondary;
        font-family: root.font-family;
        font-delta: root.font-delta;
        toggle-open(ax, ay) => { root.open-dropdown("apply_to", ax, ay); }
    }

    if root.rule.operation == "Replace Text" : VerticalLayout {
        spacing: 7px;

        BatchRenameSelectRow {
            label: "Occurrences:";
            value: root.rule.occurrences;
            open: root.open-dropdown-rule == root.rule-index && root.open-dropdown-kind == "occurrences";
            accent-bg: root.accent-bg;
            hover-bg: root.hover-bg;
            text-primary: root.text-primary;
            text-secondary: root.text-secondary;
            font-family: root.font-family;
            font-delta: root.font-delta;
            toggle-open(ax, ay) => { root.open-dropdown("occurrences", ax, ay); }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                width: 82px;
                text: "Replace text:";
                color: root.text-secondary;
                font-size: 12px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            CleanLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.rule.find-text;
                placeholder-text: root.rule.occurrences == "Regular Expression" ? "e.g. 100.* or ^(\\d+)" : "Find text";
                font-size: 12px + root.font-delta * 0.5;
                edited(val) => { root.update-field("find_text", val); }
                escape-pressed => { root.escape-modal(); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                width: 82px;
                text: "With text:";
                color: root.text-secondary;
                font-size: 12px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            CleanLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.rule.replace-text;
                placeholder-text: root.rule.occurrences == "Regular Expression" ? "Replacement ($1, $2…)" : "Replacement";
                font-size: 12px + root.font-delta * 0.5;
                edited(val) => { root.update-field("replace_text", val); }
                escape-pressed => { root.escape-modal(); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 22px;
            Rectangle { width: 82px; background: transparent; }
            ViewOptionCheckboxRow {
                horizontal-stretch: 1;
                label: "Case sensitive";
                checked: root.rule.case-sensitive;
                accent-bg: root.accent-bg;
                surface-bg: root.surface-bg;
                border-brush: root.border-brush;
                text-brush: root.text-primary;
                font-family: root.font-family;
                toggled => { root.toggle-case-sensitive(); }
            }
        }
    }

    if root.rule.operation == "Change Case" : BatchRenameSelectRow {
        label: "Format:";
        value: root.rule.case-style;
        open: root.open-dropdown-rule == root.rule-index && root.open-dropdown-kind == "case_style";
        accent-bg: root.accent-bg;
        hover-bg: root.hover-bg;
        text-primary: root.text-primary;
        text-secondary: root.text-secondary;
        font-family: root.font-family;
        font-delta: root.font-delta;
        toggle-open(ax, ay) => { root.open-dropdown("case_style", ax, ay); }
    }

    if root.rule.operation == "Add Sequence" || root.rule.operation == "Add Text" || root.rule.operation == "Add Date" : BatchRenameSelectRow {
        label: "Position:";
        value: root.rule.position;
        open: root.open-dropdown-rule == root.rule-index && root.open-dropdown-kind == "position";
        accent-bg: root.accent-bg;
        hover-bg: root.hover-bg;
        text-primary: root.text-primary;
        text-secondary: root.text-secondary;
        font-family: root.font-family;
        font-delta: root.font-delta;
        toggle-open(ax, ay) => { root.open-dropdown("position", ax, ay); }
    }

    if root.rule.operation == "Add Sequence" : VerticalLayout {
        spacing: 7px;

        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                width: 82px;
                text: "Prefix:";
                color: root.text-secondary;
                font-size: 12px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            CleanLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.rule.seq-prefix;
                placeholder-text: "e.g. _ or item_";
                font-size: 12px + root.font-delta * 0.5;
                edited(val) => { root.update-field("seq_prefix", val); }
                escape-pressed => { root.escape-modal(); }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            height: 26px;
            Text {
                width: 82px;
                text: "Start / Step:";
                color: root.text-secondary;
                font-size: 12px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            CleanLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.rule.seq-start;
                placeholder-text: "1";
                font-size: 12px + root.font-delta * 0.5;
                edited(val) => { root.update-field("seq_start", val); }
                escape-pressed => { root.escape-modal(); }
            }
            CleanLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.rule.seq-step;
                placeholder-text: "1";
                font-size: 12px + root.font-delta * 0.5;
                edited(val) => { root.update-field("seq_step", val); }
                escape-pressed => { root.escape-modal(); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                width: 82px;
                text: "Digits:";
                color: root.text-secondary;
                font-size: 12px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            CleanLineEdit {
                horizontal-stretch: 1;
                height: 26px;
                text: root.rule.seq-padding;
                placeholder-text: "3";
                font-size: 12px + root.font-delta * 0.5;
                edited(val) => { root.update-field("seq_padding", val); }
                escape-pressed => { root.escape-modal(); }
            }
        }
    }

    if root.rule.operation == "Add Text" : HorizontalLayout {
        spacing: 8px;
        height: 26px;
        Text {
            width: 82px;
            text: "Text:";
            color: root.text-secondary;
            font-size: 12px + root.font-delta * 0.5;
            font-family: root.font-family;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        CleanLineEdit {
            horizontal-stretch: 1;
            height: 26px;
            text: root.rule.replace-text;
            placeholder-text: "Text to insert";
            font-size: 12px + root.font-delta * 0.5;
            edited(val) => { root.update-field("replace_text", val); }
            escape-pressed => { root.escape-modal(); }
        }
    }

    if root.rule.operation == "Add Date" : BatchRenameSelectRow {
        label: "Format:";
        value: root.rule.date-format;
        open: root.open-dropdown-rule == root.rule-index && root.open-dropdown-kind == "date_format";
        accent-bg: root.accent-bg;
        hover-bg: root.hover-bg;
        text-primary: root.text-primary;
        text-secondary: root.text-secondary;
        font-family: root.font-family;
        font-delta: root.font-delta;
        toggle-open(ax, ay) => { root.open-dropdown("date_format", ax, ay); }
    }

    Rectangle {
        height: 1px;
        background: root.border-brush;
    }
}

component BatchRenamePreviewRowItem inherits VerticalLayout {
    in property <BatchRenamePreviewRowSlint> preview-row;
    in property <brush> accent-bg: #0D52BF;
    in property <brush> text-primary: #E1E1E6;
    in property <string> font-family: "";
    in property <length> font-delta: 0px;

    Rectangle {
        height: 30px + Math.max(0px, root.font-delta * 1.5);
        background: transparent;

        HorizontalLayout {
            spacing: 12px;

            HorizontalLayout {
                width: (parent.width - 48px) * 0.52;
                spacing: 8px;
                Rectangle {
                    width: 16px;
                    background: transparent;
                    LucideIcon {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        icon-size: 15px;
                        kind: root.preview-row.is-dir ? "folder" : (root.preview-row.is-image ? "image" : "documents");
                        icon-color: root.preview-row.is-dir ? #38B6FF : (root.preview-row.is-image ? #6E92B8 : #B4B4BE);
                        fill-color: root.preview-row.is-dir ? #4CC2FF : transparent;
                    }
                }
                Text {
                    text: root.preview-row.original-name;
                    color: root.text-primary;
                    font-size: 13px + root.font-delta * 0.5;
                    font-family: root.font-family;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 24px;
                background: transparent;

                if root.preview-row.status == "conflict" : LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-size: 16px;
                    kind: "alert-triangle";
                    icon-color: #1A1A1E;
                    fill-color: #FFD60A;
                }

                if root.preview-row.status == "changed" : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: root.accent-bg;
                    LucideIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-size: 10px;
                        kind: "arrow-right";
                        icon-color: #FFFFFF;
                    }
                }

                if root.preview-row.status == "unchanged" : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: #6E6E77;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "=";
                        color: #1A1A1E;
                        font-size: 11px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.preview-row.proposed-name;
                color: root.preview-row.status == "unchanged" ? #787882 : #FFFFFF;
                font-size: 13px + root.font-delta * 0.5;
                font-family: root.font-family;
                font-weight: root.preview-row.status == "unchanged" ? 500 : 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    Rectangle {
        height: 1px;
        background: #28282E;
    }
}


component SyncPreviewRowItem inherits Rectangle {
    in property <SyncPreviewRowSlint> srow;
    in property <brush> row-hover-bg: #26262B;
    in property <brush> text-primary: #E1E1E6;
    in property <brush> text-secondary: #888892;
    in property <brush> text-muted: #888892;
    callback toggle-approved();

    height: 26px;
    border-radius: 4px;
    background: srow-touch.has-hover ? root.row-hover-bg : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 26px;
            background: transparent;
            PermCheckbox {
                x: 4px;
                y: (parent.height - self.height) / 2;
                checked: root.srow.approved;
                toggled => { root.toggle-approved(); }
            }
        }
        Text {
            width: 88px;
            text: root.srow.action;
            color: root.srow.action == "Delete"
                ? #FF453A
                : (root.srow.action == "Conflict"
                    ? #FFD60A
                    : (root.srow.action == "Equal" ? root.text-muted : #38B6FF));
            font-size: 11px;
            font-family: "monospace";
            font-weight: 700;
            vertical-alignment: center;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            LucideIcon {
                y: (parent.height - self.height) / 2;
                icon-size: 13px;
                kind: root.srow.is-dir ? "folder" : "documents";
                icon-color: root.srow.is-dir ? #38B6FF : root.text-secondary;
            }
            Text {
                horizontal-stretch: 1;
                text: root.srow.relative-path;
                color: root.text-primary;
                font-size: 11.5px;
                font-family: "monospace";
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            width: 88px;
            text: root.srow.source-size;
            color: root.text-secondary;
            font-size: 11px;
            font-family: "monospace";
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 88px;
            text: root.srow.dest-size;
            color: root.text-secondary;
            font-size: 11px;
            font-family: "monospace";
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    srow-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-approved(); }
    }
}

component SyncModalCard inherits Rectangle {
    in property <[SyncPreviewRowSlint]> sync-preview-rows: [];
    in property <string> sync-left-path: "";
    in property <string> sync-right-path: "";
    in property <bool> sync-running: false;
    in property <string> sync-strategy: "left_to_right";
    in property <string> sync-compare-mode: "hash";
    in property <string> sync-summary-text: "";
    in property <brush> theme-bg-popover: #202024;
    in property <brush> theme-bg-toolbar: #1E1E22;
    in property <brush> theme-bg-surface: #1A1A1E;
    in property <brush> theme-row-hover: #26262B;
    in property <brush> theme-accent: #0D52BF;
    in property <brush> theme-border: #28282D;
    in property <brush> theme-text-primary: #E1E1E6;
    in property <brush> theme-text-secondary: #888892;
    in property <brush> theme-text-muted: #888892;
    in property <string> resolved-font-family: "";
    in property <length> font-size-delta: 0px;
    callback close-modal();
    callback update-sync-options(string, string);
    callback toggle-sync-row-approved(int);
    callback execute-sync-plan();

    border-radius: 12px;
    background: root.theme-bg-popover;
    border-width: 1px;
    border-color: root.theme-border;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 28px;
    drop-shadow-color: #00000099;
    clip: true;

    TouchArea {}

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 8px;
                LucideIcon {
                    y: (parent.height - self.height) / 2;
                    icon-size: 16px;
                    kind: "refresh";
                    icon-color: root.theme-text-secondary;
                }
                Text {
                    text: "Directory Sync & Diff Preview";
                    color: root.theme-text-primary;
                    font-size: 14px + root.font-size-delta;
                    font-family: root.resolved-font-family;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            ToolbarButton {
                icon-kind: "close";
                clicked => { root.close-modal(); }
            }
        }

        Rectangle { height: 1px; background: root.theme-border; }

        Rectangle {
            height: 28px;
            border-radius: 5px;
            background: root.theme-bg-surface;
            border-width: 1px;
            border-color: root.theme-border;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "Left: " + root.sync-left-path;
                    color: root.theme-text-primary;
                    font-size: 11px;
                    font-family: "monospace";
                    vertical-alignment: center;
                    overflow: elide;
                }
                LucideIcon {
                    y: (parent.height - self.height) / 2;
                    icon-size: 13px;
                    kind: "arrow-right";
                    icon-color: root.theme-text-secondary;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Right: " + root.sync-right-path;
                    color: root.theme-text-primary;
                    font-size: 11px;
                    font-family: "monospace";
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Strategy:";
                    color: root.theme-text-secondary;
                    font-size: 11.5px + root.font-size-delta * 0.5;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                SegmentControlButton {
                    label: "Left → Right";
                    btn-width: 96px;
                    active: root.sync-strategy == "left_to_right";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options("left_to_right", root.sync-compare-mode); }
                }
                SegmentControlButton {
                    label: "Right → Left";
                    btn-width: 96px;
                    active: root.sync-strategy == "right_to_left";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options("right_to_left", root.sync-compare-mode); }
                }
                SegmentControlButton {
                    label: "Mirror L → R";
                    btn-width: 96px;
                    active: root.sync-strategy == "mirror_left_to_right";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options("mirror_left_to_right", root.sync-compare-mode); }
                }
                SegmentControlButton {
                    label: "Mirror R → L";
                    btn-width: 96px;
                    active: root.sync-strategy == "mirror_right_to_left";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options("mirror_right_to_left", root.sync-compare-mode); }
                }
                SegmentControlButton {
                    label: "Bi-Directional";
                    btn-width: 102px;
                    active: root.sync-strategy == "bi_directional";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options("bi_directional", root.sync-compare-mode); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Compare:";
                    color: root.theme-text-secondary;
                    font-size: 11.5px + root.font-size-delta * 0.5;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                SegmentControlButton {
                    label: "Hash";
                    btn-width: 64px;
                    active: root.sync-compare-mode == "hash";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options(root.sync-strategy, "hash"); }
                }
                SegmentControlButton {
                    label: "Time + Size";
                    btn-width: 92px;
                    active: root.sync-compare-mode == "timestamp";
                    accent-bg: root.theme-accent;
                    font-family: root.resolved-font-family;
                    clicked => { root.update-sync-options(root.sync-strategy, "timestamp"); }
                }
            }
        }

        Rectangle {
            height: 26px;
            border-radius: 5px;
            background: root.theme-bg-toolbar;
            border-width: 1px;
            border-color: root.theme-border;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text { width: 26px; text: "Run"; color: root.theme-text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                Text { width: 88px; text: "Action"; color: root.theme-text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: "Relative Path"; color: root.theme-text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                Text { width: 88px; text: "Left Size"; color: root.theme-text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                Text { width: 88px; text: "Right Size"; color: root.theme-text-muted; font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            background: root.theme-bg-surface;
            border-width: 1px;
            border-color: root.theme-border;
            clip: true;

            if root.sync-preview-rows.length == 0 : VerticalLayout {
                alignment: center;
                Text {
                    text: "Both directories are in sync — no differences detected.";
                    color: root.theme-text-secondary;
                    font-size: 12px + root.font-size-delta * 0.5;
                    horizontal-alignment: center;
                }
            }

            if root.sync-preview-rows.length > 0 : ScrollView {
                viewport-height: root.sync-preview-rows.length * 28px + 8px;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for srow[s-idx] in root.sync-preview-rows : SyncPreviewRowItem {
                        srow: srow;
                        row-hover-bg: root.theme-row-hover;
                        text-primary: root.theme-text-primary;
                        text-secondary: root.theme-text-secondary;
                        text-muted: root.theme-text-muted;
                        toggle-approved => { root.toggle-sync-row-approved(s-idx); }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: root.theme-border; }

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.sync-summary-text;
                color: root.theme-text-secondary;
                font-size: 11.5px + root.font-size-delta * 0.5;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 8px;
                ToolbarButton {
                    label: "Cancel";
                    clicked => { root.close-modal(); }
                }
                ToolbarButton {
                    label: root.sync-running ? "Synchronizing…" : "Synchronize";
                    active: true;
                    enabled-state: !root.sync-running && root.sync-preview-rows.length > 0;
                    accent-bg: root.theme-accent;
                    clicked => { root.execute-sync-plan(); }
                }
            }
        }
    }
}

