    callback toggle-dual-pane();
    callback toggle-font-bold();
    callback toggle-inspector();
    callback toggle-pause-transfer(string);
    callback toggle-sync-row-approved(int);
    callback toggle-view-options-option(string);
    callback update-batch-rename-rule(int, string, string);
    callback update-sync-options(string, string);
    callback use-view-options-as-defaults();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: transparent;

    if root.show-sibling-dropdown : Rectangle {
        z: 20;
        width: 100%;
        height: 100%;
        background: #00000033;

        TouchArea {
            clicked => { root.show-sibling-dropdown = false; }
        }

        // Software-renderer drop shadow layer
        Rectangle {
            x: Math.min(root.sibling-dropdown-x, root.width - 230px) - 2px;
            y: root.sibling-dropdown-y + 4px;
            width: 219px;
            height: Math.min(280px, Math.max(36px, root.sibling-dropdown-items.length * 28px + 12px)) + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: Math.min(root.sibling-dropdown-x, root.width - 230px);
            y: root.sibling-dropdown-y;
            width: 215px;
            height: Math.min(280px, Math.max(36px, root.sibling-dropdown-items.length * 28px + 12px));
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            TouchArea {}

            ScrollView {
                viewport-height: root.sibling-dropdown-items.length * 28px + 12px;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for sib in root.sibling-dropdown-items : ContextMenuItem {
                        icon-kind: "folder";
                        label: sib.label;
                        triggered => {
                            root.show-sibling-dropdown = false;
                            root.navigate-to-breadcrumb(root.sibling-dropdown-is-right, sib.target-path);
                        }
                    }
                }
            }
        }
    }


    // LAYER 3 (z: 1000): FLOATING RIGHT-CLICK CONTEXT MENU (doc/specification_2.md §2.1 & §4.1:
    // - 100% opaque #202024 surface (opacity: 1.0) on both container and items
    // - 1px solid #323238 border, 8px border-radius
    // - Multi-layer software-renderer shadow + native drop-shadow (offset-y: 10px, blur: 24px, #00000073)
    // - Subtle backdrop scrim (#00000055) so underlying table text never visually merges with menu labels
    // - Crisp 16x16px Lucide vector SVG icons)
    if root.show-context-menu : Rectangle {
        z: 1000;
        width: 100%;
        height: 100%;
        background: #00000055;

        TouchArea {
            clicked => { root.show-context-menu = false; }
        }

        // Outer ambient drop shadow (ensures visible elevation even in software renderer)
        Rectangle {
            x: Math.clamp(root.context-menu-x, 8px, root.width - 270px) - 4px;
            y: Math.clamp(root.context-menu-y, 8px, Math.max(8px, root.height - ctx-menu-layout.preferred-height - 16px)) + 6px;
            width: 264px;
            height: ctx-menu-layout.preferred-height + 8px;
            border-radius: 12px;
            background: #00000055;
        }

        // Inner crisp drop shadow
        Rectangle {
            x: Math.clamp(root.context-menu-x, 8px, root.width - 270px) - 2px;
            y: Math.clamp(root.context-menu-y, 8px, Math.max(8px, root.height - ctx-menu-layout.preferred-height - 16px)) + 3px;
            width: 260px;
            height: ctx-menu-layout.preferred-height + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: Math.clamp(root.context-menu-x, 8px, root.width - 270px);
            y: Math.clamp(root.context-menu-y, 8px, Math.max(8px, root.height - ctx-menu-layout.preferred-height - 16px));
            width: 256px;
            height: ctx-menu-layout.preferred-height;
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;
            clip: true;

            TouchArea {}

            ctx-menu-layout := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                if !root.context-is-blank && root.context-selected-count > 1 : ContextMenuItem {
                    icon-kind: "folder";
                    label: "New Folder with Selection";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("new_folder_with_selection");
                    }
                }
                if !root.context-is-blank && root.context-selected-count > 1 : Rectangle { height: 1px; background: #323238; }

                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "external";
                    label: "Open";
                    shortcut-hint: "Enter";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("open");
                    }
                }
                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "external";
                    label: "Open With…";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("open_with");
                    }
                }
                if (root.context-target-is-dir && !root.context-target-is-app-bundle) || root.context-is-blank : ContextMenuItem {
                    icon-kind: "plus";
                    label: "Open in New Tab";
                    shortcut-hint: "Ctrl+T";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("open_new_tab");
                    }
                }

                if !root.context-is-blank && (root.context-can-show-enclosing || root.context-target-is-archive || root.context-target-is-app-bundle) : Rectangle { height: 1px; background: #323238; }

                if !root.context-is-blank && root.context-can-show-enclosing : ContextMenuItem {
                    icon-kind: "folder-up";
                    label: "Show in Enclosing Folder";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("show_in_enclosing_folder");
                    }
                }
                if !root.context-is-blank && root.context-target-is-archive : ContextMenuItem {
                    icon-kind: "archive-contents";
                    label: "Show Archive Contents";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("show_archive_contents");
                    }
                }
                if !root.context-is-blank && root.context-target-is-app-bundle : ContextMenuItem {
                    icon-kind: "archive-contents";
                    label: "Show Package Contents";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("show_package_contents");
                    }
                }

                if !root.context-is-blank : Rectangle { height: 1px; background: #323238; }

                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "trash";
                    label: "Move to Bin";
                    shortcut-hint: "Del";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("trash");
                    }
                }
                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "close";
                    label: "Permanent Delete";
                    shortcut-hint: "Shift+Del";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("delete_permanent");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "info";
                    label: "Get Info";
                    shortcut-hint: "Ctrl+I";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("get_info");
                    }
                }
                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "edit";
                    label: root.context-selected-count > 1
                        ? ("Rename " + root.context-selected-count + " Items…")
                        : "Rename";
                    shortcut-hint: "F2";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("rename");
                    }
                }
                ContextMenuItem {
                    icon-kind: "folder";
                    label: "New Folder";
                    shortcut-hint: "Ctrl+N";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("new_folder");
                    }
                }
                ContextMenuItem {
                    icon-kind: "file";
                    label: "New File";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("new_file");
                    }
                }
                if (root.context-target-is-dir || root.context-is-blank) && !root.context-target-is-favorite : ContextMenuItem {
                    icon-kind: "star";
                    label: "Add to Favorites";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("add_favorite");
                    }
                }
                if (root.context-target-is-dir || root.context-is-blank) && root.context-target-is-favorite : ContextMenuItem {
                    icon-kind: "eject";
                    label: "Remove from Favorites";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("remove_favorite");
                    }
                }
                if !root.context-is-blank && root.context-target-is-archive : ContextMenuItem {
                    icon-kind: "archive";
                    label: "Extract \"" + root.context-target-name + "\" Here";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("extract");
                    }
                }
                if !root.context-is-blank && !root.context-target-is-archive : ContextMenuItem {
                    icon-kind: "archive";
                    label: root.context-selected-count > 1
                        ? ("Compress " + root.context-selected-count + " Items")
                        : ("Compress \"" + root.context-target-name + "\"");
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("compress");
                    }
                }
                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "copy";
                    label: "Duplicate";
                    shortcut-hint: "Ctrl+D";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("duplicate");
                    }
                }
                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "link";
                    label: "Create Symlink";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("make_alias");
                    }
                }
                ContextMenuItem {
                    icon-kind: "terminal";
                    label: "Open in Bottom Terminal";
                    triggered => {
                        root.show-context-menu = false;
                        root.open-terminal-here();
                    }
                }
                ContextMenuItem {
                    icon-kind: "external";
                    label: "Open in OS File Manager";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("reveal_in_finder");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "scissors";
                    label: root.context-selected-count > 1
                        ? ("Cut " + root.context-selected-count + " Items")
                        : ("Cut \"" + root.context-target-name + "\"");
                    shortcut-hint: "Ctrl+X";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("cut");
                    }
                }
                if !root.context-is-blank : ContextMenuItem {
                    icon-kind: "copy";
                    label: root.context-selected-count > 1
                        ? ("Copy " + root.context-selected-count + " Items")
                        : ("Copy \"" + root.context-target-name + "\"");
                    shortcut-hint: "Ctrl+C";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("copy");
                    }
                }
                if root.has-clipboard-item : ContextMenuItem {
                    icon-kind: "downloads";
                    label: "Paste Item Here";
                    shortcut-hint: "Ctrl+V";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("paste");
                    }
                }
                ContextMenuItem {
                    icon-kind: "link";
                    label: "Copy Path";
                    shortcut-hint: "Ctrl+Shift+C";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("copy_path");
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "sliders";
                    label: "Show View Options";
                    shortcut-hint: "Ctrl+J";
                    triggered => {
                        root.show-context-menu = false;
                        root.execute-context-action("show_view_options");
                    }
                }

                if !root.context-is-blank : Rectangle { height: 1px; background: #323238; }

                if !root.context-is-blank : HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    height: 24px;
                    alignment: space-between;
                    Text {
                        text: "Tag:";
                        color: #A0A0AB;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        ColorSwatchDot {
                            swatch-color: #FF453A;
                            selected: root.inspector-color-index == 6;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(6);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #FF9F0A;
                            selected: root.inspector-color-index == 7;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(7);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #FFD60A;
                            selected: root.inspector-color-index == 5;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(5);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #5AC85A;
                            selected: root.inspector-color-index == 2;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(2);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #0A84FF;
                            selected: root.inspector-color-index == 4;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(4);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #AF52DE;
                            selected: root.inspector-color-index == 3;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(3);
                            }
                        }
                        ColorSwatchDot {
                            swatch-color: #8E8E93;
                            selected: root.inspector-color-index == 1;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(1);
                            }
                        }
                        ColorSwatchDot {
                            is-none: true;
                            selected: root.inspector-color-index == 0;
                            clicked => {
                                root.show-context-menu = false;
                                root.set-selected-color-label(0);
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.2 (z: 1600): SIDEBAR OBJECT RIGHT-CLICK CONTEXT MENU (Devices, Connections, Favorites)
    if root.show-sidebar-context-menu : Rectangle {
        z: 1600;
        width: 100%;
        height: 100%;
        background: #00000055;

        TouchArea {
            clicked => { root.show-sidebar-context-menu = false; }
        }

        // Outer ambient shadow layer
        Rectangle {
            x: Math.min(root.sidebar-context-x, root.width - 266px) - 2px;
            y: Math.min(root.sidebar-context-y, Math.max(8px, root.height - sb-ctx-layout.preferred-height - 16px)) + 5px;
            width: 260px;
            height: sb-ctx-layout.preferred-height + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        // Solid opaque Dark Zinc surface (#202024, border #323238)
        Rectangle {
            x: Math.min(root.sidebar-context-x, root.width - 266px);
            y: Math.min(root.sidebar-context-y, Math.max(8px, root.height - sb-ctx-layout.preferred-height - 16px));
            width: 256px;
            height: sb-ctx-layout.preferred-height;
            border-radius: 8px;
            opacity: 1.0;
            background: #202024;
            border-width: 1px;
            border-color: #323238;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            TouchArea {}

            sb-ctx-layout := VerticalLayout {
                padding: 5px;
                spacing: 2px;

                // Header badge showing selected Device / Connection / Favorite
                Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: #161618;
                    border-width: 1px;
                    border-color: #28282D;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 14px;
                            kind: root.sidebar-context-icon;
                            icon-color: root.theme-text-secondary;
                        }
                        Text {
                            text: root.sidebar-context-label;
                            color: #FFFFFF;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.sidebar-context-section;
                            color: #888892;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                ContextMenuItem {
                    icon-kind: "folder";
                    label: "Open";
                    shortcut-hint: "Enter";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("open");
                    }
                }
                ContextMenuItem {
                    icon-kind: "plus";
                    label: "Open in New Tab";
                    shortcut-hint: "Cmd+T";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("open_new_tab");
                    }
                }
                ContextMenuItem {
                    icon-kind: "columns";
                    label: "Open in Dual Pane";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("open_other_pane");
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                ContextMenuItem {
                    icon-kind: "edit";
                    label: root.sidebar-context-section == "Connections"
                        ? "Edit Connection…"
                        : "Edit Label / Information…";
                    shortcut-hint: "Cmd+E";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("edit");
                    }
                }
                ContextMenuItem {
                    icon-kind: "info";
                    label: root.sidebar-context-section == "Favorites"
                        ? "Get Info"
                        : (root.sidebar-context-section == "Connections"
                            ? "Get Connection Info"
                            : "Get Info / Volume Details");
                    shortcut-hint: "Cmd+I";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("get_info");
                    }
                }
                ContextMenuItem {
                    icon-kind: "terminal";
                    label: root.sidebar-context-section == "Connections"
                        ? "Open SSH Terminal"
                        : "Open Terminal Here";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("terminal");
                    }
                }
                ContextMenuItem {
                    icon-kind: "refresh";
                    label: root.sidebar-context-section == "Connections"
                        ? "Reconnect Server"
                        : (root.sidebar-context-section == "Favorites"
                            ? "Refresh Folder"
                            : "Refresh Volume");
                    shortcut-hint: "Cmd+R";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("refresh");
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                ContextMenuItem {
                    icon-kind: "copy";
                    label: "Copy Path / URI";
                    shortcut-hint: "Cmd+Opt+C";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("copy_path");
                    }
                }
                if root.sidebar-context-section == "Favorites" : ContextMenuItem {
                    icon-kind: "chevron-up";
                    label: "Move Up in Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("move_fav_up");
                    }
                }
                if root.sidebar-context-section == "Favorites" : ContextMenuItem {
                    icon-kind: "chevron-down";
                    label: "Move Down in Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("move_fav_down");
                    }
                }
                if root.sidebar-context-section == "Connections" : ContextMenuItem {
                    icon-kind: "copy";
                    label: "Duplicate Connection";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("duplicate_connection");
                    }
                }
                if root.sidebar-context-section != "Favorites" && !root.sidebar-context-is-favorite : ContextMenuItem {
                    icon-kind: "star";
                    label: "Add to Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("add_favorite");
                    }
                }
                if root.sidebar-context-section == "Favorites" || root.sidebar-context-is-favorite : ContextMenuItem {
                    icon-kind: "eject";
                    label: "Remove from Favorites";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("remove_favorite");
                    }
                }
                if root.sidebar-context-section == "Connections" || (root.sidebar-context-section == "Devices" && root.sidebar-context-can-eject) : ContextMenuItem {
                    icon-kind: "eject";
                    label: root.sidebar-context-section == "Connections"
                        ? "Disconnect / Remove"
                        : "Eject / Unmount Volume";
                    triggered => {
                        root.show-sidebar-context-menu = false;
                        root.execute-sidebar-context-action("eject");
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                // 8-Color Swatch Tag Row for Devices, Connections & Favorites
                HorizontalLayout {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 9px;
                    alignment: center;
                    ColorSwatchDot {
                        swatch-color: #FF453A;
                        selected: root.sidebar-context-color-index == 6;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(6);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #FF9F0A;
                        selected: root.sidebar-context-color-index == 7;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(7);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #FFD60A;
                        selected: root.sidebar-context-color-index == 5;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(5);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #4E9A5E;
                        selected: root.sidebar-context-color-index == 2;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(2);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #0A84FF;
                        selected: root.sidebar-context-color-index == 4;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(4);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #BF5AF2;
                        selected: root.sidebar-context-color-index == 3;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(3);
                        }
                    }
                    ColorSwatchDot {
                        swatch-color: #8E8E93;
                        selected: root.sidebar-context-color-index == 1;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(1);
                        }
                    }
                    ColorSwatchDot {
                        is-none: true;
                        selected: root.sidebar-context-color-index == 0;
                        clicked => {
                            root.show-sidebar-context-menu = false;
                            root.set-sidebar-item-color(0);
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): NEW FOLDER / RENAME / COMPRESS ARCHIVE INPUT MODAL
    if root.show-input-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        init => {
            input-modal-edit.focus-input();
        }
        TouchArea {
            clicked => {
                root.show-input-modal = false;
                root.focus-key-router();
            }
        }

        Rectangle {
            width: Math.clamp(
                (root.input-modal-mode == "compress" ? 450px : 420px) + root.font-size-delta * 18,
                390px,
                root.width - 40px
            );
            height: input-modal-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;

            TouchArea {}

            input-modal-layout := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        y: 0px;
                        border-radius: 9px;
                        background: #0D52BF22;
                        border-width: 1px;
                        border-color: root.theme-accent;
                        LucideIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-size: 16px;
                            kind: root.input-modal-mode == "new_folder"
                                ? "folder"
                                : (root.input-modal-mode == "new_file"
                                    ? "file"
                                    : (root.input-modal-mode == "compress" ? "archive" : "edit"));
                            icon-color: root.theme-text-primary;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        alignment: center;
                        Text {
                            width: 100%;
                            text: root.input-modal-title;
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 14px + root.font-size-delta;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        if root.input-modal-mode == "compress" && root.compress-items-summary != "" : Text {
                            width: 100%;
                            text: root.compress-items-summary;
                            color: root.theme-text-secondary;
                            font-family: root.resolved-font-family;
                            font-size: 11.5px + root.font-size-delta * 0.5;
                            font-weight: 500;
                            wrap: word-wrap;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    if root.input-modal-mode == "compress" : Text {
                        text: "Archive Base Name:";
                        color: root.theme-text-secondary;
                        font-family: root.resolved-font-family;
                        font-size: 11.5px + root.font-size-delta * 0.5;
                        font-weight: 600;
                    }
                    input-modal-edit := CleanLineEdit {
                        height: 32px + Math.max(0px, root.font-size-delta * 1.5);
                        text <=> root.input-modal-value;
                        font-size: 13px + root.font-size-delta;
                        accepted(val) => {
                            root.show-input-modal = false;
                            root.focus-key-router();
                            root.confirm-input-modal(val);
                        }
                        escape-pressed => {
                            root.show-input-modal = false;
                            root.focus-key-router();
                        }
                    }
                }

                if root.input-modal-mode == "compress" : VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Compression Algorithm / Format:";
                        color: root.theme-text-secondary;
                        font-family: root.resolved-font-family;
                        font-size: 11.5px + root.font-size-delta * 0.5;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SegmentControlButton {
                            label: "TAR.GZ (.tar.gz)";
                            btn-width: 162px;
                            active: root.compress-format == "tar.gz";
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            font-delta: root.font-size-delta;
                            clicked => {
                                root.compress-format = "tar.gz";
                            }
                        }
                        SegmentControlButton {
                            label: "ZIP (.zip)";
                            btn-width: 138px;
                            active: root.compress-format == "zip";
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            font-delta: root.font-size-delta;
                            clicked => {
                                root.compress-format = "zip";
                            }
                        }
                    }
                    Text {
                        text: "Output file: " + root.input-modal-value + "." + root.compress-format;
                        color: root.theme-text-secondary;
                        font-family: "monospace";
                        font-size: 11px + root.font-size-delta * 0.5;
                        overflow: elide;
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    ToolbarButton {
                        label: "Cancel";
                        font-family: root.resolved-font-family;
                        font-delta: root.font-size-delta;
                        accent-bg: root.theme-accent;
                        clicked => {
                            root.show-input-modal = false;
                            root.focus-key-router();
                        }
                    }
                    ToolbarButton {
                        label: root.input-modal-mode == "compress" ? "Compress" : "Confirm";
                        active: true;
                        font-family: root.resolved-font-family;
                        font-delta: root.font-size-delta;
                        accent-bg: root.theme-accent;
                        clicked => {
                            root.show-input-modal = false;
                            root.focus-key-router();
                            root.confirm-input-modal(root.input-modal-value);
                        }
                    }
                }
            }
        }
    }

    // LAYER 4.05 (z: 2040): MULTI-RENAME (BATCH RENAME) WINDOW MODAL
    if root.show-batch-rename-modal : Rectangle {
        z: 2040;
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {
                if root.batch-rename-open-dropdown-kind != "" {
                    root.batch-rename-open-dropdown-rule = -1;
                    root.batch-rename-open-dropdown-kind = "";
                } else {
                    root.show-batch-rename-modal = false;
                    root.focus-key-router();
                }
            }
        }

        Rectangle {
            width: Math.clamp(root.width * 0.78, 780px, 1020px);
            height: Math.clamp(root.height * 0.76, 500px, 680px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 14px;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000AA;
            clip: true;

            TouchArea {
                clicked => {
                    if root.batch-rename-open-dropdown-kind != "" {
                        root.batch-rename-open-dropdown-rule = -1;
                        root.batch-rename-open-dropdown-kind = "";
                    }
                }
            }

            VerticalLayout {
                width: 100%;
                height: 100%;

                // Main Split Body: Left Rule Pipeline Sidebar | Right Live Preview Table
                HorizontalLayout {
                    vertical-stretch: 1;

                    // LEFT SIDEBAR: Stacked Rule Pipeline
                    Rectangle {
                        width: 308px;
                        background: root.theme-bg-sidebar;

                        br-rules-flick := Flickable {
                            width: 100%;
                            height: 100%;
                            viewport-width: self.width;
                            viewport-height: Math.max(self.height, br-rules-col.preferred-height + 16px);

                            br-rules-col := VerticalLayout {
                                width: parent.width;
                                alignment: start;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                // Saved Multi-Rename Favorites / Presets Card
                                Rectangle {
                                    border-radius: 7px;
                                    background: root.theme-bg-surface;
                                    border-width: 1px;
                                    border-color: root.theme-border;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 5px;
                                                LucideIcon {
                                                    y: (parent.height - self.height) / 2;
                                                    icon-size: 12px;
                                                    kind: "star";
                                                    icon-color: root.theme-text-secondary;
                                                }
                                                Text {
                                                    text: "Favorites";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.font-size-delta * 0.5;
                                                    font-family: root.resolved-font-family;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            ToolbarButton {
                                                label: "+ Save Preset";
                                                font-family: root.resolved-font-family;
                                                font-delta: root.font-size-delta;
                                                accent-bg: root.theme-accent;
                                                clicked => { root.save-batch-rename-favorite(); }
                                            }
                                        }
                                        if root.batch-rename-favorite-names.length == 0 : Text {
                                            text: "No saved presets yet.";
                                            color: root.theme-text-muted;
                                            font-size: 10.5px;
                                            font-family: root.resolved-font-family;
                                        }
                                        for fav-name[f-idx] in root.batch-rename-favorite-names : Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: fav-apply-touch.has-hover ? root.theme-row-hover : transparent;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 4px;
                                                spacing: 6px;
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        width: 100%;
                                                        height: 100%;
                                                        text: fav-name;
                                                        color: root.theme-text-primary;
                                                        font-size: 11px;
                                                        font-family: root.resolved-font-family;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    fav-apply-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.apply-batch-rename-favorite(f-idx); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    y: 3px;
                                                    border-radius: 3px;
                                                    background: fav-del-touch.has-hover ? #FF453A33 : transparent;
                                                    LucideIcon {
                                                        x: 3.5px;
                                                        y: 3.5px;
                                                        icon-size: 11px;
                                                        kind: "close";
                                                        icon-color: fav-del-touch.has-hover ? #FF453A : root.theme-text-secondary;
                                                    }
                                                    fav-del-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.delete-batch-rename-favorite(f-idx); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                for rule[r-idx] in root.batch-rename-rules : BatchRenameRuleCard {
                                    rule: rule;
                                    rule-index: r-idx;
                                    total-rules: root.batch-rename-rules.length;
                                    open-dropdown-rule: root.batch-rename-open-dropdown-rule;
                                    open-dropdown-kind: root.batch-rename-open-dropdown-kind;
                                    accent-bg: root.theme-accent;
                                    surface-bg: root.theme-bg-surface;
                                    hover-bg: root.theme-row-hover;
                                    border-brush: root.theme-border;
                                    text-primary: root.theme-text-primary;
                                    text-secondary: root.theme-text-secondary;
                                    font-family: root.resolved-font-family;
                                    font-delta: root.font-size-delta;
                                    add-rule => {
                                        root.batch-rename-open-dropdown-rule = -1;
                                        root.batch-rename-open-dropdown-kind = "";
                                        root.add-batch-rename-rule(r-idx);
                                    }
                                    remove-rule => {
                                        root.batch-rename-open-dropdown-rule = -1;
                                        root.batch-rename-open-dropdown-kind = "";
                                        root.remove-batch-rename-rule(r-idx);
                                    }
                                    open-dropdown(kind, ax, ay) => {
                                        if root.batch-rename-open-dropdown-rule == r-idx && root.batch-rename-open-dropdown-kind == kind {
                                            root.batch-rename-open-dropdown-rule = -1;
                                            root.batch-rename-open-dropdown-kind = "";
                                        } else {
                                            root.batch-rename-dropdown-x = ax;
                                            root.batch-rename-dropdown-y = ay;
                                            root.batch-rename-open-dropdown-rule = r-idx;
                                            root.batch-rename-open-dropdown-kind = kind;
                                        }
                                    }
                                    update-field(field, val) => {
                                        root.update-batch-rename-rule(r-idx, field, val);
                                    }
                                    toggle-case-sensitive => {
                                        root.toggle-batch-rename-case-sensitive(r-idx);
                                    }
                                    escape-modal => {
                                        root.show-batch-rename-modal = false;
                                        root.focus-key-router();
                                    }
                                }
                            }
                        }
                    }

                    // 1px Vertical Divider
                    Rectangle {
                        width: 1px;
                        background: root.theme-border;
                    }

                    // RIGHT PANE: Live Side-by-Side Preview Table
                    Rectangle {
                        horizontal-stretch: 1;
                        background: root.theme-bg-surface;

                        br-preview-flick := Flickable {
                            width: 100%;
                            height: 100%;
                            viewport-width: self.width;
                            viewport-height: Math.max(self.height, br-preview-col.preferred-height + 16px);

                            br-preview-col := VerticalLayout {
                                width: parent.width;
                                alignment: start;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                padding-left: 16px;
                                padding-right: 16px;

                                for p-row[p-idx] in root.batch-rename-preview-rows : BatchRenamePreviewRowItem {
                                    preview-row: p-row;
                                    accent-bg: root.theme-accent;
                                    text-primary: root.theme-text-primary;
                                    font-family: root.resolved-font-family;
                                    font-delta: root.font-size-delta;
                                }
                            }
                        }
                    }
                }

                // Bottom 1px Border
                Rectangle {
                    height: 1px;
                    background: root.theme-border;
                }

                // Bottom Footer Bar
                Rectangle {
                    height: 48px;
                    background: root.theme-bg-popover;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            horizontal-stretch: 1;

                            if root.batch-rename-conflict-count > 0 : LucideIcon {
                                y: (parent.height - self.height) / 2;
                                icon-size: 16px;
                                kind: "alert-triangle";
                                icon-color: #1A1A1E;
                                fill-color: #FFD60A;
                            }

                            Text {
                                text: root.batch-rename-status-text;
                                color: root.batch-rename-conflict-count > 0
                                    ? root.theme-text-primary
                                    : root.theme-text-secondary;
                                font-size: 12.5px + root.font-size-delta * 0.5;
                                font-family: root.resolved-font-family;
                                font-weight: root.batch-rename-conflict-count > 0 ? 600 : 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;

                            ToolbarButton {
                                label: "Reset Rules";
                                font-family: root.resolved-font-family;
                                font-delta: root.font-size-delta;
                                accent-bg: root.theme-accent;
                                clicked => {
                                    root.batch-rename-open-dropdown-rule = -1;
                                    root.batch-rename-open-dropdown-kind = "";
                                    root.reset-batch-rename-rules();
                                }
                            }

                            ToolbarButton {
                                label: "Cancel";
                                font-family: root.resolved-font-family;
                                font-delta: root.font-size-delta;
                                accent-bg: root.theme-accent;
                                clicked => {
                                    root.batch-rename-open-dropdown-rule = -1;
                                    root.batch-rename-open-dropdown-kind = "";
                                    root.show-batch-rename-modal = false;
                                    root.focus-key-router();
                                }
                            }

                            ToolbarButton {
                                label: "Rename";
                                active: true;
                                enabled-state: root.batch-rename-conflict-count == 0 && root.batch-rename-changed-count > 0;
                                font-family: root.resolved-font-family;
                                font-delta: root.font-size-delta;
                                accent-bg: root.theme-accent;
                                clicked => {
                                    root.batch-rename-open-dropdown-rule = -1;
                                    root.batch-rename-open-dropdown-kind = "";
                                    root.confirm-batch-rename-modal();
                                }
                            }
                        }
                    }
                }
            }
        }

        // FLOATING DROPDOWN POPOVER MENU OVERLAY FOR MULTI-RENAME SELECTORS
        if root.batch-rename-open-dropdown-rule >= 0 && root.batch-rename-open-dropdown-kind != "" : Rectangle {
            z: 2060;
            x: Math.clamp(root.batch-rename-dropdown-x, 12px, root.width - 244px);
            y: Math.clamp(root.batch-rename-dropdown-y, 12px, root.height - br-dd-col.preferred-height - 16px);
            width: 228px;
            height: br-dd-col.preferred-height;
            border-radius: 8px;
            background: #24242A;
            border-width: 1px;
            border-color: #3E3E48;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000AA;

            TouchArea {}

            br-dd-col := VerticalLayout {
                padding: 5px;
                spacing: 2px;

                for opt in (
                    root.batch-rename-open-dropdown-kind == "operation"
                        ? ["Replace Text", "Change Case", "Add Sequence", "Add Text", "Add Date"]
                        : (root.batch-rename-open-dropdown-kind == "apply_to"
                            ? ["Name", "Name with Extension", "Extension"]
                            : (root.batch-rename-open-dropdown-kind == "occurrences"
                                ? ["All", "First", "Last", "Regular Expression"]
                                : (root.batch-rename-open-dropdown-kind == "case_style"
                                    ? ["lowercase", "UPPERCASE", "Title Case", "camelCase", "snake_case", "kebab-case"]
                                    : (root.batch-rename-open-dropdown-kind == "position"
                                        ? ["After Name", "Before Name", "Replace Name"]
                                        : ["YYYY-MM-DD", "YYYY-MM-DD_HH-mm", "YYYYMMDD", "File Modified (YYYY-MM-DD)", "File Modified (Date & Time)"]))))
                ) : ContextMenuItem {
                    icon-kind: (
                        (root.batch-rename-open-dropdown-kind == "operation" && root.batch-rename-rules[root.batch-rename-open-dropdown-rule].operation == opt)
                        || (root.batch-rename-open-dropdown-kind == "apply_to" && root.batch-rename-rules[root.batch-rename-open-dropdown-rule].apply-to == opt)
                        || (root.batch-rename-open-dropdown-kind == "occurrences" && root.batch-rename-rules[root.batch-rename-open-dropdown-rule].occurrences == opt)
                        || (root.batch-rename-open-dropdown-kind == "case_style" && root.batch-rename-rules[root.batch-rename-open-dropdown-rule].case-style == opt)
                        || (root.batch-rename-open-dropdown-kind == "position" && root.batch-rename-rules[root.batch-rename-open-dropdown-rule].position == opt)
                        || (root.batch-rename-open-dropdown-kind == "date_format" && root.batch-rename-rules[root.batch-rename-open-dropdown-rule].date-format == opt)
                    ) ? "check" : "";
                    label: opt;
                    triggered => {
                        root.update-batch-rename-rule(
                            root.batch-rename-open-dropdown-rule,
                            root.batch-rename-open-dropdown-kind,
                            opt
                        );
                        root.batch-rename-open-dropdown-rule = -1;
                        root.batch-rename-open-dropdown-kind = "";
                    }
                }
            }
        }
    }

    // LAYER 4.1 (z: 2050): "OPEN WITH…" APPLICATION PICKER MODAL
    if root.show-open-with-modal : Rectangle {
        z: 2050;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {
            clicked => {
                root.show-open-with-modal = false;
                root.focus-key-router();
            }
        }

        Rectangle {
            width: Math.clamp(460px + root.font-size-delta * 18, 430px, root.width - 40px);
            height: Math.clamp(420px + root.font-size-delta * 16, 390px, root.height - 60px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;

            TouchArea {}

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 10px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 8px;
                            background: #0D52BF22;
                            border-width: 1px;
                            border-color: root.theme-accent;
                            LucideIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon-size: 15px;
                                kind: "external";
                                icon-color: root.theme-text-primary;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Open \"" + root.open-with-target-name + "\" With…";
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 14px + root.font-size-delta;
                            font-weight: 700;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                    ToolbarButton {
                        icon-kind: "close";
                        tooltip: "Close (Esc)";
                        accent-bg: root.theme-accent;
                        clicked => {
                            root.show-open-with-modal = false;
                            root.focus-key-router();
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: root.theme-bg-sidebar;
                    border-width: 1px;
                    border-color: root.theme-border;
                    clip: true;

                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-height: Math.max(self.height, root.open-with-apps.length * (36px + root.font-size-delta * 1.5) + 12px);
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            alignment: start;
                            for app[app-idx] in root.open-with-apps : Rectangle {
                                height: 34px + Math.max(0px, root.font-size-delta * 1.5);
                                border-radius: 6px;
                                background: root.open-with-selected-idx == app-idx
                                    ? root.theme-accent
                                    : (ow-app-touch.has-hover ? root.theme-row-hover : transparent);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    LucideIcon {
                                        y: (parent.height - self.height) / 2;
                                        icon-size: 15px;
                                        kind: app.icon-kind != "" ? app.icon-kind : "applications";
                                        icon-color: root.open-with-selected-idx == app-idx ? #FFFFFF : root.theme-text-secondary;
                                    }
                                    Text {
                                        text: app.name;
                                        color: root.open-with-selected-idx == app-idx ? #FFFFFF : root.theme-text-primary;
                                        font-family: root.resolved-font-family;
                                        font-size: 13px + root.font-size-delta;
                                        font-weight: root.open-with-selected-idx == app-idx ? 700 : 500;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: app.detail;
                                        color: root.open-with-selected-idx == app-idx ? #E2E8F0 : root.theme-text-secondary;
                                        font-family: root.resolved-font-family;
                                        font-size: 11px + root.font-size-delta * 0.5;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                ow-app-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-with-selected-idx = app-idx;
                                        root.open-with-custom-cmd = "";
                                    }
                                    double-clicked => {
                                        root.show-open-with-modal = false;
                                        root.focus-key-router();
                                        root.confirm-open-with(app.id);
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Or enter custom application / command:";
                        color: root.theme-text-secondary;
                        font-family: root.resolved-font-family;
                        font-size: 11.5px + root.font-size-delta * 0.5;
                        font-weight: 600;
                    }
                    CleanLineEdit {
                        height: 30px + Math.max(0px, root.font-size-delta * 1.5);
                        text <=> root.open-with-custom-cmd;
                        placeholder-text: "e.g. Visual Studio Code, VLC, vim, open -a Preview…";
                        font-size: 12.5px + root.font-size-delta;
                        accepted(val) => {
                            root.show-open-with-modal = false;
                            root.focus-key-router();
                            root.confirm-open-with(val);
                        }
                        escape-pressed => {
                            root.show-open-with-modal = false;
                            root.focus-key-router();
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    ToolbarButton {
                        label: "Cancel";
                        font-family: root.resolved-font-family;
                        font-delta: root.font-size-delta;
                        accent-bg: root.theme-accent;
                        clicked => {
                            root.show-open-with-modal = false;
                            root.focus-key-router();
                        }
                    }
                    ToolbarButton {
                        label: "Open";
                        active: true;
                        font-family: root.resolved-font-family;
                        font-delta: root.font-size-delta;
                        accent-bg: root.theme-accent;
                        clicked => {
                            root.show-open-with-modal = false;
                            root.focus-key-router();
                            if root.open-with-custom-cmd != "" {
                                root.confirm-open-with(root.open-with-custom-cmd);
                            } else if root.open-with-selected-idx >= 0 && root.open-with-selected-idx < root.open-with-apps.length {
                                root.confirm-open-with(root.open-with-apps[root.open-with-selected-idx].id);
                            } else {
                                root.confirm-open-with("");
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): DYNAMIC CONNECTION / INSPECTOR MODAL (Protocol-Specific Fields & Placeholders)
    if root.show-connect-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {}

        Rectangle {
            width: Math.clamp(540px + root.font-size-delta * 20, 520px, root.width - 40px);
            height: connect-modal-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;

            connect-modal-layout := VerticalLayout {
                padding: 18px;
                spacing: 8px;

                // Top Header Bar with Colored Padlock/Globe Icon + Connection Title
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 5px;
                        background: #28282D;
                        LucideIcon {
                            x: 3px;
                            y: 3px;
                            icon-size: 16px;
                            kind: (root.connect-protocol == "SFTP" || root.connect-protocol == "FTPS") ? "lock" : "globe";
                            icon-color: root.connect-color-index == 1
                                ? #8E8E93
                                : (root.connect-color-index == 2
                                    ? #4E9A5E
                                    : (root.connect-color-index == 3
                                        ? #BF5AF2
                                        : (root.connect-color-index == 4
                                            ? #0A84FF
                                            : (root.connect-color-index == 5
                                                 ? #FFD60A
                                                 : (root.connect-color-index == 6
                                                     ? #FF453A
                                                     : (root.connect-color-index == 7 ? #FF9F0A : root.theme-text-secondary))))));
                        }
                    }
                    Text {
                        text: root.connect-name != ""
                            ? root.connect-name
                            : (root.connect-protocol == "S3" && root.connect-s3-bucket != ""
                                ? root.connect-s3-bucket
                                : (root.connect-server != ""
                                    ? root.connect-server
                                    : (root.connect-editing-id != ""
                                        ? ("Edit " + root.connect-protocol + " Connection")
                                        : ("New " + root.connect-protocol + " Connection"))));
                        color: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        font-size: 14px + root.font-size-delta;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if root.connect-editing-id != "" : Rectangle {
                        height: 18px;
                        width: 54px;
                        border-radius: 4px;
                        background: #0D52BF33;
                        border-width: 1px;
                        border-color: #0D52BF;
                        Text {
                            text: "Editing";
                            color: root.theme-text-primary;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: #2A2A30; }

                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 105px; text: "Display Name:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                    CleanLineEdit {
                        horizontal-stretch: 1;
                        text <=> root.connect-name;
                        escape-pressed => {
                            root.close-connect-dialog();
                            root.focus-key-router();
                        }
                        placeholder-text: root.connect-protocol == "S3"
                            ? "e.g. AWS Production Bucket (optional)"
                            : (root.connect-protocol == "SMB"
                                ? "e.g. Office NAS Share (optional)"
                                : (root.connect-protocol == "WebDAV"
                                    ? "e.g. Nextcloud Server (optional)"
                                    : "e.g. Production Server (optional)"));
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 105px; text: "Protocol:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                    HorizontalLayout {
                        spacing: 4px;
                        for proto in ["SFTP", "S3", "SMB", "FTP", "FTPS", "WebDAV"] : SegmentControlButton {
                            label: proto;
                            btn-width: 56px;
                            active: root.connect-protocol == proto;
                            clicked => { root.select-connect-protocol(proto); }
                        }
                    }
                }

                // 1. SFTP / FTP / WebDAV Primary Fields
                if root.connect-protocol == "SFTP" || root.connect-protocol == "FTP" || root.connect-protocol == "FTPS" || root.connect-protocol == "WebDAV" : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Server:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-server;
                            placeholder-text: (root.connect-protocol == "FTP" || root.connect-protocol == "FTPS")
                                ? "ftp.example.com"
                                : (root.connect-protocol == "WebDAV"
                                    ? "cloud.example.com"
                                    : "sftp.example.com or 192.168.1.10");
                        }
                        Text { text: "Port:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 64px;
                            text <=> root.connect-port;
                            placeholder-text: root.connect-protocol == "FTP"
                                ? "21"
                                : (root.connect-protocol == "FTPS"
                                    ? "990"
                                    : (root.connect-protocol == "WebDAV" ? "443" : "22"));
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Username:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-username;
                            placeholder-text: (root.connect-protocol == "FTP" || root.connect-protocol == "FTPS")
                                ? "anonymous or ftpuser"
                                : (root.connect-protocol == "WebDAV" ? "dav-user" : "root or ubuntu");
                        }
                    }
                    if root.connect-protocol != "SFTP" || root.connect-auth-method == "password" : HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Password:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            input-type: InputType.password;
                            text <=> root.connect-password;
                            placeholder-text: root.connect-protocol == "WebDAV"
                                ? "App password or token"
                                : "••••••••";
                        }
                        if root.connect-protocol == "SFTP" : ToolbarButton {
                            icon-kind: "key";
                            tooltip: "Switch to SSH Private Key";
                            tooltip-align-right: true;
                            tooltip-above: true;
                            active: false;
                            clicked => { root.connect-auth-method = "private_key"; }
                        }
                    }
                    if root.connect-protocol == "SFTP" && root.connect-auth-method == "private_key" : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 105px; text: "Private Key:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                            CleanLineEdit {
                                horizontal-stretch: 1;
                                text <=> root.connect-key-path;
                                placeholder-text: "~/.ssh/id_ed25519";
                            }
                            ToolbarButton {
                                icon-kind: "key";
                                tooltip: "Switch to SSH Password";
                                tooltip-align-right: true;
                                tooltip-above: true;
                                active: true;
                                clicked => { root.connect-auth-method = "password"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 105px; text: "Passphrase:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                            CleanLineEdit {
                                horizontal-stretch: 1;
                                input-type: InputType.password;
                                text <=> root.connect-passphrase;
                                placeholder-text: "Optional key passphrase";
                            }
                        }
                    }
                }

                // 2. S3 / S3-Compatible Object Storage Primary Fields
                if root.connect-protocol == "S3" : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Endpoint URL:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-s3-endpoint;
                            placeholder-text: "https://s3.amazonaws.com or https://minio.example.com";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Bucket:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-s3-bucket;
                            placeholder-text: "my-production-bucket";
                        }
                        Text { text: "Region:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 96px;
                            text <=> root.connect-s3-region;
                            placeholder-text: "us-east-1";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Access Key:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-s3-access-key;
                            placeholder-text: "AKIAIOSFODNN7EXAMPLE";
                        }
                        Text { text: "Secret:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 118px;
                            input-type: InputType.password;
                            text <=> root.connect-s3-secret-key;
                            placeholder-text: "••••••••";
                        }
                    }
                }

                // 3. SMB / CIFS Network Share Primary Fields
                if root.connect-protocol == "SMB" : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Server:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-server;
                            placeholder-text: "nas.local or 192.168.1.50";
                        }
                        Text { text: "Share:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 116px;
                            text <=> root.connect-smb-share;
                            placeholder-text: "SharedDocs";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Username:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-username;
                            placeholder-text: "smbuser";
                        }
                        Text { text: "Domain:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; }
                        CleanLineEdit {
                            width: 96px;
                            text <=> root.connect-smb-domain;
                            placeholder-text: "WORKGROUP";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Password:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            input-type: InputType.password;
                            text <=> root.connect-password;
                            placeholder-text: "••••••••";
                        }
                    }
                }

                // Remote Path / Prefix / DAV Endpoint (Protocol-Aware Label & Placeholder)
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 105px;
                        text: root.connect-protocol == "S3"
                            ? "Key Prefix:"
                            : (root.connect-protocol == "WebDAV"
                                ? "DAV Path:"
                                : (root.connect-protocol == "SMB" ? "Subfolder:" : "Remote Path:"));
                        color: #A0A0AB;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    CleanLineEdit {
                        horizontal-stretch: 1;
                        text <=> root.connect-remote-path;
                        placeholder-text: root.connect-protocol == "S3"
                            ? "Optional prefix (e.g. backups/2026/)"
                            : (root.connect-protocol == "WebDAV"
                                ? "/remote.php/dav/files/user/"
                                : (root.connect-protocol == "FTP"
                                    ? "/public_html"
                                    : (root.connect-protocol == "SMB" ? "/ (optional path in share)" : "/home/user or /var/www")));
                    }
                }

                // Protocol-Specific Advanced Options
                if root.connect-show-advanced : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Local Path:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-local-path;
                            placeholder-text: "Optional default local directory (e.g. ~/Downloads)";
                        }
                    }
                    if root.connect-protocol == "S3" || root.connect-protocol == "WebDAV" || root.connect-protocol == "FTP" || root.connect-protocol == "FTPS" : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 105px;
                            text: root.connect-protocol == "S3" ? "CDN / URL:" : "Base URL:";
                            color: #A0A0AB;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-base-url;
                            placeholder-text: root.connect-protocol == "S3"
                                ? "https://cdn.example.com (optional public URL)"
                                : (root.connect-protocol == "WebDAV"
                                    ? "https://cloud.example.com/remote.php/dav"
                                    : "https://www.example.com (optional HTTP root)");
                        }
                        if root.connect-protocol == "FTP" || root.connect-protocol == "FTPS" : Text {
                            text: "Encoding:";
                            color: #A0A0AB;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if root.connect-protocol == "FTP" || root.connect-protocol == "FTPS" : CleanLineEdit {
                            width: 128px;
                            text <=> root.connect-encoding;
                            placeholder-text: "UTF-8 / ISO-8859-1";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 105px; text: "Note:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        CleanLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.connect-note;
                            placeholder-text: root.connect-protocol == "S3"
                                ? "Bucket policy, IAM role, or environment notes"
                                : "Server notes, jump host, or environment info";
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { width: 105px; text: "Color Label:"; color: #A0A0AB; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 4px;
                        ColorSwatchDot {
                            is-none: true;
                            selected: root.connect-color-index == 0;
                            clicked => { root.select-connect-color(0); }
                        }
                        ColorSwatchDot {
                            swatch-color: #8E8E93;
                            selected: root.connect-color-index == 1;
                            clicked => { root.select-connect-color(1); }
                        }
                        ColorSwatchDot {
                            swatch-color: #5AC85A;
                            selected: root.connect-color-index == 2;
                            clicked => { root.select-connect-color(2); }
                        }
                        ColorSwatchDot {
                            swatch-color: #AF52DE;
                            selected: root.connect-color-index == 3;
                            clicked => { root.select-connect-color(3); }
                        }
                        ColorSwatchDot {
                            swatch-color: #0A84FF;
                            selected: root.connect-color-index == 4;
                            clicked => { root.select-connect-color(4); }
                        }
                        ColorSwatchDot {
                            swatch-color: #FFD60A;
                            selected: root.connect-color-index == 5;
                            clicked => { root.select-connect-color(5); }
                        }
                        ColorSwatchDot {
                            swatch-color: #FF453A;
                            selected: root.connect-color-index == 6;
                            clicked => { root.select-connect-color(6); }
                        }
                        ColorSwatchDot {
                            swatch-color: #FF9F0A;
                            selected: root.connect-color-index == 7;
                            clicked => { root.select-connect-color(7); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PermCheckbox {
                        y: 3px;
                        checked: root.connect-save-credentials;
                        toggled => { root.connect-save-credentials = !root.connect-save-credentials; }
                    }
                    Text {
                        text: "Save in Keyring";
                        color: #A0A0AB;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                // 5. Max Transfer Bandwidth Throttle (Fixed-Position 5-Stop Slider)
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        width: 105px;
                        text: "Bandwidth:";
                        color: #A0A0AB;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    bw-slider := Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        background: transparent;

                        property <int> bw-step: root.pref-max-bandwidth-mbps == 5
                            ? 1
                            : (root.pref-max-bandwidth-mbps == 20
                                ? 2
                                : (root.pref-max-bandwidth-mbps == 50
                                    ? 3
                                    : (root.pref-max-bandwidth-mbps == 100 ? 4 : 0)));
                        property <length> track-x: 14px;
                        property <length> track-w: Math.max(1px, self.width - 28px);

                        function snap-mbps(mx: length) -> int {
                            let ratio = Math.clamp((mx - self.track-x) / self.track-w, 0.0, 1.0);
                            let idx = Math.round(ratio * 4.0);
                            return idx <= 0 ? 0 : (idx == 1 ? 5 : (idx == 2 ? 20 : (idx == 3 ? 50 : 100)));
                        }

                        // Slider Track Background
                        Rectangle {
                            x: bw-slider.track-x;
                            y: 9px;
                            width: bw-slider.track-w;
                            height: 6px;
                            border-radius: 3px;
                            background: #24242C;
                            border-width: 1px;
                            border-color: #34343E;
                        }

                        // Slider Active Fill
                        Rectangle {
                            x: bw-slider.track-x;
                            y: 9px;
                            width: bw-slider.track-w * (bw-slider.bw-step / 4.0);
                            height: 6px;
                            border-radius: 3px;
                            background: root.theme-accent;
                        }

                        // 5 Fixed Stop Tick Marks & Labels
                        for stop in [
                            { idx: 0, lbl: "∞" },
                            { idx: 1, lbl: "5M" },
                            { idx: 2, lbl: "20M" },
                            { idx: 3, lbl: "50M" },
                            { idx: 4, lbl: "100M" }
                        ] : Rectangle {
                            x: bw-slider.track-x + bw-slider.track-w * (stop.idx / 4.0) - 18px;
                            y: 0px;
                            width: 36px;
                            height: 34px;
                            background: transparent;

                            Rectangle {
                                x: 14px;
                                y: 8px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: stop.idx <= bw-slider.bw-step ? root.theme-accent : #3C3C48;
                            }

                            Text {
                                x: 0px;
                                y: 19px;
                                width: 36px;
                                text: stop.lbl;
                                color: stop.idx == bw-slider.bw-step ? #FFFFFF : #888892;
                                font-size: 9.5px;
                                font-weight: stop.idx == bw-slider.bw-step ? 700 : 500;
                                horizontal-alignment: center;
                            }
                        }

                        // Active Slider Thumb Knob
                        Rectangle {
                            x: bw-slider.track-x + bw-slider.track-w * (bw-slider.bw-step / 4.0) - 7px;
                            y: 5px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: #FFFFFF;
                            border-width: 2.5px;
                            border-color: root.theme-accent;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.select-max-bandwidth-mbps(bw-slider.snap-mbps(self.mouse-x));
                            }
                            moved => {
                                if self.pressed {
                                    root.select-max-bandwidth-mbps(bw-slider.snap-mbps(self.mouse-x));
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 82px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: #18181D;
                        border-width: 1px;
                        border-color: root.pref-max-bandwidth-mbps == 0 ? #32323A : root.theme-accent;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.pref-max-bandwidth-mbps == 0
                                ? "Unlimited"
                                : root.pref-max-bandwidth-mbps + " MB/s";
                            color: #FFFFFF;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: #2A2A30; }

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        ToolbarButton {
                            label: "Add to Favorites";
                            icon-kind: "star";
                            clicked => { root.add-connection-to-favorites(); }
                        }
                        ToolbarButton {
                            label: root.connect-show-advanced ? "Hide Advanced" : "Show Advanced";
                            active: root.connect-show-advanced;
                            clicked => { root.connect-show-advanced = !root.connect-show-advanced; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.close-connect-dialog(); }
                        }
                        ToolbarButton {
                            label: root.connect-editing-id != "" ? "Save & Connect" : "Connect";
                            active: true;
                            clicked => { root.confirm-connect-dialog(); }
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): CONFLICT RESOLUTION MODAL (Theme-Aware & Font-Size Responsive)
    if root.show-conflict-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {}

        Rectangle {
            width: Math.clamp(380px + root.font-size-delta * 18, 354px, root.width - 40px);
            height: conflict-modal-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000099;

            conflict-modal-layout := VerticalLayout {
                padding-top: 20px;
                padding-bottom: 18px;
                padding-left: 22px;
                padding-right: 22px;
                spacing: 10px;
                alignment: space-between;

                // Top Document Page Illustration (white page with folded corner & content lines)
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 46px;
                        height: 56px;
                        border-radius: 6px;
                        background: #EDEDF2;
                        border-width: 1px;
                        border-color: #C8C8D0;

                        // Folded top-right corner flap
                        Path {
                            x: 32px;
                            y: 0px;
                            width: 14px;
                            height: 14px;
                            fill: #C4C4CC;
                            commands: "M 0 0 L 14 14 L 0 14 Z";
                        }

                        // Miniature document content preview bars
                        Rectangle {
                            x: 8px;
                            y: 18px;
                            width: 10px;
                            height: 8px;
                            border-radius: 1.5px;
                            background: #B4B4BE;
                        }
                        Rectangle {
                            x: 21px;
                            y: 19px;
                            width: 16px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #B4B4BE;
                        }
                        Rectangle {
                            x: 21px;
                            y: 24px;
                            width: 13px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #B4B4BE;
                        }
                        Rectangle {
                            x: 8px;
                            y: 31px;
                            width: 29px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #C2C2CC;
                        }
                        Rectangle {
                            x: 8px;
                            y: 37px;
                            width: 24px;
                            height: 2.5px;
                            border-radius: 1px;
                            background: #C2C2CC;
                        }
                    }
                }

                // Headline & Subheadline
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        width: 100%;
                        text: root.conflict-headline;
                        color: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        font-size: 13.5px + root.font-size-delta;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        width: 100%;
                        text: root.conflict-subheadline;
                        color: root.theme-text-secondary;
                        font-family: root.resolved-font-family;
                        font-size: 11.5px + root.font-size-delta * 0.5;
                        font-weight: 500;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // Side-by-Side Comparison: [New] vs [Existing]
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 46px;
                                height: 20px;
                                border-radius: 5px;
                                background: root.theme-accent;
                                Text {
                                    text: "New";
                                    color: #FFFFFF;
                                    font-family: root.resolved-font-family;
                                    font-size: 11px + root.font-size-delta * 0.5;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.conflict-new-date;
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 11px + root.font-size-delta * 0.5;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.conflict-new-size;
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 11px + root.font-size-delta * 0.5;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 64px;
                                height: 20px;
                                border-radius: 5px;
                                background: #525258;
                                Text {
                                    text: "Existing";
                                    color: #FFFFFF;
                                    font-family: root.resolved-font-family;
                                    font-size: 11px + root.font-size-delta * 0.5;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.conflict-existing-date;
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 11px + root.font-size-delta * 0.5;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.conflict-existing-size;
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 11px + root.font-size-delta * 0.5;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // Vertical Action Stack (Replace pill, Replace Older, Keep Both, Skip, Stop pill)
                VerticalLayout {
                    spacing: 2px;

                    // Primary Blue Pill: Replace
                    Rectangle {
                        height: 30px + Math.max(0px, root.font-size-delta * 1.5);
                        border-radius: 15px;
                        background: cf-replace-touch.has-hover ? #1E90FF : root.theme-accent;
                        Text {
                            text: "Replace";
                            color: #FFFFFF;
                            font-family: root.resolved-font-family;
                            font-size: 12.5px + root.font-size-delta * 0.5;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-replace-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("replace"); }
                        }
                    }

                    // Action Row: Replace Older
                    Rectangle {
                        height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                        border-radius: 6px;
                        background: cf-older-touch.has-hover ? root.theme-row-hover : transparent;
                        Text {
                            text: "Replace Older";
                            color: cf-older-touch.has-hover ? #FFFFFF : root.theme-text-secondary;
                            font-family: root.resolved-font-family;
                            font-size: 12px + root.font-size-delta * 0.5;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-older-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("replace_older"); }
                        }
                    }

                    Rectangle { height: 1px; background: root.theme-border; }

                    // Action Row: Keep Both
                    Rectangle {
                        height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                        border-radius: 6px;
                        background: cf-keep-touch.has-hover ? root.theme-row-hover : transparent;
                        Text {
                            text: "Keep Both";
                            color: cf-keep-touch.has-hover ? #FFFFFF : root.theme-text-secondary;
                            font-family: root.resolved-font-family;
                            font-size: 12px + root.font-size-delta * 0.5;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-keep-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("keep_both"); }
                        }
                    }

                    Rectangle { height: 1px; background: root.theme-border; }

                    // Action Row: Skip
                    Rectangle {
                        height: 28px + Math.max(0px, root.font-size-delta * 1.5);
                        border-radius: 6px;
                        background: cf-skip-touch.has-hover ? root.theme-row-hover : transparent;
                        Text {
                            text: "Skip";
                            color: cf-skip-touch.has-hover ? #FFFFFF : root.theme-text-secondary;
                            font-family: root.resolved-font-family;
                            font-size: 12px + root.font-size-delta * 0.5;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-skip-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("skip"); }
                        }
                    }

                    // Secondary Grey Pill: Stop
                    Rectangle {
                        height: 30px + Math.max(0px, root.font-size-delta * 1.5);
                        border-radius: 15px;
                        background: cf-stop-touch.has-hover ? #56565E : #46464C;
                        Text {
                            text: "Stop";
                            color: #FFFFFF;
                            font-family: root.resolved-font-family;
                            font-size: 12.5px + root.font-size-delta * 0.5;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cf-stop-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.resolve-conflict("stop"); }
                        }
                    }
                }

                // Bottom "Apply to all" Checkbox Row
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    PermCheckbox {
                        y: (parent.height - self.height) / 2;
                        checked: root.conflict-apply-all;
                        toggled => { root.conflict-apply-all = !root.conflict-apply-all; }
                    }
                    Rectangle {
                        width: cf-apply-lbl.preferred-width;
                        height: 22px;
                        background: transparent;
                        cf-apply-lbl := Text {
                            text: "Apply to all";
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 12px + root.font-size-delta * 0.5;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.conflict-apply-all = !root.conflict-apply-all; }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.5 (z: 1500): TASKS & TRANSFERS POPOVER (Pause/Resume/Cancel + Live Bandwidth Control)
    if root.show-tasks-popover : Rectangle {
        z: 1500;
        width: 100%;
        height: 100%;
        background: #00000033;

        TouchArea {
            clicked => { root.show-tasks-popover = false; }
        }

        Rectangle {
            x: Math.max(12px, root.width - 362px) - 2px;
            y: 42px;
            width: 354px;
            height: Math.min(390px, Math.max(154px, root.transfer-rows.length * 76px + 96px)) + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: Math.max(12px, root.width - 362px);
            y: 38px;
            width: 350px;
            height: Math.min(390px, Math.max(154px, root.transfer-rows.length * 76px + 96px));
            border-radius: 8px;
            opacity: 1.0;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000073;

            TouchArea {}

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 14px;
                            kind: root.task-running
                                ? ("refresh-" + root.spinner-frame)
                                : "refresh";
                            icon-color: root.theme-text-primary;
                        }
                        Text {
                            text: "Tasks & Operations";
                            color: root.theme-text-primary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 5px;
                        if root.dual-pane-mode : ToolbarButton {
                            label: "Sync…";
                            clicked => {
                                root.show-tasks-popover = false;
                                root.open-sync-modal();
                            }
                        }
                        ToolbarButton {
                            label: "Refresh";
                            clicked => { root.sync-panes(); }
                        }
                        if root.transfer-rows.length > 0 : ToolbarButton {
                            label: "Clear";
                            clicked => { root.clear-completed-tasks(); }
                        }
                    }
                }

                // Live Bandwidth Limiter Strip
                HorizontalLayout {
                    spacing: 4px;
                    alignment: space-between;
                    Text {
                        text: "Speed Limit:";
                        color: root.theme-text-secondary;
                        font-size: 10.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        SegmentControlButton {
                            label: "∞";
                            btn-width: 34px;
                            active: root.pref-max-bandwidth-mbps == 0;
                            accent-bg: root.theme-accent;
                            clicked => { root.select-max-bandwidth-mbps(0); }
                        }
                        for mbps in [5, 20, 50, 100] : SegmentControlButton {
                            label: mbps + "M";
                            btn-width: 44px;
                            active: root.pref-max-bandwidth-mbps == mbps;
                            accent-bg: root.theme-accent;
                            clicked => { root.select-max-bandwidth-mbps(mbps); }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                if root.transfer-rows.length == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "No active background tasks.";
                        color: root.theme-text-secondary;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }

                if root.transfer-rows.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    viewport-height: root.transfer-rows.length * 76px + 8px;
                    VerticalLayout {
                        spacing: 6px;
                        for tr in root.transfer-rows : TransferTaskCard {
                            tr: tr;
                            spinner-frame: root.spinner-frame;
                            bg-surface: root.theme-bg-surface;
                            bg-canvas: root.theme-bg-canvas;
                            accent-bg: root.theme-accent;
                            border-brush: root.theme-border;
                            text-secondary: root.theme-text-secondary;
                            toggle-pause(id) => { root.toggle-pause-transfer(id); }
                            cancel-task(id) => { root.cancel-transfer(id); }
                        }
                    }
                }
            }
        }
    }

    // LAYER 4 (z: 2000): DELETE CONFIRMATION MODAL (Theme-Aware, Font-Size Responsive & Word-Wrapped)
    if root.show-delete-modal : Rectangle {
        z: 2000;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {
            clicked => {
                root.show-delete-modal = false;
                root.focus-key-router();
            }
        }

        // Outer ambient drop shadow
        Rectangle {
            width: del-card.width + 6px;
            height: del-card.height + 6px;
            x: del-card.x - 3px;
            y: del-card.y + 4px;
            border-radius: 15px;
            background: #00000073;
        }

        del-card := Rectangle {
            width: Math.clamp(450px + root.font-size-delta * 22, 410px, root.width - 40px);
            height: del-modal-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000099;

            TouchArea {}

            del-modal-layout := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    // Destructive Warning Icon Badge
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: 0px;
                        border-radius: 10px;
                        background: #FF453A1F;
                        border-width: 1px;
                        border-color: #FF453A4D;
                        LucideIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-size: 18px;
                            kind: "trash";
                            icon-color: #FF453A;
                        }
                    }

                    // Wrapped Title & Description Column (never overflows card bounds)
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text {
                            width: 100%;
                            text: root.delete-modal-title;
                            color: root.theme-text-primary;
                            font-family: root.resolved-font-family;
                            font-size: 14px + root.font-size-delta;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            width: 100%;
                            text: root.delete-modal-message;
                            color: root.theme-text-secondary;
                            font-family: root.resolved-font-family;
                            font-size: 12.5px + root.font-size-delta;
                            font-weight: root.ui-font-bold ? 700 : 500;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    // Secondary Cancel Button
                    Rectangle {
                        height: 30px + Math.max(0px, root.font-size-delta * 1.5);
                        width: del-cancel-layout.preferred-width;
                        border-radius: 6px;
                        background: del-cancel-touch.has-hover ? root.theme-row-hover : root.theme-bg-sidebar;
                        border-width: 1px;
                        border-color: root.theme-border;
                        del-cancel-layout := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: "Cancel";
                                color: root.theme-text-primary;
                                font-family: root.resolved-font-family;
                                font-size: 12.5px + root.font-size-delta * 0.5;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        del-cancel-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-modal = false;
                                root.focus-key-router();
                            }
                        }
                    }

                    // Primary Destructive Action Button
                    Rectangle {
                        height: 30px + Math.max(0px, root.font-size-delta * 1.5);
                        width: del-confirm-layout.preferred-width;
                        border-radius: 6px;
                        background: del-confirm-touch.has-hover ? #E64840 : #D93830;
                        border-width: 1px;
                        border-color: #FF5E54;
                        del-confirm-layout := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            alignment: center;
                            LucideIcon {
                                y: (parent.height - self.height) / 2;
                                icon-size: 14px;
                                kind: "trash";
                                icon-color: #FFFFFF;
                            }
                            Text {
                                text: root.delete-modal-permanent ? "Delete Permanently" : "Move to Trash";
                                color: #FFFFFF;
                                font-family: root.resolved-font-family;
                                font-size: 12.5px + root.font-size-delta * 0.5;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        del-confirm-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-delete-modal = false;
                                root.focus-key-router();
                                root.confirm-delete-modal();
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.7 (z: 1700): MANIFOLD MAIN MENU DROPDOWN (Top-Left Application Menu)
    if root.show-app-menu : Rectangle {
        z: 1700;
        width: 100%;
        height: 100%;
        background: #00000033;

        TouchArea {
            clicked => { root.show-app-menu = false; }
        }

        Rectangle {
            x: 10px;
            y: 44px;
            width: 256px;
            height: app-menu-col.preferred-height + 4px;
            border-radius: 10px;
            background: #00000073;
        }

        Rectangle {
            x: 12px;
            y: 40px;
            width: 252px;
            height: app-menu-col.preferred-height;
            border-radius: 8px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000088;

            TouchArea {}

            app-menu-col := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                ContextMenuItem {
                    icon-kind: "info";
                    label: "About Manifold";
                    shortcut-hint: root.app-version-label;
                    triggered => {
                        root.show-app-menu = false;
                        root.show-about-modal = true;
                    }
                }
                ContextMenuItem {
                    icon-kind: "star";
                    label: "Preferences & Themes…";
                    shortcut-hint: "Ctrl+,";
                    triggered => {
                        root.show-app-menu = false;
                        root.show-preferences-modal = true;
                    }
                }
                ContextMenuItem {
                    icon-kind: "sliders";
                    label: root.show-view-options-popover ? "Hide View Options" : "Show View Options";
                    shortcut-hint: "Ctrl+J";
                    triggered => {
                        root.show-app-menu = false;
                        root.execute-context-action("show_view_options");
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                ContextMenuItem {
                    icon-kind: "plus";
                    label: "New Folder";
                    shortcut-hint: "Ctrl+N";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-new-folder-modal();
                    }
                }
                ContextMenuItem {
                    icon-kind: "file";
                    label: "New File";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-new-file-modal();
                    }
                }
                ContextMenuItem {
                    icon-kind: root.current-folder-is-favorite ? "eject" : "star";
                    label: root.current-folder-is-favorite
                        ? "Remove Current Folder from Favorites"
                        : "Add Current Folder to Favorites";
                    triggered => {
                        root.show-app-menu = false;
                        root.add-current-folder-to-favorites();
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                ContextMenuItem {
                    icon-kind: "terminal";
                    label: root.show-terminal-drawer ? "Hide Bottom Terminal" : "Open Bottom Terminal";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-terminal();
                    }
                }
                ContextMenuItem {
                    icon-kind: "columns";
                    label: root.dual-pane-mode ? "Switch to Single Pane" : "Switch to Dual Pane";
                    shortcut-hint: "F6";
                    triggered => {
                        root.show-app-menu = false;
                        root.toggle-dual-pane();
                    }
                }
                ContextMenuItem {
                    icon-kind: "info";
                    label: root.show-inspector ? "Hide Inspector Drawer" : "Show Inspector Drawer";
                    shortcut-hint: "Ctrl+I";
                    triggered => {
                        root.show-app-menu = false;
                        root.toggle-inspector();
                    }
                }

                Rectangle { height: 1px; background: #323238; }

                ContextMenuItem {
                    icon-kind: "refresh";
                    label: "Directory Sync & Diff…";
                    shortcut-hint: "Ctrl+Shift+Y";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-sync-modal();
                    }
                }
                ContextMenuItem {
                    icon-kind: "globe";
                    label: "New Remote Connection…";
                    triggered => {
                        root.show-app-menu = false;
                        root.open-connect-dialog();
                    }
                }
            }
        }
    }

    // LAYER 3.75 (z: 1700): FLOATING FILE & DIRECTORY VIEW OPTIONS POPOVER (Show View Options, Ctrl/Cmd+J)
    if root.show-view-options-popover : Rectangle {
        z: 1700;
        width: 100%;
        height: 100%;
        background: transparent;

        property <length> vo-card-x: (root.dual-pane-mode && !root.right-pane-active)
            ? Math.clamp(root.sidebar-width + root.left-pane-width - 252px, 16px, Math.max(16px, root.width - 260px))
            : Math.clamp(root.width - (root.show-inspector ? (root.inspector-width + 8px) : 0px) - 258px, 16px, Math.max(16px, root.width - 260px));
        property <length> vo-card-y: Math.clamp(124px, 46px, Math.max(46px, root.height - vo-card.height - 12px));

        TouchArea {
            clicked => {
                root.view-options-scope-menu-open = false;
                root.view-options-sort-menu-open = false;
                root.view-options-icon-menu-open = false;
                root.view-options-font-menu-open = false;
                root.view-options-text-menu-open = false;
                root.show-view-options-popover = false;
                root.focus-key-router();
            }
        }

        // Top Pointer Notch (matching media_1794056042968_bf466895.jpg & media_1794056116244_eb10f6d2.png)
        Path {
            x: parent.vo-card-x + 114px;
            y: parent.vo-card-y - 9px;
            width: 20px;
            height: 10px;
            viewbox-width: 20;
            viewbox-height: 10;
            fill: root.theme-bg-popover;
            stroke: root.theme-border;
            stroke-width: 1px;
            commands: "M 0 10 L 10 1 L 20 10 Z";
        }

        // Software-renderer ambient drop shadow
        Rectangle {
            x: parent.vo-card-x - 3px;
            y: parent.vo-card-y + 5px;
            width: 254px;
            height: vo-card.height + 4px;
            border-radius: 14px;
            background: #00000088;
        }

        vo-card := Rectangle {
            x: parent.vo-card-x;
            y: parent.vo-card-y;
            width: 248px;
            height: vo-main-col.preferred-height;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000099;

            TouchArea {
                clicked => {
                    root.view-options-scope-menu-open = false;
                    root.view-options-sort-menu-open = false;
                    root.view-options-icon-menu-open = false;
                    root.view-options-font-menu-open = false;
                    root.view-options-text-menu-open = false;
                }
            }

            vo-main-col := VerticalLayout {
                padding: 12px;
                spacing: 6px;

                // 1. Scope Selector Pill Button (All Folders / This Folder / This Folder and Subfolders)
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        width: Math.min(220px, scope-btn-layout.preferred-width + 4px);
                        border-radius: 6px;
                        background: scope-btn-touch.has-hover ? root.theme-row-hover : root.theme-bg-surface;
                        border-width: 1px;
                        border-color: root.view-options-scope-menu-open ? root.theme-accent : root.theme-border;
                        scope-btn-layout := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: root.vo-scope == "this_folder"
                                    ? "This Folder"
                                    : (root.vo-scope == "this_folder_and_subfolders"
                                        ? "This Folder and Subfolders"
                                        : "All Folders");
                                color: root.theme-text-primary;
                                font-size: 12px;
                                font-family: root.resolved-font-family;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            LucideIcon {
                                y: (parent.height - self.height) / 2;
                                icon-size: 11px;
                                kind: "arrow-up-down";
                                icon-color: root.theme-text-secondary;
                            }
                        }
                        scope-btn-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-sort-menu-open = false;
                                root.view-options-icon-menu-open = false;
                                root.view-options-font-menu-open = false;
                                root.view-options-text-menu-open = false;
                                root.view-options-scope-menu-open = !root.view-options-scope-menu-open;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 2. Sort by Row
                HorizontalLayout {
                    height: 24px;
                    alignment: space-between;
                    Text {
                        text: "Sort by:";
                        color: root.theme-text-primary;
                        font-size: 12px;
                        font-family: root.resolved-font-family;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 22px;
                        width: 114px;
                        border-radius: 5px;
                        background: sort-btn-touch.has-hover ? root.theme-row-hover : root.theme-bg-surface;
                        border-width: 1px;
                        border-color: root.view-options-sort-menu-open ? root.theme-accent : root.theme-border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: space-between;
                            Text {
                                text: root.vo-sort-by == "modified"
                                    ? "Modified"
                                    : (root.vo-sort-by == "created"
                                        ? "Created"
                                        : (root.vo-sort-by == "added"
                                            ? "Added"
                                            : (root.vo-sort-by == "size"
                                                ? "Size"
                                                : (root.vo-sort-by == "kind"
                                                    ? "Kind"
                                                    : (root.vo-sort-by == "permissions" ? "Permissions" : "Name")))));
                                color: root.theme-text-primary;
                                font-size: 11.5px;
                                font-family: root.resolved-font-family;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            LucideIcon {
                                y: (parent.height - self.height) / 2;
                                icon-size: 10px;
                                kind: "arrow-up-down";
                                icon-color: root.theme-text-secondary;
                            }
                        }
                        sort-btn-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-scope-menu-open = false;
                                root.view-options-icon-menu-open = false;
                                root.view-options-font-menu-open = false;
                                root.view-options-text-menu-open = false;
                                root.view-options-sort-menu-open = !root.view-options-sort-menu-open;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 3. Icon size, Font & Text size (Synced with Themes & Typography Manager)
                HorizontalLayout {
                    height: 24px;
                    alignment: space-between;
                    Text {
                        text: "Icon size:";
                        color: root.theme-text-primary;
                        font-size: 12px;
                        font-family: root.resolved-font-family;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 22px;
                        width: 62px;
                        border-radius: 5px;
                        background: icon-btn-touch.has-hover ? root.theme-row-hover : root.theme-bg-surface;
                        border-width: 1px;
                        border-color: root.view-options-icon-menu-open ? root.theme-accent : root.theme-border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: space-between;
                            Text {
                                text: root.vo-icon-size + "";
                                color: root.theme-text-primary;
                                font-size: 11.5px;
                                font-family: "monospace";
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            LucideIcon {
                                y: (parent.height - self.height) / 2;
                                icon-size: 10px;
                                kind: "arrow-up-down";
                                icon-color: root.theme-text-secondary;
                            }
                        }
                        icon-btn-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-scope-menu-open = false;
                                root.view-options-sort-menu-open = false;
                                root.view-options-font-menu-open = false;
                                root.view-options-text-menu-open = false;
                                root.view-options-icon-menu-open = !root.view-options-icon-menu-open;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 24px;
                    alignment: space-between;
                    Text {
                        text: "Font:";
                        color: root.theme-text-primary;
                        font-size: 12px;
                        font-family: root.resolved-font-family;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 22px;
                        width: 158px;
                        border-radius: 5px;
                        background: font-btn-touch.has-hover ? root.theme-row-hover : root.theme-bg-surface;
                        border-width: 1px;
                        border-color: root.view-options-font-menu-open ? root.theme-accent : root.theme-border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: space-between;
                            Text {
                                text: root.ui-font-family == "Inter"
                                    ? "Inter / UI"
                                    : (root.ui-font-family == "monospace"
                                        ? "Monospace"
                                        : (root.ui-font-family == "serif" ? "Serif" : "System Font Regular"));
                                color: root.theme-text-primary;
                                font-size: 11px;
                                font-family: root.resolved-font-family;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: root.theme-border;
                                Text {
                                    text: "T";
                                    color: root.theme-text-primary;
                                    font-size: 9.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        font-btn-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-scope-menu-open = false;
                                root.view-options-sort-menu-open = false;
                                root.view-options-icon-menu-open = false;
                                root.view-options-text-menu-open = false;
                                root.view-options-font-menu-open = !root.view-options-font-menu-open;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 24px;
                    alignment: space-between;
                    Text {
                        text: "Text size:";
                        color: root.theme-text-primary;
                        font-size: 12px;
                        font-family: root.resolved-font-family;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 22px;
                        width: 62px;
                        border-radius: 5px;
                        background: txt-btn-touch.has-hover ? root.theme-row-hover : root.theme-bg-surface;
                        border-width: 1px;
                        border-color: root.view-options-text-menu-open ? root.theme-accent : root.theme-border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: space-between;
                            Text {
                                text: root.ui-font-size-delta <= -1
                                    ? "11"
                                    : (root.ui-font-size-delta == 0
                                        ? "12"
                                        : (root.ui-font-size-delta == 1
                                            ? "13"
                                            : (root.ui-font-size-delta == 2 ? "14" : "16")));
                                color: root.theme-text-primary;
                                font-size: 11.5px;
                                font-family: "monospace";
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            LucideIcon {
                                y: (parent.height - self.height) / 2;
                                icon-size: 10px;
                                kind: "arrow-up-down";
                                icon-color: root.theme-text-secondary;
                            }
                        }
                        txt-btn-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-scope-menu-open = false;
                                root.view-options-sort-menu-open = false;
                                root.view-options-icon-menu-open = false;
                                root.view-options-font-menu-open = false;
                                root.view-options-text-menu-open = !root.view-options-text-menu-open;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 4. Show Columns Section
                Text {
                    text: "Show Columns:";
                    color: root.theme-text-primary;
                    font-size: 12px;
                    font-family: root.resolved-font-family;
                    font-weight: 600;
                }

                VerticalLayout {
                    spacing: 3px;
                    ViewOptionCheckboxRow {
                        label: "Size";
                        checked: root.vo-col-size;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_size"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Kind";
                        checked: root.vo-col-kind;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_kind"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Date modified";
                        checked: root.vo-col-modified;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_modified"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Date added";
                        checked: root.vo-col-added;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_added"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Date created";
                        checked: root.vo-col-created;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_created"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Owner";
                        checked: root.vo-col-owner;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_owner"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Group";
                        checked: root.vo-col-group;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_group"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Permissions";
                        checked: root.vo-col-permissions;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_permissions"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Tags";
                        checked: root.vo-col-tags;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("col_tags"); }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 5. Folder & View Behavior Options
                VerticalLayout {
                    spacing: 3px;
                    ViewOptionCheckboxRow {
                        label: "Bold Folders";
                        checked: root.vo-bold-folders;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("bold_folders"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Show Hidden files";
                        checked: root.vo-show-hidden;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("show_hidden"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Show icon preview";
                        checked: root.vo-show-icon-preview;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("show_icon_preview"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Treat packages as folders";
                        checked: root.vo-treat-packages-as-folders;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("treat_packages_as_folders"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Show folders on top";
                        checked: root.vo-show-folders-on-top;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("show_folders_on_top"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Always sort alphabetically";
                        indent: 14px;
                        small-text: true;
                        enabled-state: root.vo-show-folders-on-top;
                        checked: root.vo-folders-always-alpha;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-secondary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("folders_always_alpha"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Use relative dates";
                        checked: root.vo-use-relative-dates;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("use_relative_dates"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Calculate all sizes";
                        checked: root.vo-calculate-all-sizes;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("calculate_all_sizes"); }
                    }
                    ViewOptionCheckboxRow {
                        label: "Use alternating background";
                        checked: root.vo-use-alternating-bg;
                        accent-bg: root.theme-accent;
                        surface-bg: root.theme-bg-surface;
                        border-brush: root.theme-border;
                        text-brush: root.theme-text-primary;
                        font-family: root.resolved-font-family;
                        toggled => { root.toggle-view-options-option("use_alternating_bg"); }
                    }
                }

                Rectangle { height: 2px; background: transparent; }

                // 6. Bottom "Use as Defaults" Button
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        width: 124px;
                        border-radius: 5px;
                        background: defaults-btn-touch.has-hover ? root.theme-row-hover : root.theme-bg-surface;
                        border-width: 1px;
                        border-color: root.theme-border;
                        Text {
                            text: "Use as Defaults";
                            color: root.theme-text-primary;
                            font-size: 11.5px;
                            font-family: root.resolved-font-family;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        defaults-btn-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.use-view-options-as-defaults();
                            }
                        }
                    }
                }
            }

            // Floating Scope Selector Menu Overlay (media_1794056116244_eb10f6d2.png)
            if root.view-options-scope-menu-open : Rectangle {
                z: 50;
                x: 24px;
                y: 36px;
                width: 214px;
                height: 86px;
                border-radius: 8px;
                background: root.theme-bg-popover;
                border-width: 1px;
                border-color: root.theme-border;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000AA;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for sc in [
                        { id: "all_folders", label: "All Folders" },
                        { id: "this_folder", label: "This Folder" },
                        { id: "this_folder_and_subfolders", label: "This Folder and Subfolders" }
                    ] : Rectangle {
                        height: 24px;
                        border-radius: 5px;
                        background: sc-touch.has-hover ? root.theme-accent : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                width: 12px;
                                text: root.vo-scope == sc.id ? "✓" : "";
                                color: sc-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: sc.label;
                                color: sc-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-family: root.resolved-font-family;
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        sc-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-scope-menu-open = false;
                                root.set-view-options-scope(sc.id);
                            }
                        }
                    }
                }
            }

            // Floating Sort By Menu Overlay
            if root.view-options-sort-menu-open : Rectangle {
                z: 50;
                x: 112px;
                y: 66px;
                width: 126px;
                height: 182px;
                border-radius: 8px;
                background: root.theme-bg-popover;
                border-width: 1px;
                border-color: root.theme-border;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000AA;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for srt in [
                        { id: "name", label: "Name" },
                        { id: "modified", label: "Modified" },
                        { id: "created", label: "Created" },
                        { id: "added", label: "Added" },
                        { id: "size", label: "Size" },
                        { id: "kind", label: "Kind" },
                        { id: "permissions", label: "Permissions" }
                    ] : Rectangle {
                        height: 24px;
                        border-radius: 5px;
                        background: srt-touch.has-hover ? root.theme-accent : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                width: 12px;
                                text: root.vo-sort-by == srt.id ? "✓" : "";
                                color: srt-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: srt.label;
                                color: srt-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-family: root.resolved-font-family;
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        srt-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-sort-menu-open = false;
                                root.set-view-options-sort(srt.id);
                            }
                        }
                    }
                }
            }

            // Floating Icon Size Menu Overlay
            if root.view-options-icon-menu-open : Rectangle {
                z: 50;
                x: 156px;
                y: 98px;
                width: 82px;
                height: 110px;
                border-radius: 8px;
                background: root.theme-bg-popover;
                border-width: 1px;
                border-color: root.theme-border;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000AA;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for isz in [16, 20, 24, 32] : Rectangle {
                        height: 24px;
                        border-radius: 5px;
                        background: isz-touch.has-hover ? root.theme-accent : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                width: 12px;
                                text: root.vo-icon-size == isz ? "✓" : "";
                                color: isz-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: isz + " px";
                                color: isz-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-family: "monospace";
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        isz-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-icon-menu-open = false;
                                root.set-view-options-icon-size(isz);
                            }
                        }
                    }
                }
            }

            // Floating Font Family Menu Overlay (Synced with AppPreferences)
            if root.view-options-font-menu-open : Rectangle {
                z: 50;
                x: 68px;
                y: 128px;
                width: 170px;
                height: 110px;
                border-radius: 8px;
                background: root.theme-bg-popover;
                border-width: 1px;
                border-color: root.theme-border;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000AA;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for fnt in [
                        { id: "sans-serif", label: "System Font Regular" },
                        { id: "Inter", label: "Inter / UI" },
                        { id: "monospace", label: "Monospace" },
                        { id: "serif", label: "Serif" }
                    ] : Rectangle {
                        height: 24px;
                        border-radius: 5px;
                        background: fnt-touch.has-hover ? root.theme-accent : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                width: 12px;
                                text: (root.ui-font-family == fnt.id || (fnt.id == "sans-serif" && root.ui-font-family == "")) ? "✓" : "";
                                color: fnt-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: fnt.label;
                                color: fnt-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-family: root.resolved-font-family;
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        fnt-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-font-menu-open = false;
                                root.select-font-family(fnt.id);
                            }
                        }
                    }
                }
            }

            // Floating Text Size Menu Overlay (Synced with AppPreferences.font_size_delta)
            if root.view-options-text-menu-open : Rectangle {
                z: 50;
                x: 152px;
                y: 158px;
                width: 86px;
                height: 134px;
                border-radius: 8px;
                background: root.theme-bg-popover;
                border-width: 1px;
                border-color: root.theme-border;
                drop-shadow-offset-y: 8px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000AA;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for tsz in [
                        { delta: -1, label: "11 pt" },
                        { delta: 0, label: "12 pt" },
                        { delta: 1, label: "13 pt" },
                        { delta: 2, label: "14 pt" },
                        { delta: 4, label: "16 pt" }
                    ] : Rectangle {
                        height: 24px;
                        border-radius: 5px;
                        background: tsz-touch.has-hover ? root.theme-accent : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                width: 12px;
                                text: root.ui-font-size-delta == tsz.delta ? "✓" : "";
                                color: tsz-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: tsz.label;
                                color: tsz-touch.has-hover ? #FFFFFF : root.theme-text-primary;
                                font-size: 12px;
                                font-family: "monospace";
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        tsz-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.view-options-text-menu-open = false;
                                root.select-font-size-delta(tsz.delta);
                            }
                        }
                    }
                }
            }
        }
    }

    // LAYER 3.8 (z: 1800): FLOATING IMAGE / FILE PREVIEW MINION (Quick Look HUD)
    if root.show-preview-minion : Rectangle {
        z: 1800;
        x: Math.clamp(root.preview-minion-x, 16px, Math.max(16px, root.width - 576px));
        y: Math.clamp(root.preview-minion-y, 44px, Math.max(44px, root.height - 460px));
        width: 560px;
        height: 430px;
        border-radius: 10px;
        background: #1C1C21;
        border-width: 1px;
        border-color: root.theme-accent;
        drop-shadow-offset-y: 14px;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000000AA;
        clip: true;

        TouchArea {}

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Draggable Preview Minion Header Bar (36px)
            Rectangle {
                height: 36px;
                background: root.theme-bg-toolbar;
                border-width: 1px;
                border-color: root.theme-border;

                minion-drag-touch := TouchArea {
                    mouse-cursor: move;
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                            root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                            root.col-resize-start-w = root.preview-minion-x;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.preview-minion-x = Math.clamp(
                                root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                16px,
                                Math.max(16px, root.width - 576px)
                            );
                            root.preview-minion-y = Math.clamp(
                                self.absolute-position.y + self.mouse-y - 18px,
                                44px,
                                Math.max(44px, root.height - 460px)
                            );
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 15px;
                            kind: root.inspector-has-image ? "image" : (root.inspector-is-dir ? "folder" : "eye");
                            icon-color: root.theme-text-secondary;
                        }
                        Text {
                            text: "Preview Minion — " + root.inspector-title;
                            color: #FFFFFF;
                            font-size: 12.5px + root.ui-font-size-delta * 1px;
                            font-family: root.ui-font-family;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.inspector-image-dimensions != "" : Rectangle {
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: #0D52BF33;
                            border-width: 1px;
                            border-color: root.theme-accent;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.inspector-image-dimensions;
                                    color: root.theme-text-primary;
                                    font-size: 10px;
                                    font-family: "monospace";
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        if root.inspector-has-image : ToolbarButton {
                            label: "−";
                            tooltip: "Zoom Out";
                            clicked => {
                                root.preview-minion-zoom = Math.max(0.5, root.preview-minion-zoom - 0.25);
                            }
                        }
                        if root.inspector-has-image : ToolbarButton {
                            label: Math.round(root.preview-minion-zoom * 100) + "%";
                            tooltip: "Reset Zoom (100%)";
                            clicked => { root.preview-minion-zoom = 1.0; }
                        }
                        if root.inspector-has-image : ToolbarButton {
                            label: "+";
                            tooltip: "Zoom In";
                            clicked => {
                                root.preview-minion-zoom = Math.min(3.0, root.preview-minion-zoom + 0.25);
                            }
                        }
                        ToolbarButton {
                            icon-kind: "close";
                            tooltip: "Close Preview Minion (Space / Esc)";
                            tooltip-align-right: true;
                            clicked => { root.show-preview-minion = false; }
                        }
                    }
                }
            }

            // Preview Minion Body (High-Res Image or Code/Text/Hex Viewport)
            Rectangle {
                vertical-stretch: 1;
                background: #101014;
                clip: true;

                if root.inspector-has-image : ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: Math.max(self.width, self.width * root.preview-minion-zoom);
                    viewport-height: Math.max(self.height, self.height * root.preview-minion-zoom);
                    Rectangle {
                        width: Math.max(parent.width, parent.width * root.preview-minion-zoom);
                        height: Math.max(parent.height, parent.height * root.preview-minion-zoom);
                        background: transparent;
                        Image {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                            image-fit: contain;
                            source: root.inspector-preview-image;
                        }
                    }
                }

                if !root.inspector-has-image && root.inspector-is-dir : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        LucideIcon {
                            icon-size: 68px;
                            kind: "folder";
                            icon-color: #38B6FF;
                            fill-color: #4CC2FF;
                        }
                    }
                    Text {
                        text: root.inspector-title;
                        color: #FFFFFF;
                        font-size: 15px + root.ui-font-size-delta * 1px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.inspector-subtitle + " •Modified: " + root.inspector-modified;
                        color: #A0A0AB;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                if !root.inspector-has-image && !root.inspector-is-dir : ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: Math.max(self.height, minion-text-preview.preferred-height + 24px);
                    VerticalLayout {
                        padding: 12px;
                        alignment: start;
                        minion-text-preview := Text {
                            text: root.inspector-preview-text;
                            color: #E1E1E6;
                            font-size: 11.5px + root.ui-font-size-delta * 1px;
                            font-family: "monospace";
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Preview Minion Footer Metadata Bar (28px)
            Rectangle {
                height: 28px;
                background: root.theme-bg-toolbar;
                border-width: 1px;
                border-color: root.theme-border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    Text {
                        text: root.inspector-subtitle + "  |  Size: " + root.inspector-size;
                        color: root.theme-text-secondary;
                        font-size: 11px;
                        font-family: "monospace";
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Modified: " + root.inspector-modified + "  |  Perm: " + root.inspector-perm-symbolic + " (" + root.inspector-perm-octal + ")";
                        color: root.theme-text-secondary;
                        font-size: 11px;
                        font-family: "monospace";
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // LAYER 4.1 (z: 2150): ABOUT MANIFOLD MODAL
    if root.show-about-modal : Rectangle {
        z: 2150;
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea {
            clicked => { root.show-about-modal = false; }
        }

        Rectangle {
            width: 300px;
            height: 214px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000099;

            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 14px;
                        background: #1C1E26;
                        border-width: 1px;
                        border-color: #3A3D4A;
                        LucideIcon {
                            x: 10px;
                            y: 10px;
                            icon-size: 44px;
                            kind: "folder";
                            icon-color: #38B6FF;
                            fill-color: #4CC2FF;
                        }
                    }
                }

                Text {
                    text: "Manifold";
                    color: #FFFFFF;
                    font-size: 16px + root.font-size-delta;
                    font-family: root.resolved-font-family;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.app-version-label;
                    color: #B4B4BE;
                    font-size: 12.5px + root.font-size-delta;
                    font-family: "monospace";
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Rectangle { height: 4px; background: transparent; }

                HorizontalLayout {
                    alignment: center;
                    ToolbarButton {
                        label: "Close";
                        active: true;
                        accent-bg: root.theme-accent;
                        font-family: root.resolved-font-family;
                        clicked => { root.show-about-modal = false; }
                    }
                }
            }
        }
    }

    // LAYER 4.2 (z: 2100): PREFERENCES & THEMES MODAL (Font Size/Type/Style & App Color Themes)
    if root.show-preferences-modal : Rectangle {
        z: 2100;
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea {
            clicked => { root.show-preferences-modal = false; }
        }

        Rectangle {
            width: 660px;
            height: 522px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.theme-bg-popover;
            border-width: 1px;
            border-color: root.theme-border;
            drop-shadow-offset-y: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;

            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 8px;
                        LucideIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: 16px;
                            kind: "star";
                            icon-color: root.theme-text-secondary;
                        }
                        Text {
                            text: "Manifold Preferences — Fonts & Themes";
                            color: root.theme-text-primary;
                            font-size: 14px + root.font-size-delta;
                            font-family: root.resolved-font-family;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    ToolbarButton {
                        icon-kind: "close";
                        accent-bg: root.theme-accent;
                        clicked => { root.show-preferences-modal = false; }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 1. Font Size Preference
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 110px;
                        text: "Font Size:";
                        color: root.theme-text-secondary;
                        font-size: 12px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        font-weight: root.ui-font-bold ? 700 : 500;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SegmentControlButton {
                            label: "Compact (-1)";
                            btn-width: 96px;
                            active: root.ui-font-size-delta == -1;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(-1); }
                        }
                        SegmentControlButton {
                            label: "Standard (0)";
                            btn-width: 96px;
                            active: root.ui-font-size-delta == 0;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(0); }
                        }
                        SegmentControlButton {
                            label: "Medium (+1)";
                            btn-width: 96px;
                            active: root.ui-font-size-delta == 1;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(1); }
                        }
                        SegmentControlButton {
                            label: "Large (+2)";
                            btn-width: 88px;
                            active: root.ui-font-size-delta == 2;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(2); }
                        }
                        SegmentControlButton {
                            label: "XL (+4)";
                            btn-width: 78px;
                            active: root.ui-font-size-delta == 4;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-size-delta(4); }
                        }
                    }
                }

                // 2. Font Family / Type Preference
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 110px;
                        text: "Font Type:";
                        color: root.theme-text-secondary;
                        font-size: 12px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        font-weight: root.ui-font-bold ? 700 : 500;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SegmentControlButton {
                            label: "System Sans";
                            btn-width: 108px;
                            active: root.ui-font-family == "" || root.ui-font-family == "sans-serif";
                            accent-bg: root.theme-accent;
                            font-family: "";
                            clicked => { root.select-font-family("sans-serif"); }
                        }
                        SegmentControlButton {
                            label: "Inter / UI";
                            btn-width: 98px;
                            active: root.ui-font-family == "Inter";
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { root.select-font-family("Inter"); }
                        }
                        SegmentControlButton {
                            label: "Monospace";
                            btn-width: 108px;
                            active: root.ui-font-family == "monospace";
                            accent-bg: root.theme-accent;
                            font-family: "monospace";
                            clicked => { root.select-font-family("monospace"); }
                        }
                        SegmentControlButton {
                            label: "Serif";
                            btn-width: 84px;
                            active: root.ui-font-family == "serif";
                            accent-bg: root.theme-accent;
                            font-family: "serif";
                            clicked => { root.select-font-family("serif"); }
                        }
                    }
                }

                // 3. Font Weight / Style Preference
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 110px;
                        text: "Font Style:";
                        color: root.theme-text-secondary;
                        font-size: 12px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        font-weight: root.ui-font-bold ? 700 : 500;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        SegmentControlButton {
                            label: "Regular Weight";
                            btn-width: 132px;
                            active: !root.ui-font-bold;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { if root.ui-font-bold { root.toggle-font-bold(); } }
                        }
                        SegmentControlButton {
                            label: "Bold / High-Legibility";
                            btn-width: 164px;
                            active: root.ui-font-bold;
                            accent-bg: root.theme-accent;
                            font-family: root.resolved-font-family;
                            clicked => { if !root.ui-font-bold { root.toggle-font-bold(); } }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.theme-border; }

                // 4. Color Theme Presets
                Text {
                    text: "Application Color Theme:";
                    color: root.theme-text-primary;
                    font-size: 12px + root.font-size-delta;
                    font-family: root.resolved-font-family;
                    font-weight: 700;
                }

                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        for th in [
                            { id: "dark_zinc", title: "Dark Zinc", bg: #1A1A1E, acc: #0D52BF },
                            { id: "midnight_ocean", title: "Midnight Ocean", bg: #131B2E, acc: #0284C7 },
                            { id: "dracula_pro", title: "Dracula Pro", bg: #21222C, acc: #BD93F9 }
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            height: 60px;
                            border-radius: 6px;
                            background: th.bg;
                            border-width: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? 2px : 1px;
                            border-color: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? root.theme-accent : root.theme-border;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: th.acc;
                                    }
                                    Text {
                                        text: th.title;
                                        color: #FFFFFF;
                                        font-size: 12px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? "✓ Active Theme" : "Click to apply";
                                    color: (root.ui-theme-preset == th.id || (th.id == "dark_zinc" && (root.ui-theme-preset == "" || root.ui-theme-preset == "Dark Zinc"))) ? root.theme-text-primary : #888892;
                                    font-size: 10px + root.font-size-delta;
                                    font-family: root.resolved-font-family;
                                    font-weight: 600;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-theme-preset(th.id); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        for th in [
                            { id: "nordic_slate", title: "Nordic Slate", bg: #242933, acc: #5E81AC },
                            { id: "solarized_dark", title: "Solarized Dark", bg: #002B36, acc: #268BD2 },
                            { id: "high_contrast", title: "High Contrast", bg: #09090B, acc: #2563EB }
                        ] : Rectangle {
                            horizontal-stretch: 1;
                            height: 60px;
                            border-radius: 6px;
                            background: th.bg;
                            border-width: root.ui-theme-preset == th.id ? 2px : 1px;
                            border-color: root.ui-theme-preset == th.id ? root.theme-accent : root.theme-border;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: th.acc;
                                    }
                                    Text {
                                        text: th.title;
                                        color: #FFFFFF;
                                        font-size: 12px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.ui-theme-preset == th.id ? "✓ Active Theme" : "Click to apply";
                                    color: root.ui-theme-preset == th.id ? root.theme-text-primary : #888892;
                                    font-size: 10px + root.font-size-delta;
                                    font-family: root.resolved-font-family;
                                    font-weight: 600;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-theme-preset(th.id); }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Preferences are automatically saved to ~/.config/manifold/preferences.toml";
                        color: root.theme-text-muted;
                        font-size: 10.5px + root.font-size-delta;
                        font-family: root.resolved-font-family;
                        vertical-alignment: center;
                    }
                    ToolbarButton {
                        label: "Done";
                        active: true;
                        accent-bg: root.theme-accent;
                        font-family: root.resolved-font-family;
                        clicked => { root.show-preferences-modal = false; }
                    }
                }
            }
        }
    }

    // LAYER 4.8 (z: 2400): FLOATING DRAG-AND-DROP GHOST PILL HUD
    if root.is-dragging-row && root.drag-ghost-label != "" : Rectangle {
        z: 2400;
        x: Math.clamp(root.drag-ghost-x + 16px, 8px, root.width - self.width - 8px);
        y: Math.clamp(root.drag-ghost-y - 14px, 8px, root.height - 36px);
        height: 28px;
        width: Math.clamp(ghost-pill-layout.preferred-width, 136px, 340px);
        border-radius: 14px;
        background: #202024EE;
        border-width: 1px;
        border-color: root.drag-target-hint != "" ? root.theme-accent : #3A3A44;
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000099;

        ghost-pill-layout := HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 6px;
            alignment: start;

            LucideIcon {
                y: (parent.height - self.height) / 2;
                icon-size: 13px;
                kind: root.drag-target-hint != "" ? "folder" : "copy";
                icon-color: root.drag-target-hint != "" ? #E1E1E6 : #B4B4BE;
            }

            Text {
                text: root.drag-ghost-label;
                color: #FFFFFF;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.drag-target-hint != "" : Text {
                text: root.drag-target-hint;
                color: #B4B4BE;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // LAYER 4.85 (z: 2440): FLOATING TRANSLUCENT SIDEBAR FAVORITE REORDER PILL (Follows mouse cursor)
    if root.dragging-sidebar-idx >= 0 && root.drag-fav-label != "" : Rectangle {
        z: 2440;
        x: Math.clamp(root.drag-fav-mouse-x - root.drag-fav-grab-offset-x, 8px, root.sidebar-width - 8px);
        y: Math.clamp(root.drag-fav-mouse-y - root.drag-fav-grab-offset-y, 48px, root.height - 38px);
        width: Math.max(120px, root.sidebar-width - 16px);
        height: 28px + Math.max(0px, root.font-size-delta * 1.5);
        border-radius: 5px;
        background: #24242BD8;
        border-width: 1px;
        border-color: #3E3E4A;
        opacity: 0.90;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            Rectangle {
                width: 16px;
                background: transparent;
                SidebarItemIcon {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    kind: root.drag-fav-icon;
                    selected: true;
                    has-color-tag: false;
                    color-tag-brush: transparent;
                }
            }

            Text {
                text: root.drag-fav-label;
                color: #FFFFFF;
                font-size: 13.5px + root.font-size-delta;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }

    // LAYER 4.9 (z: 2450): FLOATING TRANSLUCENT TAB REORDER PILL (Follows mouse cursor)
    if root.dragging-tab-active && root.drag-tab-title != "" : Rectangle {
        z: 2450;
        x: Math.clamp(root.drag-tab-mouse-x - root.drag-tab-grab-offset-x, 8px, root.width - root.drag-tab-width - 8px);
        y: Math.clamp(root.drag-tab-mouse-y - root.drag-tab-grab-offset-y, 44px, root.height - 38px);
        height: 28px + Math.max(0px, root.font-size-delta * 1.5);
        width: root.drag-tab-width;
        border-radius: 6px;
        background: #1C1C22D8;
        border-width: 1px;
        border-color: #3E3E4A;
        opacity: 0.90;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Rectangle {
                width: 16px;
                background: transparent;
                LucideIcon {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    icon-size: 15px;
                    kind: root.drag-tab-icon != "" ? root.drag-tab-icon : "folder";
                    icon-color: #FFFFFF;
                    fill-color: transparent;
                }
            }
            Text {
                text: root.drag-tab-title;
                color: #FFFFFF;
                font-size: 13px + root.font-size-delta;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }

    // LAYER 4.08 (z: 2045): INTERACTIVE DIRECTORY SYNC & DIFF MODAL
    if root.show-sync-modal : Rectangle {
        z: 2045;
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {
                root.show-sync-modal = false;
                root.focus-key-router();
            }
        }

        SyncModalCard {
            width: Math.clamp(root.width * 0.78, 760px, 1040px);
            height: Math.clamp(root.height * 0.76, 480px, 680px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            sync-left-path: root.sync-left-path;
            sync-right-path: root.sync-right-path;
            sync-running: root.sync-running;
            sync-preview-rows: root.sync-preview-rows;
            sync-strategy: root.sync-strategy;
            sync-compare-mode: root.sync-compare-mode;
            sync-summary-text: root.sync-summary-text;
            theme-bg-popover: root.theme-bg-popover;
            theme-bg-toolbar: root.theme-bg-toolbar;
            theme-bg-surface: root.theme-bg-surface;
            theme-row-hover: root.theme-row-hover;
            theme-accent: root.theme-accent;
            theme-border: root.theme-border;
            theme-text-primary: root.theme-text-primary;
            theme-text-secondary: root.theme-text-secondary;
            theme-text-muted: root.theme-text-muted;
            resolved-font-family: root.resolved-font-family;
            font-size-delta: root.font-size-delta;
            close-modal => {
                root.show-sync-modal = false;
                root.focus-key-router();
            }
            update-sync-options(strat, cmp) => {
                root.update-sync-options(strat, cmp);
            }
            toggle-sync-row-approved(idx) => {
                root.toggle-sync-row-approved(idx);
            }
            execute-sync-plan => {
                root.execute-sync-plan();
            }
        }
    }

    // LAYER 5.0 (z: 2600): ACTIONABLE STATUS & ERROR BANNER
    if root.status-banner-text != "" : Rectangle {
        z: 2600;
        width: Math.clamp(status-lbl.preferred-width + 76px, 280px, Math.max(320px, root.width - 64px));
        height: 38px;
        x: (root.width - self.width) / 2;
        y: root.height - 54px;
        border-radius: 8px;
        background: root.status-banner-is-error ? #2A1618 : root.theme-bg-popover;
        border-width: 1px;
        border-color: root.status-banner-is-error ? #FF453A : root.theme-border;
        drop-shadow-offset-y: 8px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000099;

        TouchArea {}

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            LucideIcon {
                y: (parent.height - self.height) / 2;
                icon-size: 15px;
                kind: root.status-banner-is-error ? "alert-triangle" : "info";
                icon-color: root.status-banner-is-error ? #FF453A : root.theme-text-primary;
            }
            status-lbl := Text {
                horizontal-stretch: 1;
                text: root.status-banner-text;
                color: #FFFFFF;
                font-size: 12px + root.font-size-delta * 0.5;
                font-family: root.resolved-font-family;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: banner-dismiss.has-hover ? #FFFFFF1A : transparent;
                LucideIcon {
                    x: 4px;
                    y: 4px;
                    icon-size: 12px;
                    kind: "close";
                    icon-color: #E1E1E6;
                }
                banner-dismiss := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.status-banner-text = ""; }
                }
            }
        }
    }

}
