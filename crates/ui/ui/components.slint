                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    width: 66px;
                                                    text: "Modified";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.ui-font-size-delta * 1px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.inspector-modified;
                                                    color: root.theme-text-primary;
                                                    font-size: 11px + root.ui-font-size-delta * 1px;
                                                    font-family: "monospace";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    width: 66px;
                                                    text: "Created";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.ui-font-size-delta * 1px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.inspector-created;
                                                    color: root.theme-text-primary;
                                                    font-size: 11px + root.ui-font-size-delta * 1px;
                                                    font-family: "monospace";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    width: 66px;
                                                    text: "Extension";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px + root.ui-font-size-delta * 1px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.inspector-extension;
                                                    color: root.theme-text-primary;
                                                    font-size: 11px + root.ui-font-size-delta * 1px;
                                                    font-family: "monospace";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }

                                    // CARD 4: MEDIA DETAILS (Photo / Image, Audio / Music, Video / Media)
                                    if root.inspector-media-category != "" : Rectangle {
                                        border-radius: 6px;
                                        background: root.theme-bg-surface;
                                        border-width: 1px;
                                        border-color: root.theme-border;

                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            padding-top: 8px;
                                            padding-bottom: 9px;
                                            spacing: 5px;

                                            Text {
                                                text: root.inspector-media-category;
                                                color: root.theme-text-secondary;
                                                font-size: 10.5px;
                                                font-weight: 700;
                                                letter-spacing: 0.4px;
                                            }

                                            Rectangle { height: 1px; background: root.theme-border; }

                                            if root.inspector-media-line1 != "" : Text {
                                                text: root.inspector-media-line1;
                                                color: root.theme-text-primary;
                                                font-size: 11px + root.ui-font-size-delta * 1px;
                                                font-family: "monospace";
                                                wrap: word-wrap;
                                            }
                                            if root.inspector-media-line2 != "" : Text {
                                                text: root.inspector-media-line2;
                                                color: root.theme-text-secondary;
                                                font-size: 11px + root.ui-font-size-delta * 1px;
                                                font-family: "monospace";
                                                wrap: word-wrap;
                                            }
                                            if root.inspector-media-line3 != "" : Text {
                                                text: root.inspector-media-line3;
                                                color: root.theme-text-secondary;
                                                font-size: 10.5px + root.ui-font-size-delta * 1px;
                                                font-family: "monospace";
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    // CARD 5: PERMISSIONS & OWNERSHIP
                                    Rectangle {
                                        border-radius: 6px;
                                        background: root.theme-bg-surface;
                                        border-width: 1px;
                                        border-color: root.theme-border;

                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            padding-top: 8px;
                                            padding-bottom: 9px;
                                            spacing: 6px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: space-between;
                                                Text {
                                                    text: "PERMISSIONS";
                                                    color: root.theme-text-secondary;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    letter-spacing: 0.5px;
                                                    vertical-alignment: center;
                                                }
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    Text {
                                                        text: root.inspector-perm-symbolic;
                                                        color: root.theme-text-secondary;
                                                        font-size: 10.5px;
                                                        font-family: "monospace";
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        width: 32px;
                                                        height: 18px;
                                                        border-radius: 3px;
                                                        background: root.theme-bg-canvas;
                                                        border-width: 1px;
                                                        border-color: root.theme-border;
                                                        Text {
                                                            text: root.inspector-perm-octal;
                                                            color: #FFFFFF;
                                                            font-size: 10px;
                                                            font-family: "monospace";
                                                            font-weight: 700;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            Rectangle { height: 1px; background: root.theme-border; }

                                            // Compact 3x3 R/W/X Matrix with fixed 26px columns on the right
                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: "Role";
                                                    color: root.theme-text-secondary;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    width: 26px;
                                                    text: "R";
                                                    color: root.theme-text-secondary;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    width: 26px;
                                                    text: "W";
                                                    color: root.theme-text-secondary;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    width: 26px;
                                                    text: "X";
                                                    color: root.theme-text-secondary;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            HorizontalLayout {
                                                height: 20px;
                                                spacing: 4px;
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: "Owner";
                                                    color: root.theme-text-primary;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-ur;
                                                        toggled => { root.toggle-permission-bit(0, 0); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-uw;
                                                        toggled => { root.toggle-permission-bit(0, 1); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-ux;
                                                        toggled => { root.toggle-permission-bit(0, 2); }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                height: 20px;
                                                spacing: 4px;
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: "Group";
                                                    color: root.theme-text-primary;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-gr;
                                                        toggled => { root.toggle-permission-bit(1, 0); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-gw;
                                                        toggled => { root.toggle-permission-bit(1, 1); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-gx;
                                                        toggled => { root.toggle-permission-bit(1, 2); }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                height: 20px;
                                                spacing: 4px;
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: "Others";
                                                    color: root.theme-text-primary;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-or;
                                                        toggled => { root.toggle-permission-bit(2, 0); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-ow;
                                                        toggled => { root.toggle-permission-bit(2, 1); }
                                                    }
                                                }
                                                Rectangle {
                                                    width: 26px;
                                                    background: transparent;
                                                    PermCheckbox {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        checked: root.perm-ox;
                                                        toggled => { root.toggle-permission-bit(2, 2); }
                                                    }
                                                }
                                            }

                                            Rectangle { height: 1px; background: root.theme-border; }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    width: 66px;
                                                    text: "Owner";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.inspector-owner;
                                                    color: root.theme-text-primary;
                                                    font-size: 11px;
                                                    font-family: "monospace";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                Text {
                                                    width: 66px;
                                                    text: "Group";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.inspector-group;
                                                    color: root.theme-text-primary;
                                                    font-size: 11px;
                                                    font-family: "monospace";
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                height: 20px;
                                                spacing: 6px;
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: "Locked";
                                                    color: root.theme-text-secondary;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                                PermCheckbox {
                                                    y: (parent.height - self.height) / 2;
                                                    checked: root.inspector-locked;
                                                    toggled => { root.toggle-locked(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // TAB 1: TASKS & TRANSFERS (Width-locked Flickable prevents horizontal overflow)
                        if root.inspector-tab-index == 1 : Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            background: transparent;

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                scroll-event(ev) => {
                                    insp-tasks-flick.viewport-y = Math.clamp(
                                        insp-tasks-flick.viewport-y + ev.delta-y,
                                        Math.min(0px, insp-tasks-flick.height - insp-tasks-flick.viewport-height),
                                        0px
                                    );
                                    return accept;
                                }
                            }

                            insp-tasks-flick := Flickable {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                interactive: false;
                                viewport-width: self.width;
                                viewport-height: Math.max(self.height, insp-tasks-col.preferred-height + 8px);

                                insp-tasks-col := VerticalLayout {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Tasks & Transfers";
                                            color: root.theme-text-primary;
                                            font-size: 12px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        if root.transfer-rows.length > 0 : ToolbarButton {
                                            label: "Clear";
                                            clicked => { root.clear-completed-tasks(); }
                                        }
                                    }
                                    if root.transfer-rows.length == 0 : Rectangle {
                                        height: 68px;
                                        border-radius: 6px;
                                        background: root.theme-bg-surface;
                                        border-width: 1px;
                                        border-color: root.theme-border;
                                        Text {
                                            text: "No active or recent tasks.";
                                            color: root.theme-text-secondary;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    for tr in root.transfer-rows : TransferTaskCard {
                                        tr: tr;
                                        spinner-frame: root.spinner-frame;
                                        bg-surface: root.theme-bg-surface;
                                        bg-canvas: root.theme-bg-canvas;
                                        accent-bg: root.theme-accent;
                                        border-brush: root.theme-border;
                                        text-secondary: root.theme-text-secondary;
                                        toggle-pause(id) => { root.toggle-pause-transfer(id); }
                                        cancel-task(id) => { root.cancel-transfer(id); }
                                    }
                                }
                            }
                        }
                    }
}

export component TerminalDrawer inherits Rectangle {
    in-out property <length> col-resize-start-w;
    in-out property <length> col-resize-start-x;
    in property <string> resolved-mono-font-family;
    in-out property <bool> show-terminal-drawer;
    in property <bool> terminal-alt-screen;
    in-out property <length> terminal-canvas-height;
    in-out property <length> terminal-canvas-width;
    in property <length> terminal-cell-width;
    in property <string> terminal-cwd;
    in-out property <length> terminal-drawer-height;
    in-out property <bool> terminal-focused;
    in property <[TerminalLineSlint]> terminal-lines;
    in property <int> terminal-max-scroll;
    in property <int> terminal-scroll-offset;
    in property <string> terminal-session-label;
    in property <brush> theme-accent;
    in property <brush> theme-border;
    in property <int> ui-font-size-delta;
    in property <length> window-height;
    callback clear-terminal();
    callback focus-key-router();
    callback restart-terminal();
    callback sync-terminal-cwd();
    callback terminal-key-input(string, string, bool, bool, bool);
    callback terminal-paste();
    callback terminal-scroll(int);

    public function focus-terminal() {
        term-focus-scope.focus();
    }

    height: root.terminal-drawer-height;
    vertical-stretch: 0;
    background: #0B0C10;
    border-width: 1px;
    border-color: root.terminal-focused ? #2A4365 : root.theme-border;

                init => {
                    root.terminal-canvas-width = term-canvas-rect.width;
                    root.terminal-canvas-height = term-canvas-rect.height;
                    term-focus-scope.focus();
                }

                // Top 5px Height Resize Handle
                Rectangle {
                    z: 30;
                    x: 0px;
                    y: -2px;
                    width: parent.width;
                    height: 5px;
                    background: term-resizer.has-hover || term-resizer.pressed ? root.theme-accent : transparent;
                    term-resizer := TouchArea {
                        mouse-cursor: row-resize;
                        pointer-event(ev) => {
                            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                root.col-resize-start-x = self.absolute-position.y + self.mouse-y;
                                root.col-resize-start-w = root.terminal-drawer-height;
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.terminal-drawer-height = Math.clamp(
                                    root.col-resize-start-w - ((self.absolute-position.y + self.mouse-y) - root.col-resize-start-x),
                                    140px,
                                    Math.max(240px, root.window-height - 180px)
                                );
                                root.terminal-canvas-width = term-canvas-rect.width;
                                root.terminal-canvas-height = term-canvas-rect.height;
                            }
                        }
                    }
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Sleek Integrated Terminal Title Strip (28px)
                    Rectangle {
                        height: 28px;
                        background: #14151A;

                        Rectangle {
                            x: 0px;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: #23252E;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3.5px;
                                    background: root.terminal-focused ? #4E9A5E : #585864;
                                }
                                LucideIcon {
                                    y: (parent.height - self.height) / 2;
                                    icon-size: 13px;
                                    kind: "terminal";
                                    icon-color: #C9D1D9;
                                }
                                Text {
                                    text: root.terminal-session-label;
                                    color: #E6EDF3;
                                    font-size: 12px + root.ui-font-size-delta * 0.5px;
                                    font-family: root.resolved-mono-font-family;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "·";
                                    color: #585B66;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.terminal-cwd;
                                    color: #8B949E;
                                    font-size: 11.5px + root.ui-font-size-delta * 0.5px;
                                    font-family: root.resolved-mono-font-family;
                                    font-weight: 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.terminal-alt-screen : Rectangle {
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: #1F2937;
                                    border-width: 1px;
                                    border-color: #374151;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "TUI / ALT";
                                            color: #9CA3AF;
                                            font-family: root.resolved-mono-font-family;
                                            font-size: 10px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if root.terminal-scroll-offset > 0 : Rectangle {
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: #0D52BF44;
                                    border-width: 1px;
                                    border-color: root.theme-accent;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "↑ -" + root.terminal-scroll-offset + " lines";
                                            color: #E6EDF3;
                                            font-family: root.resolved-mono-font-family;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: end;
                                ToolbarButton {
                                    label: "Sync CWD";
                                    tooltip: "cd terminal to active folder";
                                    tooltip-above: true;
                                    clicked => {
                                        term-focus-scope.focus();
                                        root.sync-terminal-cwd();
                                    }
                                }
                                ToolbarButton {
                                    label: "Paste";
                                    tooltip: "Paste clipboard into terminal (Cmd+V / Ctrl+Shift+V)";
                                    tooltip-above: true;
                                    clicked => {
                                        term-focus-scope.focus();
                                        root.terminal-paste();
                                    }
                                }
                                ToolbarButton {
                                    label: "^C";
                                    tooltip: "Send SIGINT (Interrupt Running Command)";
                                    tooltip-above: true;
                                    clicked => {
                                        term-focus-scope.focus();
                                        root.terminal-key-input("c", "", true, false, false);
                                    }
                                }
                                ToolbarButton {
                                    label: "Clear";
                                    tooltip: "Clear terminal screen (Ctrl+L / Cmd+K)";
                                    tooltip-above: true;
                                    clicked => {
                                        term-focus-scope.focus();
                                        root.clear-terminal();
                                    }
                                }
                                ToolbarButton {
                                    label: "Restart";
                                    tooltip: "Restart shell session in current folder";
                                    tooltip-above: true;
                                    clicked => {
                                        term-focus-scope.focus();
                                        root.restart-terminal();
                                    }
                                }
                                ToolbarButton {
                                    icon-kind: "close";
                                    tooltip: "Hide Bottom Terminal";
                                    tooltip-align-right: true;
                                    tooltip-above: true;
                                    clicked => {
                                        root.show-terminal-drawer = false;
                                        root.focus-key-router();
                                    }
                                }
                            }
                        }
                    }

                    // Direct Interactive Terminal Canvas (Exact Monospace Cell Grid)
                    term-canvas-rect := Rectangle {
                        vertical-stretch: 1;
                        background: #0B0C10;
                        clip: true;

                        property <length> live-cell-w: root.terminal-cell-width;

                        term-focus-scope := FocusScope {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            init => {
                                self.focus();
                            }
                            focus-changed-event => {
                                root.terminal-focused = self.has-focus;
                                root.terminal-canvas-width = term-canvas-rect.width;
                                root.terminal-canvas-height = term-canvas-rect.height;
                            }
                            key-pressed(ev) => {
                                root.terminal-canvas-width = term-canvas-rect.width;
                                root.terminal-canvas-height = term-canvas-rect.height;
                                if (ev.modifiers.meta && (ev.text == "v" || ev.text == "V"))
                                    || (ev.modifiers.control && ev.modifiers.shift && (ev.text == "v" || ev.text == "V")) {
                                    root.terminal-paste();
                                    return accept;
                                }
                                if ev.modifiers.meta && (ev.text == "k" || ev.text == "K") {
                                    root.clear-terminal();
                                    return accept;
                                }
                                if ev.text == Key.Return || ev.text == "\n" || ev.text == "\u{000d}" {
                                    root.terminal-key-input("", "return", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.Backspace || ev.text == "\u{0008}" || ev.text == "\u{007f}" {
                                    root.terminal-key-input("", "backspace", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.Tab || ev.text == Key.Backtab || ev.text == "\u{0009}" {
                                    root.terminal-key-input("", "tab", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.Escape || ev.text == "\u{001b}" {
                                    root.terminal-key-input("", "escape", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.UpArrow || ev.text == "\u{f700}" {
                                    root.terminal-key-input("", "up", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.DownArrow || ev.text == "\u{f701}" {
                                    root.terminal-key-input("", "down", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.LeftArrow || ev.text == "\u{f702}" {
                                    root.terminal-key-input("", "left", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.RightArrow || ev.text == "\u{f703}" {
                                    root.terminal-key-input("", "right", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.Home || ev.text == "\u{f729}" {
                                    root.terminal-key-input("", "home", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.End || ev.text == "\u{f72b}" {
                                    root.terminal-key-input("", "end", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.Delete || ev.text == "\u{f728}" {
                                    root.terminal-key-input("", "delete", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    return accept;
                                }
                                if ev.text == Key.PageUp || ev.text == "\u{f72c}" {
                                    if ev.modifiers.shift {
                                        root.terminal-scroll(8);
                                    } else {
                                        root.terminal-key-input("", "pageup", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    }
                                    return accept;
                                }
                                if ev.text == Key.PageDown || ev.text == "\u{f72d}" {
                                    if ev.modifiers.shift {
                                        root.terminal-scroll(-8);
                                    } else {
                                        root.terminal-key-input("", "pagedown", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                    }
                                    return accept;
                                }
                                root.terminal-key-input(ev.text, "", ev.modifiers.control, ev.modifiers.alt, ev.modifiers.shift);
                                return accept;
                            }

                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 0px;
                                alignment: start;
                                for line in root.terminal-lines : Rectangle {
                                    height: 18px + root.ui-font-size-delta * 1.5px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 0px;
                                        alignment: start;
                                        TermSpanCell { span: line.s0; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s1; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s2; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s3; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s4; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s5; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s6; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s7; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s8; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s9; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s10; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s11; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s12; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s13; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s14; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                        TermSpanCell { span: line.s15; font-delta: root.ui-font-size-delta; mono-font-family: root.resolved-mono-font-family; cell-width: term-canvas-rect.live-cell-w; }
                                    }
                                }
                            }

                            // Subtle Right-Edge Scrollback Position Bar (when scrollback history exists)
                            if !root.terminal-alt-screen && root.terminal-max-scroll > 0 : Rectangle {
                                x: parent.width - 7px;
                                y: 4px;
                                width: 4px;
                                height: parent.height - 8px;
                                border-radius: 2px;
                                background: #1A1C23;

                                property <float> thumb-ratio: Math.clamp(
                                    root.terminal-lines.length / Math.max(1.0, root.terminal-lines.length + root.terminal-max-scroll),
                                    0.12,
                                    1.0
                                );
                                property <length> thumb-h: Math.max(20px, self.height * self.thumb-ratio);
                                property <float> scroll-frac: Math.clamp(
                                    1.0 - (root.terminal-scroll-offset / Math.max(1.0, root.terminal-max-scroll)),
                                    0.0,
                                    1.0
                                );

                                Rectangle {
                                    x: 0px;
                                    y: (parent.height - parent.thumb-h) * parent.scroll-frac;
                                    width: 4px;
                                    height: parent.thumb-h;
                                    border-radius: 2px;
                                    background: root.terminal-scroll-offset > 0 ? root.theme-accent : #484C58;
                                }
                            }

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: text;
                                clicked => {
                                    root.terminal-canvas-width = term-canvas-rect.width;
                                    root.terminal-canvas-height = term-canvas-rect.height;
                                    term-focus-scope.focus();
                                }
                                pointer-event(ev) => {
                                    if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                        term-focus-scope.focus();
                                        root.terminal-paste();
                                    }
                                }
                                scroll-event(ev) => {
                                    root.terminal-scroll(ev.delta-y > 0px ? 3 : -3);
                                    return accept;
                                }
                            }
                        }
                    }
                }
}
