                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: "COLOR TAG";
                                                    color: root.theme-text-secondary;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    letter-spacing: 0.5px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.inspector-color-index == 1 ? "Gray"
                                                        : (root.inspector-color-index == 2 ? "Green"
                                                        : (root.inspector-color-index == 3 ? "Purple"
                                                        : (root.inspector-color-index == 4 ? "Blue"
                                                        : (root.inspector-color-index == 5 ? "Yellow"
                                                        : (root.inspector-color-index == 6 ? "Red"
                                                        : (root.inspector-color-index == 7 ? "Orange" : "None"))))));
                                                    color: root.inspector-color-index == 0 ? root.theme-text-secondary : root.theme-text-primary;
                                                    font-size: 10.5px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;
                                                ColorSwatchDot {
                                                    is-none: true;
