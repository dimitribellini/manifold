// Clean Dark Zinc Text Input (Replaces std-widgets LineEdit so #000000 black box never renders)
export component CleanLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    in property <length> font-size: 12.5px;
    callback edited(string);
    callback accepted(string);
    callback escape-pressed();

    public function focus-input() {
        inner-input.focus();
        inner-input.select-all();
    }

    height: 28px;
    border-radius: 5px;
    background: #141417;
    border-width: 1px;
    border-color: inner-input.has-focus ? #0D52BF : #28282D;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            if root.text == "" && !inner-input.has-focus : Text {
                text: root.placeholder-text;
                color: #6E6E77;
                font-size: root.font-size;
                vertical-alignment: center;
            }

            inner-input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                input-type: root.input-type;
                font-size: root.font-size;
                color: #E1E1E6;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
                key-pressed(ev) => {
                    if ev.text == "\u{001b}" {
                        root.escape-pressed();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}

// Standardized FileRow Component (doc/specification_2.md §3 & §4.4)
// - Row Height: 28px + font_delta * 2.0
// - Focused Selected: #0D52BF (Royal Blue), Unfocused Selected: #2E323B (Muted Slate), Hover: #26262B
// - Vertically centered Lucide vector icon / tile
// - Primary Filename: 13.5px + font_delta (#ffffff selected, #e1e1e6 default)
// - Tabular Monospace Size & Date Modified: 12.5px + font_delta (#d0d0d8 selected, #888892 default)
export component FileRow inherits Rectangle {
    in property <int> row_index: 0;
    in property <string> file_name;
    in property <string> file_size;
    in property <string> file_date;
    in property <string> file_kind: "";
    in property <string> file_created: "";
    in property <string> file_added: "";
    in property <string> file_owner: "";
    in property <string> file_group: "";
    in property <string> file_permissions: "";
    in property <string> ext_badge: "";
    in property <bool> is_dir: false;
    in property <bool> is_image: false;
    in property <bool> has_thumbnail: false;
    in property <image> thumbnail;
    in property <bool> is_executable: false;
    in property <bool> is_expanded: false;
    in property <bool> selected: false;
    in property <bool> pane_focused: true;
    in property <int> depth: 0;
    in property <bool> tree_mode: false;
    in property <bool> has_color_tag: false;
    in property <string> color_tag_name: "";
    in property <brush> color_tag_brush: transparent;
    in property <brush> color_tag_tint: transparent;
    in property <length> size_col_width: 96px;
    in property <length> date_col_width: 145px;
    in property <bool> show_col_size: true;
    in property <bool> show_col_kind: false;
    in property <bool> show_col_modified: true;
    in property <bool> show_col_created: false;
    in property <bool> show_col_added: false;
    in property <bool> show_col_owner: false;
    in property <bool> show_col_group: false;
    in property <bool> show_col_permissions: false;
    in property <bool> show_col_tags: true;
    in property <bool> bold_folders: false;
    in property <bool> use_alt_bg: false;
    in property <length> view_icon_size: 16px;
    in property <bool> drag_drop_highlight: false;
    in property <length> font_delta: 1px;
    in property <bool> font_bold: false;
    in property <string> font_family: "";
    in property <brush> row_bg: #1A1A1E;
    in property <brush> row_alt_bg: #1E1E24;
    in property <brush> row_hover_bg: #26262B;
    in property <brush> row_accent_bg: #0D52BF;
    in property <brush> text_primary: #e1e1e6;
    in property <brush> text_muted: #888892;
    private property <bool> down_shift: false;
    private property <bool> down_cmd: false;
    private property <bool> drag_active: false;
    private property <bool> suppress_next_click: false;

    callback row-clicked(bool, bool);
    callback row-double-clicked();
    callback row-context-menu(length, length);
    callback row-hovered(length, length);
    callback row-unhovered();
    callback row-shift-drag(length);
    callback row-drag-moved(length, length);
    callback row-drag-ended(length, length);
    callback row-drag-to-other-pane();
    callback toggle-expand();
    callback wheel-scroll(length);

    height: 28px + Math.max(0px, root.font_delta * 2.0) + Math.max(0px, root.view_icon_size - 16px);
    border-radius: 4px;
    border-width: drag_drop_highlight ? 1px : 0px;
    border-color: drag_drop_highlight ? root.row_accent_bg : transparent;
    background: drag_drop_highlight
        ? #0D52BF38
        : (selected
            ? (pane_focused ? root.row_accent_bg : #2E323B)
            : (touch.has-hover
                ? root.row_hover_bg
                : (has_color_tag
                    ? color_tag_tint
                    : (root.use_alt_bg && Math.mod(root.row_index, 2) == 1
                        ? root.row_alt_bg
                        : root.row_bg))));

    // Left vertical color tag accent bar for immediate visual feedback
    if root.has_color_tag : Rectangle {
        x: 1px;
        y: 3px;
        width: 3px;
        height: parent.height - 6px;
        border-radius: 1.5px;
        background: root.selected ? #FFFFFF : root.color_tag_brush;
    }

    touch := TouchArea {
        clicked => {
            if !root.suppress_next_click {
                root.row-clicked(root.down_shift, root.down_cmd);
            }
            root.suppress_next_click = false;
            root.down_shift = false;
            root.down_cmd = false;
        }
        double-clicked => {
            root.drag_active = false;
            root.suppress_next_click = false;
            root.row-double-clicked();
        }
        moved => {
            if self.pressed && !root.down_shift && !root.down_cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                root.drag_active = true;
                root.suppress_next_click = true;
                root.row-drag-moved(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
        changed has-hover => {
            if self.has-hover && !self.pressed && !root.drag_active {
                root.row-hovered(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            } else if !self.has-hover {
                root.row-unhovered();
            }
        }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move && !self.pressed && !root.drag_active {
                root.row-hovered(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.down_shift = ev.modifiers.shift;
                root.down_cmd = ev.modifiers.control || ev.modifiers.meta;
                root.drag_active = false;
                root.suppress_next_click = false;
            }
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                root.drag_active = false;
                root.suppress_next_click = true;
                root.row-context-menu(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.drag_active {
                root.drag_active = false;
                root.row-drag-ended(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if ev.kind == PointerEventKind.cancel {
                root.down_shift = false;
                root.down_cmd = false;
                root.suppress_next_click = false;
            }
        }
        scroll-event(ev) => {
            root.wheel-scroll(ev.delta-y);
            return accept;
        }
    }

    // Subtle vertical/horizontal tree guide connector for nested rows in Tree View
    if root.tree_mode && root.depth > 0 : Rectangle {
        x: 8px + (root.depth - 1) * 16px + 6px;
        y: 0px;
        width: 10px;
        height: parent.height;
        background: transparent;
        Rectangle {
            x: 0px;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: root.selected ? #FFFFFF55 : #383842;
        }
        Rectangle {
            x: 0px;
            y: parent.height / 2;
            width: 8px;
            height: 1px;
            background: root.selected ? #FFFFFF55 : #383842;
        }
    }

    HorizontalLayout {
        padding-left: root.tree_mode ? (8px + root.depth * 16px) : 10px;
        padding-right: 12px;
        spacing: 8px;

        // Expand/collapse chevron for directories in Tree View
        if root.tree_mode : Rectangle {
            width: 14px;
            background: transparent;
            if root.is_dir : LucideIcon {
                x: 1px;
                y: (parent.height - self.height) / 2;
                icon-size: 12px;
                kind: root.is_expanded ? "chevron-down" : "chevron-right";
                icon-color: root.selected ? #FFFFFF : root.text_muted;
            }
            if root.is_dir : TouchArea {
                clicked => {
                    root.toggle-expand();
                }
                scroll-event(ev) => {
                    root.wheel-scroll(ev.delta-y);
                    return accept;
                }
            }
        }

        // Vertically centered Thumbnail or Vector File Type Icon (scaled by view_icon_size)
        Rectangle {
            width: Math.max(20px, root.view_icon_size + 4px);
            background: transparent;
            if !root.is_dir && root.has_thumbnail : Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: Math.max(20px, root.view_icon_size + 4px);
                height: Math.max(20px, root.view_icon_size + 4px);
                border-radius: 3px;
                background: #121215;
                border-width: 1px;
                border-color: root.selected ? #FFFFFFAA : #32323A;
                clip: true;
                Image {
                    x: 1px;
                    y: 1px;
                    width: Math.max(18px, root.view_icon_size + 2px);
                    height: Math.max(18px, root.view_icon_size + 2px);
                    image-fit: contain;
                    source: root.thumbnail;
                }
            }
            if root.is_dir || !root.has_thumbnail : LucideIcon {
                x: 2px;
                y: (parent.height - self.height) / 2;
                icon-size: root.view_icon_size;
                kind: root.is_dir
                    ? "folder"
                    : (root.ext_badge == "APP"
                        ? "applications"
                        : (root.is_image
                            ? "image"
                            : ((root.ext_badge == "ZIP" || root.ext_badge == "TAR" || root.ext_badge == "GZ" || root.ext_badge == "ISO" || root.ext_badge == "7Z" || root.ext_badge == "RAR")
                                ? "archive"
                                : ((root.ext_badge == "MP3" || root.ext_badge == "WAV" || root.ext_badge == "FLAC" || root.ext_badge == "M4A" || root.ext_badge == "AAC" || root.ext_badge == "OGG")
                                    ? "music"
                                    : ((root.ext_badge == "MP4" || root.ext_badge == "MOV" || root.ext_badge == "MKV" || root.ext_badge == "WEBM" || root.ext_badge == "AVI")
                                        ? "movies"
                                        : (root.is_executable ? "terminal" : "documents"))))));
                icon-color: root.has_color_tag
                    ? root.color_tag_brush
                    : ((root.is_dir || root.ext_badge == "APP")
                        ? #38B6FF
                        : (root.ext_badge == "PDF"
                            ? #FF5F56
                            : (root.is_image ? #6E92B8 : #A0A0AB)));
                fill-color: root.is_dir
                    ? (root.has_color_tag ? root.color_tag_brush : #4CC2FF)
                    : transparent;
            }
        }

        // Primary Filename Text (scaled by font_delta, #ffffff selected, bold_folders support)
        Text {
            text: root.file_name;
            color: root.selected ? #ffffff : root.text_primary;
            font-size: 13.5px + root.font_delta;
            font-family: root.font_family;
            font-weight: (root.font_bold || (root.is_dir && root.bold_folders)) ? 700 : (root.has_color_tag ? 600 : 500);
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Labeled Color Tag Pill Badge ([ ● Orange ])
        if root.has_color_tag && root.show_col_tags : Rectangle {
            width: tag-pill-layout.preferred-width;
            height: 18px + Math.max(0px, root.font_delta * 0.5);
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: root.selected ? #00000044 : root.color_tag_tint;
            border-width: 1px;
            border-color: root.selected ? #FFFFFF88 : root.color_tag_brush;
            tag-pill-layout := HorizontalLayout {
                padding-left: 6px;
                padding-right: 7px;
                spacing: 5px;
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3.5px;
                    background: root.color_tag_brush;
                }
                Text {
                    text: root.color_tag_name;
                    color: root.selected ? #FFFFFF : #F2F2F7;
                    font-size: 10.5px + root.font_delta * 0.5;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Tabular Monospace Size Column (resizable width, right-aligned)
        if root.show_col_size : Text {
            text: root.file_size;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12.5px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: root.size_col_width;
            overflow: elide;
        }

        // Kind Column
        if root.show_col_kind : Text {
            text: root.file_kind;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: root.font_family;
            vertical-alignment: center;
            horizontal-alignment: left;
            width: 112px;
            overflow: elide;
        }

        // Tabular Monospace Date Modified Column (resizable width, right-aligned)
        if root.show_col_modified : Text {
            text: root.file_date;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12.5px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: root.date_col_width;
            overflow: elide;
        }

        // Date Added Column
        if root.show_col_added : Text {
            text: root.file_added;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 140px;
            overflow: elide;
        }

        // Date Created Column
        if root.show_col_created : Text {
            text: root.file_created;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 140px;
            overflow: elide;
        }

        // Owner Column
        if root.show_col_owner : Text {
            text: root.file_owner;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: left;
            width: 84px;
            overflow: elide;
        }

        // Group Column
        if root.show_col_group : Text {
            text: root.file_group;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: left;
            width: 84px;
            overflow: elide;
        }

        // Permissions Column
        if root.show_col_permissions : Text {
            text: root.file_permissions;
            color: root.selected ? #d0d0d8 : root.text_muted;
            font-size: 12px + root.font_delta;
            font-weight: root.font_bold ? 700 : 500;
            font-family: "monospace";
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 92px;
            overflow: elide;
        }
    }
}

// Vector Sidebar Item Icon using Unified Lucide SVG Paths
export component SidebarItemIcon inherits Rectangle {
    in property <string> kind: "folder";
    in property <bool> selected: false;
    in property <bool> has-color-tag: false;
    in property <brush> color-tag-brush: transparent;
    width: 16px;
    height: 16px;
    background: transparent;

    LucideIcon {
        x: 0px;
        y: (parent.height - self.height) / 2;
        icon-size: 16px;
        kind: root.kind;
        icon-color: root.selected
            ? #FFFFFF
            : (root.has-color-tag
                ? root.color-tag-brush
                : ((root.kind == "folder" || root.kind == "globe")
                    ? #38B6FF
                    : #A0A0AB));
        fill-color: root.kind == "folder"
            ? (root.selected
                ? #FFFFFF
                : (root.has-color-tag ? root.color-tag-brush : #4CC2FF))
            : transparent;
    }
}

// Clean Segmented Control Button (Unified Toolbar & Inspector Tabs)
export component SegmentControlButton inherits Rectangle {
    in property <string> label: "";
    in property <string> icon-kind: "";
    in property <bool> pill-style: false;
    in property <bool> active: false;
    in property <bool> enabled-state: true;
    in property <length> btn-width: 64px;
    in property <string> tooltip: "";
    in property <bool> tooltip-align-right: false;
    in property <brush> accent-bg: #0D52BF;
    in property <string> font-family: "";
    in property <length> font-delta: 1px;
    callback clicked();

    width: btn-width;
    height: root.pill-style ? 24px : 26px;
    horizontal-stretch: 0;
    border-radius: root.pill-style ? 12px : 5px;
    opacity: enabled-state ? 1.0 : 0.3;
    background: active
        ? (root.pill-style ? #3A3A44 : root.accent-bg)
        : (touch.has-hover && enabled-state ? #282830 : transparent);
    border-width: 0px;

    if root.icon-kind != "" : LucideIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon-size: 16px;
        kind: root.icon-kind;
        icon-color: active ? #FFFFFF : (touch.has-hover ? #E5E5EE : #C2C2CC);
    }

    if root.label != "" : Text {
        text: root.label;
        color: active ? #FFFFFF : #B4B4BE;
        font-size: 12.5px + root.font-delta * 0.5;
        font-family: root.font-family;
        font-weight: active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.tooltip != "" && touch.has-hover && !touch.pressed : Rectangle {
        z: 3000;
        x: root.tooltip-align-right ? (parent.width - self.width) : 0px;
        y: parent.height + 6px;
        height: 22px;
        width: seg-tt-text.preferred-width + 14px;
        border-radius: 4px;
        background: #202024;
        border-width: 1px;
        border-color: #3A3A44;
        seg-tt-text := Text {
            x: 7px;
            y: (parent.height - self.height) / 2;
            text: root.tooltip;
            color: #F2F2F7;
            font-size: 11px;
            font-weight: 500;
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled-state {
                root.clicked();
            }
        }
    }
}

// Toolbar Action Button (Supports either a Lucide vector icon or text label + hover tooltip)
export component ToolbarButton inherits Rectangle {
    in property <string> label: "";
    in property <string> icon-kind: "";
    in property <bool> active: false;
    in property <bool> enabled-state: true;
    in property <string> tooltip: "";
    in property <bool> tooltip-align-right: false;
    in property <bool> tooltip-above: false;
    in property <brush> accent-bg: #0D52BF;
    in property <string> font-family: "";
    in property <length> font-delta: 1px;
    callback clicked();

    height: 30px;
    min-width: 30px;
    horizontal-stretch: 0;
    border-radius: 6px;
    opacity: enabled-state ? 1.0 : 0.35;
    background: active ? root.accent-bg : (touch.has-hover && enabled-state ? #26262B : #161618);
    border-width: 1px;
    border-color: active ? root.accent-bg : #28282D;

    HorizontalLayout {
        padding-left: root.icon-kind != "" && root.label == "" ? 7px : 9px;
        padding-right: root.icon-kind != "" && root.label == "" ? 7px : 9px;
        spacing: 5px;
        alignment: center;

        if root.icon-kind != "" : LucideIcon {
            y: (parent.height - self.height) / 2;
            icon-size: 15px;
            kind: root.icon-kind;
            icon-color: root.active ? #FFFFFF : #E1E1E6;
        }

        if root.label != "" : Text {
            text: root.label;
            color: active ? #FFFFFF : #E1E1E6;
            font-size: 12.5px + root.font-delta * 0.5;
            font-family: root.font-family;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.tooltip != "" && touch.has-hover && !touch.pressed : Rectangle {
        z: 3000;
        x: root.tooltip-align-right ? (parent.width - self.width) : 0px;
        y: root.tooltip-above ? -26px : (parent.height + 5px);
        height: 22px;
        width: btn-tt-text.preferred-width + 14px;
        border-radius: 4px;
        background: #202024;
        border-width: 1px;
        border-color: #3A3A44;
        btn-tt-text := Text {
            x: 7px;
            y: (parent.height - self.height) / 2;
            text: root.tooltip;
            color: #F2F2F7;
            font-size: 11px;
            font-weight: 500;
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled-state {
                root.clicked();
            }
        }
    }
}

// Checkbox used in Permissions matrix & Connect modal
export component PermCheckbox inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 16px;
    height: 16px;
    border-radius: 3.5px;
    background: checked ? #0D52BF : #1A1A1E;
    border-width: 1px;
    border-color: checked ? #0D52BF : #28282D;

    if checked : Text {
        text: "✓";
        color: #FFFFFF;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

export component ViewOptionCheckboxRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    in property <bool> enabled-state: true;
    in property <length> indent: 0px;
    in property <bool> small-text: false;
    in property <brush> accent-bg: #0D52BF;
    in property <brush> surface-bg: #1A1A1E;
    in property <brush> border-brush: #28282D;
    in property <brush> text-brush: #E1E1E6;
    in property <string> font-family: "";
    callback toggled();

    height: root.small-text ? 18px : 20px;
    opacity: root.enabled-state ? 1.0 : 0.42;
    background: transparent;

    HorizontalLayout {
        padding-left: root.indent;
        spacing: 7px;
        alignment: start;

        Rectangle {
            width: root.small-text ? 13px : 15px;
            height: root.small-text ? 13px : 15px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: root.checked ? root.accent-bg : root.surface-bg;
            border-width: 1px;
            border-color: root.checked
                ? root.accent-bg
                : (row-touch.has-hover && root.enabled-state ? #52525E : root.border-brush);

            if root.checked : LucideIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon-size: root.small-text ? 9px : 11px;
                kind: "check";
                icon-color: #FFFFFF;
            }
        }

        Text {
            text: root.label;
            color: root.text-brush;
            font-size: root.small-text ? 11px : 12px;
            font-family: root.font-family;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    row-touch := TouchArea {
        mouse-cursor: root.enabled-state ? pointer : default;
        clicked => {
            if root.enabled-state {
                root.toggled();
            }
        }
    }
}

export component ColorSwatchDot inherits Rectangle {
    in property <brush> swatch-color;
    in property <bool> selected: false;
    in property <bool> is-none: false;
    callback clicked();

    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: is-none ? #1A1A1E : swatch-color;
    border-width: (selected || swatch-touch.has-hover) ? 2px : 1px;
    border-color: selected ? #FFFFFF : (swatch-touch.has-hover ? #D0D0D8 : #323238);

    if selected && !is-none : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: #FFFFFF;
    }

    if is-none : LucideIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon-size: 10px;
        kind: "close";
        icon-color: selected ? #FFFFFF : #888892;
    }

    swatch-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Opaque Context Menu Row Item (doc/specification_2.md §2.1 & §4.1:
// 100% opaque #202024 default fill, #0D52BF hover fill, crisp Lucide vector icon)
export component ContextMenuItem inherits Rectangle {
    in property <string> icon-kind: "file";
    in property <string> label;
    in property <string> shortcut-hint: "";
    callback triggered();

    height: 28px;
    border-radius: 4px;
    opacity: 1.0;
    background: touch.has-hover ? #0D52BF : #202024;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Rectangle {
            width: 16px;
            background: transparent;
            LucideIcon {
                x: 0px;
                y: (parent.height - self.height) / 2;
                icon-size: 15px;
                kind: root.icon-kind;
                icon-color: touch.has-hover ? #FFFFFF : #A0A0AB;
            }
        }

        Text {
            text: root.label;
            color: touch.has-hover ? #FFFFFF : #E1E1E6;
            font-size: 13px;
            font-weight: 500;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.shortcut-hint != "" : Text {
            text: root.shortcut-hint;
            color: touch.has-hover ? #E1E1E6 : #888892;
            font-size: 11.5px;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.triggered(); }
    }
}

// Polaroid Icon Card Cell (Mode 1: 3-Column Icon Grid with Direct Image & Document Previews)
export component PolaroidCell inherits Rectangle {
    in property <FileRowSlint> item;
    in property <bool> pane-focused: true;
    in property <bool> drag-drop-highlight: false;
    in property <length> font-delta: 1px;
    in property <bool> font-bold: false;
    in property <string> font-family: "";
    in property <brush> accent-bg: #0D52BF;
    private property <bool> down-shift: false;
    private property <bool> down-cmd: false;
    private property <bool> drag-active: false;
    private property <bool> suppress-next-click: false;
    callback select-cell(bool, bool);
    callback open-cell();
    callback context-cell(length, length);
    callback cell-hovered(length, length);
    callback cell-unhovered();
    callback cell-drag-moved(length, length);
    callback cell-drag-ended(length, length);
    callback wheel-scroll(length);

    height: 128px + Math.max(0px, root.font-delta * 4.0);
    horizontal-stretch: 1;
    border-radius: 6px;
    background: drag-drop-highlight
        ? #0D52BF38
        : (item.is-selected
            ? (pane-focused ? #0D52BF33 : #2E323B66)
            : (cell-touch.has-hover
                ? #26262B
                : (item.has-color-tag ? item.color-tag-tint : transparent)));
    border-width: (drag-drop-highlight || item.is-selected || item.has-color-tag) ? 1px : 0px;
    border-color: drag-drop-highlight
        ? root.accent-bg
        : (item.is-selected
            ? (pane-focused ? root.accent-bg : #3A3A44)
            : (item.has-color-tag ? item.color-tag-brush : transparent));

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding-top: 6px;
        padding-bottom: 6px;

        HorizontalLayout {
            alignment: center;
            if item.is-dir : Rectangle {
                width: 64px;
                height: 60px;
                background: transparent;
                LucideIcon {
                    x: 8px;
                    y: 6px;
                    icon-size: 48px;
                    kind: "folder";
                    icon-color: item.has-color-tag ? item.color-tag-brush : #38B6FF;
                    fill-color: item.has-color-tag ? item.color-tag-brush : #4CC2FF;
                }
            }
            if !item.is-dir : Rectangle {
                width: 108px;
                height: 68px;
                border-radius: 6px;
                background: item.has-thumbnail ? #101014 : #1E1E22;
                border-width: 1px;
                border-color: item.is-selected
                    ? root.accent-bg
                    : (item.has-color-tag ? item.color-tag-brush : #2E2E36);
                clip: true;

                // 1. Live Raster Image Thumbnail Preview directly inside the Polaroid card
                if item.has-thumbnail : Image {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    image-fit: contain;
                    source: item.thumbnail;
                }

                // 2. Styled Document / File Preview Card when no raster image thumbnail
                if !item.has-thumbnail : LucideIcon {
                    x: (parent.width - self.width) / 2;
                    y: 12px;
                    icon-size: 28px;
                    kind: item.ext-badge == "APP"
                        ? "applications"
                        : (item.is-image
                            ? "image"
                            : ((item.ext-badge == "ZIP" || item.ext-badge == "TAR" || item.ext-badge == "GZ" || item.ext-badge == "ISO" || item.ext-badge == "7Z" || item.ext-badge == "RAR")
                                ? "archive"
                                : ((item.ext-badge == "MP3" || item.ext-badge == "FLAC" || item.ext-badge == "WAV" || item.ext-badge == "M4A" || item.ext-badge == "OGG" || item.ext-badge == "AAC")
                                    ? "music"
                                    : ((item.ext-badge == "MP4" || item.ext-badge == "MKV" || item.ext-badge == "MOV" || item.ext-badge == "AVI" || item.ext-badge == "WEBM")
                                        ? "movies"
                                        : (item.is-executable ? "terminal" : "documents")))));
                    icon-color: item.has-color-tag
                        ? item.color-tag-brush
                        : (item.ext-badge == "PDF"
                            ? #FF5F56
                            : ((item.ext-badge == "DOC" || item.ext-badge == "DOCX" || item.ext-badge == "APP")
                                ? #4CC2FF
                                : ((item.ext-badge == "ZIP" || item.ext-badge == "TAR" || item.ext-badge == "GZ" || item.ext-badge == "ISO")
                                    ? #FF9F0A
                                    : (item.is-image ? #6E92B8 : (item.is-executable ? #5B9A72 : #B4B4BE)))));
                }

                // Extension Badge Pill in top-right corner of Polaroid preview card
                if item.ext-badge != "" : Rectangle {
                    x: parent.width - self.width - 4px;
                    y: 4px;
                    width: card-ext-txt.preferred-width + 8px;
                    height: 14px;
                    border-radius: 3px;
                    background: item.ext-badge == "PDF"
                        ? #FF453ACC
                        : ((item.ext-badge == "DOC" || item.ext-badge == "DOCX")
                            ? #0A84FFCC
                            : ((item.ext-badge == "ZIP" || item.ext-badge == "TAR" || item.ext-badge == "GZ" || item.ext-badge == "ISO")
                                ? #FF9F0ACC
                                : #18181CDD));
                    card-ext-txt := Text {
                        x: 4px;
                        y: (parent.height - self.height) / 2;
                        text: item.ext-badge;
                        color: #FFFFFF;
                        font-size: 8.5px;
                        font-family: "monospace";
                        font-weight: 700;
                    }
                }

                // File Size Footer strip at bottom of document preview card
                if !item.has-thumbnail && item.size-text != "" : Rectangle {
                    x: 0px;
                    y: parent.height - 15px;
                    width: parent.width;
                    height: 15px;
                    background: #141418CC;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: item.size-text;
                        color: #9898A4;
                        font-size: 9px;
                        font-family: "monospace";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            Rectangle {
                height: 20px;
                horizontal-stretch: 1;
                border-radius: 4px;
                background: item.is-selected ? (pane-focused ? root.accent-bg : #2E323B) : transparent;
                Text {
                    x: 6px;
                    y: 0px;
                    width: parent.width - (item.has-color-tag ? 22px : 12px);
                    height: 20px;
                    text: item.name;
                    color: item.is-selected ? #FFFFFF : #E1E1E6;
                    font-size: 12.5px + root.font-delta;
                    font-family: root.font-family;
                    font-weight: root.font-bold ? 700 : (item.has-color-tag ? 600 : 500);
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if item.has-color-tag : Rectangle {
                    x: parent.width - 13px;
                    y: 5px;
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: item.color-tag-brush;
                    border-width: 1px;
                    border-color: #FFFFFFAA;
                }
            }
        }
    }

    cell-touch := TouchArea {
        clicked => {
            if !root.suppress-next-click {
                root.select-cell(root.down-shift, root.down-cmd);
            }
            root.suppress-next-click = false;
            root.down-shift = false;
            root.down-cmd = false;
        }
        double-clicked => {
            root.drag-active = false;
            root.suppress-next-click = false;
            root.open-cell();
        }
        moved => {
            if self.pressed && !root.down-shift && !root.down-cmd && (Math.abs(self.mouse-x - self.pressed-x) > 14px || Math.abs(self.mouse-y - self.pressed-y) > 14px) {
                root.drag-active = true;
                root.suppress-next-click = true;
                root.cell-drag-moved(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
        changed has-hover => {
            if self.has-hover && !self.pressed && !root.drag-active {
                root.cell-hovered(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            } else if !self.has-hover {
                root.cell-unhovered();
            }
        }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.move && !self.pressed && !root.drag-active {
                root.cell-hovered(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.down-shift = ev.modifiers.shift;
                root.down-cmd = ev.modifiers.control || ev.modifiers.meta;
                root.drag-active = false;
                root.suppress-next-click = false;
            }
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                root.drag-active = false;
                root.suppress-next-click = true;
                root.context-cell(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.drag-active {
                root.drag-active = false;
                root.cell-drag-ended(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
            if ev.kind == PointerEventKind.cancel {
                root.down-shift = false;
                root.down-cmd = false;
                root.suppress-next-click = false;
            }
        }
        scroll-event(ev) => {
            root.wheel-scroll(ev.delta-y);
            return accept;
        }
    }
}


export component TransferTaskCard inherits Rectangle {
    in property <TransferRowSlint> tr;
    in property <int> spinner-frame: 0;
    in property <brush> bg-surface: #1A1A1E;
    in property <brush> bg-canvas: #121214;
    in property <brush> accent-bg: #0D52BF;
    in property <brush> border-brush: #28282D;
    in property <brush> text-secondary: #888892;
    callback toggle-pause(string);
    callback cancel-task(string);

    height: 68px;
    border-radius: 6px;
    background: root.bg-surface;
    border-width: 1px;
    border-color: root.tr.progress-pct < 100 ? root.accent-bg : root.border-brush;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            alignment: space-between;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                LucideIcon {
                    y: (parent.height - self.height) / 2;
                    icon-size: 13px;
                    kind: root.tr.progress-pct < 100
                        ? ("refresh-" + root.spinner-frame)
                        : "check";
                    icon-color: root.tr.progress-pct < 100 ? root.text-secondary : #3B8256;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.tr.source-name;
                    color: #FFFFFF;
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: end;
                Text {
                    text: root.tr.progress-pct + "%";
                    color: root.tr.progress-pct < 100 ? root.text-secondary : #3B8256;
                    font-size: 10px;
                    font-family: "monospace";
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.tr.can-control && root.tr.progress-pct < 100 : Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: tr-pause-touch.has-hover ? #2C2C36 : #1F1F26;
                    border-width: 1px;
                    border-color: root.border-brush;
                    LucideIcon {
                        x: 3.5px;
                        y: 3.5px;
                        icon-size: 11px;
                        kind: root.tr.is-paused ? "play" : "pause";
                        icon-color: #FFFFFF;
                    }
                    tr-pause-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-pause(root.tr.id); }
                    }
                }
                if root.tr.can-control && root.tr.progress-pct < 100 : Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: tr-cancel-touch.has-hover ? #FF453A33 : #1F1F26;
                    border-width: 1px;
                    border-color: tr-cancel-touch.has-hover ? #FF453A : root.border-brush;
                    LucideIcon {
                        x: 3.5px;
                        y: 3.5px;
                        icon-size: 11px;
                        kind: "close";
                        icon-color: tr-cancel-touch.has-hover ? #FF453A : #E1E1E6;
                    }
                    tr-cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel-task(root.tr.id); }
                    }
                }
            }
        }
        Text {
            text: root.tr.dest-path;
            color: root.text-secondary;
            font-size: 10px;
            overflow: elide;
        }
        Rectangle {
            height: 5px;
            border-radius: 2.5px;
            background: root.bg-canvas;
            Rectangle {
                x: 0px;
                y: 0px;
                height: 5px;
                border-radius: 2.5px;
                width: parent.width * (Math.clamp(root.tr.progress-pct, 0, 100) / 100.0);
                background: root.tr.progress-pct < 100 ? root.accent-bg : #3B8256;
            }
        }
        Text {
            text: root.tr.status-text;
            color: root.tr.progress-pct < 100 ? root.text-secondary : #3B8256;
            font-size: 10px;
            overflow: elide;
        }
    }
}

export component SidebarPanel inherits Rectangle {
    in-out property <length> col-resize-start-w;
    in-out property <length> col-resize-start-x;
    in-out property <length> drag-fav-grab-offset-x;
    in-out property <length> drag-fav-grab-offset-y;
    in-out property <string> drag-fav-icon;
    in-out property <string> drag-fav-label;
    in-out property <length> drag-fav-mouse-x;
    in-out property <length> drag-fav-mouse-y;
    in-out property <int> drag-hover-fav-idx;
    in property <int> drag-hover-sidebar-idx;
    in-out property <length> drag-sidebar-scroll-y;
    in-out property <int> dragging-sidebar-idx;
    in property <int> fav-max-sidebar-idx;
    in property <int> fav-min-sidebar-idx;
    in property <length> font-size-delta;
    in property <[SidebarEntrySlint]> sidebar-items;
    in-out property <length> sidebar-width;
    in property <brush> theme-accent;
    in property <brush> theme-bg-hover;
    in property <brush> theme-bg-popover;
    in property <brush> theme-bg-sidebar;
    in property <brush> theme-border;
    in property <brush> theme-text-muted;
    in property <brush> theme-text-primary;
    in property <bool> ui-font-bold;
    callback eject-sidebar-item(int);
    callback focus-key-router();
    callback open-sidebar-context-menu(int, length, length);
    callback reorder-sidebar-favorite(int, int);
    callback select-sidebar-item(int);

    width: root.sidebar-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.theme-bg-sidebar;
    border-width: 1px;
    border-color: root.theme-border;

                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        sb-flick := Flickable {
                            interactive: false;
                            viewport-y <=> root.drag-sidebar-scroll-y;
                            viewport-width: self.width;
                            viewport-height: Math.max(
                                self.height,
                                sb-col.preferred-height + 8px
                            );
                            sb-col := VerticalLayout {
                                alignment: start;
                                spacing: 2px;
                                padding-left: 8px;
                                padding-right: 8px;
                                for item[idx] in root.sidebar-items : Rectangle {
                                    height: item.is-header
                                        ? (24px + Math.max(0px, root.font-size-delta))
                                        : (28px + Math.max(0px, root.font-size-delta * 1.5));
                                    background: transparent;

                                    sb-touch := TouchArea {
                                        mouse-cursor: item.is-header ? default : pointer;
                                        clicked => {
                                            root.focus-key-router();
                                            if !item.is-header && root.dragging-sidebar-idx < 0 {
                                                root.select-sidebar-item(idx);
                                            }
                                        }
                                        moved => {
                                            if !item.is-header && item.section == "Favorites" && self.pressed && Math.abs(self.mouse-y - self.pressed-y) > 6px {
                                                if root.dragging-sidebar-idx < 0 {
                                                    root.dragging-sidebar-idx = idx;
                                                    root.drag-fav-label = item.label;
                                                    root.drag-fav-icon = item.icon-kind != "" ? item.icon-kind : "folder";
                                                    root.drag-fav-grab-offset-x = self.pressed-x;
                                                    root.drag-fav-grab-offset-y = self.pressed-y;
                                                }
                                                root.drag-fav-mouse-x = self.absolute-position.x + self.mouse-x;
                                                root.drag-fav-mouse-y = self.absolute-position.y + self.mouse-y;
                                                root.drag-hover-fav-idx = Math.clamp(
                                                    idx + Math.round((self.mouse-y - 14px) / (30px + Math.max(0px, root.font-size-delta * 1.5))),
                                                    root.fav-min-sidebar-idx >= 0 ? root.fav-min-sidebar-idx : idx,
                                                    root.fav-max-sidebar-idx >= 0 ? root.fav-max-sidebar-idx : idx
                                                );
                                            }
                                        }
                                        pointer-event(ev) => {
                                            if !item.is-header && ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                                root.open-sidebar-context-menu(
                                                    idx,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y
                                                );
                                            }
                                            if !item.is-header && (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                if root.dragging-sidebar-idx == idx && root.drag-hover-fav-idx >= 0 && root.drag-hover-fav-idx != idx {
                                                    root.reorder-sidebar-favorite(idx, root.drag-hover-fav-idx);
                                                }
                                                root.dragging-sidebar-idx = -1;
                                                root.drag-hover-fav-idx = -1;
                                            }
                                        }
                                        scroll-event(ev) => {
                                            sb-flick.viewport-y = Math.clamp(
                                                sb-flick.viewport-y + ev.delta-y,
                                                Math.min(0px, sb-flick.height - sb-flick.viewport-height),
                                                0px
                                            );
                                            return accept;
                                        }
                                    }

                                    // Animated visual card inside the slot (shifts smoothly when another Favorite moves across it)
                                    Rectangle {
                                        x: 0px;
                                        y: (root.dragging-sidebar-idx >= 0 && root.drag-hover-fav-idx >= 0 && item.section == "Favorites" && !item.is-header)
                                            ? (idx == root.dragging-sidebar-idx
                                                ? ((root.drag-hover-fav-idx - root.dragging-sidebar-idx) * (30px + Math.max(0px, root.font-size-delta * 1.5)))
                                                : ((idx > root.dragging-sidebar-idx && idx <= root.drag-hover-fav-idx)
                                                    ? -(30px + Math.max(0px, root.font-size-delta * 1.5))
                                                    : ((idx < root.dragging-sidebar-idx && idx >= root.drag-hover-fav-idx)
                                                        ? (30px + Math.max(0px, root.font-size-delta * 1.5))
                                                        : 0px)))
                                            : 0px;
                                        animate y { duration: 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1.0); }
                                        width: parent.width;
                                        height: parent.height;
                                        border-radius: 5px;
                                        opacity: root.dragging-sidebar-idx == idx ? 0.32 : 1.0;
                                        border-width: (root.drag-hover-sidebar-idx == idx || root.dragging-sidebar-idx == idx) ? 1px : 0px;
                                        border-color: root.drag-hover-sidebar-idx == idx
                                            ? root.theme-accent
                                            : (root.dragging-sidebar-idx == idx ? #32323C : transparent);
                                        background: root.drag-hover-sidebar-idx == idx
                                            ? #0D52BF38
                                            : (root.dragging-sidebar-idx == idx
                                                ? #101014
                                                : (item.is-selected
                                                    ? root.theme-accent
                                                    : (sb-touch.has-hover && !item.is-header && root.dragging-sidebar-idx < 0 ? root.theme-bg-hover : transparent)));

                                        HorizontalLayout {
                                            padding-left: item.is-header ? 4px : (8px + item.indent-level * 12px);
                                            padding-right: 6px;
                                            spacing: 8px;

                                            if !item.is-header && root.dragging-sidebar-idx != idx : Rectangle {
                                                width: 16px;
                                                background: transparent;
                                                SidebarItemIcon {
                                                    x: 0px;
                                                    y: (parent.height - self.height) / 2;
                                                    kind: item.icon-kind;
                                                    selected: item.is-selected;
                                                    has-color-tag: item.has-color-tag;
                                                    color-tag-brush: item.color-tag-brush;
                                                }
                                            }

                                            if root.dragging-sidebar-idx != idx : Text {
                                                text: item.label;
                                                color: item.is-header
                                                    ? root.theme-text-muted
                                                    : (item.is-selected ? #FFFFFF : root.theme-text-primary);
                                                font-size: item.is-header ? (11px + root.font-size-delta) : (13.5px + root.font-size-delta);
                                                font-weight: item.is-header ? 700 : (root.ui-font-bold || item.is-selected ? 600 : 500);
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }

                                            if !item.is-header && item.has-color-tag && root.dragging-sidebar-idx != idx : Rectangle {
                                                width: 7px;
                                                height: 7px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 3.5px;
                                                background: item.color-tag-brush;
                                                border-width: 1px;
                                                border-color: item.is-selected ? #FFFFFF : root.theme-bg-sidebar;
                                            }

                                            if item.badge != "" && root.dragging-sidebar-idx != idx : Text {
                                                text: item.badge;
                                                color: item.is-selected ? #D0D0D8 : root.theme-text-muted;
                                                font-size: 11px + root.font-size-delta;
                                                font-family: "monospace";
                                                vertical-alignment: center;
                                            }

                                            if item.can-eject && root.dragging-sidebar-idx != idx : Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                y: 4px;
                                                border-radius: 3px;
                                                background: eject-touch.has-hover ? #323238 : transparent;
                                                LucideIcon {
                                                    x: 3px;
                                                    y: 3px;
                                                    icon-size: 12px;
                                                    kind: "eject";
                                                    icon-color: eject-touch.has-hover || item.is-selected ? #FFFFFF : root.theme-text-muted;
                                                }
                                                if eject-touch.has-hover && !eject-touch.pressed : Rectangle {
                                                    z: 3000;
                                                    x: parent.width - self.width;
                                                    y: parent.height + 4px;
                                                    height: 20px;
                                                    width: 114px;
                                                    border-radius: 4px;
                                                    background: root.theme-bg-popover;
                                                    border-width: 1px;
                                                    border-color: #3A3A44;
                                                    Text {
                                                        x: 6px;
                                                        y: (parent.height - self.height) / 2;
                                                        text: "Disconnect / Eject";
                                                        color: #F2F2F7;
                                                        font-size: 10px;
                                                        font-weight: 500;
                                                    }
                                                }
                                                eject-touch := TouchArea {
                                                    clicked => {
                                                        root.eject-sidebar-item(idx);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Draggable right-edge resizer for Left Sidebar
                    Rectangle {
                        x: parent.width - 3px;
                        y: 0px;
                        width: 4px;
                        height: parent.height;
                        background: sb-resizer.has-hover || sb-resizer.pressed ? root.theme-accent : transparent;
                        sb-resizer := TouchArea {
                            mouse-cursor: col-resize;
                            pointer-event(ev) => {
                                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                    root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                    root.col-resize-start-w = root.sidebar-width;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.sidebar-width = Math.clamp(
                                        root.col-resize-start-w + ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                        155px,
                                        340px
                                    );
                                }
                            }
                        }
                    }
}

export component InspectorDrawer inherits Rectangle {
    in-out property <length> col-resize-start-w;
    in-out property <length> col-resize-start-x;
    in property <length> font-size-delta;
    in property <int> inspector-color-index;
    in property <string> inspector-created;
    in property <string> inspector-extension;
    in property <string> inspector-group;
    in property <bool> inspector-has-image;
    in property <bool> inspector-has-text-preview;
    in property <string> inspector-image-dimensions;
    in property <bool> inspector-is-dir;
    in property <bool> inspector-is-image;
    in property <bool> inspector-locked;
    in property <string> inspector-media-category;
    in property <string> inspector-media-line1;
    in property <string> inspector-media-line2;
    in property <string> inspector-media-line3;
    in property <string> inspector-modified;
    in property <string> inspector-owner;
    in property <string> inspector-perm-octal;
    in property <string> inspector-perm-symbolic;
    in property <image> inspector-preview-image;
    in property <string> inspector-preview-text;
    in property <string> inspector-size;
    in property <string> inspector-subtitle;
    in property <int> inspector-tab-index;
    in property <string> inspector-title;
    in-out property <length> inspector-width;
    in property <bool> perm-gr;
    in property <bool> perm-gw;
    in property <bool> perm-gx;
    in property <bool> perm-or;
    in property <bool> perm-ow;
    in property <bool> perm-ox;
    in property <bool> perm-ur;
    in property <bool> perm-uw;
    in property <bool> perm-ux;
    in property <string> resolved-font-family;
    in property <int> spinner-frame;
    in property <brush> theme-accent;
    in property <brush> theme-bg-canvas;
    in property <brush> theme-bg-hover;
    in property <brush> theme-bg-sidebar;
    in property <brush> theme-bg-surface;
    in property <brush> theme-border;
    in property <brush> theme-text-primary;
    in property <brush> theme-text-secondary;
    in property <[TransferRowSlint]> transfer-rows;
    in property <int> ui-font-size-delta;
    callback calculate-selected-dir-size();
    callback cancel-transfer(string);
    callback clear-completed-tasks();
    callback set-inspector-tab(int);
    callback set-selected-color-label(int);
    callback toggle-locked();
    callback toggle-pause-transfer(string);
    callback toggle-permission-bit(int, int);
    callback toggle-preview-minion();

    width: root.inspector-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.theme-bg-sidebar;
    border-width: 1px;
    border-color: root.theme-border;
    clip: true;

                    // Draggable Inspector Left-Edge Resizer
                    Rectangle {
                        z: 40;
                        x: -2px;
                        y: 0px;
                        width: 5px;
                        height: parent.height;
                        background: insp-resizer.has-hover || insp-resizer.pressed ? root.theme-accent : transparent;
                        insp-resizer := TouchArea {
                            mouse-cursor: col-resize;
                            pointer-event(ev) => {
                                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                                    root.col-resize-start-x = self.absolute-position.x + self.mouse-x;
                                    root.col-resize-start-w = root.inspector-width;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.inspector-width = Math.clamp(
                                        root.col-resize-start-w - ((self.absolute-position.x + self.mouse-x) - root.col-resize-start-x),
                                        252px,
                                        440px
                                    );
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Unified Segmented Capsule Switcher (Info | Tasks)
                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: root.theme-bg-canvas;
                            border-width: 1px;
                            border-color: root.theme-border;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.inspector-tab-index == 0
                                        ? root.theme-accent
                                        : (insp-tab-info-touch.has-hover ? root.theme-bg-hover : transparent);
                                    Text {
                                        text: "Info";
                                        color: root.inspector-tab-index == 0 ? #FFFFFF : root.theme-text-secondary;
                                        font-size: 11.5px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        font-weight: root.inspector-tab-index == 0 ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    insp-tab-info-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-inspector-tab(0); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.inspector-tab-index == 1
                                        ? root.theme-accent
                                        : (insp-tab-tasks-touch.has-hover ? root.theme-bg-hover : transparent);
                                    Text {
                                        text: root.transfer-rows.length > 0
                                            ? ("Tasks (" + root.transfer-rows.length + ")")
                                            : "Tasks";
                                        color: root.inspector-tab-index == 1 ? #FFFFFF : root.theme-text-secondary;
                                        font-size: 11.5px + root.font-size-delta;
                                        font-family: root.resolved-font-family;
                                        font-weight: root.inspector-tab-index == 1 ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    insp-tab-tasks-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-inspector-tab(1); }
                                    }
                                }
                            }
                        }

                        // TAB 0: FILE INFO & METADATA CARDS (Width-locked Flickable prevents horizontal overflow/clipping)
                        if root.inspector-tab-index == 0 : Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            background: transparent;

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                scroll-event(ev) => {
                                    insp-info-flick.viewport-y = Math.clamp(
                                        insp-info-flick.viewport-y + ev.delta-y,
                                        Math.min(0px, insp-info-flick.height - insp-info-flick.viewport-height),
                                        0px
                                    );
                                    return accept;
                                }
                            }

                            insp-info-flick := Flickable {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                interactive: false;
                                viewport-width: self.width;
                                viewport-height: Math.max(self.height, insp-info-col.preferred-height + 8px);

                                insp-info-col := VerticalLayout {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    spacing: 8px;

                                    // CARD 1: HERO PREVIEW & FILE IDENTITY
                                    Rectangle {
                                        border-radius: 6px;
                                        background: root.theme-bg-surface;
                                        border-width: 1px;
                                        border-color: root.theme-border;
                                        clip: true;

                                        VerticalLayout {
                                            spacing: 0px;

                                            Rectangle {
                                                height: 132px;
                                                background: root.theme-bg-canvas;
                                                clip: true;

                                                if root.inspector-is-dir : LucideIcon {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2 - 10px;
                                                    icon-size: 52px;
                                                    kind: "folder";
                                                    icon-color: #38B6FF;
                                                    fill-color: #4CC2FF;
                                                }
                                                if !root.inspector-is-dir && root.inspector-has-image : Image {
                                                    x: 6px;
                                                    y: 6px;
                                                    width: parent.width - 12px;
                                                    height: parent.height - 32px;
                                                    image-fit: contain;
                                                    source: root.inspector-preview-image;
                                                }
                                                if !root.inspector-is-dir && !root.inspector-has-image && root.inspector-is-image : LucideIcon {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2 - 10px;
                                                    icon-size: 50px;
                                                    kind: "image";
                                                    icon-color: root.theme-text-secondary;
                                                }
                                                if !root.inspector-is-dir && !root.inspector-is-image && root.inspector-has-text-preview : VerticalLayout {
                                                    padding: 8px;
                                                    Text {
                                                        text: root.inspector-preview-text;
                                                        color: root.theme-text-secondary;
                                                        font-size: 9.5px + root.ui-font-size-delta * 1px;
                                                        font-family: "monospace";
                                                        wrap: word-wrap;
                                                        overflow: elide;
                                                    }
                                                }
                                                if !root.inspector-is-dir && !root.inspector-is-image && !root.inspector-has-text-preview : LucideIcon {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2 - 10px;
                                                    icon-size: 48px;
                                                    kind: root.inspector-media-category == "Audio / Music"
                                                        ? "music"
                                                        : (root.inspector-media-category == "Video / Media" ? "video" : "file");
                                                    icon-color: root.theme-text-secondary;
