                                                }
                                                ColorSwatchDot {
                                                    swatch-color: #0A84FF;
                                                    selected: root.inspector-color-index == 4;
                                                    clicked => { root.set-selected-color-label(4); }
                                                }
                                                ColorSwatchDot {
                                                    swatch-color: #FFD60A;
