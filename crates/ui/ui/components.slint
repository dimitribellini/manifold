// Declarative Slint UI definition for Project Manifold
// Implements the complete UI/UX & Architectural Specifications in doc/specification_1.md,
// doc/specification_2.md, and doc/BRIEF.md.
//
// Elevation Token System (Dark Zinc Palette - doc/specification_2.md §2.2):
// - Base Window Canvas:       #121214
// - Unified Top Toolbar:      #1E1E22 (height: 36px, bottom border: #28282D)
// - Sidebar (Panel 0):        #161618 (border: #28282D)
// - Main File View (Panel 1): #1A1A1E (border: #28282D — no neon outer focus border)
// - Table Header Row:         #1E1E22 (height: 28px, uppercase #8E8E93, bottom border: #28282D)
// - Row Hover:                #26262B
// - Row Selected (Focused):   #0D52BF (Professional Royal Blue)
// - Row Selected (Unfocused): #2E323B (Muted Slate when pane loses focus)
// - Context Menu / Popover:   #202024 (100% Opaque, border: 1px solid #323238, radius: 8px)
// - Borders & Dividers:       #28282D (1px solid)

import { ScrollView } from "std-widgets.slint";

export struct SidebarEntrySlint {
    id: string,
    section: string,
    icon-kind: string,
    is-header: bool,
    label: string,
    badge: string,
    can-eject: bool,
    indent-level: int,
    is-selected: bool,
    has-color-tag: bool,
    color-tag-brush: brush,
}

export struct TabEntrySlint {
    title: string,
    tooltip: string,
    icon-kind: string,
    is-active: bool,
    is-search: bool,
    is-remote: bool,
}

export struct BreadcrumbSegmentSlint {
    label: string,
    target-path: string,
    is-last: bool,
}

export struct FileRowSlint {
    name: string,
    path: string,
    ext-badge: string,
    size-text: string,
    modified-text: string,
    created-text: string,
    added-text: string,
    kind-text: string,
    owner-text: string,
    group-text: string,
    permissions-text: string,
    color-tag-hex: string,
    color-tag-name: string,
    color-tag-brush: brush,
    color-tag-tint: brush,
    has-color-tag: bool,
    is-dir: bool,
    is-image: bool,
    has-thumbnail: bool,
    thumbnail: image,
    is-executable: bool,
    is-expanded: bool,
    is-selected: bool,
    depth: int,
}

export struct IconGridTripleSlint {
    has-0: bool,
    idx-0: int,
    item-0: FileRowSlint,
    has-1: bool,
    idx-1: int,
    item-1: FileRowSlint,
    has-2: bool,
    idx-2: int,
    item-2: FileRowSlint,
}

export struct TransferRowSlint {
    id: string,
    priority-label: string,
    source-name: string,
    dest-path: string,
    status-text: string,
    progress-pct: int,
    is-paused: bool,
    can-control: bool,
}

export struct SyncPreviewRowSlint {
    relative-path: string,
    action: string,
    source-size: string,
    dest-size: string,
    approved: bool,
    is-dir: bool,
}

export struct OpenWithAppSlint {
    id: string,
    name: string,
    detail: string,
    icon-kind: string,
}

export struct BatchRenameRuleSlint {
    operation: string,
    apply-to: string,
    occurrences: string,
    find-text: string,
    replace-text: string,
    case-sensitive: bool,
    case-style: string,
    position: string,
    seq-prefix: string,
    seq-start: string,
    seq-step: string,
    seq-padding: string,
    date-format: string,
}

export struct BatchRenamePreviewRowSlint {
    original-name: string,
    proposed-name: string,
    is-dir: bool,
    is-image: bool,
    status: string,
}

export struct TerminalSpanSlint {
    text: string,
    char-count: int,
    fg: brush,
    bg: brush,
    has-bg: bool,
    bold: bool,
    underline: bool,
}

export struct TerminalLineSlint {
    s0: TerminalSpanSlint,
    s1: TerminalSpanSlint,
    s2: TerminalSpanSlint,
    s3: TerminalSpanSlint,
    s4: TerminalSpanSlint,
    s5: TerminalSpanSlint,
    s6: TerminalSpanSlint,
    s7: TerminalSpanSlint,
    s8: TerminalSpanSlint,
    s9: TerminalSpanSlint,
    s10: TerminalSpanSlint,
    s11: TerminalSpanSlint,
    s12: TerminalSpanSlint,
    s13: TerminalSpanSlint,
    s14: TerminalSpanSlint,
    s15: TerminalSpanSlint,
}

export component TermSpanCell inherits Rectangle {
    in property <TerminalSpanSlint> span;
    in property <int> font-delta: 1;
    in property <string> mono-font-family: "Menlo";
    in property <length> cell-width: 7.8px;
    width: span.char-count <= 0 ? 0px : span.char-count * root.cell-width;
    height: 18px + font-delta * 1.5px;
    background: span.has-bg && span.char-count > 0 ? span.bg : transparent;

    span-txt := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: span.text;
        color: span.fg;
        font-size: 13px + root.font-delta * 1px;
        font-family: root.mono-font-family;
        font-weight: span.bold ? 700 : 400;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    if span.char-count > 0 && span.underline : Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 1px;
        background: span.fg;
    }
}

// Unified Lucide Vector Icon System (16x16px, 1.5px stroke width — doc/specification_2.md §2.5 & §4.5)
export component LucideIcon inherits Rectangle {
    in property <string> kind: "file";
    in property <brush> icon-color: #A0A0AB;
    in property <brush> fill-color: transparent;
    in property <length> icon-size: 16px;

    width: icon-size;
    height: icon-size;
    background: transparent;

    Path {
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 24;
